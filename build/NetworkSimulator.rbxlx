<Item class="ModuleScript" referent="RBX6">
<Properties>
<string name="Name">NetworkTypes</string>
<ProtectedString name="Source"><![CDATA[--!strict
--[[
	NetworkTypes (ModuleScript, ReplicatedStorage/Shared)
	Definisi type ketat untuk seluruh simulasi. Type-only module (return nil).
]]

export type PortType = "WAN" | "RJ45" | "SFP" | "Console"
export type CableColorType = "LAN_Blue" | "WAN_Yellow" | "Mgmt_Red"
export type VMStatus = "running" | "throttled" | "stopped"
export type DeviceType = "Router" | "Switch" | "BareMetal" | "ColocationServer"
export type TicketCategory = "CloudVPS" | "Colocation" | "CustomBuild" | "Incident"
export type TicketStatus = "Available" | "Active" | "Completed" | "Failed"
export type TerminalMode = "Disconnected" | "LocalConsole" | "RemoteSSH"

export type PortData = {
	portId: string,
	portType: PortType,
	connectedToDeviceId: string?,
	connectedToPortId: string?,
	cableColor: CableColorType?,
	linkUp: boolean,
	vlanId: number,
	isTrunk: boolean?,
	trafficLoadMbps: number,
}

export type VMData = {
	name: string,
	cpu: number,
	ram: number,
	disk: number,
	assignedIp: string?,
	cpuThrottlePercent: number,
	currentLoadPercent: number,
	status: VMStatus,
}

export type DeviceSpecs = {
	cpu: number,
	ram: number,
	disk: number,
	powerWatts: number,
}

export type DeviceNode = {
	id: string,
	name: string,
	deviceType: DeviceType,
	itemId: string,
	rackId: string?,
	uSlot: number?,
	uSize: number,
	ip: string?,
	gateway: string?,
	subnetMask: string,
	defaultVlan: number,
	interVlanRouting: boolean?,
	contractId: string?,
	ports: { [string]: PortData },
	specs: DeviceSpecs,
	vms: { [string]: VMData },
	blockedIps: { [string]: boolean },
	osInstalled: string?,
	isPowered: boolean,
	temperatureC: number,
	loadPercent: number,
	hasDegradedDrive: boolean,
	degradedBayIndex: number?,
	isUnderDDoS: boolean,
	ddosAttackerIp: string?,
	freeform: boolean,
	posX: number?,
	posZ: number?,
	rotY: number?,
}

export type RackData = {
	rackId: string,
	name: string,
	itemId: string,
	maxU: number,
	occupiedSlots: { [number]: string },
	totalPowerWatts: number,
	maxPowerWatts: number,
	pduPowered: boolean,
}

export type ContractTicket = {
	id: string,
	category: TicketCategory,
	clientName: string,
	title: string,
	description: string,
	requirements: { [string]: any },
	rewardPayout: number,
	payoutIntervalSec: number?,
	slaRemainingSec: number?,
	runtimeRemainingSec: number?,
	vlanId: number?,
	targetIp: string?,
	phase: string?,
	validationText: string?,
	targetDeviceId: string?,
	targetRackId: string?,
	targetUSlot: number?,
	status: TicketStatus,
}

export type TerminalSession = {
	mode: TerminalMode,
	targetDeviceId: string?,
	sshStack: { any },
}

export type ActiveCable = {
	cableId: string,
	aDeviceId: string,
	aPortId: string,
	bDeviceId: string,
	bPortId: string,
	color: CableColorType,
	beam: Beam,
}

export type ConsoleLink = {
	deviceId: string,
	beam: Beam,
}

export type WorkbenchState = {
	chassis: string?,
	mobo: string?,
	cpuCount: number,
	cpuSockets: number,
	cpuCores: number,
	ramSlotsUsed: number,
	ramSlots: number,
	ramGb: number,
	storageBaysUsed: number,
	storageBays: number,
	storageGb: number,
	psu: string?,
	powered: boolean,
	osInstalled: string?,
	installing: boolean,
	stressRunning: boolean,
	tested: boolean,
	shipped: boolean,
	deviceId: string?,
	totalSpent: number,
	snapIndex: number?,
	benchModel: any?,
	lastCpuId: string?,
	lastRamId: string?,
}

export type DeviceSnapshot = {
	id: string,
	name: string,
	deviceType: DeviceType,
	ip: string?,
	isPowered: boolean,
	temperatureC: number,
	loadPercent: number,
	vmCount: number,
	peers: { string },
}

export type FacilitySnapshot = {
	plotIndex: number,
	balance: number,
	reputation: number,
	uptimePercent: number,
	powerWatts: number,
	avgTempC: number,
	storm: boolean,
	day: number,
	clockText: string,
	devices: { DeviceSnapshot },
	vms: { { name: string, hostId: string, cpu: number, ram: number, disk: number, ip: string?, status: VMStatus, loadPercent: number } },
	objectives: { [string]: boolean },
	tickets: { { id: string, category: string, title: string, description: string, rewardPayout: number, status: string, requirementsText: string, slaRemainingSec: number?, payoutIntervalSec: number?, validationText: string?, vlanId: number? } },
}

export type Session = {
	player: Player,
	plotIndex: number,
	balance: number,
	reputation: number,
	day: number,
	terminal: TerminalSession,
	devices: { [string]: DeviceNode },
	deviceModels: { [string]: Model },
	racks: { [string]: RackData },
	rackModels: { [string]: Model },
	cables: { [string]: ActiveCable },
	pendingCableDeviceId: string?,
	pendingCablePortId: string?,
	pendingCableHighlight: SelectionBox?,
	consoleLink: ConsoleLink?,
	pendingPlacementItemId: string?,
	workbench: WorkbenchState,
	facility: { [string]: any },
	flags: { [string]: boolean },
	hookedDevices: { [string]: boolean },
	vmIpCounter: { [string]: number },
	cableCounter: number,
	deviceCounter: number,
	broadcastStorm: boolean,
	loadedFromSave: boolean,
	noSaveWarned: boolean,
	tickets: { any },
	cableSpools: { [string]: number },
	selectedCableColor: CableColorType,
	carry: any?,
	colocation: { [string]: any },
	rackSlots: { [string]: any },
}

return nil
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX7">
<Properties>
<string name="Name">NetworkUtils</string>
<ProtectedString name="Source"><![CDATA[--!strict
--[[
	NetworkUtils (ModuleScript, ReplicatedStorage/Shared)
	Utilitas jaringan murni & deterministik: validasi IPv4, subnet bitwise,
	generator IP, formatter currency/watt/uptime, escape RichText.
	Tidak menyentuh API Roblox -> bisa di-unit-test dengan luau CLI.
]]

local NetworkUtils = {}

function NetworkUtils.IsValidIPv4(ip: string): boolean
	if type(ip) ~= "string" or #ip == 0 or #ip > 15 then
		return false
	end
	local parts = string.split(ip, ".")
	if #parts ~= 4 then
		return false
	end
	for _, p in ipairs(parts) do
		if #p == 0 or #p > 3 then
			return false
		end
		for i = 1, #p do
			local ch = string.sub(p, i, i)
			if ch < "0" or ch > "9" then
				return false
			end
		end
		local n = tonumber(p)
		if n == nil then
			return false
		end
		if n < 0 or n > 255 then
			return false
		end
		if #p > 1 and string.sub(p, 1, 1) == "0" then
			return false
		end
	end
	return true
end

function NetworkUtils.IPToNumber(ip: string): number
	local parts = string.split(ip, ".")
	local n = 0
	for _, p in ipairs(parts) do
		n = bit32.bor(bit32.lshift(n, 8), tonumber(p) or 0)
	end
	return n
end

function NetworkUtils.NumberToIP(n: number): string
	local a = bit32.band(bit32.rshift(n, 24), 255)
	local b = bit32.band(bit32.rshift(n, 16), 255)
	local c = bit32.band(bit32.rshift(n, 8), 255)
	local d = bit32.band(n, 255)
	return string.format("%d.%d.%d.%d", a, b, c, d)
end

function NetworkUtils.MaskToPrefix(mask: string): number
	local n = NetworkUtils.IPToNumber(mask)
	local prefix = 0
	for i = 31, 0, -1 do
		if bit32.band(bit32.rshift(n, i), 1) == 1 then
			prefix += 1
		else
			break
		end
	end
	return prefix
end

function NetworkUtils.IsSameSubnet(ipA: string, ipB: string, mask: string): boolean
	if not NetworkUtils.IsValidIPv4(ipA) or not NetworkUtils.IsValidIPv4(ipB) or not NetworkUtils.IsValidIPv4(mask) then
		return false
	end
	local m = NetworkUtils.IPToNumber(mask)
	return bit32.band(NetworkUtils.IPToNumber(ipA), m) == bit32.band(NetworkUtils.IPToNumber(ipB), m)
end

function NetworkUtils.IsPrivateIP(ip: string): boolean
	if not NetworkUtils.IsValidIPv4(ip) then
		return false
	end
	local parts = string.split(ip, ".")
	local a = tonumber(parts[1]) or 0
	local b = tonumber(parts[2]) or 0
	if a == 10 or a == 127 then
		return true
	end
	if a == 172 and b >= 16 and b <= 31 then
		return true
	end
	if a == 192 and b == 168 then
		return true
	end
	return false
end

function NetworkUtils.GenerateRandomPublicIP(): string
	return string.format("203.0.113.%d", math.random(2, 254))
end

function NetworkUtils.GenerateInternalIP(index: number): string
	local last = math.clamp(index, 2, 254)
	return string.format("10.0.0.%d", last)
end

function NetworkUtils.FormatCurrency(amount: number): string
	local negative = amount < 0
	local n = math.floor(math.abs(amount) + 0.5)
	local s = tostring(n)
	local formatted = s
	while true do
		local k
		formatted, k = string.gsub(formatted, "^(-?%d+)(%d%d%d)", "%1,%2")
		if k == 0 then
			break
		end
	end
	local prefix = if negative then "-$" else "$"
	return prefix .. formatted
end

function NetworkUtils.FormatWatts(watts: number): string
	return string.format("%d W", math.floor(watts + 0.5))
end

function NetworkUtils.FormatUptime(seconds: number): string
	local s = math.max(0, math.floor(seconds))
	local days = math.floor(s / 86400)
	local hours = math.floor((s % 86400) / 3600)
	local minutes = math.floor((s % 3600) / 60)
	if days > 0 then
		return string.format("%dd %dh %02dm", days, hours, minutes)
	end
	if hours > 0 then
		return string.format("%dh %02dm", hours, minutes)
	end
	return string.format("%dm", minutes)
end

function NetworkUtils.EscapeRich(text: string): string
	local out = text
	out = string.gsub(out, "&", "&amp;")
	out = string.gsub(out, "<", "&lt;")
	out = string.gsub(out, ">", "&gt;")
	return out
end

return NetworkUtils
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX8">
<Properties>
<string name="Name">HardwareCatalog</string>
<ProtectedString name="Source"><![CDATA[--!strict
--[[
	HardwareCatalog (ModuleScript, ReplicatedStorage/Shared)
	Katalog hardware: harga, ukuran U, specs, warna visual, deskripsi.
]]

export type ItemCategory = "Rack" | "Network" | "Server" | "Component" | "Cable"

export type ItemDef = {
	id: string,
	name: string,
	category: ItemCategory,
	price: number,
	uSize: number,
	description: string,
	specs: { [string]: number },
	visualColor: Color3,
}

local Catalog = {}

local ITEMS: { [string]: ItemDef } = {}

local function addItem(def: ItemDef)
	ITEMS[def.id] = def
end

-- ===== Racks =====
addItem({
	id = "rack_12u",
	name = "Server Rack 12U",
	category = "Rack",
	price = 400,
	uSize = 12,
	description = "Rack 12U dengan PDU 3000W. Tempat mount device rackable.",
	specs = { maxU = 12, maxPowerWatts = 3000, idleWatts = 40 },
	visualColor = Color3.fromRGB(88, 102, 120),
})
addItem({
	id = "rack_24u",
	name = "Server Rack 24U",
	category = "Rack",
	price = 950,
	uSize = 24,
	description = "Rack 24U dengan PDU 6000W. Kapasitas dobel.",
	specs = { maxU = 24, maxPowerWatts = 6000, idleWatts = 60 },
	visualColor = Color3.fromRGB(68, 92, 124),
})

-- ===== Network =====
addItem({
	id = "switch_8p",
	name = "Gigabit Switch 8-Port",
	category = "Network",
	price = 250,
	uSize = 1,
	description = "8x RJ45. Distribusi LAN dasar.",
	specs = { ports = 8, sfpPorts = 0, wanPorts = 0, powerWatts = 30 },
	visualColor = Color3.fromRGB(48, 136, 174),
})
addItem({
	id = "switch_24p",
	name = "Gigabit Switch 24-Port",
	category = "Network",
	price = 650,
	uSize = 1,
	description = "24x RJ45 + 2x SFP. Untuk kolokasi skala besar.",
	specs = { ports = 24, sfpPorts = 2, wanPorts = 0, powerWatts = 60 },
	visualColor = Color3.fromRGB(36, 114, 166),
})
addItem({
	id = "router_edge",
	name = "Edge Router",
	category = "Network",
	price = 500,
	uSize = 1,
	description = "2x WAN + 4x RJ45. Gateway antar subnet/VLAN.",
	specs = { ports = 4, sfpPorts = 0, wanPorts = 2, powerWatts = 40 },
	visualColor = Color3.fromRGB(72, 102, 224),
})

-- ===== Bare-Metal =====
addItem({
	id = "bm_starter",
	name = "Bare-Metal Starter",
	category = "Server",
	price = 800,
	uSize = 2,
	description = "8 vCPU / 16GB RAM / 500GB Disk / 450W.",
	specs = { cpu = 8, ram = 16, disk = 500, powerWatts = 450, ports = 1, sfpPorts = 0, wanPorts = 0 },
	visualColor = Color3.fromRGB(164, 176, 192),
})
addItem({
	id = "bm_enterprise",
	name = "Bare-Metal Enterprise",
	category = "Server",
	price = 2200,
	uSize = 2,
	description = "32 vCPU / 128GB RAM / 2TB Disk / 750W.",
	specs = { cpu = 32, ram = 128, disk = 2000, powerWatts = 750, ports = 2, sfpPorts = 0, wanPorts = 0 },
	visualColor = Color3.fromRGB(124, 140, 162),
})

-- ===== Components (Custom Build) =====
addItem({
	id = "chassis_1u",
	name = "Chassis 1U",
	category = "Component",
	price = 150,
	uSize = 1,
	description = "Casing rack 1U untuk custom build (1x RJ45 terpasang).",
	specs = { uSize = 1, width = 4.2, ports = 1, sfpPorts = 0, wanPorts = 0 },
	visualColor = Color3.fromRGB(182, 190, 202),
})
addItem({
	id = "chassis_2u",
	name = "Chassis 2U",
	category = "Component",
	price = 220,
	uSize = 2,
	description = "Casing rack 2U, lebih lega (1x RJ45 terpasang).",
	specs = { uSize = 2, width = 4.6, ports = 1, sfpPorts = 0, wanPorts = 0 },
	visualColor = Color3.fromRGB(154, 166, 184),
})
addItem({
	id = "mobo_single",
	name = "Motherboard Single-Socket",
	category = "Component",
	price = 200,
	uSize = 0,
	description = "1 socket CPU, 2 slot RAM, 2 bay storage.",
	specs = { sockets = 1, ramSlots = 2, storageBays = 2 },
	visualColor = Color3.fromRGB(48, 152, 92),
})
addItem({
	id = "mobo_dual",
	name = "Motherboard Dual-Socket",
	category = "Component",
	price = 450,
	uSize = 0,
	description = "2 socket CPU, 4 slot RAM, 3 bay storage.",
	specs = { sockets = 2, ramSlots = 4, storageBays = 3 },
	visualColor = Color3.fromRGB(36, 142, 122),
})
addItem({
	id = "cpu_xeon8",
	name = "CPU Xeon 8-Core",
	category = "Component",
	price = 300,
	uSize = 0,
	description = "8 vCPU untuk host bare-metal.",
	specs = { cores = 8 },
	visualColor = Color3.fromRGB(206, 214, 224),
})
addItem({
	id = "cpu_epyc32",
	name = "CPU EPYC 32-Core",
	category = "Component",
	price = 850,
	uSize = 0,
	description = "32 vCPU untuk host bare-metal.",
	specs = { cores = 32 },
	visualColor = Color3.fromRGB(220, 172, 114),
})
addItem({
	id = "ram_32g",
	name = "RAM 32GB ECC",
	category = "Component",
	price = 120,
	uSize = 0,
	description = "32GB memory per module.",
	specs = { ramGb = 32 },
	visualColor = Color3.fromRGB(64, 214, 148),
})
addItem({
	id = "ram_128g",
	name = "RAM 128GB ECC",
	category = "Component",
	price = 420,
	uSize = 0,
	description = "128GB memory per module.",
	specs = { ramGb = 128 },
	visualColor = Color3.fromRGB(56, 189, 248),
})
addItem({
	id = "nvme_1tb",
	name = "NVMe 1TB",
	category = "Component",
	price = 140,
	uSize = 0,
	description = "Storage 1000GB per drive.",
	specs = { storageGb = 1000 },
	visualColor = Color3.fromRGB(78, 98, 134),
})
addItem({
	id = "psu_redundant",
	name = "PSU Redundant 750W",
	category = "Component",
	price = 180,
	uSize = 0,
	description = "Power supply 750W untuk menyalakan build.",
	specs = { powerWatts = 750 },
	visualColor = Color3.fromRGB(134, 144, 158),
})
addItem({
	id = "replacement_hdd",
	name = "Replacement HDD",
	category = "Component",
	price = 90,
	uSize = 0,
	description = "Drive pengganti untuk Remote Hands (Fase 2).",
	specs = { storageGb = 500 },
	visualColor = Color3.fromRGB(92, 110, 134),
})

-- ===== Cables (aktif penuh di Fase 2) =====
addItem({
	id = "cable_lan_blue",
	name = "Cable Spool LAN Blue",
	category = "Cable",
	price = 15,
	uSize = 0,
	description = "Kabel patch LAN biru. Satu spool = 5 kabel RJ45/SFP.",
	specs = {},
	visualColor = Color3.fromRGB(70, 130, 255),
})
addItem({
	id = "cable_wan_yellow",
	name = "Cable Spool WAN Yellow",
	category = "Cable",
	price = 15,
	uSize = 0,
	description = "Kabel WAN kuning untuk uplink router. Satu spool = 5 kabel.",
	specs = {},
	visualColor = Color3.fromRGB(240, 210, 70),
})
addItem({
	id = "cable_mgmt_red",
	name = "Cable Spool Mgmt Red",
	category = "Cable",
	price = 15,
	uSize = 0,
	description = "Kabel management merah untuk trunk/link khusus. Satu spool = 5 kabel.",
	specs = {},
	visualColor = Color3.fromRGB(230, 80, 80),
})

Catalog.Items = ITEMS

function Catalog.Get(itemId: string): ItemDef?
	return ITEMS[itemId]
end

function Catalog.IsPlaceable(itemId: string): boolean
	local def = ITEMS[itemId]
	if def == nil then
		return false
	end
	return def.category == "Rack" or def.category == "Network" or def.category == "Server"
end

Catalog.StoreCategories = { "Rack", "Network", "Server", "Component", "Cable" }

function Catalog.ListByCategory(category: ItemCategory): { ItemDef }
	local out: { ItemDef } = {}
	for _, def in pairs(ITEMS) do
		if def.category == category then
			table.insert(out, def)
		end
	end
	table.sort(out, function(a, b)
		return a.price < b.price
	end)
	return out
end

return Catalog
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX9">
<Properties>
<string name="Name">PlotConstants</string>
<ProtectedString name="Source"><![CDATA[--!strict
--[[
	PlotConstants (ModuleScript, ReplicatedStorage/Shared)
	Layout lab per pemain, bounds placement, snap grid, konstanta ekonomi, warna.
	Dipakai server DAN client: geometry & aturan validasi harus konsisten di dua-duanya.
]]

export type RoomSpec = {
	halfX: number,
	halfZ: number,
	height: number,
	doorWidth: number,
	doorHeight: number,
	floorTopY: number,
	wallThickness: number,
}

export type ZoneSpec = {
	name: string,
	position: Vector3,
	radius: number,
}

local PlotConstants = {}

PlotConstants.PLOT_COUNT = 4
PlotConstants.PLOT_POSITIONS = {
	Vector3.new(-210, 0, 0),
	Vector3.new(-70, 0, 0),
	Vector3.new(70, 0, 0),
	Vector3.new(210, 0, 0),
}

PlotConstants.ROOM = {
	halfX = 32,
	halfZ = 32,
	height = 18,
	doorWidth = 14,
	doorHeight = 10,
	floorTopY = 0.5,
	wallThickness = 1,
} :: RoomSpec

-- Area bebas placement device (relatif pusat plot, di lantai dalam ruangan)
PlotConstants.PLACEMENT_BOUNDS = { minX = -26, maxX = 26, minZ = -26, maxZ = 26 }
PlotConstants.SNAP_GRID = 2

-- Zona furniture: device tidak boleh placement menabrak area ini
PlotConstants.FURNITURE_ZONES = {
	{ name = "Rack", position = Vector3.new(-22, 0, -20), radius = 7 },
	{ name = "Workbench", position = Vector3.new(18, 0, -12), radius = 8 },
	{ name = "NOCDesk", position = Vector3.new(18, 0, 16), radius = 8 },
	{ name = "Dock", position = Vector3.new(0, 0, -24), radius = 8 },
	{ name = "ISP", position = Vector3.new(-20, 0, -28), radius = 6 },
} :: { ZoneSpec }

PlotConstants.RACK_POS = Vector3.new(-22, 0, -20)
PlotConstants.RACK_ROT_Y = 0
PlotConstants.WORKBENCH_POS = Vector3.new(18, 0, -12)
PlotConstants.NOCDESK_POS = Vector3.new(18, 0, 16)
PlotConstants.DOCK_POS = Vector3.new(0, 0, -24)
PlotConstants.ISP_POS = Vector3.new(-20, 0, -28)
PlotConstants.BEACON_OFFSET = Vector3.new(0, 15.6, -6)
PlotConstants.AC_OFFSET = Vector3.new(29.8, 7, -10)

PlotConstants.STARTER = {
	isp = { id = "isp_uplink", name = "ISP_Uplink" },
	router = {
		id = "isp_router_1",
		name = "ISP_Gateway_Router",
		itemId = "router_edge",
		uSlot = 12,
		ip = "192.168.1.1",
		gateway = "203.0.113.1",
		subnetMask = "255.255.255.0",
	},
	switch = { id = "sw_main_1", name = "Switch_8P", itemId = "switch_8p", uSlot = 10 },
	baremetal = { id = "bm_starter_1", name = "BareMetal_Starter", itemId = "bm_starter", uSlot = 8 },
}

PlotConstants.LAPTOP_BRIDGE_IP = "192.168.1.254"

PlotConstants.ECONOMY = {
	startBalance = 2500,
	startReputation = 10,
	tickSeconds = 5,
	payoutInterval = 15,
	electricityPerWattPerTick = 0.00015,
	vpsCpuRatePerPayout = 0.15,
	vpsRamRatePerPayout = 0.02,
	vpsDiskRatePerPayout = 0.003,
}

-- ===== Fase 2: manual cabling & colour-coded spools =====
-- One store purchase fills a spool with spoolYield patch cables.
PlotConstants.CABLES = {
	spoolYield = 5,
	starter = {
		LAN_Blue = 8,
		WAN_Yellow = 2,
		Mgmt_Red = 2,
	},
	colors = { "LAN_Blue", "WAN_Yellow", "Mgmt_Red" },
	labels = {
		LAN_Blue = "LAN Biru",
		WAN_Yellow = "WAN Kuning",
		Mgmt_Red = "Mgmt Merah",
	},
	itemByColor = {
		LAN_Blue = "cable_lan_blue",
		WAN_Yellow = "cable_wan_yellow",
		Mgmt_Red = "cable_mgmt_red",
	},
}

-- ===== Fase 2: colocation contracts =====
PlotConstants.COLOCATION = {
	vlanChoices = { 20, 30, 40 },
	uSize = 2,
	slaSeconds = 240, -- time to mount, cable, VLAN and power the client server
	runtimeSeconds = 60, -- paid service window after validation
	payoutIntervalSeconds = 10, -- one payout tick inside the service window
	deliveryDelaySeconds = 3, -- crate appears at the dock after accepting
	cleanupDelaySeconds = 15, -- client collects the server after completion
}

PlotConstants.COLORS = {
	floor = Color3.fromRGB(214, 220, 228),
	floorGrid = Color3.fromRGB(186, 195, 208),
	wall = Color3.fromRGB(228, 233, 240),
	wallLower = Color3.fromRGB(108, 122, 142),
	trim = Color3.fromRGB(188, 198, 210),
	frame = Color3.fromRGB(68, 78, 94),
	glass = Color3.fromRGB(165, 215, 245),
	accentCyan = Color3.fromRGB(56, 189, 248),
	accentAmber = Color3.fromRGB(245, 196, 48),
	lightPanel = Color3.fromRGB(248, 252, 255),
	ledGreen = Color3.fromRGB(60, 245, 115),
	ledYellow = Color3.fromRGB(255, 215, 70),
	ledRed = Color3.fromRGB(255, 82, 82),
	ledOff = Color3.fromRGB(95, 102, 112),
	consoleBlue = Color3.fromRGB(64, 172, 255),
}

return PlotConstants
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX10">
<Properties>
<string name="Name">ModelFactory</string>
<ProtectedString name="Source"><![CDATA[--!strict
--[[
	ModelFactory (ModuleScript, ReplicatedStorage/Shared)
	Pabrik model 3D prosedural berskala ergonomis karakter Roblox (~5.2 studs):
	device rackable (1U=0.50 / 2U=1.04), rack (12U=7.6 / 24U=14.3 studs),
	workbench (tinggi meja 2.68), NOC desk (tinggi meja 2.58, monitor setinggi
	mata 2.9..5.2), dock, ISP uplink, beacon, AC unit, laptop, crate, komponen.
	Konvensi: semua model dibangun dengan pivot di titik tengah-bawah (lantai).
]]

local Catalog = require(script.Parent.HardwareCatalog)
local PlotConstants = require(script.Parent.PlotConstants)

type ItemDef = Catalog.ItemDef

local ModelFactory = {}

local C = PlotConstants.COLORS

-- Shared bright industrial palette for multi-part hardware detailing
local ALU_LIGHT = Color3.fromRGB(204, 212, 224)
local ALU_MID = Color3.fromRGB(162, 174, 190)
local SLATE_TRIM = Color3.fromRGB(72, 86, 106)
local NAVY_PANEL = Color3.fromRGB(48, 64, 88)
local FACE_LIGHT = Color3.fromRGB(230, 236, 244)
local PORT_SOCKET = Color3.fromRGB(52, 62, 76)
local GOLD_PIN = Color3.fromRGB(240, 196, 62)
local SAFETY_YELLOW = Color3.fromRGB(245, 196, 48)
local CYAN_ACCENT = Color3.fromRGB(56, 189, 248)
local ESD_BLUE = Color3.fromRGB(64, 134, 198)
local OAK_WOOD = Color3.fromRGB(204, 164, 118)

type PortRef = {
	portId: string,
	portType: string,
	part: Part,
	attachment: Attachment,
	led: Part,
}

local function newPart(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Name = props.name or "Part"
	p.Size = props.size or Vector3.new(1, 1, 1)
	p.CFrame = props.cf or CFrame.new(0, 0, 0)
	p.Color = props.color or ALU_MID
	p.Material = props.material or Enum.Material.SmoothPlastic
	p.Transparency = props.transparency or 0
	p.CanCollide = if props.canCollide ~= nil then props.canCollide else false
	p.Anchored = if props.anchored ~= nil then props.anchored else true
	if props.castShadow ~= nil then
		p.CastShadow = props.castShadow
	end
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props.shape == "Cylinder" then
		p.Shape = Enum.PartType.Cylinder
	end
	return p
end

local function neon(props: { [string]: any }): Part
	props.material = Enum.Material.Neon
	return newPart(props)
end

-- Human-scale rack dimensions (1U = 0.50 studs, 2U = 1.04 studs; fits inside 5.6-wide rack)
function ModelFactory.DeviceDimensions(itemId: string): (number, number, number, number)
	-- return: width, height, depth, uSize
	local def = Catalog.Get(itemId)
	local uSize = if def then def.uSize else 1
	local width = 4.4
	local depth = 2.6
	if itemId == "switch_8p" then
		width = 4.4
	elseif itemId == "switch_24p" then
		width = 4.8
	elseif itemId == "router_edge" then
		width = 4.6
	elseif itemId == "bm_starter" or itemId == "bm_enterprise" then
		width = 4.4
		depth = 2.8
	end
	local height = if uSize <= 1 then 0.50 else 1.04
	return width, height, depth, uSize
end

function ModelFactory.ComputeFootprint(itemId: string): (number, number)
	local width, _, depth, _ = ModelFactory.DeviceDimensions(itemId)
	if itemId == "rack_12u" or itemId == "rack_24u" then
		return 2.9, 1.8
	end
	return width / 2 + 0.2, depth / 2 + 0.2
end

--[[
	BuildDeviceModel: model device rackable/freeform berskala 1U/2U realistis,
	lengkap dengan faceplate, drive bays (server), rack ears, port berkode warna,
	console port belakang, status LED, dan smoke emitter.
	Mengembalikan: model, ports (portId -> ref), consoleAttachment, statusLED, smoke
]]
function ModelFactory.BuildDeviceModel(itemId: string, deviceId: string): (Model, { [string]: PortRef }, Attachment, Part, ParticleEmitter)
	local def = Catalog.Get(itemId)
	assert(def ~= nil, "Item tidak ada di katalog: " .. itemId)
	local defv = def :: ItemDef
	local width, height, depth, uSize = ModelFactory.DeviceDimensions(itemId)
	local isServer = defv.category == "Server" or string.sub(itemId, 1, 8) == "chassis_"

	local model = Instance.new("Model")
	model.Name = defv.name

	-- Main powder-coated chassis
	local chassis = newPart({
		name = "Chassis",
		size = Vector3.new(width, height, depth),
		cf = CFrame.new(0, height / 2, 0),
		color = defv.visualColor,
		material = Enum.Material.SmoothPlastic,
	})
	chassis.Parent = model

	-- Silver top airflow panel
	newPart({
		name = "TopGrille",
		size = Vector3.new(width - 0.5, 0.04, depth - 0.6),
		cf = CFrame.new(0, height + 0.02, -0.08),
		color = ALU_LIGHT,
	}).Parent = model

	-- Rack-mount ears (brushed silver flanges on left & right)
	for _, side in ipairs({ -1, 1 }) do
		newPart({
			name = "RackEar",
			size = Vector3.new(0.22, height - 0.06, 0.12),
			cf = CFrame.new(side * (width / 2 + 0.09), height / 2, depth / 2 - 0.05),
			color = ALU_LIGHT,
		}).Parent = model
	end

	-- Contrasting front faceplate bezel
	local faceplateColor = if isServer then FACE_LIGHT else NAVY_PANEL
	newPart({
		name = "Faceplate",
		size = Vector3.new(width - 0.14, height - 0.08, 0.06),
		cf = CFrame.new(0, height / 2, depth / 2 + 0.02),
		color = faceplateColor,
	}).Parent = model

	-- Category-specific front detailing
	if isServer then
		local bayCount = 4
		local bayAreaW = width - 1.35
		local bayW = (bayAreaW - 0.28) / bayCount
		local bayH = math.min(0.46, height * 0.44)
		for i = 1, bayCount do
			local bx = -bayAreaW / 2 + (i - 0.5) * (bayAreaW / bayCount) - 0.22
			newPart({
				name = "DriveBay_" .. i,
				size = Vector3.new(bayW, bayH, 0.08),
				cf = CFrame.new(bx, bayH / 2 + 0.14, depth / 2 + 0.06),
				color = SLATE_TRIM,
			}).Parent = model
			newPart({
				name = "DriveLatch_" .. i,
				size = Vector3.new(0.11, bayH - 0.08, 0.1),
				cf = CFrame.new(bx + bayW / 2 - 0.09, bayH / 2 + 0.14, depth / 2 + 0.07),
				color = CYAN_ACCENT,
			}).Parent = model
		end
		newPart({
			name = "AccentStrip",
			size = Vector3.new(width - 0.35, 0.07, 0.08),
			cf = CFrame.new(0, height - 0.1, depth / 2 + 0.06),
			color = if itemId == "bm_enterprise" then GOLD_PIN else CYAN_ACCENT,
		}).Parent = model
	else
		local stripeColor = if itemId == "router_edge" then SAFETY_YELLOW else CYAN_ACCENT
		newPart({
			name = "BrandStripe",
			size = Vector3.new(width - 0.25, 0.06, 0.08),
			cf = CFrame.new(0, 0.07, depth / 2 + 0.06),
			color = stripeColor,
		}).Parent = model
	end

	-- Status LED (bright neon indicator on front-right)
	local led = neon({
		name = "StatusLED",
		size = Vector3.new(0.22, 0.1, 0.09),
		cf = CFrame.new(width / 2 - 0.28, height - 0.12, depth / 2 + 0.07),
		color = C.ledRed,
	})
	led.Parent = model

	-- Smoke overheat (off by default)
	local smokeAnchor = newPart({
		name = "SmokeAnchor",
		size = Vector3.new(0.1, 0.1, 0.1),
		cf = CFrame.new(0, height + 0.1, -depth / 2 + 0.3),
		transparency = 1,
	})
	smokeAnchor.Parent = model
	local smoke = Instance.new("ParticleEmitter")
	smoke.Name = "OverheatSmoke"
	smoke.Rate = 8
	smoke.Lifetime = NumberRange.new(1, 1.8)
	smoke.Speed = NumberRange.new(1.2, 2.2)
	smoke.Size = NumberSequence.new(0.4)
	smoke.Color = ColorSequence.new(Color3.fromRGB(165, 170, 180))
	smoke.Transparency = NumberSequence.new(0.3, 1)
	smoke.SpreadAngle = Vector2.new(12, 12)
	smoke.Enabled = false
	smoke.Parent = smokeAnchor

	-- Port plan
	local portsSpec: { { id: string, portType: string } } = {}
	local specs = defv.specs
	local wanPorts = specs.wanPorts or 0
	local rjPorts = specs.ports or 0
	local sfpPorts = specs.sfpPorts or 0
	for i = 1, wanPorts do
		table.insert(portsSpec, { id = "wan" .. i, portType = "WAN" })
	end
	for i = 1, rjPorts do
		table.insert(portsSpec, { id = "eth" .. i, portType = "RJ45" })
	end
	for i = 1, sfpPorts do
		table.insert(portsSpec, { id = "sfp" .. i, portType = "SFP" })
	end

	local ports: { [string]: PortRef } = {}
	local total = #portsSpec
	if total > 0 then
		local rows = if total > 12 then 2 else 1
		local perRow = math.ceil(total / rows)
		local usable = width - 0.95
		local step = if perRow > 1 then usable / (perRow - 1) else 0
		local portW = if rows == 2 then 0.22 else 0.34
		local portH = if rows == 2 then 0.14 else 0.22
		for idx, spec in ipairs(portsSpec) do
			local rowIdx = if rows == 2 then (if idx <= perRow then 0 else 1) else 0
			local colIdx = if rows == 2 then ((idx - 1) % perRow) else (idx - 1)
			local px: number
			if isServer then
				px = width / 2 - 0.52 - (if perRow > 1 then (colIdx * 0.45) else 0)
			else
				px = if perRow > 1 then (-usable / 2 - 0.08) + colIdx * step else 0
			end
			local py = if rows == 2
				then (height * 0.68 - rowIdx * 0.22)
				else (height * 0.54)

			local collarColor = ALU_LIGHT
			if spec.portType == "WAN" then
				collarColor = SAFETY_YELLOW
			elseif spec.portType == "SFP" then
				collarColor = CYAN_ACCENT
			end
			newPart({
				name = "PortFrame_" .. spec.id,
				size = Vector3.new(portW + 0.07, portH + 0.07, 0.12),
				cf = CFrame.new(px, py, depth / 2 + 0.06),
				color = collarColor,
			}).Parent = model

			local portPart = newPart({
				name = "Port_" .. spec.id,
				size = Vector3.new(portW, portH, 0.18),
				cf = CFrame.new(px, py, depth / 2 + 0.1),
				color = PORT_SOCKET,
			})
			portPart:SetAttribute("PortId", spec.id)
			portPart:SetAttribute("PortType", spec.portType)
			portPart:SetAttribute("DeviceId", deviceId)
			portPart.Parent = model

			local portLed = neon({
				name = "PortLED_" .. spec.id,
				size = Vector3.new(math.min(0.14, portW * 0.5), 0.06, 0.07),
				cf = CFrame.new(px, py - portH / 2 - 0.05, depth / 2 + 0.11),
				color = C.ledOff,
			})
			portLed:SetAttribute("PortId", spec.id)
			portLed:SetAttribute("DeviceId", deviceId)
			portLed.Parent = model

			local attach = Instance.new("Attachment")
			attach.Name = "PortAttach"
			attach.CFrame = CFrame.new(0, 0, 0.11)
			attach.Parent = portPart

			local click = Instance.new("ClickDetector")
			click.Name = "Click"
			click.MaxActivationDistance = 45
			click.Parent = portPart

			ports[spec.id] = { portId = spec.id, portType = spec.portType, part = portPart, attachment = attach, led = portLed }
		end
	end

	-- Console port (belakang, biru terang + collar silver)
	newPart({
		name = "ConsoleCollar",
		size = Vector3.new(0.58, math.min(0.42, height - 0.06), 0.12),
		cf = CFrame.new(0, height / 2, -depth / 2 - 0.04),
		color = ALU_LIGHT,
	}).Parent = model
	local consolePart = neon({
		name = "ConsolePort",
		size = Vector3.new(0.44, math.min(0.32, height - 0.12), 0.18),
		cf = CFrame.new(0, height / 2, -depth / 2 - 0.09),
		color = C.consoleBlue,
	})
	consolePart:SetAttribute("ConsoleDeviceId", deviceId)
	consolePart.Parent = model
	local consoleAttach = Instance.new("Attachment")
	consoleAttach.Name = "ConsoleAttach"
	consoleAttach.CFrame = CFrame.new(0, 0, -0.1)
	consoleAttach.Parent = consolePart

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "ConsolePrompt"
	prompt.ActionText = "Connect Console Cable"
	prompt.ObjectText = defv.name
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = consolePart

	model:SetAttribute("DeviceId", deviceId)
	model:SetAttribute("ItemId", itemId)
	model:SetAttribute("USize", uSize)
	model.WorldPivot = CFrame.new(0, 0, 0)

	return model, ports, consoleAttach, led, smoke
end

--[[
	BuildRack: rak enterprise proporsional (12U = ~7.6 studs, 24U = ~14.3 studs)
	dengan plinth bawah, rail U silver, header LED, dan vertical PDU strip.
	SlotFrame diposisikan di z = -0.80 sehingga offset +0.95 dari BuildFacility
	mendudukkan device rata rapi di dalam kabinet rak.
]]
function ModelFactory.BuildRack(itemId: string, rackId: string): (Model, { [number]: Attachment }, Part)
	local def = Catalog.Get(itemId)
	assert(def ~= nil, "Item tidak ada di katalog: " .. itemId)
	local defv = def :: ItemDef
	local maxU = defv.specs.maxU
	local slotH = 0.56
	local baseH = 0.55
	local bodyH = maxU * slotH + baseH
	local w = 5.6
	local d = 3.2

	local model = Instance.new("Model")
	model.Name = defv.name

	-- Bottom plinth base
	newPart({
		name = "BasePlinth",
		size = Vector3.new(w, baseH * 0.85, d),
		cf = CFrame.new(0, baseH * 0.425, 0),
		color = SLATE_TRIM,
		canCollide = true,
	}).Parent = model

	-- Back panel (clean slate blue-grey)
	newPart({
		name = "BackPanel",
		size = Vector3.new(w - 0.35, bodyH - baseH * 0.5, 0.16),
		cf = CFrame.new(0, bodyH / 2 + 0.15, -d / 2 + 0.08),
		color = defv.visualColor,
		canCollide = true,
	}).Parent = model

	-- 4 vertical corner posts + brushed silver front U-rails + side braces
	for sx = -1, 1, 2 do
		for sz = -1, 1, 2 do
			newPart({
				name = "Post",
				size = Vector3.new(0.32, bodyH, 0.32),
				cf = CFrame.new(sx * (w / 2 - 0.18), bodyH / 2, sz * (d / 2 - 0.18)),
				color = SLATE_TRIM,
				canCollide = true,
			}).Parent = model
		end
		-- Brushed aluminum front U-mounting rail
		newPart({
			name = "FrontRail",
			size = Vector3.new(0.16, bodyH - baseH, 0.14),
			cf = CFrame.new(sx * (w / 2 - 0.44), baseH + (bodyH - baseH) / 2, d / 2 - 0.22),
			color = ALU_LIGHT,
		}).Parent = model
		-- Side horizontal cross-braces
		for _, frac in ipairs({ 0.36, 0.72 }) do
			newPart({
				name = "SideBrace",
				size = Vector3.new(0.14, 0.2, d - 0.6),
				cf = CFrame.new(sx * (w / 2 - 0.18), bodyH * frac, 0),
				color = ALU_MID,
			}).Parent = model
		end
	end

	-- Top cap roof + illuminated front header LED bar
	newPart({
		name = "TopCap",
		size = Vector3.new(w + 0.16, 0.36, d + 0.16),
		cf = CFrame.new(0, bodyH + 0.18, 0),
		color = SLATE_TRIM,
		canCollide = true,
	}).Parent = model
	neon({
		name = "RackHeaderLED",
		size = Vector3.new(w - 0.6, 0.12, 0.1),
		cf = CFrame.new(0, bodyH + 0.18, d / 2 + 0.09),
		color = if itemId == "rack_24u" then GOLD_PIN else CYAN_ACCENT,
	}).Parent = model

	-- High-visibility vertical PDU power strip (right rear)
	local pduH = math.max(3.6, bodyH - 1.0)
	local pdu = newPart({
		name = "PDU_Strip",
		size = Vector3.new(0.42, pduH, 0.42),
		cf = CFrame.new(w / 2 - 0.44, pduH / 2 + 0.55, -d / 2 + 0.55),
		color = NAVY_PANEL,
		canCollide = true,
	})
	pdu.Parent = model
	newPart({
		name = "PDUStripe",
		size = Vector3.new(0.1, pduH - 0.3, 0.44),
		cf = CFrame.new(w / 2 - 0.64, pduH / 2 + 0.55, -d / 2 + 0.55),
		color = Color3.fromRGB(235, 90, 70),
	}).Parent = model
	local outletCount = math.clamp(math.floor(pduH / 1.1), 4, 8)
	for i = 1, outletCount do
		local oy = 0.9 + (i - 0.5) * ((pduH - 0.9) / outletCount)
		newPart({
			name = "PDUOutlet_" .. i,
			size = Vector3.new(0.24, 0.28, 0.1),
			cf = CFrame.new(w / 2 - 0.44, oy, -d / 2 + 0.78),
			color = FACE_LIGHT,
		}).Parent = model
	end
	local pduLed = neon({
		name = "PDULed",
		size = Vector3.new(0.22, 0.22, 0.12),
		cf = CFrame.new(w / 2 - 0.44, pduH + 0.2, -d / 2 + 0.78),
		color = C.ledGreen,
	})
	pduLed.Parent = model
	local pduClick = Instance.new("ClickDetector")
	pduClick.Name = "PDUClick"
	pduClick.MaxActivationDistance = 45
	pduClick.Parent = pdu

	-- Slot attachments: z = -0.80 so WorldCFrame * CFrame.new(0, 0, 0.95) puts
	-- mounted devices at z = +0.15 (front faceplate flush with front rack rails).
	local slots: { [number]: Attachment } = {}
	local slotFrame = newPart({
		name = "SlotFrame",
		size = Vector3.new(w - 0.8, 0.08, 0.08),
		cf = CFrame.new(0, baseH, -0.80),
		transparency = 1,
	})
	slotFrame.Parent = model
	for u = 1, maxU do
		local a = Instance.new("Attachment")
		a.Name = "USlot_" .. u
		a.CFrame = CFrame.new(0, (u - 1) * slotH, 0)
		a.Parent = slotFrame
		slots[u] = a
	end

	model:SetAttribute("RackId", rackId)
	model:SetAttribute("ItemId", itemId)
	model.WorldPivot = CFrame.new(0, 0, 0)

	return model, slots, pdu
end

--[[
	BuildWorkbench: meja rakit ergonomis (permukaan 2.68 studs, ESD mat 2.72)
	dengan kayu oak cerah, pegboard alat, lampu kerja LED (5.1 studs), dan saklar merah.
]]
function ModelFactory.BuildWorkbench(): (Model, { [number]: Attachment }, Part, Part)
	local model = Instance.new("Model")
	model.Name = "AssemblyWorkbench"

	-- Warm light oak butcher-block tabletop (surface at y = 2.68)
	local top = newPart({
		name = "BenchTop",
		size = Vector3.new(8.6, 0.28, 4.0),
		cf = CFrame.new(0, 2.54, 0),
		color = OAK_WOOD,
		material = Enum.Material.Wood,
		canCollide = true,
	})
	top.Parent = model

	-- Blue anti-static ESD mat on bench surface (top at y = 2.72)
	newPart({
		name = "ESDMat",
		size = Vector3.new(6.8, 0.04, 3.1),
		cf = CFrame.new(-0.4, 2.70, 0.1),
		color = ESD_BLUE,
	}).Parent = model

	-- Silver tubular industrial frame legs + lower storage shelf
	for sx = -1, 1, 2 do
		for sz = -1, 1, 2 do
			newPart({
				name = "Leg",
				size = Vector3.new(0.34, 2.4, 0.34),
				cf = CFrame.new(sx * 3.9, 1.2, sz * 1.65),
				color = ALU_MID,
				canCollide = true,
			}).Parent = model
		end
	end
	newPart({
		name = "LowerShelf",
		size = Vector3.new(7.6, 0.14, 3.1),
		cf = CFrame.new(0, 0.65, 0),
		color = ALU_LIGHT,
		canCollide = true,
	}).Parent = model

	-- Eye-level tool pegboard backpanel (y = 2.68..4.98) + overhead task light (y = 5.1)
	newPart({
		name = "BackPanel",
		size = Vector3.new(8.6, 2.3, 0.22),
		cf = CFrame.new(0, 3.83, -1.89),
		color = Color3.fromRGB(136, 150, 168),
		canCollide = true,
	}).Parent = model
	newPart({
		name = "ToolTray",
		size = Vector3.new(3.4, 0.2, 0.45),
		cf = CFrame.new(-1.8, 3.35, -1.58),
		color = SAFETY_YELLOW,
	}).Parent = model
	newPart({
		name = "ScrewdriverA",
		size = Vector3.new(0.14, 0.95, 0.14),
		cf = CFrame.new(1.9, 3.95, -1.72),
		color = Color3.fromRGB(235, 92, 68),
	}).Parent = model
	newPart({
		name = "ScrewdriverB",
		size = Vector3.new(0.14, 0.8, 0.14),
		cf = CFrame.new(2.35, 3.88, -1.72),
		color = CYAN_ACCENT,
	}).Parent = model
	newPart({
		name = "TaskLightHood",
		size = Vector3.new(8.6, 0.22, 1.35),
		cf = CFrame.new(0, 5.08, -1.35),
		color = SLATE_TRIM,
	}).Parent = model
	local taskBar = neon({
		name = "TaskLightBar",
		size = Vector3.new(7.4, 0.1, 0.42),
		cf = CFrame.new(0, 4.94, -1.05),
		color = Color3.fromRGB(250, 252, 255),
	})
	taskBar.Parent = model
	local taskLight = Instance.new("SurfaceLight")
	taskLight.Face = Enum.NormalId.Bottom
	taskLight.Range = 12
	taskLight.Brightness = 1.5
	taskLight.Angle = 120
	taskLight.Parent = taskBar

	-- Snap attachments flush on ESD mat (2.54 + 0.18 = 2.72)
	local snaps: { [number]: Attachment } = {}
	for i = 1, 6 do
		local a = Instance.new("Attachment")
		a.Name = "Snap_" .. i
		a.CFrame = CFrame.new(-3.25 + (i - 1) * 1.3, 0.18, 0)
		a.Parent = top
		snaps[i] = a
	end

	-- Power switch box + red clickable switch + bright LED on right edge of bench
	newPart({
		name = "SwitchHousing",
		size = Vector3.new(0.88, 0.24, 0.88),
		cf = CFrame.new(3.65, 2.80, 1.25),
		color = ALU_LIGHT,
	}).Parent = model
	local switchPart = newPart({
		name = "PowerSwitch",
		size = Vector3.new(0.62, 0.36, 0.36),
		cf = CFrame.new(3.65, 3.04, 1.25),
		color = Color3.fromRGB(230, 68, 68),
	})
	switchPart.Parent = model
	local switchClick = Instance.new("ClickDetector")
	switchClick.Name = "BenchPowerClick"
	switchClick.MaxActivationDistance = 45
	switchClick.Parent = switchPart

	local benchLed = neon({
		name = "BenchLed",
		size = Vector3.new(0.26, 0.18, 0.12),
		cf = CFrame.new(3.65, 3.34, 1.25),
		color = C.ledOff,
	})
	benchLed.Parent = model

	model.WorldPivot = CFrame.new(0, 0, 0)
	return model, snaps, switchPart, benchLed
end

--[[
	BuildNOCDesk: konsol operasi NOC ergonomis (tinggi meja 2.58 studs,
	3 monitor widescreen melengkung tepat setinggi mata di y = 2.88..5.22,
	PixelsPerStud = 78 agar layout SurfaceGui 180px pas & tajam).
]]
function ModelFactory.BuildNOCDesk(): (Model, { [string]: Part })
	local model = Instance.new("Model")
	model.Name = "NOCDesk"

	-- Human-scale command-center desktop (surface at y = 2.58)
	local top = newPart({
		name = "DeskTop",
		size = Vector3.new(11.6, 0.28, 4.0),
		cf = CFrame.new(0, 2.44, 0),
		color = Color3.fromRGB(216, 222, 232),
		canCollide = true,
	})
	top.Parent = model

	-- Cobalt-blue modesty panel + cyan LED front accent trim
	newPart({
		name = "FrontPanel",
		size = Vector3.new(10.6, 1.7, 0.2),
		cf = CFrame.new(0, 1.45, -1.75),
		color = Color3.fromRGB(64, 118, 198),
		canCollide = true,
	}).Parent = model
	neon({
		name = "DeskAccentLED",
		size = Vector3.new(11.4, 0.08, 0.1),
		cf = CFrame.new(0, 2.32, 2.02),
		color = CYAN_ACCENT,
	}).Parent = model

	-- Brushed silver legs
	for sx = -1, 1, 2 do
		for sz = -1, 1, 2 do
			newPart({
				name = "Leg",
				size = Vector3.new(0.34, 2.3, 0.34),
				cf = CFrame.new(sx * 5.3, 1.15, sz * 1.65),
				color = ALU_MID,
				canCollide = true,
			}).Parent = model
		end
	end

	-- Articulated monitor arm rail behind monitors
	newPart({
		name = "MonitorBar",
		size = Vector3.new(8.6, 0.18, 0.18),
		cf = CFrame.new(0, 3.65, -1.35),
		color = ALU_LIGHT,
	}).Parent = model
	newPart({
		name = "MonitorCenterPost",
		size = Vector3.new(0.28, 1.35, 0.28),
		cf = CFrame.new(0, 3.2, -1.35),
		color = ALU_MID,
	}).Parent = model

	-- 3 eye-level widescreen monitors (y = 2.88..5.23), gently angled toward operator
	local monitors: { [string]: Part } = {}
	local specs = {
		{ name = "TopologyMonitor", x = -3.65, z = -0.82, yaw = 12 },
		{ name = "TicketMonitor", x = 0, z = -1.12, yaw = 0 },
		{ name = "TelemetryMonitor", x = 3.65, z = -0.82, yaw = -12 },
	}
	for _, m in ipairs(specs) do
		local baseCF = CFrame.new(m.x, 4.05, m.z) * CFrame.Angles(0, math.rad(m.yaw), 0) * CFrame.Angles(math.rad(-4), 0, 0)
		newPart({
			name = m.name .. "_Stand",
			size = Vector3.new(0.24, 1.25, 0.24),
			cf = CFrame.new(m.x, 3.18, m.z - 0.16),
			color = ALU_MID,
		}).Parent = model

		local screen = newPart({
			name = m.name,
			size = Vector3.new(3.5, 2.35, 0.16),
			cf = baseCF,
			color = Color3.fromRGB(16, 22, 32),
		})
		screen.Parent = model

		-- Slim silver monitor back bezel
		newPart({
			name = m.name .. "_Bezel",
			size = Vector3.new(3.68, 2.52, 0.12),
			cf = baseCF * CFrame.new(0, 0, -0.11),
			color = ALU_LIGHT,
		}).Parent = model

		local gui = Instance.new("SurfaceGui")
		gui.Name = "SurfaceGui"
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 78 -- 3.5*78=273px x 2.35*78=183px (matches NOCMonitorClient layout)
		gui.Face = Enum.NormalId.Back
		gui.Brightness = 2
		gui.Parent = screen

		local root = Instance.new("Frame")
		root.Name = "Root"
		root.Size = UDim2.new(1, 0, 1, 0)
		root.BackgroundTransparency = 1
		root.Parent = gui

		monitors[m.name] = screen
	end

	-- Desk accessories scaled to desktop height (y = 2.58)
	newPart({
		name = "DeskMat",
		size = Vector3.new(4.6, 0.03, 1.65),
		cf = CFrame.new(0, 2.60, 0.75),
		color = NAVY_PANEL,
	}).Parent = model
	newPart({
		name = "Keyboard",
		size = Vector3.new(2.2, 0.1, 0.78),
		cf = CFrame.new(-0.35, 2.65, 0.75),
		color = ALU_LIGHT,
	}).Parent = model
	neon({
		name = "KeyboardGlow",
		size = Vector3.new(2.05, 0.03, 0.64),
		cf = CFrame.new(-0.35, 2.71, 0.75),
		color = CYAN_ACCENT,
	}).Parent = model
	newPart({
		name = "Mouse",
		size = Vector3.new(0.36, 0.1, 0.58),
		cf = CFrame.new(1.35, 2.65, 0.78),
		color = FACE_LIGHT,
	}).Parent = model
	newPart({
		name = "CoffeeMug",
		shape = "Cylinder",
		size = Vector3.new(0.58, 0.44, 0.44),
		cf = CFrame.new(4.1, 2.88, 0.85) * CFrame.Angles(0, 0, math.rad(90)),
		color = Color3.fromRGB(56, 178, 172),
	}).Parent = model

	-- Ergonomic swivel office chair tucked slightly aside (non-colliding so walking is smooth)
	local chairCF = CFrame.new(-2.8, 0, 3.1) * CFrame.Angles(0, math.rad(20), 0)
	newPart({
		name = "ChairBase",
		shape = "Cylinder",
		size = Vector3.new(0.18, 2.0, 2.0),
		cf = chairCF * CFrame.new(0, 0.12, 0) * CFrame.Angles(0, 0, math.rad(90)),
		color = ALU_MID,
	}).Parent = model
	newPart({
		name = "ChairStem",
		shape = "Cylinder",
		size = Vector3.new(1.25, 0.24, 0.24),
		cf = chairCF * CFrame.new(0, 0.8, 0) * CFrame.Angles(0, 0, math.rad(90)),
		color = SLATE_TRIM,
	}).Parent = model
	newPart({
		name = "ChairSeat",
		size = Vector3.new(1.85, 0.26, 1.75),
		cf = chairCF * CFrame.new(0, 1.5, 0),
		color = Color3.fromRGB(56, 98, 168),
	}).Parent = model
	newPart({
		name = "ChairBack",
		size = Vector3.new(1.75, 2.1, 0.22),
		cf = chairCF * CFrame.new(0, 2.6, 0.82) * CFrame.Angles(math.rad(-8), 0, 0),
		color = Color3.fromRGB(56, 98, 168),
	}).Parent = model

	model.WorldPivot = CFrame.new(0, 0, 0)
	return model, monitors
end

--[[
	BuildDockPad: platform loading dock industrial berskala rapi (10.4x10.4)
	dengan tepi kuning safety, 4 bollard sudut, dan zona hologram hijau.
]]
function ModelFactory.BuildDockPad(): (Model, CFrame)
	local model = Instance.new("Model")
	model.Name = "LoadingDock"

	newPart({
		name = "DockDeck",
		size = Vector3.new(10.4, 0.26, 10.4),
		cf = CFrame.new(0, 0.13, 0),
		color = Color3.fromRGB(190, 198, 210),
		material = Enum.Material.DiamondPlate,
		canCollide = true,
	}).Parent = model

	local frameDefs = {
		{ size = Vector3.new(10.6, 0.3, 0.36), cf = CFrame.new(0, 0.15, 5.2) },
		{ size = Vector3.new(10.6, 0.3, 0.36), cf = CFrame.new(0, 0.15, -5.2) },
		{ size = Vector3.new(0.36, 0.3, 10.0), cf = CFrame.new(5.2, 0.15, 0) },
		{ size = Vector3.new(0.36, 0.3, 10.0), cf = CFrame.new(-5.2, 0.15, 0) },
	}
	for i, fd in ipairs(frameDefs) do
		newPart({
			name = "SafetyTrim_" .. i,
			size = fd.size,
			cf = fd.cf,
			color = SAFETY_YELLOW,
		}).Parent = model
	end

	for sx = -1, 1, 2 do
		for sz = -1, 1, 2 do
			newPart({
				name = "Bollard",
				shape = "Cylinder",
				size = Vector3.new(1.85, 0.44, 0.44),
				cf = CFrame.new(sx * 4.9, 0.925, sz * 4.9) * CFrame.Angles(0, 0, math.rad(90)),
				color = SAFETY_YELLOW,
				canCollide = true,
			}).Parent = model
		end
	end

	local pad = newPart({
		name = "DockPad",
		size = Vector3.new(9.2, 0.1, 9.2),
		cf = CFrame.new(0, 0.31, 0),
		color = Color3.fromRGB(64, 218, 134),
		material = Enum.Material.Neon,
		transparency = 0.55,
	})
	pad.Parent = model

	model.WorldPivot = CFrame.new(0, 0, 0)
	return model, CFrame.new(0, 0.36, 0)
end

--[[
	BuildISPUplink: kotak demarkasi fiber ISP setinggi tangan/mata (2.7..4.9)
	dengan pipa conduit fiber kuning menuju overhead cable tray (y = 15.2).
]]
function ModelFactory.BuildISPUplink(deviceId: string): (Model, Attachment, Part)
	local model = Instance.new("Model")
	model.Name = "ISP_Uplink"

	local box = newPart({
		name = "Chassis",
		size = Vector3.new(2.6, 2.2, 1.2),
		cf = CFrame.new(0, 3.8, 0),
		color = FACE_LIGHT,
		canCollide = true,
	})
	box.Parent = model

	newPart({
		name = "ISPBezel",
		size = Vector3.new(2.25, 1.8, 0.12),
		cf = CFrame.new(0, 3.8, 0.62),
		color = SLATE_TRIM,
	}).Parent = model
	newPart({
		name = "FiberStripe",
		size = Vector3.new(2.25, 0.22, 0.14),
		cf = CFrame.new(0, 4.55, 0.63),
		color = SAFETY_YELLOW,
	}).Parent = model

	-- Vertical yellow fiber conduit pipe climbing to overhead cable tray
	newPart({
		name = "FiberConduit",
		shape = "Cylinder",
		size = Vector3.new(10.3, 0.34, 0.34),
		cf = CFrame.new(0, 10.05, -0.15) * CFrame.Angles(0, 0, math.rad(90)),
		color = SAFETY_YELLOW,
	}).Parent = model

	local led = neon({
		name = "StatusLED",
		size = Vector3.new(0.26, 0.18, 0.1),
		cf = CFrame.new(0.82, 4.22, 0.72),
		color = C.ledGreen,
	})
	led.Parent = model

	newPart({
		name = "WANCollar",
		size = Vector3.new(0.62, 0.46, 0.14),
		cf = CFrame.new(0, 3.55, 0.7),
		color = SAFETY_YELLOW,
	}).Parent = model
	local wanPart = newPart({
		name = "Port_wan1",
		size = Vector3.new(0.46, 0.34, 0.2),
		cf = CFrame.new(0, 3.55, 0.77),
		color = PORT_SOCKET,
	})
	wanPart:SetAttribute("PortId", "wan1")
	wanPart:SetAttribute("PortType", "WAN")
	wanPart:SetAttribute("DeviceId", deviceId)
	wanPart.Parent = model

	local wanLed = neon({
		name = "PortLED_wan1",
		size = Vector3.new(0.2, 0.12, 0.08),
		cf = CFrame.new(0, 3.22, 0.77),
		color = C.ledGreen,
	})
	wanLed:SetAttribute("PortId", "wan1")
	wanLed:SetAttribute("DeviceId", deviceId)
	wanLed.Parent = model

	local attach = Instance.new("Attachment")
	attach.Name = "PortAttach"
	attach.CFrame = CFrame.new(0, 0, 0.12)
	attach.Parent = wanPart

	local click = Instance.new("ClickDetector")
	click.Name = "Click"
	click.MaxActivationDistance = 45
	click.Parent = wanPart

	model:SetAttribute("DeviceId", deviceId)
	model.WorldPivot = CFrame.new(0, 0, 0)
	return model, attach, wanLed
end

--[[
	BuildBeacon: lampu alarm plafon dengan collar silver & lensa merah.
]]
function ModelFactory.BuildBeacon(): (Model, Part, PointLight)
	local model = Instance.new("Model")
	model.Name = "AlarmBeacon"

	newPart({
		name = "BeaconBase",
		shape = "Cylinder",
		size = Vector3.new(0.42, 1.25, 1.25),
		cf = CFrame.new(0, 0, 0) * CFrame.Angles(0, 0, math.rad(90)),
		color = ALU_LIGHT,
	}).Parent = model

	local lens = neon({
		name = "BeaconLens",
		shape = "Cylinder",
		size = Vector3.new(0.82, 0.88, 0.88),
		cf = CFrame.new(0, 0.58, 0) * CFrame.Angles(0, 0, math.rad(90)),
		color = C.ledRed,
		transparency = 0.2,
	})
	lens.Parent = model

	local light = Instance.new("PointLight")
	light.Name = "AlarmLight"
	light.Color = Color3.fromRGB(255, 70, 70)
	light.Range = 24
	light.Brightness = 0
	light.Parent = lens

	model.WorldPivot = CFrame.new(0, 0, 0)
	return model, lens, light
end

--[[
	BuildACUnit: unit CRAC dinding putih bersih dengan kipas silinder rata
	yang berputar mulus di Heartbeat.
]]
function ModelFactory.BuildACUnit(): (Model, Part)
	local model = Instance.new("Model")
	model.Name = "AC_Unit"

	local body = newPart({
		name = "ACBody",
		size = Vector3.new(1.4, 3.4, 5.0),
		cf = CFrame.new(0, 0, 0),
		color = Color3.fromRGB(236, 242, 248),
		canCollide = true,
	})
	body.Parent = model

	newPart({
		name = "ACTrim",
		size = Vector3.new(1.46, 0.28, 5.06),
		cf = CFrame.new(0, 1.32, 0),
		color = Color3.fromRGB(82, 162, 224),
	}).Parent = model
	neon({
		name = "ACLed",
		size = Vector3.new(0.12, 0.16, 0.42),
		cf = CFrame.new(-0.74, 1.32, 1.85),
		color = CYAN_ACCENT,
	}).Parent = model

	for i = 1, 4 do
		newPart({
			name = "ACLouver_" .. i,
			size = Vector3.new(0.14, 0.18, 1.5),
			cf = CFrame.new(-0.72, -0.95 + i * 0.44, 1.4),
			color = ALU_MID,
		}).Parent = model
	end

	local fan = newPart({
		name = "ACFan",
		shape = "Cylinder",
		size = Vector3.new(0.24, 2.1, 2.1),
		cf = CFrame.new(-0.76, -0.12, -0.8),
		color = SLATE_TRIM,
	})
	fan.Parent = model

	local fanGui = Instance.new("SurfaceGui")
	fanGui.Name = "FanBlades"
	fanGui.Face = Enum.NormalId.Left
	fanGui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	fanGui.CanvasSize = Vector2.new(128, 128)
	fanGui.Parent = fan
	for _, rot in ipairs({ 0, 60, 120 }) do
		local blade = Instance.new("Frame")
		blade.AnchorPoint = Vector2.new(0.5, 0.5)
		blade.Position = UDim2.fromScale(0.5, 0.5)
		blade.Size = UDim2.new(0.86, 0, 0.16, 0)
		blade.Rotation = rot
		blade.BackgroundColor3 = ALU_LIGHT
		blade.BorderSizePixel = 0
		blade.Parent = fanGui
	end
	local hub = Instance.new("Frame")
	hub.AnchorPoint = Vector2.new(0.5, 0.5)
	hub.Position = UDim2.fromScale(0.5, 0.5)
	hub.Size = UDim2.fromScale(0.26, 0.26)
	hub.BackgroundColor3 = CYAN_ACCENT
	hub.BorderSizePixel = 0
	hub.Parent = fanGui
	local hubCorner = Instance.new("UICorner")
	hubCorner.CornerRadius = UDim.new(1, 0)
	hubCorner.Parent = hub

	local cold = Instance.new("ParticleEmitter")
	cold.Name = "ColdAir"
	cold.Rate = 6
	cold.Lifetime = NumberRange.new(0.8, 1.4)
	cold.Speed = NumberRange.new(2, 4)
	cold.Size = NumberSequence.new(0.45)
	cold.Color = ColorSequence.new(Color3.fromRGB(165, 220, 255))
	cold.Transparency = NumberSequence.new(0.55, 1)
	cold.EmissionDirection = Enum.NormalId.Left
	cold.Parent = body

	model.WorldPivot = CFrame.new(0, 0, 0)
	return model, fan
end

--[[
	BuildLaptop: ultrabook teknisi ringkas (1.6x1.15) pas di genggaman avatar.
]]
function ModelFactory.BuildLaptop(): Tool
	local tool = Instance.new("Tool")
	tool.Name = "TechnicianLaptop"
	tool.ToolTip = "Klik = Terminal SSH | Dekati device = console"
	tool.CanBeDropped = false

	local handle = newPart({
		name = "Handle",
		size = Vector3.new(1.6, 0.14, 1.15),
		cf = CFrame.new(0, 0, 0),
		color = ALU_LIGHT,
		anchored = false,
		canCollide = false,
	})
	handle.Parent = tool
	tool.Grip = CFrame.new(0, -0.1, 0.25)
	tool.GripPos = Vector3.new(0, -0.1, 0.25)

	local keydeck = newPart({
		name = "KeyDeck",
		size = Vector3.new(1.42, 0.03, 0.72),
		cf = CFrame.new(0, 0.08, -0.05),
		color = SLATE_TRIM,
		anchored = false,
		canCollide = false,
	})
	keydeck.Parent = tool
	local weldKey = Instance.new("WeldConstraint")
	weldKey.Part0 = handle
	weldKey.Part1 = keydeck
	weldKey.Parent = handle

	local lid = newPart({
		name = "Lid",
		size = Vector3.new(1.6, 1.05, 0.08),
		cf = CFrame.new(0, 0.54, -0.62) * CFrame.Angles(math.rad(-15), 0, 0),
		color = ALU_LIGHT,
		anchored = false,
		canCollide = false,
	})
	lid.Parent = tool

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = handle
	weld.Part1 = lid
	weld.Parent = handle

	local gui = Instance.new("SurfaceGui")
	gui.Name = "LaptopScreen"
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 70
	gui.Face = Enum.NormalId.Back
	gui.Brightness = 2
	gui.Parent = lid
	local root = Instance.new("Frame")
	root.Name = "Root"
	root.Size = UDim2.new(1, 0, 1, 0)
	root.BackgroundColor3 = Color3.fromRGB(13, 20, 30)
	root.BorderSizePixel = 0
	root.Parent = gui
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.new(1, -10, 1, -10)
	label.Position = UDim2.new(0, 5, 0, 5)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.RobotoMono
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(0, 255, 128)
	label.Text = "[TECHNICIAN LAPTOP]\nKlik = Terminal\nDekati device = Console"
	label.Parent = root

	local serialAttach = Instance.new("Attachment")
	serialAttach.Name = "SerialPortAttachment"
	serialAttach.CFrame = CFrame.new(0.84, 0, 0)
	serialAttach.Parent = handle

	local kbLight = neon({
		name = "KBTrim",
		size = Vector3.new(1.4, 0.04, 0.07),
		cf = CFrame.new(0, 0.09, 0.4),
		color = CYAN_ACCENT,
		anchored = false,
		canCollide = false,
	})
	kbLight.Parent = tool
	local weld2 = Instance.new("WeldConstraint")
	weld2.Part0 = handle
	weld2.Part1 = kbLight
	weld2.Parent = handle

	return tool
end

--[[
	BuildWireCutter: gunting kabel teknisi (grip hitam + rahang oranye).
	Equipped: klik port yang tersambung untuk memotong kabel.
]]
function ModelFactory.BuildWireCutter(): Tool
	local tool = Instance.new("Tool")
	tool.Name = "WireCutter"
	tool.ToolTip = "Klik port tersambung untuk memotong kabel"
	tool.CanBeDropped = false

	local handle = newPart({
		name = "Handle",
		size = Vector3.new(0.28, 1.35, 0.28),
		cf = CFrame.new(0, 0, 0),
		color = Color3.fromRGB(34, 40, 50),
		material = Enum.Material.Rubber,
		anchored = false,
		canCollide = false,
	})
	handle.Parent = tool
	tool.Grip = CFrame.new(0, -0.15, 0.2)
	tool.GripPos = Vector3.new(0, -0.15, 0.2)

	-- Pivot bolt + two jaw halves at the head of the tool.
	local bolt = newPart({
		name = "PivotBolt",
		size = Vector3.new(0.34, 0.18, 0.34),
		cf = CFrame.new(0, 0.78, 0),
		color = ALU_LIGHT,
		shape = "Cylinder",
		anchored = false,
		canCollide = false,
	})
	bolt.Parent = tool
	local weldBolt = Instance.new("WeldConstraint")
	weldBolt.Part0 = handle
	weldBolt.Part1 = bolt
	weldBolt.Parent = handle

	for side = -1, 1, 2 do
		local jaw = newPart({
			name = "Jaw",
			size = Vector3.new(0.16, 0.62, 0.22),
			cf = CFrame.new(side * 0.18, 1.14, 0) * CFrame.Angles(0, 0, math.rad(side * -14)),
			color = Color3.fromRGB(240, 120, 44),
			material = Enum.Material.Metal,
			anchored = false,
			canCollide = false,
		})
		jaw.Parent = tool
		local weldJaw = Instance.new("WeldConstraint")
		weldJaw.Part0 = handle
		weldJaw.Part1 = jaw
		weldJaw.Parent = handle
	end

	local light = neon({
		name = "CutterLED",
		size = Vector3.new(0.1, 0.1, 0.1),
		cf = CFrame.new(0, 0.55, 0.16),
		color = CYAN_ACCENT,
		anchored = false,
		canCollide = false,
	})
	light.Parent = tool
	local weldLight = Instance.new("WeldConstraint")
	weldLight.Part0 = handle
	weldLight.Part1 = light
	weldLight.Parent = handle

	return tool
end

function ModelFactory.BuildCrate(label: string): Model
	local model = Instance.new("Model")
	model.Name = "Crate"

	local box = newPart({
		name = "CrateBox",
		size = Vector3.new(2.4, 1.9, 2.4),
		cf = CFrame.new(0, 0.95, 0),
		color = Color3.fromRGB(212, 168, 114),
		material = Enum.Material.Wood,
		canCollide = true,
	})
	box.Parent = model

	for _, y in ipairs({ 0.35, 1.55 }) do
		newPart({
			name = "CrateStrap",
			size = Vector3.new(2.5, 0.14, 2.5),
			cf = CFrame.new(0, y, 0),
			color = SLATE_TRIM,
		}).Parent = model
	end

	local bb = Instance.new("BillboardGui")
	bb.Name = "Label"
	bb.Size = UDim2.new(0, 180, 0, 40)
	bb.StudsOffset = Vector3.new(0, 1.9, 0)
	bb.AlwaysOnTop = true
	bb.MaxDistance = 60
	bb.Parent = box
	local tl = Instance.new("TextLabel")
	tl.Size = UDim2.new(1, 0, 1, 0)
	tl.BackgroundTransparency = 1
	tl.Font = Enum.Font.GothamBold
	tl.TextScaled = true
	tl.TextColor3 = Color3.fromRGB(255, 240, 160)
	tl.TextStrokeTransparency = 0.35
	tl.Text = label
	tl.Parent = bb

	model.WorldPivot = CFrame.new(0, 0, 0)
	return model
end

--[[
	Visual komponen yang nempel di workbench saat di-install (proporsional dengan ESD mat).
]]
function ModelFactory.BuildBenchComponentVisual(componentId: string): Model
	local def = Catalog.Get(componentId)
	assert(def ~= nil, "Komponen tidak dikenal: " .. componentId)
	local defv = def :: ItemDef
	local model = Instance.new("Model")
	model.Name = "Comp_" .. componentId

	local main: Part
	if componentId == "chassis_1u" or componentId == "chassis_2u" then
		local h = if componentId == "chassis_1u" then 0.50 else 1.04
		main = newPart({
			name = "BenchChassis",
			size = Vector3.new(3.2, h, 2.2),
			cf = CFrame.new(0, h / 2, 0),
			color = defv.visualColor,
		})
		neon({
			name = "StatusLED",
			size = Vector3.new(0.2, 0.1, 0.08),
			cf = CFrame.new(1.2, h - 0.12, 1.12),
			color = C.ledRed,
		}).Parent = model
	elseif componentId == "mobo_single" or componentId == "mobo_dual" then
		main = newPart({
			name = "BenchMobo",
			size = Vector3.new(1.6, 0.08, 1.4),
			cf = CFrame.new(0, 0.05, 0),
			color = defv.visualColor,
		})
		newPart({
			name = "SocketFrame",
			size = Vector3.new(0.45, 0.06, 0.45),
			cf = CFrame.new(-0.22, 0.11, -0.15),
			color = ALU_LIGHT,
		}).Parent = model
		newPart({
			name = "DimmSlot",
			size = Vector3.new(0.12, 0.08, 0.85),
			cf = CFrame.new(0.42, 0.12, 0),
			color = CYAN_ACCENT,
		}).Parent = model
	elseif string.sub(componentId, 1, 4) == "cpu_" then
		main = newPart({
			name = "BenchCPU",
			size = Vector3.new(0.48, 0.1, 0.48),
			cf = CFrame.new(0, 0.08, 0),
			color = defv.visualColor,
		})
		newPart({
			name = "CPUSubstrate",
			size = Vector3.new(0.56, 0.04, 0.56),
			cf = CFrame.new(0, 0.03, 0),
			color = Color3.fromRGB(48, 148, 92),
		}).Parent = model
	elseif string.sub(componentId, 1, 4) == "ram_" then
		main = newPart({
			name = "BenchRAM",
			size = Vector3.new(0.76, 0.28, 0.1),
			cf = CFrame.new(0, 0.18, 0),
			color = defv.visualColor,
		})
		newPart({
			name = "RAMPins",
			size = Vector3.new(0.72, 0.05, 0.09),
			cf = CFrame.new(0, 0.03, 0),
			color = GOLD_PIN,
		}).Parent = model
		neon({
			name = "RAMBar",
			size = Vector3.new(0.74, 0.05, 0.11),
			cf = CFrame.new(0, 0.34, 0),
			color = defv.visualColor,
		}).Parent = model
	elseif componentId == "nvme_1tb" then
		main = newPart({
			name = "BenchStorage",
			size = Vector3.new(0.72, 0.08, 0.36),
			cf = CFrame.new(0, 0.06, 0),
			color = defv.visualColor,
		})
		newPart({
			name = "NVMeEdge",
			size = Vector3.new(0.11, 0.06, 0.32),
			cf = CFrame.new(-0.35, 0.06, 0),
			color = GOLD_PIN,
		}).Parent = model
	elseif componentId == "psu_redundant" then
		main = newPart({
			name = "BenchPSU",
			size = Vector3.new(0.95, 0.48, 0.78),
			cf = CFrame.new(0, 0.25, 0),
			color = defv.visualColor,
		})
		newPart({
			name = "PSULabel",
			size = Vector3.new(0.56, 0.24, 0.04),
			cf = CFrame.new(0, 0.28, 0.4),
			color = SAFETY_YELLOW,
		}).Parent = model
	else
		main = newPart({
			name = "BenchMisc",
			size = Vector3.new(0.5, 0.24, 0.5),
			cf = CFrame.new(0, 0.13, 0),
			color = defv.visualColor,
		})
	end
	main.Parent = model
	model.WorldPivot = CFrame.new(0, 0, 0)
	return model
end

return ModelFactory
]]></ProtectedString>
</Properties>
</Item>
</Item>
</Item>
<Item class="ServerScriptService" referent="RBX11">
<Properties>
<string name="Name">ServerScriptService</string>
</Properties>
<Item class="Script" referent="RBX12">
<Properties>
<string name="Name">MainServer</string>
<bool name="Disabled">false</bool>
<ProtectedString name="Source"><![CDATA[--!strict
--[[
	MainServer (Script, ServerScriptService)
	Orkestrator: init order seluruh modul (dependency injection), lifecycle
	pemain (klaim lab, build facility, hook interaksi, load save, teleport),
	ResetDataRemote, rotasi fan AC, BindToClose.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterPack = game:GetService("StarterPack")

local Shared = ReplicatedStorage.Shared
local ModelFactory = require(Shared.ModelFactory)
local PlotConstants = require(Shared.PlotConstants)
local HardwareCatalog = require(Shared.HardwareCatalog)

local WorldAndAssetBuilder = require(script.Parent.Bootstrap.WorldAndAssetBuilder)
local SessionManager = require(script.Parent.Core.SessionManager)
local NetworkGraph = require(script.Parent.Core.NetworkGraph)
local CommandExecutor = require(script.Parent.Core.CommandExecutor)
local RackAndCablingSystem = require(script.Parent.Physical.RackAndCablingSystem)
local PlacementSystem = require(script.Parent.Physical.PlacementSystem)
local WorkbenchBuilderSystem = require(script.Parent.Physical.WorkbenchBuilderSystem)
local CarryAndMountSystem = require(script.Parent.Physical.CarryAndMountSystem)
local ShiftAndEconomyManager = require(script.Parent.Gameplay.ShiftAndEconomyManager)
local ContractAndIncidentManager = require(script.Parent.Gameplay.ContractAndIncidentManager)
local DataPersistenceManager = require(script.Parent.Gameplay.DataPersistenceManager)

-- ===== Init order (dependency injection; tidak ada require cycle) =====
local remotes = WorldAndAssetBuilder.EnsureRemotes()
WorldAndAssetBuilder.SetupLighting()

SessionManager.Init({ constants = PlotConstants })
NetworkGraph.Init({})
RackAndCablingSystem.Init({ sessions = SessionManager, graph = NetworkGraph, remotesFolder = remotes })
WorkbenchBuilderSystem.Init({
	sessions = SessionManager,
	graph = NetworkGraph,
	catalog = HardwareCatalog,
	constants = PlotConstants,
	modelFactory = ModelFactory,
	cabling = RackAndCablingSystem,
	remotesFolder = remotes,
})
PlacementSystem.Init({
	sessions = SessionManager,
	graph = NetworkGraph,
	catalog = HardwareCatalog,
	constants = PlotConstants,
	modelFactory = ModelFactory,
	workbench = WorkbenchBuilderSystem,
	cabling = RackAndCablingSystem,
	remotesFolder = remotes,
})
CarryAndMountSystem.Init({
	sessions = SessionManager,
	placement = PlacementSystem,
	graph = NetworkGraph,
	modelFactory = ModelFactory,
	constants = PlotConstants,
	catalog = HardwareCatalog,
	remotesFolder = remotes,
})
ShiftAndEconomyManager.Init({
	sessions = SessionManager,
	graph = NetworkGraph,
	constants = PlotConstants,
	remotesFolder = remotes,
	cabling = RackAndCablingSystem,
})
ContractAndIncidentManager.Init({
	sessions = SessionManager,
	graph = NetworkGraph,
	constants = PlotConstants,
	remotesFolder = remotes,
	workbench = WorkbenchBuilderSystem,
	carry = CarryAndMountSystem,
})
DataPersistenceManager.Init({
	sessions = SessionManager,
	graph = NetworkGraph,
	constants = PlotConstants,
	placement = PlacementSystem,
	workbench = WorkbenchBuilderSystem,
	remotesFolder = remotes,
})
CommandExecutor.Init({
	sessions = SessionManager,
	graph = NetworkGraph,
	utils = require(Shared.NetworkUtils),
	catalog = HardwareCatalog,
	constants = PlotConstants,
	workbench = WorkbenchBuilderSystem,
	cabling = RackAndCablingSystem,
	placement = PlacementSystem,
	carry = CarryAndMountSystem,
	remotesFolder = remotes,
})

-- ===== Loop global =====
ShiftAndEconomyManager.Start()
ContractAndIncidentManager.Start()
DataPersistenceManager.Start()

-- Rotasi fan AC (semua facility aktif)
RunService.Heartbeat:Connect(function(dt: number)
	WorldAndAssetBuilder.UpdateFans(dt)
end)

-- Laptop tool ke StarterPack: setiap respawn otomatis dapat
local starterLaptop = ModelFactory.BuildLaptop()
starterLaptop.Parent = StarterPack
-- Fase 2: wire cutter fisik (klik port tersambung = potong kabel)
local starterCutter = ModelFactory.BuildWireCutter()
starterCutter.Parent = StarterPack

-- ===== Lifecycle pemain =====
local function buildSession(player: Player)
	local session = SessionManager.GetSession(player)
	if session ~= nil then
		return -- sudah punya lab
	end
	local plotIndex = SessionManager.ClaimNextPlot()
	if plotIndex == nil then
		player:Kick("Semua lab penuh (4 pemain). Coba lagi nanti.")
		return
	end
	session = SessionManager.CreateSession(player, plotIndex)
	WorldAndAssetBuilder.BuildFacility(session)

	-- hook interaksi starter devices + facility
	for deviceId, _ in pairs(session.devices) do
		RackAndCablingSystem.HookDevice(session, deviceId)
	end
	RackAndCablingSystem.HookFacility(session)
	WorkbenchBuilderSystem.HookBenchSwitch(session)

	-- laptop langsung ke backpack (StarterPack mengurus respawn berikutnya)
	local backpack = player:FindFirstChildOfClass("Backpack")
	if backpack then
		local hasLaptop = backpack:FindFirstChild("TechnicianLaptop") ~= nil
			or (player.Character ~= nil and player.Character:FindFirstChild("TechnicianLaptop") ~= nil)
		if not hasLaptop then
			local laptop = ModelFactory.BuildLaptop()
			laptop.Parent = backpack
		end
	end

	-- load save (Apply memulihkan device, kabel, workbench, tiket, uang)
	local data = DataPersistenceManager.Load(player)
	if data ~= nil then
		DataPersistenceManager.Apply(session, data)
	end

	-- teleport ke lab pemain
	local facility = session.facility
	local function onCharacter(char: Model)
		task.wait(0.3)
		if char.Parent and facility.spawnCF then
			char:PivotTo(facility.spawnCF :: CFrame)
		end
	end
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end

	ShiftAndEconomyManager.ForceSync(session)
	-- Follow-up sync once client LocalScripts finish initializing
	task.delay(1.5, function()
		local live = SessionManager.GetSession(player)
		if live == session then
			ShiftAndEconomyManager.ForceSync(live)
		end
	end)
end

local function rebuildSession(player: Player)
	local old = SessionManager.GetSession(player)
	if old ~= nil then
		SessionManager.DeleteSession(player)
	end
	buildSession(player)
end

Players.PlayerAdded:Connect(buildSession)
for _, p in ipairs(Players:GetPlayers()) do
	task.spawn(buildSession, p)
end

Players.PlayerRemoving:Connect(function(player)
	local session = SessionManager.GetSession(player)
	if session ~= nil then
		DataPersistenceManager.Save(session)
	end
	SessionManager.DeleteSession(player)
end)

game:BindToClose(function()
	DataPersistenceManager.SaveAll()
end)

-- ===== ResetDataRemote: wipe save + rebuild lab dari nol =====
-- (binding lain sudah dilakukan masing-masing modul di Init masing-masing)
local resetRemote = remotes:FindFirstChild("ResetDataRemote")
if resetRemote then
	(resetRemote :: any).OnServerEvent:Connect(function(player)
		DataPersistenceManager.WipeSave(player)
		rebuildSession(player)
	end)
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="Folder" referent="RBX13">
<Properties>
<string name="Name">Bootstrap</string>
</Properties>
<Item class="ModuleScript" referent="RBX14">
<Properties>
<string name="Name">WorldAndAssetBuilder</string>
<ProtectedString name="Source"><![CDATA[--!strict
--[[
	WorldAndAssetBuilder (ModuleScript, ServerScriptService/Bootstrap)
	Builds the world procedurally for every player lab plot:
	- ReplicatedStorage.Remotes with EXACTLY the 10 contract remotes (idempotent)
	- Atmospheric Lighting (Future + bloom + color correction)
	- Per-plot room geometry: floor slab, walls with a front (+Z) door
	  opening, ceiling, 6 ceiling LED panels with SurfaceLight
	- Furniture: 12U rack "rack_main_1" (PDU powered), ISP uplink node,
	  starter kit mounted at U12/U10/U8 (ONLY the router is wired to the ISP;
	  switch and bare-metal stay unwired - wiring them is the first objective),
	  assembly workbench, NOC desk, loading dock, alarm beacon, AC unit
	  (fan registered for Heartbeat-driven rotation)
	- Door sign billboard ("SERVER LAB #n | <DisplayName>") and spawn CF refs
	All geometry hangs under workspace.Plots.Plot<n> so SessionManager can
	tear a whole lab down with a single root:Destroy(). Every part is anchored.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")

local ModelFactory = require(ReplicatedStorage.Shared.ModelFactory)
local PlotConstants = require(ReplicatedStorage.Shared.PlotConstants)
local HardwareCatalog = require(ReplicatedStorage.Shared.HardwareCatalog)
local NetworkGraph = require(script.Parent.Parent.Core.NetworkGraph)

local WorldAndAssetBuilder = {}

---------------------------------------------------------------------
-- Remotes
---------------------------------------------------------------------

-- CONTRACT section 3: the exact 10 remotes created by EnsureRemotes.
local REMOTE_DEFS = {
	{ name = "ExecuteCommand", class = "RemoteFunction" },
	{ name = "TerminalPushOutput", class = "RemoteEvent" },
	{ name = "OpenTerminalEvent", class = "RemoteEvent" },
	{ name = "CableActionRemote", class = "RemoteEvent" },
	{ name = "WorkbenchRemote", class = "RemoteEvent" },
	{ name = "ContractActionRemote", class = "RemoteEvent" },
	{ name = "PurchaseHardwareRemote", class = "RemoteEvent" },
	{ name = "StateSyncRemote", class = "RemoteEvent" },
	{ name = "PlaySFXRemote", class = "RemoteEvent" },
	{ name = "ResetDataRemote", class = "RemoteEvent" },
}

--[[
	Creates ReplicatedStorage.Remotes with exactly the 10 contract remotes.
	Idempotent: an existing folder is reused and any missing remote is added,
	so calling it twice never duplicates entries.
]]
function WorldAndAssetBuilder.EnsureRemotes(): Folder
	local folder = ReplicatedStorage:FindFirstChild("Remotes")
	if folder == nil or not folder:IsA("Folder") then
		local created = Instance.new("Folder")
		created.Name = "Remotes"
		created.Parent = ReplicatedStorage
		folder = created
	end
	local guaranteed = folder :: Folder
	for _, def in ipairs(REMOTE_DEFS) do
		if guaranteed:FindFirstChild(def.name) == nil then
			local inst = Instance.new(def.class)
			inst.Name = def.name
			inst.Parent = guaranteed
		end
	end
	return guaranteed
end

---------------------------------------------------------------------
-- Lighting
---------------------------------------------------------------------

-- Bright modern data-center lighting: Future lighting (set in .rbxlx), high
-- indoor ambient + environment diffuse so metallic/plastic surfaces stay crisp
-- and vibrant rather than dark, plus subtle bloom and clean atmosphere.
function WorldAndAssetBuilder.SetupLighting()
	-- Lighting.Technology is non-scriptable at runtime (configured in .rbxlx XML).
	pcall(function()
		Lighting.Technology = Enum.Technology.Future
	end)
	Lighting.Brightness = 2.4
	Lighting.Ambient = Color3.fromRGB(135, 148, 168)
	Lighting.OutdoorAmbient = Color3.fromRGB(145, 160, 185)
	Lighting.EnvironmentDiffuseScale = 0.85
	Lighting.EnvironmentSpecularScale = 0.5
	Lighting.ClockTime = 11.5
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.4

	if Lighting:FindFirstChild("DCBloom") == nil then
		local bloom = Instance.new("BloomEffect")
		bloom.Name = "DCBloom"
		bloom.Intensity = 0.22
		bloom.Size = 18
		bloom.Threshold = 1.4
		bloom.Parent = Lighting
	end
	if Lighting:FindFirstChild("DCColor") == nil then
		local cc = Instance.new("ColorCorrectionEffect")
		cc.Name = "DCColor"
		cc.Brightness = 0.04
		cc.Contrast = 0.06
		cc.Saturation = 0.12
		cc.Parent = Lighting
	end
	if Lighting:FindFirstChild("DCAtmosphere") == nil then
		local atmo = Instance.new("Atmosphere")
		atmo.Name = "DCAtmosphere"
		atmo.Density = 0.22
		atmo.Offset = 0.15
		atmo.Color = Color3.fromRGB(205, 222, 242)
		atmo.Decay = Color3.fromRGB(170, 195, 225)
		atmo.Glare = 0.15
		atmo.Haze = 0.6
		atmo.Parent = Lighting
	end
end

---------------------------------------------------------------------
-- Plots folder & AC fans
---------------------------------------------------------------------

function WorldAndAssetBuilder.EnsurePlotsFolder(): Folder
	local existing = Workspace:FindFirstChild("Plots")
	if existing ~= nil and existing:IsA("Folder") then
		return existing :: Folder
	end
	local folder = Instance.new("Folder")
	folder.Name = "Plots"
	folder.Parent = Workspace
	return folder
end

-- Registered AC fans (one entry per built facility, cleared on teardown).
type FanEntry = {
	part: BasePart,
	baseCF: CFrame,
	angle: number,
}

local activeFans: { FanEntry } = {}

-- Called from MainServer on every Heartbeat. Rotates each registered AC fan
-- around its disc axis; entries whose part vanished (destroyed plot) are pruned.
function WorldAndAssetBuilder.UpdateFans(dt: number)
	local step = math.clamp(dt, 0, 0.5) * 6 -- roughly one revolution per second
	for i = #activeFans, 1, -1 do
		local fan = activeFans[i]
		if fan.part == nil or fan.part.Parent == nil then
			table.remove(activeFans, i)
			continue
		end
		fan.angle += step
		fan.part.CFrame = fan.baseCF * CFrame.Angles(fan.angle, 0, 0)
	end
end

-- Drops every fan registration whose fan part lives under `root`
-- (called when a facility is destroyed / rebuilt).
function WorldAndAssetBuilder.ClearFansOfRoot(root: Instance)
	for i = #activeFans, 1, -1 do
		local fan = activeFans[i]
		if fan.part == nil or fan.part:IsDescendantOf(root) then
			table.remove(activeFans, i)
		end
	end
end

---------------------------------------------------------------------
-- Part helper
---------------------------------------------------------------------

local function newPart(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Name = props.name or "Part"
	p.Size = props.size or Vector3.new(1, 1, 1)
	p.CFrame = props.cf or CFrame.new(0, 0, 0)
	p.Color = props.color or Color3.fromRGB(190, 198, 210)
	p.Material = props.material or Enum.Material.SmoothPlastic
	p.Transparency = props.transparency or 0
	p.CanCollide = if props.canCollide ~= nil then props.canCollide else true
	if props.canQuery ~= nil then
		p.CanQuery = props.canQuery
	end
	if props.castShadow ~= nil then
		p.CastShadow = props.castShadow
	end
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	return p
end

-- Fresh WAN port table for the ISP uplink node (catalog has no isp_uplink
-- item, so its port layout is built literally here).
local function makeWanPort(): any
	return {
		portId = "wan1",
		portType = "WAN",
		connectedToDeviceId = nil,
		connectedToPortId = nil,
		cableColor = nil,
		linkUp = false,
		vlanId = 1,
		trafficLoadMbps = 0,
	}
end

---------------------------------------------------------------------
-- Facility
---------------------------------------------------------------------

--[[
	BuildFacility(session): constructs the whole lab for one session and the
	starter kit, returning the facility refs table (CONTRACT section 5 keys).
]]
function WorldAndAssetBuilder.BuildFacility(session: any): { [string]: any }
	local origin = PlotConstants.PLOT_POSITIONS[session.plotIndex]
	local floorTopY = PlotConstants.ROOM.floorTopY
	local halfX = PlotConstants.ROOM.halfX
	local halfZ = PlotConstants.ROOM.halfZ
	local roomH = PlotConstants.ROOM.height
	local colors = PlotConstants.COLORS

	-- helper: CFrame relative to this plot's origin
	local function plotCF(x: number, y: number, z: number): CFrame
		return CFrame.new(origin + Vector3.new(x, y, z))
	end

	local root = Instance.new("Model")
	root.Name = "Plot" .. tostring(session.plotIndex)

	local facility = Instance.new("Folder")
	facility.Name = "Facility"
	facility.Parent = root
	local devicesFolder = Instance.new("Folder")
	devicesFolder.Name = "Devices"
	devicesFolder.Parent = root
	local cablesFolder = Instance.new("Folder")
	cablesFolder.Name = "Cables"
	cablesFolder.Parent = root
	local cratesFolder = Instance.new("Folder")
	cratesFolder.Name = "Crates"
	cratesFolder.Parent = root

	-- ===== Room geometry (bright Tier-4 enterprise data-center lab) =====
	local fullW = halfX * 2 + 2 -- 66 studs
	local fullD = halfZ * 2 + 2 -- 66 studs
	local wallH = roomH -- 18 studs (proportional data-center hall)
	local doorW = PlotConstants.ROOM.doorWidth -- 14
	local doorH = PlotConstants.ROOM.doorHeight -- 10
	local wainscotH = 3.5 -- lower architectural wall band height (waist/desk level)

	-- Anti-static light raised floor slab (top at y = floorTopY = 0.5).
	local floor = newPart({
		name = "RoomFloor",
		size = Vector3.new(fullW, floorTopY, fullD),
		cf = plotCF(0, floorTopY / 2, 0),
		color = colors.floor,
		material = Enum.Material.SmoothPlastic,
	})
	floor.Parent = facility

	-- Decorative raised-floor tile grid lines (non-collidable, non-queryable).
	for gx = -24, 24, 8 do
		newPart({
			name = "FloorGridX",
			size = Vector3.new(0.14, 0.02, halfZ * 2 - 1),
			cf = plotCF(gx, floorTopY + 0.01, 0),
			color = colors.floorGrid,
			canCollide = false,
			canQuery = false,
			castShadow = false,
		}).Parent = facility
	end
	for gz = -24, 24, 8 do
		newPart({
			name = "FloorGridZ",
			size = Vector3.new(halfX * 2 - 1, 0.02, 0.14),
			cf = plotCF(0, floorTopY + 0.01, gz),
			color = colors.floorGrid,
			canCollide = false,
			canQuery = false,
			castShadow = false,
		}).Parent = facility
	end

	-- Central cold-aisle walkway + cyan LED guide rails from entrance to center.
	newPart({
		name = "WalkwayMat",
		size = Vector3.new(8.5, 0.03, 46),
		cf = plotCF(0, floorTopY + 0.015, 9),
		color = Color3.fromRGB(168, 184, 204),
		canCollide = false,
		canQuery = false,
		castShadow = false,
	}).Parent = facility
	for _, side in ipairs({ -4.35, 4.35 }) do
		newPart({
			name = "WalkwayLED",
			size = Vector3.new(0.18, 0.04, 46),
			cf = plotCF(side, floorTopY + 0.02, 9),
			color = colors.accentCyan,
			material = Enum.Material.Neon,
			canCollide = false,
			canQuery = false,
			castShadow = false,
		}).Parent = facility
	end

	-- Floor zone pads (visual wayfinding per station; CanQuery=false so placement hits RoomFloor).
	local zonePads: { { name: string, pos: Vector3, size: Vector3, color: Color3, border: Color3 } } = {
		{
			name = "ZonePad_Rack",
			pos = Vector3.new(-21, floorTopY + 0.018, -22),
			size = Vector3.new(15, 0.03, 15),
			color = Color3.fromRGB(184, 208, 232),
			border = Color3.fromRGB(56, 152, 236),
		},
		{
			name = "ZonePad_Workbench",
			pos = Vector3.new(18, floorTopY + 0.018, -12),
			size = Vector3.new(14, 0.03, 11),
			color = Color3.fromRGB(228, 214, 192),
			border = Color3.fromRGB(235, 168, 52),
		},
		{
			name = "ZonePad_NOC",
			pos = Vector3.new(18, floorTopY + 0.018, 16),
			size = Vector3.new(17, 0.03, 12),
			color = Color3.fromRGB(178, 194, 216),
			border = Color3.fromRGB(72, 130, 224),
		},
	}
	for _, zp in ipairs(zonePads) do
		newPart({
			name = zp.name,
			size = zp.size,
			cf = plotCF(zp.pos.X, zp.pos.Y, zp.pos.Z),
			color = zp.color,
			canCollide = false,
			canQuery = false,
			castShadow = false,
		}).Parent = facility
		-- crisp front accent bar on each zone pad
		newPart({
			name = zp.name .. "_Trim",
			size = Vector3.new(zp.size.X, 0.04, 0.25),
			cf = plotCF(zp.pos.X, floorTopY + 0.025, zp.pos.Z + zp.size.Z / 2),
			color = zp.border,
			material = Enum.Material.Neon,
			canCollide = false,
			canQuery = false,
			castShadow = false,
		}).Parent = facility
	end

	-- Helper: builds a two-tone solid wall section (wainscot + silver dado + upper white).
	local function addSolidWall(namePrefix: string, sizeX: number, sizeZ: number, cx: number, cz: number, yLow: number, yHigh: number)
		local lowerTop = math.min(wainscotH, yHigh)
		if yLow < lowerTop then
			local h = lowerTop - yLow
			newPart({
				name = namePrefix .. "_Low",
				size = Vector3.new(sizeX, h, sizeZ),
				cf = plotCF(cx, yLow + h / 2, cz),
				color = colors.wallLower,
			}).Parent = facility
		end
		if yHigh > lowerTop then
			local h = yHigh - lowerTop
			newPart({
				name = namePrefix .. "_High",
				size = Vector3.new(sizeX, h, sizeZ),
				cf = plotCF(cx, lowerTop + h / 2, cz),
				color = colors.wall,
			}).Parent = facility
		end
	end

	-- Back wall (-Z): solid two-tone with dado rail & cyan LED strip.
	addSolidWall("Wall_Back", fullW, 1, 0, -halfZ - 0.5, 0, wallH)
	newPart({
		name = "Dado_Back",
		size = Vector3.new(fullW - 2, 0.28, 0.16),
		cf = plotCF(0, wainscotH, -halfZ + 0.08),
		color = colors.trim,
		canCollide = false,
	}).Parent = facility
	newPart({
		name = "LEDStrip_Back",
		size = Vector3.new(fullW - 4, 0.14, 0.1),
		cf = plotCF(0, wainscotH + 0.22, -halfZ + 0.06),
		color = colors.accentCyan,
		material = Enum.Material.Neon,
		canCollide = false,
	}).Parent = facility

	-- Right wall (+X): solid two-tone (houses AC unit) with dado rail & cyan LED strip.
	addSolidWall("Wall_Right", 1, fullD, halfX + 0.5, 0, 0, wallH)
	newPart({
		name = "Dado_Right",
		size = Vector3.new(0.16, 0.28, fullD - 2),
		cf = plotCF(halfX - 0.08, wainscotH, 0),
		color = colors.trim,
		canCollide = false,
	}).Parent = facility
	newPart({
		name = "LEDStrip_Right",
		size = Vector3.new(0.1, 0.14, fullD - 4),
		cf = plotCF(halfX - 0.06, wainscotH + 0.22, 0),
		color = colors.accentCyan,
		material = Enum.Material.Neon,
		canCollide = false,
	}).Parent = facility

	-- Left wall (-X): panoramic observation glass window (z = -18..18, y = 3.5..12.5) for daylight.
	local lx = -halfX - 0.5
	addSolidWall("Wall_Left_North", 1, 15, lx, -25.5, 0, wallH) -- z = -33..-18
	addSolidWall("Wall_Left_South", 1, 15, lx, 25.5, 0, wallH) -- z = 18..33
	addSolidWall("Wall_Left_Sill", 1, 36, lx, 0, 0, 3.5)
	addSolidWall("Wall_Left_Header", 1, 36, lx, 0, 12.5, wallH)
	newPart({
		name = "Window_Left_Glass",
		size = Vector3.new(0.25, 9, 36),
		cf = plotCF(lx, 8.0, 0),
		color = colors.glass,
		material = Enum.Material.Glass,
		transparency = 0.65,
		castShadow = false,
	}).Parent = facility
	-- Window frame mullions (horizontal sill/top + vertical dividers).
	for _, my in ipairs({ 3.65, 12.35 }) do
		newPart({
			name = "Window_Left_Bar",
			size = Vector3.new(1.15, 0.35, 36.2),
			cf = plotCF(lx, my, 0),
			color = colors.frame,
		}).Parent = facility
	end
	for _, mz in ipairs({ -18, -6, 6, 18 }) do
		newPart({
			name = "Window_Left_Mullion",
			size = Vector3.new(1.15, 9, 0.45),
			cf = plotCF(lx, 8.0, mz),
			color = colors.frame,
		}).Parent = facility
	end

	-- Front wall (+Z): open glass-framed entrance (doorW=14, doorH=10) + side display windows.
	local fz = halfZ + 0.5
	-- Center lintel above doorway
	addSolidWall("Wall_Front_Lintel", doorW, 1, 0, fz, doorH, wallH)
	-- Left and right front wings with windows (x = +-11..+-25, y = 3.5..10.5)
	for _, dir in ipairs({ -1, 1 }) do
		local tag = if dir < 0 then "L" else "R"
		addSolidWall("Wall_Front_Inner_" .. tag, 4, 1, dir * 9, fz, 0, wallH) -- 7..11
		addSolidWall("Wall_Front_Outer_" .. tag, 8, 1, dir * 29, fz, 0, wallH) -- 25..33
		addSolidWall("Wall_Front_Sill_" .. tag, 14, 1, dir * 18, fz, 0, 3.5) -- 11..25
		addSolidWall("Wall_Front_Top_" .. tag, 14, 1, dir * 18, fz, 10.5, wallH)
		newPart({
			name = "Window_Front_Glass_" .. tag,
			size = Vector3.new(14, 7, 0.25),
			cf = plotCF(dir * 18, 7.0, fz),
			color = colors.glass,
			material = Enum.Material.Glass,
			transparency = 0.65,
			castShadow = false,
		}).Parent = facility
		for _, wy in ipairs({ 3.65, 10.35 }) do
			newPart({
				name = "Window_Front_Bar_" .. tag,
				size = Vector3.new(14.3, 0.35, 1.15),
				cf = plotCF(dir * 18, wy, fz),
				color = colors.frame,
			}).Parent = facility
		end
		newPart({
			name = "Window_Front_Mullion_" .. tag,
			size = Vector3.new(0.4, 7, 1.15),
			cf = plotCF(dir * 18, 7.0, fz),
			color = colors.frame,
		}).Parent = facility
	end

	-- Entrance portal frame (sleek slate aluminum pillars + glowing cyan lintel bar).
	for _, side in ipairs({ -1, 1 }) do
		newPart({
			name = "DoorPillar",
			size = Vector3.new(0.9, doorH + 0.6, 1.5),
			cf = plotCF(side * (doorW / 2 + 0.35), (doorH + 0.6) / 2, fz),
			color = colors.frame,
		}).Parent = facility
	end
	newPart({
		name = "DoorHeader",
		size = Vector3.new(doorW + 1.6, 1.2, 1.6),
		cf = plotCF(0, doorH + 0.5, fz),
		color = colors.frame,
	}).Parent = facility
	newPart({
		name = "DoorHeaderLED",
		size = Vector3.new(doorW + 0.6, 0.2, 1.68),
		cf = plotCF(0, doorH + 0.05, fz),
		color = colors.accentCyan,
		material = Enum.Material.Neon,
		canCollide = false,
	}).Parent = facility

	-- Exterior corner trim columns + roof fascia band for clean outside silhouette.
	for _, cx in ipairs({ -halfX - 0.5, halfX + 0.5 }) do
		for _, cz in ipairs({ -halfZ - 0.5, halfZ + 0.5 }) do
			newPart({
				name = "CornerColumn",
				size = Vector3.new(1.5, wallH + 0.6, 1.5),
				cf = plotCF(cx, (wallH + 0.6) / 2, cz),
				color = colors.frame,
			}).Parent = facility
		end
	end

	-- Ceiling perimeter with a central 24x24 glass skylight atrium so daylight fills the lab.
	local skyHalf = 12
	local sideBand = (fullW - skyHalf * 2) / 2 -- 21 studs
	local ceilingDefs: { { size: Vector3, x: number, z: number } } = {
		{ size = Vector3.new(fullW, 0.6, sideBand), x = 0, z = -(skyHalf + sideBand / 2) },
		{ size = Vector3.new(fullW, 0.6, sideBand), x = 0, z = skyHalf + sideBand / 2 },
		{ size = Vector3.new(sideBand, 0.6, skyHalf * 2), x = -(skyHalf + sideBand / 2), z = 0 },
		{ size = Vector3.new(sideBand, 0.6, skyHalf * 2), x = skyHalf + sideBand / 2, z = 0 },
	}
	for i, cdef in ipairs(ceilingDefs) do
		newPart({
			name = "Ceiling_" .. tostring(i),
			size = cdef.size,
			cf = plotCF(cdef.x, roomH + 0.3, cdef.z),
			color = colors.wall,
		}).Parent = facility
	end
	-- Skylight glass pane + architectural crossbeams.
	newPart({
		name = "SkylightGlass",
		size = Vector3.new(skyHalf * 2, 0.25, skyHalf * 2),
		cf = plotCF(0, roomH + 0.35, 0),
		color = colors.glass,
		material = Enum.Material.Glass,
		transparency = 0.72,
		castShadow = false,
	}).Parent = facility
	for _, bx in ipairs({ -skyHalf, 0, skyHalf }) do
		newPart({
			name = "SkylightBeamX",
			size = Vector3.new(0.6, 0.75, skyHalf * 2 + 0.6),
			cf = plotCF(bx, roomH + 0.25, 0),
			color = colors.frame,
		}).Parent = facility
	end
	for _, bz in ipairs({ -skyHalf, 0, skyHalf }) do
		newPart({
			name = "SkylightBeamZ",
			size = Vector3.new(skyHalf * 2 + 0.6, 0.75, 0.6),
			cf = plotCF(0, roomH + 0.25, bz),
			color = colors.frame,
		}).Parent = facility
	end

	-- Overhead industrial cable ladder trays + yellow fiber raceway (y = 15.2).
	local trayY = 15.2
	local trayDefs: { { size: Vector3, x: number, z: number, color: Color3 } } = {
		{ size = Vector3.new(44, 0.25, 2.2), x = -2, z = -20, color = colors.trim }, -- back main trunk
		{ size = Vector3.new(44, 0.2, 0.7), x = -2, z = -20, color = colors.accentAmber }, -- yellow fiber raceway
		{ size = Vector3.new(2.2, 0.25, 36), x = 18, z = -2, color = colors.trim }, -- workbench to NOC trunk
		{ size = Vector3.new(0.7, 0.2, 36), x = 18, z = -2, color = colors.accentAmber },
	}
	for i, tdef in ipairs(trayDefs) do
		newPart({
			name = "CableTray_" .. tostring(i),
			size = tdef.size,
			cf = plotCF(tdef.x, trayY, tdef.z),
			color = tdef.color,
			canCollide = false,
			castShadow = false,
		}).Parent = facility
	end

	-- 6 high-output ceiling LED fixtures with wide SurfaceLight + PointLight fill.
	for _, lx in ipairs({ -20, 0, 20 }) do
		for _, lz in ipairs({ -18, 18 }) do
			local housing = newPart({
				name = "LightHousing",
				size = Vector3.new(9.2, 0.25, 2.6),
				cf = plotCF(lx, roomH - 0.12, lz),
				color = colors.frame,
				canCollide = false,
				castShadow = false,
			})
			housing.Parent = facility
			local panel = newPart({
				name = "LightPanel",
				size = Vector3.new(8.6, 0.16, 2.1),
				cf = plotCF(lx, roomH - 0.26, lz),
				color = colors.lightPanel,
				material = Enum.Material.Neon,
				canCollide = false,
				castShadow = false,
			})
			panel.Parent = facility
			local light = Instance.new("SurfaceLight")
			light.Face = Enum.NormalId.Bottom
			light.Range = 48
			light.Brightness = 2.2
			light.Angle = 150
			light.Color = Color3.fromRGB(242, 248, 255)
			light.Parent = panel
			local fill = Instance.new("PointLight")
			fill.Range = 44
			fill.Brightness = 0.85
			fill.Color = Color3.fromRGB(236, 244, 255)
			fill.Shadows = false
			fill.Parent = panel
		end
	end

	-- ===== Main rack (PDU powered) =====
	local rackModel, rackSlots, pduPart = ModelFactory.BuildRack("rack_12u", "rack_main_1")
	rackModel:PivotTo(plotCF(PlotConstants.RACK_POS.X, floorTopY, PlotConstants.RACK_POS.Z))
	rackModel.Parent = facility

	session.racks["rack_main_1"] = {
		rackId = "rack_main_1",
		name = "Main Rack 12U",
		itemId = "rack_12u",
		maxU = 12,
		occupiedSlots = {},
		totalPowerWatts = 0,
		maxPowerWatts = 3000,
		pduPowered = true,
	}
	session.rackModels["rack_main_1"] = rackModel
	session.rackSlots["rack_main_1"] = rackSlots

	-- ===== ISP uplink node (WAN junction, always powered) =====
	local ispSpec = PlotConstants.STARTER.isp
	local ispModel, _ispAttach, ispWanLed = ModelFactory.BuildISPUplink(ispSpec.id)
	ispModel:PivotTo(plotCF(PlotConstants.ISP_POS.X, floorTopY, PlotConstants.ISP_POS.Z))
	ispModel.Parent = devicesFolder

	local ispNode = NetworkGraph.DefaultNode(ispSpec.id, ispSpec.name, "isp_uplink")
	ispNode.deviceType = "Router"
	ispNode.uSize = 0
	ispNode.isPowered = true
	ispNode.ports = { wan1 = makeWanPort() }
	NetworkGraph.RegisterDevice(session, ispNode, ispModel)

	-- ===== Starter devices mounted in the rack (U12 / U10 / U8) =====
	local function mountStarter(spec: any)
		local itemId = spec.itemId :: string
		local uSlot = spec.uSlot :: number
		local model, _ports, _consoleAttach, _led, _smoke = ModelFactory.BuildDeviceModel(itemId, spec.id)
		local node = NetworkGraph.DefaultNode(spec.id, spec.name, itemId)
		node.rackId = "rack_main_1"
		node.uSlot = uSlot
		node.isPowered = true

		local rack = session.racks["rack_main_1"]
		for u = uSlot - node.uSize + 1, uSlot do
			rack.occupiedSlots[u] = spec.id
		end
		rack.totalPowerWatts += node.specs.powerWatts

		if itemId == "router_edge" then
			node.ip = PlotConstants.STARTER.router.ip
			node.gateway = PlotConstants.STARTER.router.gateway
			node.subnetMask = PlotConstants.STARTER.router.subnetMask
		end

		local slot = rackSlots[uSlot]
		if slot ~= nil then
			model:PivotTo((slot :: Attachment).WorldCFrame * CFrame.new(0, 0, 0.95))
		end
		model.Parent = devicesFolder
		NetworkGraph.RegisterDevice(session, node, model)

		-- Rack-mounted devices are powered by the PDU (no freeform power prompt).
		local consolePart = model:FindFirstChild("ConsolePort", true)
		if consolePart ~= nil and consolePart:IsA("BasePart") then
			local prompt = consolePart:FindFirstChildOfClass("ProximityPrompt")
			if prompt ~= nil then
				prompt.ObjectText = spec.name .. " (U" .. tostring(uSlot) .. ")"
			end
		end
	end

	mountStarter(PlotConstants.STARTER.router)
	mountStarter(PlotConstants.STARTER.switch)
	mountStarter(PlotConstants.STARTER.baremetal)

	-- Single initial cable: router WAN <-> ISP uplink. The starter switch and
	-- bare-metal stay UNWIRED - wiring them is the player's first objective.
	NetworkGraph.ConnectPorts(session, "isp_router_1", "wan1", "isp_uplink", "wan1", "WAN_Yellow")

	-- ===== Assembly workbench =====
	local wbModel, benchSnaps, benchSwitch, benchLed = ModelFactory.BuildWorkbench()
	wbModel:PivotTo(plotCF(PlotConstants.WORKBENCH_POS.X, floorTopY, PlotConstants.WORKBENCH_POS.Z))
	wbModel.Parent = facility

	-- ===== NOC desk (3 monitors with SurfaceGui.Root for the client) =====
	local nocModel, nocMonitors = ModelFactory.BuildNOCDesk()
	nocModel:PivotTo(plotCF(PlotConstants.NOCDESK_POS.X, floorTopY, PlotConstants.NOCDESK_POS.Z))
	nocModel.Parent = facility

	-- ===== Loading dock (crate spawn pad) =====
	local dockModel, crateLocalCF = ModelFactory.BuildDockPad()
	local dockPivot = plotCF(PlotConstants.DOCK_POS.X, floorTopY, PlotConstants.DOCK_POS.Z)
	dockModel:PivotTo(dockPivot)
	dockModel.Parent = facility
	local dockCF = dockPivot * crateLocalCF

	-- ===== Alarm beacon (visual; alarm logic arrives in Fase 3) =====
	local beaconModel, beaconLens, beaconLight = ModelFactory.BuildBeacon()
	beaconModel:PivotTo(plotCF(PlotConstants.BEACON_OFFSET.X, floorTopY + PlotConstants.BEACON_OFFSET.Y, PlotConstants.BEACON_OFFSET.Z))
	beaconModel.Parent = facility

	-- ===== AC unit (fan registered for Heartbeat rotation) =====
	local acModel, acFan = ModelFactory.BuildACUnit()
	acModel:PivotTo(plotCF(PlotConstants.AC_OFFSET.X, floorTopY + PlotConstants.AC_OFFSET.Y, PlotConstants.AC_OFFSET.Z))
	acModel.Parent = facility
	table.insert(activeFans, { part = acFan, baseCF = acFan.CFrame, angle = 0 })

	-- ===== Lab sign billboard above the front door =====
	local signAnchor = newPart({
		name = "SignAnchor",
		size = Vector3.new(0.2, 0.2, 0.2),
		cf = plotCF(0, floorTopY + doorH + 2.2, halfZ + 0.9),
		transparency = 1,
		canCollide = false,
	})
	signAnchor.Parent = facility
	local signGui = Instance.new("BillboardGui")
	signGui.Name = "LabSign"
	signGui.Size = UDim2.new(0, 360, 0, 56)
	signGui.StudsOffset = Vector3.new(0, 0, 0)
	signGui.AlwaysOnTop = true
	signGui.MaxDistance = 120
	signGui.Parent = signAnchor
	local signLabel = Instance.new("TextLabel")
	signLabel.Size = UDim2.new(1, 0, 1, 0)
	signLabel.BackgroundTransparency = 1
	signLabel.Font = Enum.Font.GothamBold
	signLabel.TextScaled = true
	signLabel.TextColor3 = Color3.fromRGB(120, 220, 255)
	signLabel.TextStrokeTransparency = 0.5
	signLabel.Text = "SERVER LAB #" .. tostring(session.plotIndex) .. " | " .. session.player.DisplayName
	signLabel.Parent = signGui

	-- ===== Facility refs (CONTRACT section 5, exact keys) =====
	local spawnCF = CFrame.new(origin + Vector3.new(0, 4, halfZ + 8))

	local refs: { [string]: any } = {
		root = root,
		facility = facility,
		devices = devicesFolder,
		cables = cablesFolder,
		crates = cratesFolder,
		rackModel = rackModel,
		rackSlots = rackSlots,
		pduPart = pduPart,
		pduParts = { rack_main_1 = pduPart },
		workbenchModel = wbModel,
		benchSnaps = benchSnaps,
		benchSwitch = benchSwitch,
		benchLed = benchLed,
		nocMonitors = nocMonitors,
		dockCF = dockCF,
		beaconLens = beaconLens,
		beaconLight = beaconLight,
		fan = acFan,
		spawnCF = spawnCF,
		ispWanLed = ispWanLed,
	}

	session.facility = refs
	root.Parent = WorldAndAssetBuilder.EnsurePlotsFolder()
	return refs
end

-- Tears the lab down: stops fan registrations and destroys the whole plot.
-- Safe to call on a half-built session or twice in a row.
function WorldAndAssetBuilder.DestroyFacility(session: any)
	local facility = session.facility
	if type(facility) == "table" and facility.root ~= nil then
		WorldAndAssetBuilder.ClearFansOfRoot(facility.root)
		facility.root:Destroy()
	end
end

-- Shared catalog module (same instance the client requires).
function WorldAndAssetBuilder.GetCatalog()
	return HardwareCatalog
end

return WorldAndAssetBuilder
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="Folder" referent="RBX15">
<Properties>
<string name="Name">Core</string>
</Properties>
<Item class="ModuleScript" referent="RBX16">
<Properties>
<string name="Name">SessionManager</string>
<ProtectedString name="Source"><![CDATA[--!strict
--[[
	SessionManager (ModuleScript, ServerScriptService/Core)
	Per-player session store and lifecycle management:
	- plot claiming / releasing (one lab plot per player)
	- session creation with every CONTRACT section 4 field initialized
	- session deletion (facility teardown, console beam cleanup, plot release)
	- id counters for devices ("prefix_N") and cables ("cbl_N")
	Pure state store: no gameplay logic lives here. Other server modules
	receive the session table through their own deps injection.
]]

local SessionManager = {}

local Sessions: { [Player]: any } = {} -- player -> session table
local UsedPlots: { [number]: Player } = {} -- plotIndex -> owning player
local PlotCount = 4
local Constants: any = nil -- PlotConstants module, injected via Init

---------------------------------------------------------------------
-- Lifecycle
---------------------------------------------------------------------

-- Init(deps: { constants = PlotConstants })
function SessionManager.Init(deps: { [string]: any })
	Constants = deps.constants
	PlotCount = Constants.PLOT_COUNT
end

-- Returns the live session of a player, or nil when none exists yet.
function SessionManager.GetSession(player: Player): any?
	return Sessions[player]
end

-- Returns the shared sessions table keyed by Player.
function SessionManager.GetAllSessions(): { [Player]: any }
	return Sessions
end

-- Returns the first free plot index (1..PLOT_COUNT) or nil when all taken.
function SessionManager.ClaimNextPlot(): number?
	for i = 1, PlotCount do
		if UsedPlots[i] == nil then
			return i
		end
	end
	return nil
end

-- Creates and registers a session containing every field of CONTRACT
-- section 4 (including workbench with all WorkbenchState fields and tickets).
function SessionManager.CreateSession(player: Player, plotIndex: number): any
	local econ = Constants.ECONOMY
	local session = {
		player = player,
		plotIndex = plotIndex,
		balance = econ.startBalance,
		reputation = econ.startReputation,
		day = 1,
		terminal = {
			mode = "Disconnected",
			targetDeviceId = nil,
			sshStack = {},
		},
		devices = {},
		deviceModels = {},
		racks = {},
		rackModels = {},
		cables = {},
		pendingCableDeviceId = nil,
		pendingCablePortId = nil,
		pendingCableHighlight = nil,
		pendingCableColor = nil,
		consoleLink = nil,
		pendingPlacementItemId = nil,
		workbench = {
			chassis = nil,
			mobo = nil,
			cpuCount = 0,
			cpuCores = 0,
			cpuSockets = 0,
			ramSlotsUsed = 0,
			ramSlots = 0,
			ramGb = 0,
			storageBaysUsed = 0,
			storageBays = 0,
			storageGb = 0,
			psu = nil,
			powered = false,
			osInstalled = nil,
			installing = false,
			stressRunning = false,
			tested = false,
			shipped = false,
			deviceId = nil,
			totalSpent = 0,
			snapIndex = nil,
			benchModel = nil,
			lastCpuId = nil,
			lastRamId = nil,
		},
		facility = {},
		flags = {},
		hookedDevices = {},
		vmIpCounter = {},
		cableCounter = 0,
		deviceCounter = 0,
		broadcastStorm = false,
		loadedFromSave = false,
		noSaveWarned = false,
		tickets = {}, -- ContractTicket-like rows (filled by ContractAndIncidentManager)
		cableSpools = {
			LAN_Blue = Constants.CABLES.starter.LAN_Blue,
			WAN_Yellow = Constants.CABLES.starter.WAN_Yellow,
			Mgmt_Red = Constants.CABLES.starter.Mgmt_Red,
		},
		selectedCableColor = "LAN_Blue",
		carry = nil,
		colocation = { crates = {}, byTicket = {} },
		rackSlots = {},
	}
	Sessions[player] = session
	UsedPlots[plotIndex] = player
	return session
end

-- Removes a session: destroys the pending cable highlight, the console beam
-- and the facility root (room, devices, cables folder all hang under it),
-- then releases the plot. Safe to call even on a half-built session.
function SessionManager.DeleteSession(player: Player)
	local session = Sessions[player]
	if session == nil then
		return
	end
	if session.pendingCableHighlight ~= nil then
		session.pendingCableHighlight:Destroy()
		session.pendingCableHighlight = nil
	end
	if session.consoleLink ~= nil and session.consoleLink.beam ~= nil then
		session.consoleLink.beam:Destroy()
	end
	session.consoleLink = nil
	if session.carry ~= nil and session.carry.conn ~= nil then
		session.carry.conn:Disconnect()
	end
	session.carry = nil
	local facility = session.facility
	if facility ~= nil and facility.root ~= nil then
		facility.root:Destroy()
	end
	session.facility = {}
	UsedPlots[session.plotIndex] = nil
	Sessions[player] = nil
end

---------------------------------------------------------------------
-- Id counters
---------------------------------------------------------------------

-- "prefix_N" using the per-session device counter.
function SessionManager.NextDeviceId(session: any, prefix: string): string
	session.deviceCounter += 1
	return prefix .. "_" .. tostring(session.deviceCounter)
end

-- "cbl_N" using the per-session cable counter.
function SessionManager.NextCableId(session: any): string
	session.cableCounter += 1
	return "cbl_" .. tostring(session.cableCounter)
end

return SessionManager
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX17">
<Properties>
<string name="Name">NetworkGraph</string>
<ProtectedString name="Source"><![CDATA[--!strict
--[[
	NetworkGraph (ModuleScript, ServerScriptService/Core)
	Authoritative network state store: devices, ports, cables and LEDs.
	Implements:
	- port layout + default node factory from the hardware catalog
	- link validation with color-coded Beam visuals (droop, width 0.12)
	- BFS reachability with VLAN isolation through switches, unpowered
	  nodes never forwarding, broadcast storm (topology loop) detection
	- routing path extraction for traceroute
	- smart auto-cabling to the nearest free port
	Fase 2 adds explicit port VLANs, 802.1Q trunks and inter-VLAN routing
	through routers (switches isolate VLANs; routers bridge them at L3).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HardwareCatalog = require(ReplicatedStorage.Shared.HardwareCatalog)
local PlotConstants = require(ReplicatedStorage.Shared.PlotConstants)
local NetworkUtils = require(ReplicatedStorage.Shared.NetworkUtils)
local SessionManager = require(script.Parent.SessionManager)

local NetworkGraph = {}

---------------------------------------------------------------------
-- Visual constants
---------------------------------------------------------------------

-- Beam colors per CableColorType (CONTRACT section 6 AGENT A)
local BEAM_COLORS: { [string]: ColorSequence } = {
	LAN_Blue = ColorSequence.new(Color3.fromRGB(70, 130, 255)),
	WAN_Yellow = ColorSequence.new(Color3.fromRGB(240, 210, 70)),
	Mgmt_Red = ColorSequence.new(Color3.fromRGB(230, 80, 80)),
}

local LED_GREEN = Color3.fromRGB(85, 255, 120)
local LED_RED = Color3.fromRGB(255, 80, 80)
local LED_OFF = Color3.fromRGB(70, 70, 70)

local ISP_UPLINK_ID = "isp_uplink" -- WAN junction to the "internet"
local FALLBACK_SWITCH_ID = "sw_main_1" -- auto-cable fallback target
local AUTO_CABLE_RANGE = 60 -- studs

-- Init(deps): shared modules are required directly at the top, so deps are
-- reserved for future use (CONTRACT allows ignoring them).
function NetworkGraph.Init(_deps: { [string]: any }) end

---------------------------------------------------------------------
-- Port / node factories
---------------------------------------------------------------------

local function makePort(portId: string, portType: string): any
	return {
		portId = portId,
		portType = portType,
		connectedToDeviceId = nil,
		connectedToPortId = nil,
		cableColor = nil,
		linkUp = false,
		vlanId = 1,
		isTrunk = false,
		trafficLoadMbps = 0,
	}
end

-- Builds the default port layout for a catalog item: wanN / ethN / sfpN.
function NetworkGraph.MakePortsForItem(itemId: string): { [string]: any }
	local ports: { [string]: any } = {}
	local def = HardwareCatalog.Get(itemId)
	if def == nil then
		return ports
	end
	local specs = def.specs
	local wanCount = specs.wanPorts or 0
	local rj45Count = specs.ports or 0
	local sfpCount = specs.sfpPorts or 0
	-- Bare-metal hosts (Server category) carry no explicit port count in the
	-- catalog, but every server needs at least one RJ45 uplink to be playable
	-- (matches chassis_1u/2u, which ship with 1x RJ45). If the catalog later
	-- gains "ports" on Server items, this fallback stays a no-op.
	if def.category == "Server" and rj45Count == 0 and wanCount == 0 and sfpCount == 0 then
		rj45Count = 1
	end
	for i = 1, wanCount do
		ports["wan" .. i] = makePort("wan" .. i, "WAN")
	end
	for i = 1, rj45Count do
		ports["eth" .. i] = makePort("eth" .. i, "RJ45")
	end
	for i = 1, sfpCount do
		ports["sfp" .. i] = makePort("sfp" .. i, "SFP")
	end
	return ports
end

-- Builds a fresh DeviceNode for a catalog item; callers mutate specifics
-- (ip, rack slot, power state, freeform position, ...) afterwards.
function NetworkGraph.DefaultNode(id: string, name: string, itemId: string): any
	local def = HardwareCatalog.Get(itemId)
	local deviceType = "Switch"
	local specs = { cpu = 0, ram = 0, disk = 0, powerWatts = 0 }
	local uSize = 1
	if def ~= nil then
		if def.category == "Network" then
			deviceType = if (def.specs.wanPorts or 0) > 0 then "Router" else "Switch"
		elseif def.category == "Server" then
			deviceType = "BareMetal"
		elseif def.category == "Component" and (def.specs.ports or 0) > 0 then
			-- chassis items (chassis_1u/2u) are the base of custom builds:
			-- the workbench registers them as BareMetal hosts
			deviceType = "BareMetal"
		end
		specs = {
			cpu = def.specs.cpu or 0,
			ram = def.specs.ram or 0,
			disk = def.specs.disk or 0,
			powerWatts = def.specs.powerWatts or 0,
		}
		uSize = def.uSize
	end
	return {
		id = id,
		name = name,
		deviceType = deviceType,
		itemId = itemId,
		rackId = nil,
		uSlot = nil,
		uSize = uSize,
		ip = nil,
		gateway = nil,
		subnetMask = "255.255.255.0",
		defaultVlan = 1,
		interVlanRouting = deviceType == "Router",
		contractId = nil,
		ports = NetworkGraph.MakePortsForItem(itemId),
		specs = specs,
		vms = {},
		blockedIps = {},
		osInstalled = nil,
		isPowered = false,
		temperatureC = 32,
		hasDegradedDrive = false,
		degradedBayIndex = nil,
		isUnderDDoS = false,
		ddosAttackerIp = nil,
		freeform = false,
		posX = nil,
		posZ = nil,
		rotY = nil,
	}
end

---------------------------------------------------------------------
-- Registration & LEDs
---------------------------------------------------------------------

-- Adds a device to the session graph (and stores its model when given).
function NetworkGraph.RegisterDevice(session: any, node: any, model: Model?)
	session.devices[node.id] = node
	if model ~= nil then
		session.deviceModels[node.id] = model
	end
	NetworkGraph.UpdateDeviceLED(session, node.id)
end

-- Removes a device: severs every attached cable, destroys the model and
-- clears graph/hook bookkeeping.
function NetworkGraph.RemoveDevice(session: any, deviceId: string)
	local node = session.devices[deviceId]
	if node == nil then
		return
	end
	-- collect connected port ids first: DisconnectPort mutates node.ports
	local connected: { string } = {}
	for portId, port in pairs(node.ports) do
		if port.connectedToDeviceId ~= nil then
			table.insert(connected, portId)
		end
	end
	for _, portId in ipairs(connected) do
		NetworkGraph.DisconnectPort(session, deviceId, portId)
	end
	local model = session.deviceModels[deviceId]
	if model ~= nil then
		model:Destroy()
		session.deviceModels[deviceId] = nil
	end
	session.hookedDevices[deviceId] = nil
	session.devices[deviceId] = nil
end

-- StatusLED green/red by power state; port LEDs green when linkUp else off.
function NetworkGraph.UpdateDeviceLED(session: any, deviceId: string)
	local node = session.devices[deviceId]
	local model = session.deviceModels[deviceId]
	if node == nil or model == nil then
		return
	end
	local led = model:FindFirstChild("StatusLED", true)
	if led ~= nil and led:IsA("BasePart") then
		led.Color = if node.isPowered then LED_GREEN else LED_RED
	end
	for _, port in pairs(node.ports) do
		local ledPart = model:FindFirstChild("PortLED_" .. port.portId, true)
		if ledPart ~= nil and ledPart:IsA("BasePart") then
			ledPart.Color = if port.linkUp then LED_GREEN else LED_OFF
		end
	end
end

---------------------------------------------------------------------
-- Cabling
---------------------------------------------------------------------

-- Finds the physical port Part inside a device model by its PortId attribute.
local function findPortPart(session: any, deviceId: string, portId: string): BasePart?
	local model = session.deviceModels[deviceId]
	if model == nil then
		return nil
	end
	for _, desc in ipairs(model:GetDescendants()) do
		if desc:IsA("BasePart") and desc:GetAttribute("PortId") == portId then
			return desc
		end
	end
	return nil
end

-- Validates and creates a cable between two free, compatible ports.
-- Returns (ok, errorMessage). On success both sides are linkUp, a color-coded
-- Beam is created (parented to session.facility.cables, or temporarily to the
-- device model during facility build before the cables folder exists) and the
-- cable is registered as session.cables[cableId].
function NetworkGraph.ConnectPorts(session: any, devAId: string, portAId: string, devBId: string, portBId: string, color: string): (boolean, string)
	local a = session.devices[devAId]
	local b = session.devices[devBId]
	if a == nil or b == nil then
		return false, "Device tidak ditemukan"
	end
	if devAId == devBId then
		return false, "Tidak bisa menghubungkan device ke dirinya sendiri"
	end
	local pa = a.ports[portAId]
	local pb = b.ports[portBId]
	if pa == nil or pb == nil then
		return false, "Port tidak ditemukan"
	end
	if pa.portType == "Console" or pb.portType == "Console" then
		return false, "Port console hanya untuk kabel console laptop"
	end
	if pa.connectedToDeviceId ~= nil or pb.connectedToDeviceId ~= nil then
		return false, "Port sudah terpakai"
	end
	-- type compatibility: WAN-WAN, RJ45-RJ45, SFP-SFP, RJ45 <-> SFP
	local compatible = pa.portType == pb.portType
		or (pa.portType == "RJ45" and pb.portType == "SFP")
		or (pa.portType == "SFP" and pb.portType == "RJ45")
	if not compatible then
		return false, "Tipe port tidak kompatibel (" .. pa.portType .. " vs " .. pb.portType .. ")"
	end

	-- Fase 2 cable colours: yellow is reserved for WAN uplinks, LAN/Mgmt for
	-- copper/fibre data ports. Persistence restores the recorded colour too.
	local bothWan = pa.portType == "WAN" and pb.portType == "WAN"
	local cableColor: string = if BEAM_COLORS[color] ~= nil then color else "LAN_Blue"
	if bothWan and cableColor ~= "WAN_Yellow" then
		return false, "Port WAN membutuhkan kabel kuning (WAN_Yellow)"
	end
	if not bothWan and cableColor == "WAN_Yellow" then
		return false, "Kabel WAN kuning hanya untuk port WAN"
	end

	local cableId = SessionManager.NextCableId(session)

	pa.connectedToDeviceId = devBId
	pa.connectedToPortId = portBId
	pa.cableColor = cableColor
	pa.linkUp = true
	pb.connectedToDeviceId = devAId
	pb.connectedToPortId = portAId
	pb.cableColor = cableColor
	pb.linkUp = true

	-- Beam visual with realistic droop
	local partA = findPortPart(session, devAId, portAId)
	local partB = findPortPart(session, devBId, portBId)
	local attachA = if partA ~= nil then partA:FindFirstChild("PortAttach") else nil
	local attachB = if partB ~= nil then partB:FindFirstChild("PortAttach") else nil
	local beam: Beam? = nil
	if attachA ~= nil and attachB ~= nil and attachA:IsA("Attachment") and attachB:IsA("Attachment") then
		beam = Instance.new("Beam")
		beam.Name = "Cable_" .. cableId
		beam.Attachment0 = attachA
		beam.Attachment1 = attachB
		beam.Color = BEAM_COLORS[cableColor] :: ColorSequence
		beam.Transparency = NumberSequence.new(0.1)
		beam.Width0 = 0.12
		beam.Width1 = 0.12
		beam.CurveSize0 = -0.6
		beam.CurveSize1 = -0.6
		beam.Segments = 12
		beam.FaceCamera = true
		local facility = session.facility
		local cablesFolder = if facility ~= nil then facility.cables else nil
		if cablesFolder ~= nil then
			beam.Parent = cablesFolder
		else
			-- fallback during facility build (cables folder not assigned yet):
			-- keep the beam under the device model so it still renders in-world
			local modelA = session.deviceModels[devAId]
			if modelA ~= nil then
				beam.Parent = modelA
			end
		end
	end

	session.cables[cableId] = {
		cableId = cableId,
		aDeviceId = devAId,
		aPortId = portAId,
		bDeviceId = devBId,
		bPortId = portBId,
		color = cableColor,
		beam = beam,
	}

	NetworkGraph.UpdateDeviceLED(session, devAId)
	NetworkGraph.UpdateDeviceLED(session, devBId)
	return true, ""
end

-- Severs both ends of the cable attached to one port and destroys its beam.
function NetworkGraph.DisconnectPort(session: any, deviceId: string, portId: string): boolean
	local node = session.devices[deviceId]
	if node == nil then
		return false
	end
	local port = node.ports[portId]
	if port == nil or port.connectedToDeviceId == nil then
		return false
	end
	local peerId = port.connectedToDeviceId :: string
	local peerPortId = port.connectedToPortId :: string
	local peer = session.devices[peerId]

	-- destroy the cable record + beam
	for cableId, cable in pairs(session.cables) do
		local match = (cable.aDeviceId == deviceId and cable.aPortId == portId)
			or (cable.bDeviceId == deviceId and cable.bPortId == portId)
		if match then
			if cable.beam ~= nil then
				cable.beam:Destroy()
			end
			session.cables[cableId] = nil
			break
		end
	end

	port.connectedToDeviceId = nil
	port.connectedToPortId = nil
	port.cableColor = nil
	port.linkUp = false

	if peer ~= nil then
		local pport = peer.ports[peerPortId]
		if pport ~= nil then
			pport.connectedToDeviceId = nil
			pport.connectedToPortId = nil
			pport.cableColor = nil
			pport.linkUp = false
		end
		NetworkGraph.UpdateDeviceLED(session, peerId)
	end
	NetworkGraph.UpdateDeviceLED(session, deviceId)
	return true
end

---------------------------------------------------------------------
-- VLAN controls (Fase 2)
---------------------------------------------------------------------

--[[ Set a port VLAN (1..4094). Only non-Console ports are configurable.
	 Returns (ok, errorMessage). The simulation reads vlanId live, so no
	 re-link is needed: the next ping/traceroute sees the new isolation. ]]
function NetworkGraph.SetPortVlan(session: any, deviceId: string, portId: string, vlanId: number): (boolean, string)
	local node = session.devices[deviceId]
	if node == nil then
		return false, "Device tidak ditemukan"
	end
	local port = node.ports[portId]
	if port == nil then
		return false, "Port tidak ditemukan"
	end
	if port.portType == "Console" then
		return false, "Port console tidak punya VLAN"
	end
	if type(vlanId) ~= "number" or vlanId ~= vlanId then
		return false, "VLAN harus angka"
	end
	local vlan = math.floor(vlanId)
	if vlan < 1 or vlan > 4094 then
		return false, "VLAN harus 1..4094"
	end
	port.vlanId = vlan
	return true, ""
end

--[[ Marks a non-Console port as an 802.1Q trunk (all VLANs pass) or back to
	 access mode. Returns (ok, errorMessage). ]]
function NetworkGraph.SetPortTrunk(session: any, deviceId: string, portId: string, enabled: boolean): (boolean, string)
	local node = session.devices[deviceId]
	if node == nil then
		return false, "Device tidak ditemukan"
	end
	local port = node.ports[portId]
	if port == nil then
		return false, "Port tidak ditemukan"
	end
	if port.portType == "Console" then
		return false, "Port console tidak bisa dijadikan trunk"
	end
	port.isTrunk = enabled == true
	return true, ""
end

--[[ The switch and port a device is physically plugged into, or nil when
	 the device has no cable to a switch (routers/ISP count separately). ]]
function NetworkGraph.GetAccessSwitchPort(session: any, deviceId: string): (any?, string?)
	local node = session.devices[deviceId]
	if node == nil then
		return nil, nil
	end
	for _, port in pairs(node.ports) do
		local peerId = port.connectedToDeviceId
		if peerId ~= nil then
			local peer = session.devices[peerId]
			local peerPortId = port.connectedToPortId
			if peer ~= nil and peer.deviceType == "Switch" and peerPortId ~= nil then
				return peer, peerPortId
			end
		end
	end
	return nil, nil
end

--[[ Deterministic "port eth1 VLAN 20" rows for the terminal/badges. ]]
function NetworkGraph.ListPortVlans(session: any, deviceId: string): { string }
	local node = session.devices[deviceId]
	if node == nil then
		return { "Device tidak ditemukan" }
	end
	local ids: { string } = {}
	for portId in pairs(node.ports) do
		table.insert(ids, portId)
	end
	table.sort(ids)
	local lines: { string } = {}
	for _, portId in ipairs(ids) do
		local port = node.ports[portId]
		local state = if port.connectedToDeviceId ~= nil then "UP" else "down"
		local mode = if port.isTrunk == true then "TRUNK" else string.format("VLAN %d", port.vlanId)
		table.insert(lines, string.format("%s  %s  %s", portId, mode, state))
	end
	if #lines == 0 then
		return { "Tidak ada port" }
	end
	return lines
end

---------------------------------------------------------------------
-- Lookup helpers
---------------------------------------------------------------------

-- First device whose ip matches (nil when none).
function NetworkGraph.FindDeviceByIP(session: any, ip: string): any?
	for _, node in pairs(session.devices) do
		if node.ip == ip then
			return node
		end
	end
	return nil
end

-- True when another device (different id) already uses the ip.
function NetworkGraph.IsIPUsedByOther(session: any, ip: string, exceptId: string): boolean
	for id, node in pairs(session.devices) do
		if id ~= exceptId and node.ip == ip then
			return true
		end
	end
	return false
end

---------------------------------------------------------------------
-- BFS reachability
---------------------------------------------------------------------

-- Sort key for stable port ordering: wan -> eth -> sfp, then numeric suffix.
local function portSortKey(portId: string): (number, number)
	local prefix = string.match(portId, "^[a-zA-Z]+") or ""
	local num = tonumber(string.match(portId, "%d+") or "") or 0
	local order = 4
	if prefix == "wan" then
		order = 1
	elseif prefix == "eth" then
		order = 2
	elseif prefix == "sfp" then
		order = 3
	end
	return order, num
end

-- Deterministic port id list for a node.
local function sortedPortIds(node: any): { string }
	local ids: { string } = {}
	for portId in pairs(node.ports) do
		table.insert(ids, portId)
	end
	table.sort(ids, function(a, b)
		local oa, na = portSortKey(a)
		local ob, nb = portSortKey(b)
		if oa ~= ob then
			return oa < ob
		end
		return na < nb
	end)
	return ids
end

-- First free non-Console port id of a node whose type is compatible with
-- wantedType (RJ45 <-> SFP counts as compatible), or nil.
local function firstCompatibleFreePortId(node: any, wantedType: string): string?
	for _, portId in ipairs(sortedPortIds(node)) do
		local port = node.ports[portId]
		if port.portType ~= "Console" and port.connectedToDeviceId == nil then
			local compatible = port.portType == wantedType
				or (port.portType == "RJ45" and wantedType == "SFP")
				or (port.portType == "SFP" and wantedType == "RJ45")
			if compatible then
				return portId
			end
		end
	end
	return nil
end

-- All free non-Console port ids of a node, in deterministic order.
local function freePortIds(node: any): { string }
	local out: { string } = {}
	for _, portId in ipairs(sortedPortIds(node)) do
		local port = node.ports[portId]
		if port.portType ~= "Console" and port.connectedToDeviceId == nil then
			table.insert(out, portId)
		end
	end
	return out
end

--[[
	BFS over linkUp edges from sourceDeviceId to targetId.
	Returns (path including both endpoints | nil, stormDetected).
	Rules:
	- unpowered devices never forward packets (skipped as intermediates)
	- passing THROUGH a switch requires in-port vlanId == out-port vlanId
	  (Fase 1: all ports default to vlan 1)
	- reaching an already-visited node over a non-tree edge means a physical
	  loop exists in the topology -> broadcast storm flag
]]
local function bfsPath(session: any, sourceDeviceId: string, targetId: string): ({ string }?, boolean)
	local visited: { [string]: boolean } = {}
	local parent: { [string]: string } = {} -- childId -> parentId
	local parentPort: { [string]: string } = {} -- childId -> port on the child used to reach its parent
	local queue: { { id: string, inPortId: string? } } = { { id = sourceDeviceId, inPortId = nil } }
	local head = 1
	local storm = false
	visited[sourceDeviceId] = true

	while queue[head] ~= nil do
		local current = queue[head]
		head += 1
		if current.id == targetId then
			-- reconstruct the path source -> ... -> target
			local path: { string } = {}
			local walk: string? = current.id
			while walk ~= nil do
				table.insert(path, 1, walk)
				if walk == sourceDeviceId then
					break
				end
				walk = parent[walk]
			end
			return path, storm
		end
		local node = session.devices[current.id]
		if node == nil then
			continue
		end
		for _, portId in ipairs(sortedPortIds(node)) do
			local port = node.ports[portId]
			if not port.linkUp or port.connectedToDeviceId == nil then
				continue
			end
			-- VLAN isolation while forwarding through a switch (and through a
			-- router whose inter-VLAN routing is disabled). Routers route
			-- between VLANs at L3, so they bridge VLANs by design.
			local isolates = node.deviceType == "Switch"
				or (node.deviceType == "Router" and node.interVlanRouting == false)
			if isolates and current.inPortId ~= nil then
				local inPort = node.ports[current.inPortId]
				local trunked = (inPort ~= nil and inPort.isTrunk == true) or port.isTrunk == true
				if inPort ~= nil and inPort.vlanId ~= port.vlanId and not trunked then
					continue
				end
			end
			local nextId = port.connectedToDeviceId :: string
			local nextNode = session.devices[nextId]
			if nextNode == nil then
				continue
			end
			if visited[nextId] then
				-- non-tree edge => topology loop => broadcast storm
				local isTreeEdge = parent[current.id] == nextId and parentPort[current.id] == portId
				if not isTreeEdge then
					storm = true
				end
				continue
			end
			if not nextNode.isPowered then
				continue -- unpowered devices do not forward
			end
			visited[nextId] = true
			parent[nextId] = current.id
			-- remember the port on the CHILD through which it was discovered,
			-- so the tree edge can be recognized when the child is expanded
			parentPort[nextId] = port.connectedToPortId or portId
			table.insert(queue, { id = nextId, inPortId = port.connectedToPortId })
		end
	end
	return nil, storm
end

--[[
	CanReachIP(session, sourceDeviceId, targetIP) -> (reachable, latencyMs, err)
	sourceDeviceId == "__laptop__" = the laptop Wi-Fi management bridge
	(PlotConstants.LAPTOP_BRIDGE_IP): any powered device with an ip is
	reachable, public IPs go through the ISP (higher latency).
	Public targets (non-RFC1918) are reachable by reaching the isp_uplink.
	Ping to self = 0.1 ms. Sets session.broadcastStorm on topology loops.
]]
function NetworkGraph.CanReachIP(session: any, sourceDeviceId: string, targetIP: string): (boolean, number, string)
	session.broadcastStorm = false

	if not NetworkUtils.IsValidIPv4(targetIP) then
		return false, 0, "ping: invalid IP address"
	end

	-- Laptop management bridge (Disconnected terminal mode)
	if sourceDeviceId == "__laptop__" then
		if targetIP == PlotConstants.LAPTOP_BRIDGE_IP then
			return false, 0, "Destination Host Unreachable (bridge laptop sendiri)"
		end
		local target = NetworkGraph.FindDeviceByIP(session, targetIP)
		if target ~= nil then
			if target.isPowered then
				return true, math.random(2, 6) + math.random(), ""
			end
			return false, 0, "Destination Host Unreachable (device mati)"
		end
		if not NetworkUtils.IsPrivateIP(targetIP) then
			return true, math.random(12, 25) + math.random(), ""
		end
		return false, 0, "Destination Host Unreachable"
	end

	local src = session.devices[sourceDeviceId]
	if src == nil then
		return false, 0, "Device sumber tidak ditemukan"
	end
	if not src.isPowered then
		return false, 0, "Destination Host Unreachable (device mati)"
	end
	if src.ip == targetIP then
		return true, 0.1, "" -- ping to self
	end

	local targetNode = NetworkGraph.FindDeviceByIP(session, targetIP)
	local isPublic = not NetworkUtils.IsPrivateIP(targetIP)
	if targetNode ~= nil and not targetNode.isPowered then
		return false, 0, "Destination Host Unreachable (device mati)"
	end
	if targetNode == nil and not isPublic then
		return false, 0, "Destination Host Unreachable"
	end
	local targetId: string
	if targetNode ~= nil then
		targetId = targetNode.id
	elseif session.devices[ISP_UPLINK_ID] ~= nil then
		targetId = ISP_UPLINK_ID -- public target: reaching the ISP uplink is enough
	else
		return false, 0, "Network is unreachable"
	end

	local path, storm = bfsPath(session, sourceDeviceId, targetId)
	if storm then
		session.broadcastStorm = true
	end
	if path == nil then
		local err: string
		if storm then
			err = "Request timed out (packet loss 95% - broadcast storm)"
		elseif isPublic then
			err = "Network is unreachable"
		else
			err = "Destination Host Unreachable"
		end
		return false, 0, err
	end

	-- latency grows with hop count; leaving the lab adds WAN latency
	local hops = #path - 1
	local latency = hops * 1.2 + 0.3 + math.random() * 1.8
	if targetNode == nil then
		latency += 12
	end
	return true, math.floor(latency * 100) / 100, ""
end

--[[
	GetRoutePath(session, sourceDeviceId, targetIP) -> {deviceIds}?
	BFS path including both endpoints, or nil when unreachable.
	Public targets route to the isp_uplink junction.
]]
function NetworkGraph.GetRoutePath(session: any, sourceDeviceId: string, targetIP: string): { string }?
	if not NetworkUtils.IsValidIPv4(targetIP) then
		return nil
	end
	local src = session.devices[sourceDeviceId]
	if src == nil or not src.isPowered then
		return nil
	end
	if src.ip == targetIP then
		return { sourceDeviceId }
	end
	local targetNode = NetworkGraph.FindDeviceByIP(session, targetIP)
	local isPublic = not NetworkUtils.IsPrivateIP(targetIP)
	if targetNode ~= nil and not targetNode.isPowered then
		return nil
	end
	if targetNode == nil and not isPublic then
		return nil
	end
	local targetId: string
	if targetNode ~= nil then
		targetId = targetNode.id
	elseif session.devices[ISP_UPLINK_ID] ~= nil then
		targetId = ISP_UPLINK_ID
	else
		return nil
	end
	local path = bfsPath(session, sourceDeviceId, targetId)
	return path
end

---------------------------------------------------------------------
-- Auto cabling
---------------------------------------------------------------------

--[[
	AutoCable(session, deviceId): connect the new device to the nearest
	device (<= 60 studs) that still has a free non-Console port; fall back
	to the starter switch sw_main_1. isp_uplink is never a candidate.
	Caller skips this when session.loadedFromSave (links are restored
	explicitly by the persistence layer).
]]
function NetworkGraph.AutoCable(session: any, deviceId: string)
	local node = session.devices[deviceId]
	if node == nil then
		return
	end
	local selfModel = session.deviceModels[deviceId]
	if selfModel == nil then
		return
	end
	local selfFreePorts = freePortIds(node)
	if #selfFreePorts == 0 then
		return
	end
	local selfPos = selfModel:GetPivot().Position

	local bestId: string? = nil
	local bestSelfPortId: string? = nil
	local bestPeerPortId: string? = nil
	local bestDist = AUTO_CABLE_RANGE
	for id, other in pairs(session.devices) do
		if id == deviceId or id == ISP_UPLINK_ID then
			continue
		end
		-- find a (self port, peer port) pair whose types are compatible,
		-- otherwise ConnectPorts would reject the link
		local chosenSelf: string? = nil
		local chosenPeer: string? = nil
		for _, selfPortId in ipairs(selfFreePorts) do
			local peerPortId = firstCompatibleFreePortId(other, node.ports[selfPortId].portType)
			if peerPortId ~= nil then
				chosenSelf = selfPortId
				chosenPeer = peerPortId
				break
			end
		end
		if chosenPeer == nil then
			continue
		end
		local model = session.deviceModels[id]
		if model ~= nil then
			local dist = (model:GetPivot().Position - selfPos).Magnitude
			if dist <= bestDist then
				bestDist = dist
				bestId = id
				bestSelfPortId = chosenSelf
				bestPeerPortId = chosenPeer
			end
		end
	end

	-- fallback: the starter main switch (never connect a device to itself)
	if bestId == nil then
		local sw = session.devices[FALLBACK_SWITCH_ID]
		if sw ~= nil and deviceId ~= FALLBACK_SWITCH_ID then
			for _, selfPortId in ipairs(selfFreePorts) do
				local peerPortId = firstCompatibleFreePortId(sw, node.ports[selfPortId].portType)
				if peerPortId ~= nil then
					bestId = FALLBACK_SWITCH_ID
					bestSelfPortId = selfPortId
					bestPeerPortId = peerPortId
					break
				end
			end
		end
	end
	if bestId == nil or bestSelfPortId == nil or bestPeerPortId == nil then
		return
	end

	NetworkGraph.ConnectPorts(session, deviceId, bestSelfPortId :: string, bestId :: string, bestPeerPortId :: string, "LAN_Blue")
end

return NetworkGraph
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX18">
<Properties>
<string name="Name">CommandExecutor</string>
<ProtectedString name="Source"><![CDATA[--!strict
--[[
	CommandExecutor (ModuleScript, ServerScriptService/Core)
	Server-side handler of the terminal. Binds ExecuteCommand.OnServerInvoke
	(CONTRACT section 3) and implements the Fase 1 + Fase 2 CLI:
		help, clear, ping, traceroute, ip a/addr/set, ssh, exit, top,
		vm create/list/throttle/delete, install-os, stress-test, ship,
		vlan list/set/trunk, switch port <p> vlan|trunk, cable
		list/use/buy/cut, mount list/<rackId>.
	Terminal context: Disconnected mode runs against the laptop management
	bridge ("__laptop__"); LocalConsole / RemoteSSH run against
	session.terminal.targetDeviceId.
	Every user-derived string is escaped with NetworkUtils.EscapeRich before
	it is embedded into RichText output. Async commands (install-os,
	stress-test) complete after a task.delay and push their result lines via
	TerminalPushOutput, plus the "cash" SFX through PlaySFXRemote.
]]

local CommandExecutor = {}

---------------------------------------------------------------------
-- Injected dependencies (set in Init)
---------------------------------------------------------------------

local Sessions: any = nil -- SessionManager module
local Graph: any = nil -- NetworkGraph module
local Utils: any = nil -- NetworkUtils module
local Catalog: any = nil -- HardwareCatalog module (kept for future expansion)
local Constants: any = nil -- PlotConstants module
local Workbench: any = nil -- WorkbenchBuilderSystem module (bench state lives on session)
local Cabling: any = nil -- RackAndCablingSystem module (DetachConsole)
local Placement: any = nil -- PlacementSystem module (cable spool purchase, mount)
local Carry: any = nil -- CarryAndMountSystem module (colocation crate)
local Remotes: any = nil -- ReplicatedStorage.Remotes folder

---------------------------------------------------------------------
-- RichText palette (CONTRACT: green #00FF66, blue #58A6FF, red #FF5555,
-- grey #8B949E) and small formatting helpers
---------------------------------------------------------------------

local HEX_GREEN = "#00FF66"
local HEX_BLUE = "#58A6FF"
local HEX_RED = "#FF5555"
local HEX_GREY = "#8B949E"

local function rich(hex: string, text: string): string
	local payload = text
	if Utils ~= nil then
		payload = Utils.EscapeRich(text)
	end
	return string.format('<font color="%s">%s</font>', hex, payload)
end

local function g(text: string): string -- green
	return rich(HEX_GREEN, text)
end

local function b(text: string): string -- blue
	return rich(HEX_BLUE, text)
end

local function r(text: string): string -- red
	return rich(HEX_RED, text)
end

local function gr(text: string): string -- grey
	return rich(HEX_GREY, text)
end

-- Left-pad text to a fixed width (terminal font is monospace).
local function pad(text: string, width: number): string
	if #text >= width then
		return text
	end
	return text .. string.rep(" ", width - #text)
end

-- Compact numeric formatting (no trailing ".0").
local function num(value: number): string
	return string.format("%g", value)
end

-- Sort key for stable port ordering: wan -> eth -> sfp, then numeric suffix.
local function portSortKey(portId: string): (number, number)
	local prefix = string.match(portId, "^[a-zA-Z]+") or ""
	local numPart = tonumber(string.match(portId, "%d+") or "") or 0
	local order = 4
	if prefix == "wan" then
		order = 1
	elseif prefix == "eth" then
		order = 2
	elseif prefix == "sfp" then
		order = 3
	end
	return order, numPart
end

local function sortedPortIds(node: any): { string }
	local ids: { string } = {}
	for portId in pairs(node.ports) do
		table.insert(ids, portId)
	end
	table.sort(ids, function(a, b)
		local oa, na = portSortKey(a)
		local ob, nb = portSortKey(b)
		if oa ~= ob then
			return oa < ob
		end
		return na < nb
	end)
	return ids
end

-- Value of "--flag <value>" in the token list, or nil.
local function parseFlag(tokens: { string }, flag: string): string?
	for i = 2, #tokens - 1 do
		if tokens[i] == flag then
			return tokens[i + 1]
		end
	end
	return nil
end

---------------------------------------------------------------------
-- Terminal context helpers
---------------------------------------------------------------------

-- Resolve the current source: "__laptop__" for Disconnected mode, otherwise
-- the target device id. Returns (sourceId, errorLine?).
local function resolveSource(session: any): (string, string?)
	local mode = session.terminal.mode
	if mode == "Disconnected" then
		return "__laptop__", nil
	end
	local targetId = session.terminal.targetDeviceId
	if targetId == nil then
		return "", "Not connected"
	end
	if session.devices[targetId] == nil then
		return "", "Not connected: device tidak ditemukan"
	end
	return targetId, nil
end

-- Commands that inspect/mutate a device require console or SSH context.
-- Returns (node, errorLine?).
local function requireDevice(session: any, commandName: string): (any, string?)
	if session.terminal.mode == "Disconnected" then
		return nil, commandName .. ": belum terhubung ke device (attach console / ssh <ip> dulu)"
	end
	local targetId = session.terminal.targetDeviceId
	local node = if targetId ~= nil then session.devices[targetId] else nil
	if node == nil then
		return nil, commandName .. ": Not connected"
	end
	return node, nil
end

-- Keep the client's terminal top bar in sync with the session mode
-- (CONTRACT section 3 OpenTerminalEvent {action="open", mode, ...}).
local function notifyMode(session: any, mode: string, device: any)
	local openRemote = if Remotes ~= nil then Remotes:FindFirstChild("OpenTerminalEvent") else nil
	if openRemote == nil then
		return
	end
	if device ~= nil then
		openRemote:FireClient(session.player, {
			action = "open",
			mode = mode,
			deviceName = device.name,
			deviceId = device.id,
		})
	else
		openRemote:FireClient(session.player, {
			action = "open",
			mode = mode,
			deviceName = "Technician Laptop",
			deviceId = "__laptop__",
		})
	end
end

---------------------------------------------------------------------
-- Commands
---------------------------------------------------------------------

local function cmdHelp(): { string }
	local lines: { string } = {}
	table.insert(lines, b("=== NETSIM SHELL - DAFTAR PERINTAH ==="))
	table.insert(lines, b("-- Jaringan --"))
	table.insert(lines, "  " .. g("ping <ip>") .. gr("                  uji koneksi (4 packet ICMP)"))
	table.insert(lines, "  " .. g("traceroute <ip>") .. gr("              telusuri rute hop-per-hop"))
	table.insert(lines, "  " .. g("vlan list") .. gr("                    VLAN tiap port switch/router aktif"))
	table.insert(lines, "  " .. g("vlan set <port> <id>") .. gr("        set VLAN port (contoh: vlan set eth2 20)"))
	table.insert(lines, "  " .. g("switch port <port> vlan <id>") .. gr("  alias VLAN untuk port switch"))
	table.insert(lines, "  " .. g("switch port <port> trunk on") .. gr("    trunk 802.1Q (semua VLAN lewat)"))
	table.insert(lines, b("-- Kabel (Fase 2) --"))
	table.insert(lines, "  " .. g("cable") .. gr("                        stok spool + warna aktif"))
	table.insert(lines, "  " .. g("cable use <warna>") .. gr("            LAN_Blue | WAN_Yellow | Mgmt_Red"))
	table.insert(lines, "  " .. g("cable buy <warna>") .. gr("            beli 1 spool (5 kabel)"))
	table.insert(lines, "  " .. g("cable cut <port>") .. gr("             potong kabel di port device aktif"))
	table.insert(lines, b("-- Colocation (Fase 2) --"))
	table.insert(lines, "  " .. g("mount list") .. gr("                   rack + sisa slot U"))
	table.insert(lines, "  " .. g("mount [rackId]") .. gr("               pasang crate yang sedang dibawa"))
	table.insert(lines, b("-- Interface --"))
	table.insert(lines, "  " .. g("ip a | ip addr") .. gr("                info hostname, IP, mask, gateway, port"))
	table.insert(lines, "  " .. g("ip set <ip> <gw> [mask]") .. gr("      set IP statis device aktif"))
	table.insert(lines, b("-- Remote --"))
	table.insert(lines, "  " .. g("ssh <ip>") .. gr("                      SSH ke device via management bridge / LAN"))
	table.insert(lines, "  " .. g("exit") .. gr("                         keluar dari ssh / lepas console"))
	table.insert(lines, b("-- Sistem --"))
	table.insert(lines, "  " .. g("top") .. gr("                          monitor CPU/RAM/temp host aktif"))
	table.insert(lines, "  " .. g("install-os <os>") .. gr("              ubuntu-22.04 | debian-12 | rocky-9"))
	table.insert(lines, "  " .. g("stress-test") .. gr("                   burn-in 5 detik (validasi thermal)"))
	table.insert(lines, "  " .. g("ship") .. gr("                          kirim custom server workbench ke dock"))
	table.insert(lines, b("-- VM --"))
	table.insert(lines, "  " .. g("vm create --name <n> --cpu <n> --ram <n> --disk <n>"))
	table.insert(lines, "  " .. g("vm list") .. gr("                       daftar VM di host aktif"))
	table.insert(lines, "  " .. g("vm throttle <name> --limit <pct>") .. gr("   batasi CPU VM (5-100)"))
	table.insert(lines, "  " .. g("vm delete <name>") .. gr("              hapus VM, resource kembali ke host"))
	table.insert(lines, b("-- Terminal --"))
	table.insert(lines, "  " .. g("clear") .. gr("                        bersihkan layar"))
	table.insert(lines, "  " .. g("help") .. gr("                         daftar ini"))
	return lines
end

local function cmdPing(session: any, tokens: { string }): { string }
	local targetIP = tokens[2]
	if targetIP == nil then
		return { r("ping: usage: ping <ip>") }
	end
	local sourceId, err = resolveSource(session)
	if err ~= nil then
		return { r(err) }
	end
	local reachable, latency, errMsg = Graph.CanReachIP(session, sourceId, targetIP)
	if not reachable then
		return { r(errMsg) }
	end
	-- objective flag: starter bare-metal successfully pings the gateway router
	if sourceId == "bm_starter_1" and targetIP == "192.168.1.1" then
		session.flags.pingGateway = true
	end
	local lines: { string } = {}
	table.insert(lines, gr("PING " .. targetIP .. " (" .. targetIP .. ") 56(84) bytes of data."))
	for i = 1, 4 do
		local t = latency + (math.random() - 0.5) * 0.4
		if t < 0.05 then
			t = 0.05
		end
		table.insert(lines, g(string.format("64 bytes from %s: icmp_seq=%d ttl=64 time=%.2f ms", targetIP, i, t)))
	end
	table.insert(
		lines,
		gr(string.format("--- %s ping statistics --- 4 packets transmitted, 4 received, 0%% packet loss", targetIP))
	)
	if session.broadcastStorm then
		table.insert(lines, r("PERINGATAN: broadcast storm terdeteksi (ada loop di topology)"))
	end
	return lines
end

local function cmdTraceroute(session: any, tokens: { string }): { string }
	local targetIP = tokens[2]
	if targetIP == nil then
		return { r("traceroute: usage: traceroute <ip>") }
	end
	local sourceId, err = resolveSource(session)
	if err ~= nil then
		return { r(err) }
	end

	local path: { string }? = nil
	if sourceId == "__laptop__" then
		-- the management bridge has no graph node: synthesize a 2-hop path
		local reachable, _, reachErr = Graph.CanReachIP(session, sourceId, targetIP)
		if not reachable then
			return { r(reachErr) }
		end
		local targetNode = Graph.FindDeviceByIP(session, targetIP)
		if targetNode ~= nil then
			path = { "__laptop__", targetNode.id }
		else
			path = { "__laptop__", "isp_uplink" }
		end
	else
		path = Graph.GetRoutePath(session, sourceId, targetIP)
	end
	if path == nil or #path < 2 then
		return { r("traceroute: no route to host") }
	end

	local lines: { string } = {}
	table.insert(lines, gr("traceroute ke " .. targetIP .. ", " .. num(#path - 1) .. " hop:"))
	local cumulative = 0
	for i = 2, #path do
		local nodeId = path[i]
		local node = session.devices[nodeId]
		local name = if node ~= nil then node.name else nodeId
		local ipDisplay = if node ~= nil and node.ip ~= nil then node.ip else "--"
		cumulative += 0.8 + math.random() * 1.4
		if node == nil or node.ip == nil then
			cumulative += 8 + math.random() * 6 -- WAN-side latency
		end
		table.insert(
			lines,
			gr(string.format("  %d  ", i - 1))
				.. g(name)
				.. gr(" (" .. ipDisplay .. ")  ")
				.. b(string.format("%.2f ms", cumulative))
		)
	end
	return lines
end

local function cmdIpAddr(session: any): { string }
	if session.terminal.mode == "Disconnected" then
		-- laptop itself: only the management bridge
		local lines: { string } = {}
		table.insert(lines, b("hostname:  ") .. g("technician-laptop"))
		table.insert(lines, b("inet:      ") .. g(Constants.LAPTOP_BRIDGE_IP .. "/24") .. gr("  (management bridge Wi-Fi)"))
		table.insert(lines, b("gateway:   ") .. gr("--"))
		table.insert(lines, gr("--- ports ---"))
		table.insert(lines, "  " .. g("wifi0") .. "  " .. g("UP") .. "    " .. gr("vlan 1  peer --"))
		table.insert(lines, gr("hint: klik port console device ('Connect Console Cable') untuk akses console"))
		return lines
	end
	local node, err = requireDevice(session, "ip a")
	if err ~= nil then
		return { r(err) }
	end
	local lines: { string } = {}
	table.insert(lines, b("hostname:  ") .. g(node.name) .. gr("  (" .. node.deviceType .. ")"))
	if node.ip ~= nil then
		table.insert(
			lines,
			b("inet:      ")
				.. g(string.format("%s/%d", node.ip, Utils.MaskToPrefix(node.subnetMask)))
				.. gr("  mask " .. node.subnetMask)
		)
		table.insert(lines, b("gateway:   ") .. g(node.gateway or "--"))
	else
		table.insert(lines, b("inet:      ") .. r("-- belum di-set") .. gr("  (ip set <ip> <gw>)"))
		table.insert(lines, b("gateway:   ") .. gr("--"))
	end
	table.insert(lines, b("vlan:      ") .. g(num(node.defaultVlan)))
	table.insert(lines, b("temp:      ") .. g(string.format("%.1fC", node.temperatureC)))
	table.insert(lines, gr("--- ports ---"))
	for _, portId in ipairs(sortedPortIds(node)) do
		local port = node.ports[portId]
		local state = if port.linkUp then g("UP") else gr("DOWN")
		local peerName = "--"
		if port.connectedToDeviceId ~= nil then
			local peer = session.devices[port.connectedToDeviceId]
			peerName = if peer ~= nil then peer.name else (port.connectedToDeviceId :: string)
		end
		table.insert(
			lines,
			"  "
				.. g(portId)
				.. "  "
				.. state
				.. "  "
				.. gr(string.format("vlan %d  peer %s", port.vlanId, peerName))
		)
	end
	return lines
end

local function cmdIpSet(session: any, tokens: { string }): { string }
	local node, err = requireDevice(session, "ip set")
	if err ~= nil then
		return { r(err) }
	end
	-- tokens: { "ip", "set", ip, gateway, [mask] }
	local ip = tokens[3]
	local gateway = tokens[4]
	local mask = tokens[5] or "255.255.255.0"
	if ip == nil or gateway == nil then
		return { r("ip set: usage: ip set <ip> <gateway> [mask]") }
	end
	if not Utils.IsValidIPv4(ip) then
		return { r("ip set: invalid IPv4 address: " .. ip) }
	end
	if not Utils.IsValidIPv4(gateway) then
		return { r("ip set: invalid gateway IPv4: " .. gateway) }
	end
	if not Utils.IsValidIPv4(mask) then
		return { r("ip set: invalid subnet mask: " .. mask) }
	end
	if not Utils.IsSameSubnet(ip, gateway, mask) then
		return { r("Gateway not in subnet") }
	end
	if ip == Constants.LAPTOP_BRIDGE_IP then
		return { r("IP conflict: " .. ip .. " dipakai bridge laptop") }
	end
	if Graph.IsIPUsedByOther(session, ip, node.id) then
		local holder = Graph.FindDeviceByIP(session, ip)
		local holderName = if holder ~= nil then holder.name else "?"
		return { r("IP conflict: " .. ip .. " sudah dipakai " .. holderName) }
	end
	node.ip = ip
	node.gateway = gateway
	node.subnetMask = mask
	local lines: { string } = {}
	table.insert(lines, g(string.format("IP configured: %s/%d", ip, Utils.MaskToPrefix(mask))))
	table.insert(lines, gr("gateway " .. gateway .. " | device " .. node.name))
	return lines
end

local function cmdIp(session: any, tokens: { string }): { string }
	local sub = string.lower(tokens[2] or "")
	if sub == "a" or sub == "addr" then
		return cmdIpAddr(session)
	elseif sub == "set" then
		return cmdIpSet(session, tokens)
	end
	return { r("ip: usage: ip a | ip addr | ip set <ip> <gateway> [mask]") }
end

local function cmdSsh(session: any, tokens: { string }): { string }
	local targetIP = tokens[2]
	if targetIP == nil then
		return { r("ssh: usage: ssh <ip>") }
	end
	local term = session.terminal
	local targetNode: any = nil

	if term.mode == "Disconnected" then
		-- laptop management bridge: device must exist, be powered and have an ip
		targetNode = Graph.FindDeviceByIP(session, targetIP)
		if targetNode == nil then
			return { r("ssh: connect to host " .. targetIP .. " port 22: No route to host") }
		end
		if not targetNode.isPowered then
			return { r("ssh: connect to host " .. targetIP .. " port 22: Connection refused (device mati)") }
		end
	else
		local sourceId, err = resolveSource(session)
		if err ~= nil then
			return { r(err) }
		end
		targetNode = Graph.FindDeviceByIP(session, targetIP)
		if targetNode == nil then
			return { r("ssh: connect to host " .. targetIP .. " port 22: No route to host") }
		end
		if targetNode.id == sourceId then
			return { r("ssh: sudah berada di device ini") }
		end
		local reachable, _, reachErr = Graph.CanReachIP(session, sourceId, targetIP)
		if not reachable then
			return { r("ssh: connect to host " .. targetIP .. " port 22: " .. reachErr) }
		end
	end

	-- push the SSH chain; from the console, remember it first via the sentinel
	if term.mode == "LocalConsole" and term.sshStack[#term.sshStack] ~= "__console__" then
		table.insert(term.sshStack, "__console__")
	end
	table.insert(term.sshStack, targetNode.id)
	term.mode = "RemoteSSH"
	term.targetDeviceId = targetNode.id
	notifyMode(session, "RemoteSSH", targetNode)

	local lines: { string } = {}
	table.insert(lines, b("SSH session established -> ") .. g(targetNode.name) .. gr(" (" .. (targetNode.ip or "?") .. ")"))
	table.insert(lines, gr("ketik 'exit' untuk kembali"))
	return lines
end

local function cmdExit(session: any): { string }
	local term = session.terminal
	if term.mode == "Disconnected" then
		return { gr("Sudah di local shell (laptop).") }
	end
	if term.mode == "LocalConsole" then
		-- detach the physical console cable (RackAndCablingSystem notifies client)
		if Cabling ~= nil and Cabling.DetachConsole ~= nil then
			Cabling.DetachConsole(session, session.player, true)
		end
		return { gr("Console cable detached.") }
	end

	-- RemoteSSH: pop one level of the SSH stack
	table.remove(term.sshStack)
	local top = term.sshStack[#term.sshStack]
	if top == "__console__" and session.consoleLink ~= nil and session.devices[session.consoleLink.deviceId] ~= nil then
		table.remove(term.sshStack) -- consume the sentinel
		local consoleNode = session.devices[session.consoleLink.deviceId]
		term.mode = "LocalConsole"
		term.targetDeviceId = consoleNode.id
		notifyMode(session, "LocalConsole", consoleNode)
		return { gr("Kembali ke console ") .. g(consoleNode.name) }
	elseif top ~= nil and session.devices[top] ~= nil then
		term.mode = "RemoteSSH"
		term.targetDeviceId = top
		local node = session.devices[top]
		notifyMode(session, "RemoteSSH", node)
		return { gr("Kembali ke ") .. g(node.name) .. gr(" (" .. (node.ip or "?") .. ")") }
	else
		term.mode = "Disconnected"
		term.targetDeviceId = nil
		term.sshStack = {}
		notifyMode(session, "Disconnected", nil)
		return { gr("Kembali ke local shell (laptop).") }
	end
end

local function cmdTop(session: any): { string }
	local node, err = requireDevice(session, "top")
	if err ~= nil then
		return { r(err) }
	end
	local specs = node.specs
	local cpuUsed, ramUsed, diskUsed = 0, 0, 0
	for _, vm in pairs(node.vms) do
		cpuUsed += vm.cpu * (vm.currentLoadPercent or 0) / 100
		ramUsed += vm.ram
		diskUsed += vm.disk
	end
	local cpuPct = 0
	if specs.cpu > 0 then
		cpuPct = cpuUsed / specs.cpu * 100
	end
	local lines: { string } = {}
	table.insert(lines, b("top - ") .. g(node.name) .. gr("  (" .. node.deviceType .. ")"))
	table.insert(
		lines,
		b("cpu:  ")
			.. g(string.format("%.1f/%s vCPU (%.1f%%)", cpuUsed, num(specs.cpu), cpuPct))
			.. gr("   ")
			.. b("ram:  ")
			.. g(string.format("%s/%s GB", num(ramUsed), num(specs.ram)))
			.. gr("   ")
			.. b("disk: ")
			.. g(string.format("%s/%s GB", num(diskUsed), num(specs.disk)))
	)
	table.insert(lines, b("temp: ") .. g(string.format("%.1fC", node.temperatureC)) .. gr("   ") .. b("power: ") .. g(num(specs.powerWatts) .. "W"))
	if node.isUnderDDoS then
		table.insert(lines, r("[DDoS] UNDER ATTACK from " .. (node.ddosAttackerIp or "unknown")))
	end
	if next(node.vms) == nil then
		table.insert(lines, gr("  (belum ada VM - coba: vm create --name web-1 --cpu 2 --ram 4 --disk 50)"))
		return lines
	end
	table.insert(
		lines,
		gr(pad("NAME", 16) .. pad("CPU", 5) .. pad("RAM", 7) .. pad("DISK", 7) .. pad("IP", 12) .. pad("LOAD", 7) .. "STATUS")
	)
	local names: { string } = {}
	for name in pairs(node.vms) do
		table.insert(names, name)
	end
	table.sort(names)
	for _, name in ipairs(names) do
		local vm = node.vms[name]
		local ipDisplay = if vm.assignedIp ~= nil then vm.assignedIp else "--"
		local statusText = vm.status or "running"
		if vm.status == "throttled" then
			statusText = string.format("throttled(%s%%)", num(vm.cpuThrottlePercent or 100))
		end
		table.insert(
			lines,
			g(pad(name, 16))
				.. gr(
					pad(num(vm.cpu), 5)
						.. pad(num(vm.ram) .. "G", 7)
						.. pad(num(vm.disk) .. "G", 7)
						.. pad(ipDisplay, 12)
						.. pad(string.format("%.0f%%", vm.currentLoadPercent or 0), 7)
				)
				.. b(statusText)
		)
	end
	return lines
end

---------------------------------------------------------------------
-- vm commands
---------------------------------------------------------------------

local function requireBareMetal(session: any, commandName: string): (any, string?)
	local node, err = requireDevice(session, commandName)
	if err ~= nil then
		return nil, err
	end
	if node.deviceType ~= "BareMetal" then
		return nil, commandName .. ": device bukan BareMetal (" .. node.deviceType .. ")"
	end
	return node, nil
end

local function vmHeader(node: any): string
	return b("VMs on ") .. g(node.name) .. gr("  (" .. node.deviceType .. ")")
end

local function cmdVmCreate(session: any, tokens: { string }): { string }
	local node, err = requireBareMetal(session, "vm create")
	if err ~= nil then
		return { r(err) }
	end
	if node.osInstalled == nil then
		return { r("vm create: OS belum terinstall (install-os dulu)") }
	end
	if not node.isPowered then
		return { r("vm create: device mati (nyalakan dulu)") }
	end
	local name = parseFlag(tokens, "--name")
	local cpu = tonumber(parseFlag(tokens, "--cpu") or "")
	local ram = tonumber(parseFlag(tokens, "--ram") or "")
	local disk = tonumber(parseFlag(tokens, "--disk") or "")
	if name == nil or cpu == nil or ram == nil or disk == nil then
		return { r("vm create: usage: vm create --name <n> --cpu <n> --ram <n> --disk <n>") }
	end
	if cpu <= 0 or ram <= 0 or disk <= 0 then
		return { r("vm create: --cpu / --ram / --disk harus > 0") }
	end
	-- sanitize VM name: 1-16 chars of [A-Za-z0-9_-]
	if #name > 16 or string.match(name, "^[%w%-_]+$") == nil then
		return { r("vm create: nama VM invalid (1-16 huruf/angka/-/_): '" .. name .. "'") }
	end
	if node.vms[name] ~= nil then
		return { r("vm create: nama VM '" .. name .. "' sudah dipakai di host ini") }
	end
	-- capacity check against the host specs
	local usedCpu, usedRam, usedDisk = 0, 0, 0
	for _, vm in pairs(node.vms) do
		usedCpu += vm.cpu
		usedRam += vm.ram
		usedDisk += vm.disk
	end
	local specs = node.specs
	if usedCpu + cpu > specs.cpu then
		return { r(string.format("vm create: CPU penuh (%s/%s terpakai, diminta %s)", num(usedCpu), num(specs.cpu), num(cpu))) }
	end
	if usedRam + ram > specs.ram then
		return { r(string.format("vm create: RAM penuh (%s/%s GB terpakai, diminta %s GB)", num(usedRam), num(specs.ram), num(ram))) }
	end
	if usedDisk + disk > specs.disk then
		return { r(string.format("vm create: disk penuh (%s/%s GB terpakai, diminta %s GB)", num(usedDisk), num(specs.disk), num(disk))) }
	end
	-- assign an internal IP from the per-host counter (10.0.0.x)
	local nextIndex = (session.vmIpCounter[node.id] or 1) + 1
	while nextIndex < 254 and Graph.IsIPUsedByOther(session, Utils.GenerateInternalIP(nextIndex), node.id) do
		nextIndex += 1
	end
	session.vmIpCounter[node.id] = nextIndex
	local assignedIp = Utils.GenerateInternalIP(nextIndex)

	node.vms[name] = {
		name = name,
		cpu = cpu,
		ram = ram,
		disk = disk,
		assignedIp = assignedIp,
		cpuThrottlePercent = 100,
		currentLoadPercent = 0,
		status = "running",
	}
	-- no notification needed: the economy loop reads device state
	local lines: { string } = {}
	table.insert(lines, g(string.format("VM '%s' created on %s", name, node.name)))
	table.insert(lines, gr(string.format("allocated %s vCPU / %s GB RAM / %s GB disk", num(cpu), num(ram), num(disk))))
	table.insert(lines, b("assigned IP: ") .. g(assignedIp))
	return lines
end

local function cmdVmList(session: any): { string }
	local node, err = requireBareMetal(session, "vm list")
	if err ~= nil then
		return { r(err) }
	end
	if next(node.vms) == nil then
		return { gr("(kosong) Belum ada VM di " .. node.name) }
	end
	local lines: { string } = {}
	table.insert(lines, vmHeader(node))
	table.insert(
		lines,
		gr(pad("NAME", 16) .. pad("CPU", 5) .. pad("RAM", 7) .. pad("DISK", 7) .. pad("IP", 12) .. pad("LOAD", 7) .. "STATUS")
	)
	local names: { string } = {}
	for name in pairs(node.vms) do
		table.insert(names, name)
	end
	table.sort(names)
	for _, name in ipairs(names) do
		local vm = node.vms[name]
		local ipDisplay = if vm.assignedIp ~= nil then vm.assignedIp else "--"
		local statusText = vm.status or "running"
		if vm.status == "throttled" then
			statusText = string.format("throttled(%s%%)", num(vm.cpuThrottlePercent or 100))
		end
		table.insert(
			lines,
			g(pad(name, 16))
				.. gr(
					pad(num(vm.cpu), 5)
						.. pad(num(vm.ram) .. "G", 7)
						.. pad(num(vm.disk) .. "G", 7)
						.. pad(ipDisplay, 12)
						.. pad(string.format("%.0f%%", vm.currentLoadPercent or 0), 7)
				)
				.. b(statusText)
		)
	end
	return lines
end

local function cmdVmThrottle(session: any, tokens: { string }): { string }
	local node, err = requireBareMetal(session, "vm throttle")
	if err ~= nil then
		return { r(err) }
	end
	local name = tokens[3]
	local limitRaw = parseFlag(tokens, "--limit")
	if name == nil or limitRaw == nil then
		return { r("vm throttle: usage: vm throttle <name> --limit <pct>") }
	end
	local limit = tonumber(limitRaw)
	if limit == nil then
		return { r("vm throttle: limit harus angka (5-100)") }
	end
	limit = math.clamp(math.floor(limit + 0.5), 5, 100)
	local vm = node.vms[name]
	if vm == nil then
		return { r("vm throttle: VM '" .. name .. "' tidak ditemukan") }
	end
	vm.cpuThrottlePercent = limit
	vm.status = if limit < 100 then "throttled" else "running"
	return { g(string.format("VM '%s' throttle -> %s%%", name, num(limit))) .. gr("  (status: " .. vm.status .. ")") }
end

local function cmdVmDelete(session: any, tokens: { string }): { string }
	local node, err = requireBareMetal(session, "vm delete")
	if err ~= nil then
		return { r(err) }
	end
	local name = tokens[3]
	if name == nil then
		return { r("vm delete: usage: vm delete <name>") }
	end
	if node.vms[name] == nil then
		return { r("vm delete: VM '" .. name .. "' tidak ditemukan") }
	end
	node.vms[name] = nil
	return { g("VM '" .. name .. "' deleted, resource dikembalikan ke host") }
end

local function cmdVm(session: any, tokens: { string }): { string }
	local sub = string.lower(tokens[2] or "")
	if sub == "create" then
		return cmdVmCreate(session, tokens)
	elseif sub == "list" then
		return cmdVmList(session)
	elseif sub == "throttle" then
		return cmdVmThrottle(session, tokens)
	elseif sub == "delete" then
		return cmdVmDelete(session, tokens)
	end
	return { r("vm: usage: vm create | vm list | vm throttle <name> --limit <pct> | vm delete <name>") }
end

---------------------------------------------------------------------
-- install-os / stress-test (async, complete via TerminalPushOutput)
---------------------------------------------------------------------

local VALID_OS: { [string]: boolean } = {
	["ubuntu-22.04"] = true,
	["debian-12"] = true,
	["rocky-9"] = true,
}

local function pushLines(player: Player, lines: { string })
	local pushRemote = if Remotes ~= nil then Remotes:FindFirstChild("TerminalPushOutput") else nil
	if pushRemote ~= nil then
		pushRemote:FireClient(player, { lines = lines })
	end
end

local function playSfx(player: Player, name: string)
	local sfxRemote = if Remotes ~= nil then Remotes:FindFirstChild("PlaySFXRemote") else nil
	if sfxRemote ~= nil then
		sfxRemote:FireClient(player, name)
	end
end

local function cmdInstallOs(player: Player, session: any, tokens: { string }): { string }
	local node, err = requireBareMetal(session, "install-os")
	if err ~= nil then
		return { r(err) }
	end
	local osName = string.lower(tokens[2] or "")
	if not VALID_OS[osName] then
		return { r("install-os: pilih salah satu: install-os ubuntu-22.04 | debian-12 | rocky-9") }
	end
	local deviceId = node.id
	local guardKey = "installing_" .. deviceId
	if session.flags[guardKey] then
		return { r("install-os: instalasi sudah berjalan di " .. node.name) }
	end
	session.flags[guardKey] = true

	local lines: { string } = {}
	table.insert(lines, gr("install-os: installing " .. osName .. " on ") .. g(node.name) .. gr(" ..."))
	table.insert(lines, gr("[ 20%] retrieving packages ..."))
	table.insert(lines, gr("[ 55%] partitioning storage ..."))
	table.insert(lines, gr("[ 85%] writing bootloader ..."))

	-- finish asynchronously; guard against a deleted session / device
	task.delay(3, function()
		local liveSession = if Sessions ~= nil then Sessions.GetSession(player) else nil
		if liveSession ~= session then
			return -- player left or session was rebuilt
		end
		local liveNode = liveSession.devices[deviceId]
		if liveNode == nil then
			return -- device removed mid-install
		end
		liveSession.flags["installing_" .. deviceId] = nil
		liveNode.osInstalled = osName
		pushLines(player, {
			g("[ ok ] OS terinstall: " .. osName .. " on " .. liveNode.name),
			gr("Lanjut: vm create --name <n> --cpu <n> --ram <n> --disk <n>"),
		})
		playSfx(player, "cash")
	end)
	return lines
end

local function cmdStressTest(player: Player, session: any, _tokens: { string }): { string }
	local node, err = requireBareMetal(session, "stress-test")
	if err ~= nil then
		return { r(err) }
	end
	if node.osInstalled == nil then
		return { r("stress-test: OS belum terinstall (install-os dulu)") }
	end
	local deviceId = node.id
	local guardKey = "stress_" .. deviceId
	if session.flags[guardKey] then
		return { r("stress-test: sudah berjalan di " .. node.name) }
	end
	session.flags[guardKey] = true

	local lines: { string } = {}
	table.insert(lines, gr("stress-test: running burn-in on ") .. g(node.name) .. gr(" ..."))
	table.insert(lines, gr("  cpu: 100% semua core | ram sweep | nvme seq+rand"))
	table.insert(lines, gr("  hasil akan muncul dalam ±5 detik ..."))

	task.delay(5, function()
		local liveSession = if Sessions ~= nil then Sessions.GetSession(player) else nil
		if liveSession ~= session then
			return
		end
		local liveNode = liveSession.devices[deviceId]
		if liveNode == nil then
			return
		end
		liveSession.flags["stress_" .. deviceId] = nil
		-- burn-in drives load to 95%: temp = 30 + 95 * 0.45 = 72.75 (< 80 limit)
		local peakTemp = 30 + 95 * 0.45
		liveNode.temperatureC = peakTemp
		local resultLines: { string } = {}
		if peakTemp < 80 then
			table.insert(resultLines, g(string.format("[PASS] stress-test 5s: temp peak %.1fC (limit 80C)", peakTemp)))
			table.insert(resultLines, gr("CPU / RAM / storage: semua OK - server tervalidasi"))
			if deviceId == "bench_1" and liveSession.workbench ~= nil then
				liveSession.workbench.tested = true
				table.insert(resultLines, g("Custom build validated - ketik 'ship' untuk kirim crate ke dock"))
			end
			playSfx(player, "cash")
		else
			table.insert(resultLines, r(string.format("[FAIL] stress-test: temp peak %.1fC (>= 80C)", peakTemp)))
		end
		pushLines(player, resultLines)
	end)
	return lines
end

local function cmdShip(session: any): { string }
	if Workbench == nil or type(Workbench.Ship) ~= "function" then
		return { r("ship: sistem workbench tidak tersedia") }
	end
	local ok, errMsg = Workbench.Ship(session)
	if not ok then
		return { r("ship: " .. tostring(errMsg)) }
	end
	return {
		g("[ ok ] Custom server dikirim ke Loading Dock!"),
		gr("Payout sudah ditambahkan ke saldo lab."),
	}
end

---------------------------------------------------------------------
-- Fase 2: cable spools, VLAN, carry & mount
---------------------------------------------------------------------

local CABLE_ALIASES: { [string]: string } = {
	lan = "LAN_Blue",
	blue = "LAN_Blue",
	biru = "LAN_Blue",
	wan = "WAN_Yellow",
	yellow = "WAN_Yellow",
	kuning = "WAN_Yellow",
	mgmt = "Mgmt_Red",
	red = "Mgmt_Red",
	merah = "Mgmt_Red",
}

local function normalizeCableColor(raw: string?): string?
	if raw == nil then
		return nil
	end
	for _, color in ipairs(Constants.CABLES.colors) do
		if string.lower(color) == string.lower(raw) then
			return color
		end
	end
	return CABLE_ALIASES[string.lower(raw)]
end

local function vlanDeviceId(session: any): string
	local target = session.terminal.targetDeviceId
	if type(target) == "string" then
		local node = session.devices[target]
		if node ~= nil and (node.deviceType == "Switch" or node.deviceType == "Router") then
			return target
		end
	end
	return "sw_main_1"
end

local function cableStockLines(session: any): { string }
	local selected = session.selectedCableColor or "LAN_Blue"
	local lines: { string } = {
		b("=== SPOOL KABEL ==="),
		string.format("  Warna aktif : %s", selected),
	}
	for _, color in ipairs(Constants.CABLES.colors) do
		local label = Constants.CABLES.labels[color] or color
		local count = tonumber(session.cableSpools[color]) or 0
		table.insert(lines, string.format("  %-10s : %d kabel  (%s)", color, count, label))
	end
	table.insert(lines, gr("cable use <warna> | cable buy <warna> | cable cut <port>"))
	return lines
end

local function cmdCable(player: Player, session: any, tokens: { string }): { string }
	local sub = if tokens[2] ~= nil then string.lower(tokens[2]) else nil
	if sub == nil or sub == "list" or sub == "status" then
		return cableStockLines(session)
	end

	if sub == "use" then
		local color = normalizeCableColor(tokens[3])
		if color == nil then
			return { r("cable use: pilih LAN_Blue | WAN_Yellow | Mgmt_Red") }
		end
		session.selectedCableColor = color
		playSfx(player, "key")
		return { g("Warna kabel aktif: " .. color .. " (" .. (Constants.CABLES.labels[color] or color) .. ")") }
	end

	if sub == "buy" then
		local color = normalizeCableColor(tokens[3]) or session.selectedCableColor or "LAN_Blue"
		local itemId = Constants.CABLES.itemByColor[color]
		if itemId == nil then
			return { r("cable buy: warna tidak dikenal") }
		end
		if Placement == nil then
			return { r("cable buy: sistem store tidak tersedia") }
		end
		Placement.OnPurchase(player, itemId, "buy", nil, nil)
		return { gr("Pembelian spool " .. color .. " diproses.") }
	end

	if sub == "cut" then
		local deviceId = vlanDeviceId(session)
		local portId = tokens[3]
		if tokens[4] ~= nil then
			deviceId = tokens[3] :: string
			portId = tokens[4]
		end
		if portId == nil then
			return { r("cable cut: usage: cable cut <port>  |  cable cut <deviceId> <port>") }
		end
		local node = session.devices[deviceId]
		if node == nil then
			return { r("cable cut: device tidak ditemukan") }
		end
		local port = node.ports[portId]
		if port == nil then
			return { r("cable cut: port tidak ditemukan") }
		end
		if port.connectedToDeviceId == nil then
			return { r(string.format("%s:%s tidak tersambung", node.name, portId)) }
		end
		Graph.DisconnectPort(session, deviceId, portId)
		playSfx(player, "plug")
		return { g(string.format("Kabel di %s:%s dipotong.", node.name, portId)) }
	end

	return { r("cable: usage: cable | cable use <warna> | cable buy <warna> | cable cut <port>") }
end

local function vlanUsage(): { string }
	return { r("vlan: usage: vlan list | vlan set <port> <id> | vlan trunk <port> on|off | vlan set <deviceId> <port> <id>") }
end

local function cmdVlan(session: any, tokens: { string }): { string }
	local sub = if tokens[2] ~= nil then string.lower(tokens[2]) else nil
	if sub == nil or sub == "list" or sub == "show" then
		local deviceId = vlanDeviceId(session)
		local node = session.devices[deviceId]
		if node == nil then
			return { r("vlan: device aktif tidak ditemukan") }
		end
		local lines: { string } = { b(string.format("=== VLAN %s (%s) ===", node.name, deviceId)) }
		for _, line in ipairs(Graph.ListPortVlans(session, deviceId)) do
			table.insert(lines, "  " .. line)
		end
		table.insert(lines, gr("Set: vlan set <port> <id>   contoh: vlan set eth2 20"))
		return lines
	end

	if sub == "trunk" then
		local deviceId = vlanDeviceId(session)
		local portId = tokens[3]
		local modeRaw = tokens[4]
		if tokens[5] ~= nil then
			deviceId = tokens[3] :: string
			portId = tokens[4]
			modeRaw = tokens[5]
		end
		if portId == nil then
			return { r("vlan trunk: usage: vlan trunk <port> on|off") }
		end
		local mode = string.lower(modeRaw or "on")
		local enabled = mode == "on" or mode == "true" or mode == "1"
		local okTrunk, trunkErr = Graph.SetPortTrunk(session, deviceId, portId, enabled)
		if not okTrunk then
			return { r("vlan trunk: " .. trunkErr) }
		end
		return { g(string.format("%s:%s trunk %s", deviceId, portId, if enabled then "ON" else "OFF")) }
	end

	if sub ~= "set" then
		return vlanUsage()
	end

	local deviceId = vlanDeviceId(session)
	local portId = tokens[3]
	local vlanRaw = tokens[4]
	if tokens[5] ~= nil then
		deviceId = tokens[3] :: string
		portId = tokens[4]
		vlanRaw = tokens[5]
	end
	if portId == nil or vlanRaw == nil then
		return vlanUsage()
	end
	local node = session.devices[deviceId]
	if node == nil then
		return { r("vlan: device tidak ditemukan") }
	end
	if node.deviceType ~= "Switch" and node.deviceType ~= "Router" then
		return { r("vlan: hanya port switch/router yang punya VLAN") }
	end
	local vlan = tonumber(vlanRaw)
	if vlan == nil then
		return { r("vlan: id harus angka 1..4094") }
	end
	local ok, err = Graph.SetPortVlan(session, deviceId, portId, vlan)
	if not ok then
		return { r("vlan: " .. err) }
	end
	return { g(string.format("VLAN %s:%s -> %d", node.name, portId, math.floor(vlan))) }
end

local function cmdSwitch(session: any, tokens: { string }): { string }
	local deviceId = vlanDeviceId(session)
	local index = 2
	local candidate = tokens[2]
	if candidate ~= nil and candidate ~= "port" and candidate ~= "list" and session.devices[candidate] ~= nil then
		deviceId = candidate
		index = 3
	end
	local node = session.devices[deviceId]
	if node == nil then
		return { r("switch: device tidak ditemukan") }
	end
	if node.deviceType ~= "Switch" and node.deviceType ~= "Router" then
		return { r("switch: perintah ini hanya untuk switch/router") }
	end

	local action = tokens[index]
	if action == nil or action == "list" then
		local lines: { string } = { b(string.format("=== PORT %s (%s) ===", node.name, deviceId)) }
		for _, line in ipairs(Graph.ListPortVlans(session, deviceId)) do
			table.insert(lines, "  " .. line)
		end
		return lines
	end
	if action ~= "port" then
		return { r("switch: usage: switch [deviceId] port <port> vlan <id> | switch [deviceId] port <port> trunk on|off | switch [deviceId] list") }
	end
	local portId = tokens[index + 1]
	local keyword = tokens[index + 2]
	local value = tokens[index + 3]
	if portId == nil or keyword == nil then
		return { r("switch: usage: switch [deviceId] port <port> vlan <id> | switch [deviceId] port <port> trunk on|off") }
	end
	if keyword == "trunk" then
		local mode = string.lower(value or "on")
		local enabled = mode == "on" or mode == "true" or mode == "1"
		local okTrunk, trunkErr = Graph.SetPortTrunk(session, deviceId, portId, enabled)
		if not okTrunk then
			return { r("switch: " .. trunkErr) }
		end
		return { g(string.format("%s:%s trunk %s", node.name, portId, if enabled then "ON" else "OFF")) }
	end
	if keyword ~= "vlan" or value == nil then
		return { r("switch: usage: switch [deviceId] port <port> vlan <id> | switch [deviceId] port <port> trunk on|off") }
	end
	local vlan = tonumber(value)
	if vlan == nil then
		return { r("switch: id VLAN harus angka 1..4094") }
	end
	local ok, err = Graph.SetPortVlan(session, deviceId, portId, vlan)
	if not ok then
		return { r("switch: " .. err) }
	end
	return { g(string.format("VLAN %s:%s -> %d", node.name, portId, math.floor(vlan))) }
end

local function cmdMount(session: any, tokens: { string }): { string }
	local sub = tokens[2]
	if sub == "list" or sub == nil then
		local rackIds: { string } = {}
		for rackId in pairs(session.racks) do
			table.insert(rackIds, rackId)
		end
		table.sort(rackIds)
		local lines: { string } = { b("=== RACK & SLOT ===") }
		for _, rackId in ipairs(rackIds) do
			local rack = session.racks[rackId]
			local used = 0
			for _ in pairs(rack.occupiedSlots) do
				used += 1
			end
			local free = Placement.FindFreeUSlot(session, rackId, Constants.COLOCATION.uSize)
			table.insert(lines, string.format(
				"  %s  %s  %d/%dU  PDU %s  %s",
				rackId,
				rack.name,
				used,
				rack.maxU,
				if rack.pduPowered then "ON" else "OFF",
				if free ~= nil then string.format("muat %dU di U%d", Constants.COLOCATION.uSize, free) else "penuh"
			))
		end
		table.insert(lines, gr("Angkat crate colocation, lalu: mount <rackId>"))
		return lines
	end

	if Carry == nil then
		return { r("mount: sistem carry tidak tersedia") }
	end
	local rackId = sub
	if session.racks[rackId] == nil then
		return { r("mount: rack tidak ditemukan (" .. tostring(rackId) .. ")") }
	end
	if Carry.MountCarried(session, rackId) then
		return { g("Crate dipasang di " .. rackId) }
	end
	return {}
end

---------------------------------------------------------------------
-- Dispatcher & remote binding
---------------------------------------------------------------------

local function dispatch(player: Player, session: any, tokens: { string }): { string }
	local cmd = string.lower(tokens[1] or "")
	if cmd == "help" or cmd == "?" then
		return cmdHelp()
	elseif cmd == "clear" then
		return { "__CLEAR__" } -- sentinel: client wipes the output buffer
	elseif cmd == "ping" then
		return cmdPing(session, tokens)
	elseif cmd == "traceroute" then
		return cmdTraceroute(session, tokens)
	elseif cmd == "ip" then
		return cmdIp(session, tokens)
	elseif cmd == "ssh" then
		return cmdSsh(session, tokens)
	elseif cmd == "exit" then
		return cmdExit(session)
	elseif cmd == "top" then
		return cmdTop(session)
	elseif cmd == "vm" then
		return cmdVm(session, tokens)
	elseif cmd == "install-os" then
		return cmdInstallOs(player, session, tokens)
	elseif cmd == "stress-test" then
		return cmdStressTest(player, session, tokens)
	elseif cmd == "ship" then
		return cmdShip(session)
	elseif cmd == "cable" then
		return cmdCable(player, session, tokens)
	elseif cmd == "vlan" then
		return cmdVlan(session, tokens)
	elseif cmd == "switch" then
		return cmdSwitch(session, tokens)
	elseif cmd == "mount" then
		return cmdMount(session, tokens)
	end
	return { r("command not found: " .. cmd) .. gr("  (ketik 'help')") }
end

-- ExecuteCommand.OnServerInvoke(player, rawText) -> {lines = {string}}
local function onInvoke(player: Player, rawText: any): { lines: { string } }
	local session = if Sessions ~= nil then Sessions.GetSession(player) else nil
	if session == nil then
		return { lines = { r("Session belum siap. Tunggu sebentar ...") } }
	end
	if type(rawText) ~= "string" or #rawText == 0 then
		return { lines = {} }
	end
	if #rawText > 240 then
		return { lines = { r("command terlalu panjang (max 240 karakter)") } }
	end
	local tokens: { string } = {}
	for token in string.gmatch(rawText, "%S+") do
		table.insert(tokens, token)
	end
	if #tokens == 0 then
		return { lines = {} }
	end
	local ok, result = pcall(dispatch, player, session, tokens)
	if not ok then
		return { lines = { r("internal error: " .. tostring(result)) } }
	end
	return { lines = result }
end

-- Init(deps) per CONTRACT section 6 AGENT A. Binds ExecuteCommand.
function CommandExecutor.Init(deps: { [string]: any })
	Sessions = deps.sessions
	Graph = deps.graph
	Utils = deps.utils
	Catalog = deps.catalog
	Constants = deps.constants
	Workbench = deps.workbench
	Cabling = deps.cabling
	Placement = deps.placement
	Carry = deps.carry
	Remotes = deps.remotesFolder

	local executeRemote = Remotes:FindFirstChild("ExecuteCommand")
	if executeRemote == nil then
		executeRemote = Remotes:WaitForChild("ExecuteCommand", 60)
	end
	if executeRemote ~= nil then
		(executeRemote :: any).OnServerInvoke = onInvoke
	else
		warn("[CommandExecutor] ExecuteCommand remote not found - terminal disabled")
	end
end

return CommandExecutor
]]></ProtectedString>
