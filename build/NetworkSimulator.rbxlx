</Item>
<Item class="Folder" referent="RBX19">
<Properties>
<string name="Name">Physical</string>
</Properties>
<Item class="ModuleScript" referent="RBX20">
<Properties>
<string name="Name">RackAndCablingSystem</string>
<ProtectedString name="Source"><![CDATA[--!strict
--[[
	RackAndCablingSystem (ModuleScript, ServerScriptService/Physical)
	Physical interaction layer for cabling, console links and power:
	- Two-click port cabling with Fase 2 colour-coded spools: WAN ports always
	  use the yellow spool, data ports use the selected LAN/Mgmt spool; the
	  spool is consumed only when the link is created
	- WireCutter tool equipped: clicking a connected port cuts its cable
	- First click marks the port with a yellow SelectionBox "PendingCableSel"
	  (15 s timeout), second click connects; clicking a connected port
	  disconnects it; clicking the same port cancels the pending selection
	- Laptop console cable: ProximityPrompt on the device ConsolePort attaches
	  a blue Beam from the equipped TechnicianLaptop to the device and opens
	  the terminal in LocalConsole mode; auto-detach beyond 18 studs
	- HookDevice: wires port ClickDetectors, the console prompt and a power
	  toggle prompt for freeform devices (once per device per session)
	- HookFacility: rack PDU click toggles power for every rack-mounted device
	- Remote responders: CableActionRemote "disconnect_all" (topology UI) and
	  OpenTerminalEvent "request_shell" (laptop click -> open terminal)
	Player isolation: every handler verifies the caller owns the session.
]]

local RackAndCablingSystem = {}

local Sessions: any = nil -- SessionManager module
local Graph: any = nil -- NetworkGraph module
local Remotes: any = nil -- Remotes folder

local PENDING_TIMEOUT = 15 -- seconds before a pending cable selection expires
local CONSOLE_MAX_DISTANCE = 18 -- studs between player and device pivot

local LED_GREEN = Color3.fromRGB(85, 255, 120)
local LED_RED = Color3.fromRGB(255, 80, 80)
local HIGHLIGHT_YELLOW = Color3.fromRGB(255, 220, 80)
local CONSOLE_BLUE = Color3.fromRGB(80, 160, 255)

---------------------------------------------------------------------
-- Init & remote bindings
---------------------------------------------------------------------

function RackAndCablingSystem.Init(deps: { [string]: any })
	Sessions = deps.sessions
	Graph = deps.graph
	Remotes = deps.remotesFolder

	-- Topology UI: disconnect every cable of one device (ownership checked).
	local cableRemote = Remotes:FindFirstChild("CableActionRemote")
	if cableRemote ~= nil then
		(cableRemote :: any).OnServerEvent:Connect(function(player, payload)
			RackAndCablingSystem.onCableAction(player, payload)
		end)
	end

	-- Laptop Tool click (client fires {action="request_shell"}): answer by
	-- opening the terminal in the session's current mode - "Disconnected"
	-- for a fresh session, matching the CONTRACT section 7 flow.
	local terminalRemote = Remotes:FindFirstChild("OpenTerminalEvent")
	if terminalRemote ~= nil then
		(terminalRemote :: any).OnServerEvent:Connect(function(player, payload)
			RackAndCablingSystem.onTerminalRequest(player, payload)
		end)
	end
end

---------------------------------------------------------------------
-- Small helpers
---------------------------------------------------------------------

local function playSFX(player: Player, name: string)
	local remote = if Remotes ~= nil then Remotes:FindFirstChild("PlaySFXRemote") else nil
	if remote ~= nil then
		(remote :: any):FireClient(player, name)
	end
end

local function openTerminal(player: Player, payload: { [string]: any })
	local remote = if Remotes ~= nil then Remotes:FindFirstChild("OpenTerminalEvent") else nil
	if remote ~= nil then
		(remote :: any):FireClient(player, payload)
	end
end

-- Clears the pending two-click cable selection (highlight + state).
local function clearPendingCable(session: any)
	if session.pendingCableHighlight ~= nil then
		session.pendingCableHighlight:Destroy()
	end
	session.pendingCableHighlight = nil
	session.pendingCableDeviceId = nil
	session.pendingCablePortId = nil
	session.pendingCableColor = nil
end

local function hasWireCutter(player: Player): boolean
	local char = player.Character
	if char == nil then
		return false
	end
	local tool = char:FindFirstChild("WireCutter")
	return tool ~= nil and tool:IsA("Tool")
end

local function hint(player: Player, message: string)
	openTerminal(player, { action = "hint", message = message })
end

--[[ Fase 2: pick the cable colour for a pending link. WAN ports always use
	 the yellow spool; data ports use the player's selected spool (never WAN). ]]
local function cableColorFor(session: any, port: any): string
	if port.portType == "WAN" then
		return "WAN_Yellow"
	end
	local selected = session.selectedCableColor
	if selected == "Mgmt_Red" then
		return "Mgmt_Red"
	end
	return "LAN_Blue"
end

local function spoolCount(session: any, color: string): number
	return tonumber(session.cableSpools[color]) or 0
end

---------------------------------------------------------------------
-- Port cabling (two-click)
---------------------------------------------------------------------

--[[
	HandlePortClick(player, session, deviceId, portId):
	- connected port  -> DisconnectPort + "plug" SFX
	- empty port      -> first click starts a pending selection (yellow
	                     SelectionBox, 15 s timeout); second click on another
	                     port connects both ("LAN_Blue") with "plug"/"error";
	                     same port cancels the pending selection
]]
function RackAndCablingSystem.HandlePortClick(player: Player, session: any, deviceId: string, portId: string)
	if session == nil or session.player ~= player then
		return -- only the session owner may touch its ports
	end
	local node = session.devices[deviceId]
	if node == nil then
		return
	end
	local port = node.ports[portId]
	if port == nil or port.portType == "Console" then
		return
	end

	-- WireCutter equipped: click a connected port to cut its cable.
	if hasWireCutter(player) then
		if port.connectedToDeviceId ~= nil then
			Graph.DisconnectPort(session, deviceId, portId)
			playSFX(player, "plug")
			hint(player, "Kabel dipotong dengan WireCutter.")
		else
			playSFX(player, "error")
			hint(player, "WireCutter: klik port yang tersambung untuk memotong kabel.")
		end
		return
	end

	-- Connected port: click = unplug.
	if port.connectedToDeviceId ~= nil then
		Graph.DisconnectPort(session, deviceId, portId)
		playSFX(player, "plug")
		return
	end

	-- Empty port, no pending selection yet: start one.
	if session.pendingCableDeviceId == nil or session.pendingCablePortId == nil then
		local color = cableColorFor(session, port)
		if spoolCount(session, color) <= 0 then
			playSFX(player, "error")
			hint(player, "Spool " .. color .. " habis. Beli di Store > Cable (1 spool = 5 kabel).")
			return
		end
		session.pendingCableDeviceId = deviceId
		session.pendingCablePortId = portId
		session.pendingCableColor = color
		local model = session.deviceModels[deviceId]
		if model ~= nil then
			for _, desc in ipairs(model:GetDescendants()) do
				if desc:IsA("BasePart") and desc:GetAttribute("PortId") == portId then
					local sel = Instance.new("SelectionBox")
					sel.Name = "PendingCableSel"
					sel.Adornee = desc
					sel.Color3 = HIGHLIGHT_YELLOW
					sel.LineThickness = 0.05
					sel.SurfaceTransparency = 0.7
					sel.Parent = desc
					session.pendingCableHighlight = sel
					break
				end
			end
		end
		playSFX(player, "key")
		task.delay(PENDING_TIMEOUT, function()
			-- expires only if the same selection is still pending
			if session.pendingCableDeviceId == deviceId and session.pendingCablePortId == portId then
				clearPendingCable(session)
			end
		end)
		return
	end

	-- Same port clicked again: cancel the pending selection.
	if session.pendingCableDeviceId == deviceId and session.pendingCablePortId == portId then
		clearPendingCable(session)
		return
	end

	-- Second endpoint: connect (NetworkGraph validates type + colour rules).
	local fromDev = session.pendingCableDeviceId :: string
	local fromPort = session.pendingCablePortId :: string
	local color = session.pendingCableColor or "LAN_Blue"
	clearPendingCable(session)
	if spoolCount(session, color) <= 0 then
		playSFX(player, "error")
		hint(player, "Spool " .. color .. " habis. Beli di Store > Cable.")
		return
	end
	local ok, err = Graph.ConnectPorts(session, fromDev, fromPort, deviceId, portId, color)
	if ok then
		session.cableSpools[color] = spoolCount(session, color) - 1
	end
	playSFX(player, if ok then "plug" else "error")
	if not ok and err ~= "" then
		hint(player, err)
	end
end

---------------------------------------------------------------------
-- Console cable (laptop <-> device)
---------------------------------------------------------------------

--[[
	AttachConsole(player, session, deviceId): requires the TechnicianLaptop
	Tool equipped; clicking the console prompt of the linked device detaches
	(toggle), another device re-targets the console link. Opens the terminal
	in LocalConsole mode for the device.
]]
function RackAndCablingSystem.AttachConsole(player: Player, session: any, deviceId: string)
	if session == nil or session.player ~= player then
		return
	end
	local node = session.devices[deviceId]
	if node == nil then
		return
	end

	-- Toggle: same device already linked -> detach.
	local link = session.consoleLink
	if link ~= nil and link.deviceId == deviceId then
		RackAndCablingSystem.DetachConsole(session, player, true)
		return
	end

	-- The console cable is physical: the laptop must be equipped.
	local char = player.Character
	local laptop = if char ~= nil then char:FindFirstChild("TechnicianLaptop") else nil
	if laptop == nil then
		playSFX(player, "error")
		openTerminal(player, { action = "hint", message = "Equip TechnicianLaptop dulu (slot 1) untuk menyambung kabel console." })
		return
	end

	local serial = laptop:FindFirstChild("SerialPortAttachment", true)
	local model = session.deviceModels[deviceId]
	local consolePart = if model ~= nil then model:FindFirstChild("ConsolePort", true) else nil
	local consoleAttach = if consolePart ~= nil and consolePart:IsA("BasePart") then consolePart:FindFirstChild("ConsoleAttach") else nil
	if serial == nil or not serial:IsA("Attachment") or consoleAttach == nil or not consoleAttach:IsA("Attachment") then
		playSFX(player, "error")
		return
	end

	-- Re-targeting: silently drop the previous beam (no detach notification).
	if link ~= nil then
		if link.beam ~= nil then
			link.beam:Destroy()
		end
		session.consoleLink = nil
	end

	local beam = Instance.new("Beam")
	beam.Name = "ConsoleBeam"
	beam.Attachment0 = serial
	beam.Attachment1 = consoleAttach
	beam.Color = ColorSequence.new(CONSOLE_BLUE)
	beam.Transparency = NumberSequence.new(0.05)
	beam.Width0 = 0.16
	beam.Width1 = 0.16
	beam.CurveSize0 = -0.8
	beam.CurveSize1 = -0.8
	beam.Segments = 14
	beam.FaceCamera = true
	local cablesFolder = session.facility.cables
	if cablesFolder ~= nil then
		beam.Parent = cablesFolder
	else
		beam.Parent = model :: Model -- fallback before the facility refs exist
	end
	session.consoleLink = { deviceId = deviceId, beam = beam }

	session.terminal.mode = "LocalConsole"
	session.terminal.targetDeviceId = deviceId

	playSFX(player, "plug")
	openTerminal(player, { action = "open", mode = "LocalConsole", deviceName = node.name, deviceId = deviceId })
end

--[[
	DetachConsole(session, player?, notify): destroys the console beam and
	resets the terminal to Disconnected. `notify` also tells the client
	({action="detach"} + "key" SFX) so the terminal window reacts.
]]
function RackAndCablingSystem.DetachConsole(session: any, player: Player?, notify: boolean)
	local link = session.consoleLink
	if link ~= nil then
		if link.beam ~= nil then
			link.beam:Destroy()
		end
		session.consoleLink = nil
	end
	session.terminal.mode = "Disconnected"
	session.terminal.targetDeviceId = nil
	session.terminal.sshStack = {}
	if notify and player ~= nil then
		openTerminal(player, { action = "detach" })
		playSFX(player, "key")
	end
end

---------------------------------------------------------------------
-- Hooking device interactions
---------------------------------------------------------------------

--[[
	HookDevice(session, deviceId): connects all interaction callbacks of one
	device model, exactly once per session (session.hookedDevices guard):
	- every port ClickDetector -> HandlePortClick
	- console ProximityPrompt  -> AttachConsole
	- freeform devices get a "PowerPrompt" on their Chassis (HoldDuration 0.4)
	  toggling node.isPowered (rack-mounted devices are driven by the PDU)
]]
function RackAndCablingSystem.HookDevice(session: any, deviceId: string)
	if session.hookedDevices[deviceId] then
		return
	end
	local model = session.deviceModels[deviceId]
	if model == nil then
		return -- nothing to hook yet; do not consume the guard
	end
	session.hookedDevices[deviceId] = true
	local player = session.player

	-- Port click detectors ("Click" on parts carrying PortId/DeviceId attrs).
	for _, desc in ipairs(model:GetDescendants()) do
		if desc:IsA("ClickDetector") and desc.Name == "Click" then
			local portPart = desc.Parent
			if portPart ~= nil and portPart:IsA("BasePart") then
				local portId = portPart:GetAttribute("PortId")
				local devId = portPart:GetAttribute("DeviceId")
				if portId ~= nil and devId ~= nil then
					desc.MouseClick:Connect(function(clicker)
						if clicker ~= player then
							return
						end
						RackAndCablingSystem.HandlePortClick(clicker, session, devId :: string, portId :: string)
					end)
				end
			end
		end
	end

	-- Console port prompt -> laptop console link.
	local consolePart = model:FindFirstChild("ConsolePort", true)
	if consolePart ~= nil and consolePart:IsA("BasePart") then
		local prompt = consolePart:FindFirstChildOfClass("ProximityPrompt")
		if prompt ~= nil then
			prompt.Triggered:Connect(function(triggerer)
				if triggerer ~= player then
					return
				end
				RackAndCablingSystem.AttachConsole(triggerer, session, deviceId)
			end)
		end
	end

	-- Freeform devices: physical power toggle on the chassis.
	local node = session.devices[deviceId]
	if node ~= nil and node.freeform == true then
		local chassis = model:FindFirstChild("Chassis")
		if chassis ~= nil and chassis:IsA("BasePart") and chassis:FindFirstChild("PowerPrompt") == nil then
			local powerPrompt = Instance.new("ProximityPrompt")
			powerPrompt.Name = "PowerPrompt"
			powerPrompt.ActionText = "Toggle Power"
			powerPrompt.ObjectText = node.name
			powerPrompt.HoldDuration = 0.4
			powerPrompt.MaxActivationDistance = 10
			powerPrompt.RequiresLineOfSight = false
			powerPrompt.Parent = chassis
			powerPrompt.Triggered:Connect(function(triggerer)
				if triggerer ~= player then
					return
				end
				local live = session.devices[deviceId]
				if live == nil then
					return
				end
				live.isPowered = not live.isPowered
				Graph.UpdateDeviceLED(session, deviceId)
				playSFX(player, if live.isPowered then "plug" else "key")
			end)
		end
	end
end

---------------------------------------------------------------------
-- Rack PDU
---------------------------------------------------------------------

--[[
	HookFacility(session): wires the PDU click detector of every rack in
	facility.pduParts (guard attribute "Hooked" so racks are wired once even
	when HookFacility runs again after another rack is placed). Toggling the
	PDU powers on/off every rack-mounted device and recolors the PDU LED.
]]
function RackAndCablingSystem.HookFacility(session: any)
	local facility = session.facility
	if type(facility) ~= "table" then
		return
	end
	local pduParts = facility.pduParts
	if type(pduParts) ~= "table" then
		return
	end
	local player = session.player

	for rackId, pdu in pairs(pduParts) do
		local click = if pdu ~= nil and pdu:IsA("BasePart") then pdu:FindFirstChild("PDUClick") else nil
		if click ~= nil and click:IsA("ClickDetector") and not click:GetAttribute("Hooked") then
			click:SetAttribute("Hooked", true)
			click.MouseClick:Connect(function(clicker)
				if clicker ~= player then
					return
				end
				local rack = session.racks[rackId]
				if rack == nil then
					return
				end
				rack.pduPowered = not rack.pduPowered
				-- PDU drives every device mounted in this rack
				for id, node in pairs(session.devices) do
					if node.rackId == rackId then
						node.isPowered = rack.pduPowered
						Graph.UpdateDeviceLED(session, id)
					end
				end
				local rackModel = session.rackModels[rackId]
				local ledSource = if rackModel ~= nil then rackModel else pdu.Parent
				local led = if ledSource ~= nil then ledSource:FindFirstChild("PDULed", true) else nil
				if led ~= nil and led:IsA("BasePart") then
					led.Color = if rack.pduPowered then LED_GREEN else LED_RED
				end
				playSFX(player, if rack.pduPowered then "plug" else "key")
			end)
		end
	end
end

---------------------------------------------------------------------
-- Per-tick upkeep
---------------------------------------------------------------------

--[[
	Update(session) (called from the economy tick): the console cable is a
	physical wire - walking more than 18 studs from the device detaches it.
]]
function RackAndCablingSystem.Update(session: any)
	local link = session.consoleLink
	if link == nil then
		return
	end
	local char = session.player.Character
	local model = session.deviceModels[link.deviceId]
	if char == nil or model == nil then
		RackAndCablingSystem.DetachConsole(session, session.player, true)
		return
	end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if hrp ~= nil and hrp:IsA("BasePart") then
		local dist = (hrp.Position - model:GetPivot().Position).Magnitude
		if dist > CONSOLE_MAX_DISTANCE then
			RackAndCablingSystem.DetachConsole(session, session.player, true)
		end
	end
end

---------------------------------------------------------------------
-- Remote responders
---------------------------------------------------------------------

-- CableActionRemote {action="disconnect_all", deviceId}: disconnect every
-- connected non-Console port of a device owned by this session.
function RackAndCablingSystem.onCableAction(player: Player, payload: any)
	if type(payload) ~= "table" or payload.action ~= "disconnect_all" then
		return
	end
	if Sessions == nil then
		return
	end
	local session = Sessions.GetSession(player)
	if session == nil then
		return
	end
	local deviceId = payload.deviceId
	if type(deviceId) ~= "string" or session.devices[deviceId] == nil then
		return
	end
	local node = session.devices[deviceId]
	local disconnectedAny = false
	for _, port in pairs(node.ports) do
		if port.connectedToDeviceId ~= nil and port.portType ~= "Console" then
			Graph.DisconnectPort(session, deviceId, port.portId)
			disconnectedAny = true
		end
	end
	if disconnectedAny then
		playSFX(player, "plug")
	end
end

-- OpenTerminalEvent {action="request_shell"} from the laptop Tool click:
-- open the terminal in the session's current mode (fresh session = "Disconnected").
function RackAndCablingSystem.onTerminalRequest(player: Player, payload: any)
	if type(payload) ~= "table" or payload.action ~= "request_shell" then
		return
	end
	if Sessions == nil then
		return
	end
	local session = Sessions.GetSession(player)
	if session == nil then
		return
	end
	local mode = if session.terminal.mode ~= nil then session.terminal.mode else "Disconnected"
	local deviceName = "Laptop Shell"
	local deviceId = session.terminal.targetDeviceId
	if deviceId ~= nil and session.devices[deviceId] ~= nil then
		deviceName = session.devices[deviceId].name
	end
	openTerminal(player, { action = "open", mode = mode, deviceName = deviceName, deviceId = deviceId })
end

return RackAndCablingSystem
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX21">
<Properties>
<string name="Name">PlacementSystem</string>
<ProtectedString name="Source"><![CDATA[--!strict
--[[
	PlacementSystem (ModuleScript, ServerScriptService/Physical)
	Server-authoritative hardware purchase + freeform placement:
	- ValidatePlacement: 2-stud grid snap, lab bounds, furniture-zone
	  clearance, freeform device overlap, floor height forcing
	- PlaceDevice: racks (rack data + PDU + hooks) or freeform devices
	  (model + graph node + config apply + auto-cable + hooks). Also used by
	  DataPersistenceManager to restore saved devices (session.loadedFromSave
	  suppresses auto-cabling; restored cables are linked explicitly)
	- OnPurchase: PurchaseHardwareRemote dispatcher - "prepare"/"place"/
	  "cancel" for placeables, "buy" for components (workbench) and cable
	  spools (Fase 2 inventory), plus MountDevice/UnmountDevice for the carry
	  system and save restore.
	All rejections reach the client as OpenTerminalEvent {action="hint"}.
]]

local PlacementSystem = {}

local Sessions: any = nil -- SessionManager module
local Graph: any = nil -- NetworkGraph module
local Catalog: any = nil -- HardwareCatalog module
local Constants: any = nil -- PlotConstants module
local ModelFactory: any = nil -- ModelFactory module
local Workbench: any = nil -- WorkbenchBuilderSystem module
local Cabling: any = nil -- RackAndCablingSystem module
local Remotes: any = nil -- Remotes folder

-- Id counters live in SessionManager (Core, owned by AGENT A; read-only use).
local SessionManager = require(script.Parent.Parent.Core.SessionManager)

---------------------------------------------------------------------
-- Init
---------------------------------------------------------------------

function PlacementSystem.Init(deps: { [string]: any })
	Sessions = deps.sessions
	Graph = deps.graph
	Catalog = deps.catalog
	Constants = deps.constants
	ModelFactory = deps.modelFactory
	Workbench = deps.workbench
	Cabling = deps.cabling
	Remotes = deps.remotesFolder

	local purchase = Remotes:FindFirstChild("PurchaseHardwareRemote")
	if purchase ~= nil then
		(purchase :: any).OnServerEvent:Connect(function(player, itemId, action, cf, rotY)
			PlacementSystem.OnPurchase(player, itemId, action, cf, rotY)
		end)
	end
end

---------------------------------------------------------------------
-- Small helpers
---------------------------------------------------------------------

local function hint(player: Player, message: string)
	local remote = if Remotes ~= nil then Remotes:FindFirstChild("OpenTerminalEvent") else nil
	if remote ~= nil then
		(remote :: any):FireClient(player, { action = "hint", message = message })
	end
end

local function playSFX(player: Player, name: string)
	local remote = if Remotes ~= nil then Remotes:FindFirstChild("PlaySFXRemote") else nil
	if remote ~= nil then
		(remote :: any):FireClient(player, name)
	end
end

-- Device id prefix: "bm" servers, "rt" routers (Network with WAN ports),
-- "sw" everything else (switches). Racks use "rack".
local function prefixFor(def: any): string
	if def.category == "Server" then
		return "bm"
	end
	if def.category == "Network" and (def.specs.wanPorts or 0) > 0 then
		return "rt"
	end
	return "sw"
end

---------------------------------------------------------------------
-- Validation
---------------------------------------------------------------------

--[[
	ValidatePlacement(session, itemId, cf) -> (ok, reason, snappedCF)
	- snaps the requested position to the 2-stud grid (plot-relative)
	- inside PLACEMENT_BOUNDS (plot-relative)
	- clear of every FURNITURE_ZONES bubble (radius + device half-extent)
	- clear of every other freeform device ((sum of half extents) + 0.5)
	- Y is forced to the room floor top
	node.posX/posZ are stored as world coordinates (so DataPersistenceManager
	can rebuild with CFrame.new(posX, floorY, posZ)); they are converted back
	to plot-relative here for the distance checks.
]]
function PlacementSystem.ValidatePlacement(session: any, itemId: string, cf: CFrame): (boolean, string, CFrame)
	local def = Catalog.Get(itemId)
	if def == nil then
		return false, "Item tidak dikenal", cf
	end

	local origin = Constants.PLOT_POSITIONS[session.plotIndex]
	local floorY = Constants.ROOM.floorTopY
	local halfX, halfZ = ModelFactory.ComputeFootprint(itemId)

	local rel = cf.Position - origin
	local grid = Constants.SNAP_GRID
	local sx = math.floor(rel.X / grid + 0.5) * grid
	local sz = math.floor(rel.Z / grid + 0.5) * grid

	local bounds = Constants.PLACEMENT_BOUNDS
	if sx < bounds.minX or sx > bounds.maxX or sz < bounds.minZ or sz > bounds.maxZ then
		return false, "Di luar area lab", cf
	end

	local relSnap = Vector3.new(sx, 0, sz)
	local margin = math.max(halfX, halfZ)
	for _, zone in ipairs(Constants.FURNITURE_ZONES) do
		local zoneRel = Vector3.new(zone.position.X, 0, zone.position.Z)
		local dist = (zoneRel - relSnap).Magnitude
		if dist < zone.radius + margin then
			return false, "Menabrak area " .. zone.name, cf
		end
	end

	for _, node in pairs(session.devices) do
		if node.freeform == true and node.posX ~= nil and node.posZ ~= nil then
			local otherHalfX, otherHalfZ = ModelFactory.ComputeFootprint(node.itemId)
			local otherRel = Vector3.new(node.posX - origin.X, 0, node.posZ - origin.Z)
			local dist = (otherRel - relSnap).Magnitude
			if dist < (halfX + otherHalfX) + (halfZ + otherHalfZ) + 0.5 then
				return false, "Menabrak " .. node.name, cf
			end
		end
	end

	local snapped = CFrame.new(origin + Vector3.new(sx, floorY, sz))
	return true, "", snapped
end

---------------------------------------------------------------------
-- Placement
---------------------------------------------------------------------

--[[ Builds and registers one rack at the given world CFrame. Shared by the
	 store placement flow and the save-restore path so both keep the same
	 rack data, slot attachments and PDU hooks. Returns the new rack id. ]]
local function createRack(session: any, itemId: string, snappedCF: CFrame, rotY: number): string
	local def = Catalog.Get(itemId)
	if def == nil then
		return ""
	end
	local rackId = SessionManager.NextDeviceId(session, "rack")
	local model, slots, pduPart = ModelFactory.BuildRack(itemId, rackId)
	model:PivotTo(snappedCF * CFrame.Angles(0, rotY, 0))
	model.Parent = session.facility.devices

	session.racks[rackId] = {
		rackId = rackId,
		name = def.name,
		itemId = itemId,
		maxU = def.specs.maxU,
		occupiedSlots = {},
		totalPowerWatts = 0,
		maxPowerWatts = def.specs.maxPowerWatts,
		pduPowered = false,
	}
	session.rackModels[rackId] = model
	session.rackSlots[rackId] = slots

	session.facility.pduParts = session.facility.pduParts or {}
	session.facility.pduParts[rackId] = pduPart
	Cabling.HookFacility(session) -- wires the new PDU (guard attr skips old ones)
	return rackId
end

--[[ Restores a rack saved by DataPersistenceManager (including PDU state). ]]
function PlacementSystem.RestoreRack(session: any, itemId: string, posX: number, posZ: number, rotY: number, pduPowered: boolean): string
	local rackId = createRack(session, itemId, CFrame.new(Vector3.new(posX, Constants.ROOM.floorTopY, posZ)), rotY)
	local rack = session.racks[rackId]
	if rack ~= nil then
		rack.pduPowered = pduPowered
	end
	return rackId
end

--[[ First free contiguous U block of uSize (top slot number), or nil. ]]
function PlacementSystem.FindFreeUSlot(session: any, rackId: string, uSize: number): number?
	local rack = session.racks[rackId]
	if rack == nil then
		return nil
	end
	local size = math.max(1, math.floor(uSize))
	for top = rack.maxU, size, -1 do
		local free = true
		for u = top - size + 1, top do
			if rack.occupiedSlots[u] ~= nil then
				free = false
				break
			end
		end
		if free then
			return top
		end
	end
	return nil
end

--[[ Mounts a catalog device into a rack U slot and registers its graph node.
	 Used by the Fase 2 carry system, colocation delivery and save restore.
	 config: { name?, deviceType?, ip?, gateway?, subnetMask?, osInstalled?,
	           isPowered?, contractId?, noAutoCable?, idPrefix? }
	 Returns (ok, deviceId or errorMessage). ]]
function PlacementSystem.MountDevice(session: any, itemId: string, rackId: string, uSlot: number, config: any?): (boolean, string)
	local def = Catalog.Get(itemId)
	if def == nil then
		return false, "Item tidak dikenal"
	end
	local rack = session.racks[rackId]
	if rack == nil then
		return false, "Rack tidak ditemukan"
	end
	local nodeSize = math.max(1, math.floor(def.uSize or 1))
	if uSlot < nodeSize or uSlot > rack.maxU then
		return false, "Slot U di luar batas rack"
	end
	for u = uSlot - nodeSize + 1, uSlot do
		if rack.occupiedSlots[u] ~= nil then
			return false, "Slot U" .. tostring(uSlot) .. " sudah terpakai"
		end
	end

	local cfg = if type(config) == "table" then config else {}
	local prefix = if type(cfg.idPrefix) == "string" then cfg.idPrefix else "srv"
	local deviceId = SessionManager.NextDeviceId(session, prefix)
	local model, _ports, _consoleAttach, _led, _smoke = ModelFactory.BuildDeviceModel(itemId, deviceId)
	local slots = session.rackSlots[rackId]
	local slot = if type(slots) == "table" then slots[uSlot] else nil
	if slot ~= nil and slot:IsA("Attachment") then
		model:PivotTo((slot :: Attachment).WorldCFrame * CFrame.new(0, 0, 0.95))
	else
		local rackModel = session.rackModels[rackId]
		if rackModel ~= nil then
			model:PivotTo(rackModel:GetPivot() * CFrame.new(0, 1.2, 0.2))
		end
	end
	model.Parent = session.facility.devices

	local node = Graph.DefaultNode(deviceId, if type(cfg.name) == "string" then cfg.name else def.name, itemId)
	node.rackId = rackId
	node.uSlot = uSlot
	node.freeform = false
	if type(cfg.deviceType) == "string" then
		node.deviceType = cfg.deviceType
	end
	node.ip = cfg.ip
	node.gateway = cfg.gateway
	node.subnetMask = if type(cfg.subnetMask) == "string" then cfg.subnetMask else "255.255.255.0"
	node.osInstalled = cfg.osInstalled
	node.contractId = cfg.contractId
	node.isPowered = if cfg.isPowered ~= nil then cfg.isPowered == true else rack.pduPowered

	for u = uSlot - nodeSize + 1, uSlot do
		rack.occupiedSlots[u] = deviceId
	end
	rack.totalPowerWatts += node.specs.powerWatts

	Graph.RegisterDevice(session, node, model)
	if cfg.noAutoCable ~= true and not session.loadedFromSave then
		Graph.AutoCable(session, deviceId)
	end
	Cabling.HookDevice(session, deviceId)
	return true, deviceId
end

--[[ Removes a rack-mounted device, frees its U block and adjusts rack power. ]]
function PlacementSystem.UnmountDevice(session: any, deviceId: string)
	local node = session.devices[deviceId]
	if node == nil then
		return
	end
	local rack = if node.rackId ~= nil then session.racks[node.rackId] else nil
	if rack ~= nil and node.uSlot ~= nil then
		for u = node.uSlot - node.uSize + 1, node.uSlot do
			if rack.occupiedSlots[u] == deviceId then
				rack.occupiedSlots[u] = nil
			end
		end
		rack.totalPowerWatts = math.max(0, rack.totalPowerWatts - node.specs.powerWatts)
	end
	Graph.RemoveDevice(session, deviceId)
end

--[[
	PlaceDevice(session, itemId, snappedCF, rotY, config?) -> id
	Rack category: builds the rack model, session.racks entry (pduPowered =
	false - the player must switch the PDU on), registers the PDU part in
	facility.pduParts and hooks it.
	Everything else: device model + DefaultNode (freeform, world posX/posZ),
	config applied when present (restore path), RegisterDevice, AutoCable
	(skipped when session.loadedFromSave) and interaction hooks.
	Returns the new device/rack id ("" when the item is unknown).
]]
function PlacementSystem.PlaceDevice(session: any, itemId: string, snappedCF: CFrame, rotY: number, config: any?): string
	local def = Catalog.Get(itemId)
	if def == nil then
		return ""
	end

	if def.category == "Rack" then
		return createRack(session, itemId, snappedCF, rotY)
	end

	local deviceId = SessionManager.NextDeviceId(session, prefixFor(def))
	local model, _ports, _consoleAttach, _led, _smoke = ModelFactory.BuildDeviceModel(itemId, deviceId)
	model:PivotTo(snappedCF * CFrame.Angles(0, rotY, 0))
	model.Parent = session.facility.devices

	local node = Graph.DefaultNode(deviceId, def.name, itemId)
	node.freeform = true
	node.posX = snappedCF.Position.X
	node.posZ = snappedCF.Position.Z
	node.rotY = rotY

	-- Restore config (DataPersistenceManager): IP setup, OS, power, VMs.
	if type(config) == "table" then
		node.ip = config.ip
		node.gateway = config.gateway
		node.subnetMask = if type(config.subnetMask) == "string" then config.subnetMask else "255.255.255.0"
		node.osInstalled = config.osInstalled
		node.isPowered = if config.isPowered ~= nil then config.isPowered == true else false
		if type(config.vms) == "table" then
			for _, vm in ipairs(config.vms) do
				if type(vm) == "table" and type(vm.name) == "string" and #vm.name > 0 then
					node.vms[vm.name] = vm
				end
			end
		end
	end

	Graph.RegisterDevice(session, node, model)
	if not session.loadedFromSave then
		Graph.AutoCable(session, deviceId) -- saved sessions re-link cables explicitly
	end
	Cabling.HookDevice(session, deviceId)
	return deviceId
end

---------------------------------------------------------------------
-- Purchase dispatch
---------------------------------------------------------------------

--[[
	OnPurchase(player, itemId, action, cf, rotY): PurchaseHardwareRemote
	handler. Categories:
	- Cable     -> Fase 2 hint (manual cabling is out of Fase 1 scope)
	- Component -> workbench.TryInstall (assembly order enforced there)
	- Rack/Network/Server -> "prepare" (balance check, remembers pending item),
	  "place" (validate + deduct + PlaceDevice + "cash"), "cancel"
]]
function PlacementSystem.OnPurchase(player: Player, itemId: any, action: any, cf: any, rotY: any)
	if Sessions == nil then
		return
	end
	local session = Sessions.GetSession(player)
	if session == nil then
		return
	end
	if type(itemId) ~= "string" or type(action) ~= "string" then
		return
	end
	local def = Catalog.Get(itemId)
	if def == nil then
		return
	end

	if def.category == "Cable" then
		if action ~= "buy" then
			hint(player, "Kabel dibeli sebagai spool: tekan BELI pada kategori Cable.")
			return
		end
		local color: string? = nil
		for candidate, item in pairs(Constants.CABLES.itemByColor) do
			if item == itemId then
				color = candidate
				break
			end
		end
		if color == nil then
			return
		end
		if session.balance < def.price then
			hint(player, "Uang belum cukup untuk " .. def.name .. " ($" .. tostring(def.price) .. ")")
			return
		end
		session.balance -= def.price
		local current = tonumber(session.cableSpools[color]) or 0
		session.cableSpools[color] = current + Constants.CABLES.spoolYield
		playSFX(player, "cash")
		hint(player, string.format(
			"Spool %s dibeli: +%d kabel (stok %d).",
			Constants.CABLES.labels[color] or color,
			Constants.CABLES.spoolYield,
			session.cableSpools[color]
		))
		return
	end

	if def.category == "Component" then
		Workbench.TryInstall(player, session, itemId)
		return
	end

	-- Placeable categories: Rack / Network / Server
	if action == "prepare" then
		if session.balance < def.price then
			hint(player, "Uang belum cukup untuk " .. def.name .. " ($" .. tostring(def.price) .. ")")
			return
		end
		session.pendingPlacementItemId = itemId
		return
	elseif action == "cancel" then
		if session.pendingPlacementItemId == itemId then
			session.pendingPlacementItemId = nil
		end
		return
	elseif action == "place" then
		if typeof(cf) ~= "CFrame" or type(rotY) ~= "number" then
			return
		end
		-- Tolerant: a place without prepare is accepted (balance is still
		-- enforced server-side), keeping the ghost flow resilient.
		if session.pendingPlacementItemId ~= itemId then
			session.pendingPlacementItemId = itemId
		end

		local ok, reason, snapped = PlacementSystem.ValidatePlacement(session, itemId, cf :: CFrame)
		if not ok then
			hint(player, "Placement ditolak: " .. reason)
			playSFX(player, "error")
			return
		end
		if session.balance < def.price then
			hint(player, "Uang belum cukup untuk " .. def.name .. " ($" .. tostring(def.price) .. ")")
			session.pendingPlacementItemId = nil
			return
		end

		session.balance -= def.price
		session.pendingPlacementItemId = nil
		PlacementSystem.PlaceDevice(session, itemId, snapped, rotY :: number, nil)
		playSFX(player, "cash")
		return
	end
end

return PlacementSystem
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX22">
<Properties>
<string name="Name">WorkbenchBuilderSystem</string>
<ProtectedString name="Source"><![CDATA[--!strict
--[[
	WorkbenchBuilderSystem (ModuleScript, ServerScriptService/Physical)
	Custom server assembly on the AssemblyWorkbench, single clean path:
	- Install order: Chassis -> Mobo -> CPU* -> RAM* -> Storage* -> PSU
	  (hints + "error" SFX on every violation)
	- Chassis install builds the bench device model ("bench_1") on the bench
	  top; the device id is reserved but the node is NOT registered until the
	  build is complete (mobo + psu present) and powered on
	- Every other component gets a visual model snapped to the bench top
	  (Snap_1..6 attachments, used cyclically), parented to facility.devices
	- Bench power switch toggles session.workbench.powered, syncs the bench
	  node LED and registers the node when the build is complete
	- Ship: payout = floor(totalSpent * 0.3) + 100, crate spawns at the dock
	- ApplyState / Serialize: persistence hooks (no Instance values serialized)
	Note: CommandExecutor sets node.osInstalled directly on install-os; Ship
	and Serialize sync workbench.osInstalled from the bench node so a finished
	build ships and persists correctly.
]]

local WorkbenchBuilderSystem = {}

local Sessions: any = nil -- SessionManager module
local Graph: any = nil -- NetworkGraph module
local Catalog: any = nil -- HardwareCatalog module
local Constants: any = nil -- PlotConstants module (reserved: bench layout constants)
local ModelFactory: any = nil -- ModelFactory module
local Cabling: any = nil -- RackAndCablingSystem module
local Remotes: any = nil -- Remotes folder

local BENCH_DEVICE_ID = "bench_1" -- reserved device id of the workbench build
local INSTALL_RANGE = 16 -- studs between player and workbench pivot
local PAYOUT_MARGIN = 0.3 -- fraction of totalSpent paid out on shipping
local PAYOUT_BONUS = 100 -- flat bonus per shipped build
local CRATE_DESPAWN = 20 -- seconds before the shipping crate disappears

local LED_GREEN = Color3.fromRGB(85, 255, 120)
local LED_OFF = Color3.fromRGB(70, 70, 70)

---------------------------------------------------------------------
-- Init
---------------------------------------------------------------------

function WorkbenchBuilderSystem.Init(deps: { [string]: any })
	Sessions = deps.sessions
	Graph = deps.graph
	Catalog = deps.catalog
	Constants = deps.constants
	ModelFactory = deps.modelFactory
	Cabling = deps.cabling
	Remotes = deps.remotesFolder

	-- Client fallback: {action="register"} forces the bench node registration
	-- (used when the client believes the build is complete but power state
	-- desynced, e.g. after a reconnect).
	local remote = Remotes:FindFirstChild("WorkbenchRemote")
	if remote ~= nil then
		(remote :: any).OnServerEvent:Connect(function(player, action)
			WorkbenchBuilderSystem.onWorkbenchAction(player, action)
		end)
	end
end

---------------------------------------------------------------------
-- Small helpers
---------------------------------------------------------------------

local function playSFX(player: Player, name: string)
	local remote = if Remotes ~= nil then Remotes:FindFirstChild("PlaySFXRemote") else nil
	if remote ~= nil then
		(remote :: any):FireClient(player, name)
	end
end

local function hint(player: Player, message: string)
	local remote = if Remotes ~= nil then Remotes:FindFirstChild("OpenTerminalEvent") else nil
	if remote ~= nil then
		(remote :: any):FireClient(player, { action = "hint", message = message })
	end
end

-- Places a component visual relative to the workbench pivot, snapped to the
-- Snap_<index> attachment position when available (bench top row).
local function placeVisual(session: any, visual: Model, snapIndex: number)
	local facility = session.facility
	local bench = facility.workbenchModel
	if bench == nil then
		return
	end
	local pivot = bench:GetPivot()
	local offset = CFrame.new(0, 2.72, 1.0) -- fallback: on the human-scale bench top
	local snaps = facility.benchSnaps
	local snap = if type(snaps) == "table" then snaps[snapIndex] else nil
	if snap ~= nil and snap:IsA("Attachment") then
		offset = CFrame.new(snap.WorldPosition - pivot.Position)
	end
	visual:PivotTo(pivot * offset)
	visual.Parent = facility.devices
end

-- Builds (or rebuilds) the bench device model on the bench top. Called when
-- the chassis is installed or when ApplyState restores a chassis. The model
-- is NOT registered as a node here - RegisterBenchNode does that later.
local function ensureBenchModel(session: any)
	local wb = session.workbench
	local facility = session.facility
	if wb.chassis == nil or wb.benchModel ~= nil or facility.workbenchModel == nil then
		return
	end
	local chassisId = wb.chassis :: string
	local model, _ports, _consoleAttach, _led, _smoke = ModelFactory.BuildDeviceModel(chassisId, BENCH_DEVICE_ID)
	model:PivotTo(facility.workbenchModel:GetPivot() * CFrame.new(0, 2.72, 0))
	model.Parent = facility.devices

	-- The bench console prompt should read as the custom build.
	local consolePart = model:FindFirstChild("ConsolePort", true)
	if consolePart ~= nil and consolePart:IsA("BasePart") then
		local prompt = consolePart:FindFirstChildOfClass("ProximityPrompt")
		if prompt ~= nil then
			prompt.ObjectText = "Custom Server (Workbench)"
		end
	end

	wb.benchModel = model
	wb.deviceId = BENCH_DEVICE_ID
end

---------------------------------------------------------------------
-- Bench switch
---------------------------------------------------------------------

--[[
	HookBenchSwitch(session): wires the bench power switch ClickDetector
	(guard attribute "Hooked"). Toggling flips session.workbench.powered,
	recolors the bench LED, syncs the registered bench node power state and
	(registering when the build is complete and powering on).
]]
function WorkbenchBuilderSystem.HookBenchSwitch(session: any)
	local facility = session.facility
	if type(facility) ~= "table" or facility.benchSwitch == nil then
		return
	end
	local switchPart = facility.benchSwitch :: BasePart
	local click = switchPart:FindFirstChild("BenchPowerClick")
	if click == nil or not click:IsA("ClickDetector") or click:GetAttribute("Hooked") then
		return
	end
	click:SetAttribute("Hooked", true)
	local benchLed = facility.benchLed
	local player = session.player

	click.MouseClick:Connect(function(clicker)
		if clicker ~= player then
			return
		end
		local wb = session.workbench
		wb.powered = not wb.powered
		if benchLed ~= nil and benchLed:IsA("BasePart") then
			benchLed.Color = if wb.powered then LED_GREEN else LED_OFF
		end
		if wb.powered then
			WorkbenchBuilderSystem.RegisterBenchNode(session)
		end
		local node = session.devices[BENCH_DEVICE_ID]
		if node ~= nil then
			node.isPowered = wb.powered
			Graph.UpdateDeviceLED(session, BENCH_DEVICE_ID)
		end
		playSFX(player, if wb.powered then "plug" else "key")
	end)
end

---------------------------------------------------------------------
-- Component installation
---------------------------------------------------------------------

--[[
	TryInstall(player, session, itemId): buys + installs one component.
	Enforces proximity (16 studs of the workbench pivot), install order,
	capacity (sockets / RAM slots / storage bays) and balance; deducts the
	price into session.workbench.totalSpent; attaches a bench visual; updates
	the registered node specs; registers the node when PSU lands on a powered
	bench. Every path gives a hint + appropriate SFX.
]]
function WorkbenchBuilderSystem.TryInstall(player: Player, session: any, itemId: string)
	local def = Catalog.Get(itemId)
	if def == nil then
		return
	end
	if def.category ~= "Component" then
		return -- only components install at the workbench
	end
	if itemId == "replacement_hdd" then
		hint(player, "Replacement HDD dipakai untuk Remote Hands (Fase 2).")
		return
	end

	local wb = session.workbench
	local facility = session.facility

	-- Must stand at the workbench.
	local char = player.Character
	local hrp = if char ~= nil then char:FindFirstChild("HumanoidRootPart") else nil
	if hrp == nil or facility.workbenchModel == nil then
		hint(player, "Dekati AssemblyWorkbench untuk memasang komponen.")
		return
	end
	if (hrp.Position - facility.workbenchModel:GetPivot().Position).Magnitude > INSTALL_RANGE then
		hint(player, "Dekati AssemblyWorkbench untuk memasang komponen.")
		return
	end

	-- Component classification.
	local isChassis = string.sub(itemId, 1, 8) == "chassis_"
	local isMobo = string.sub(itemId, 1, 5) == "mobo_"
	local isCpu = string.sub(itemId, 1, 4) == "cpu_"
	local isRam = string.sub(itemId, 1, 4) == "ram_"
	local isStorage = itemId == "nvme_1tb"
	local isPsu = itemId == "psu_redundant"

	-- Install order + capacity enforcement.
	local orderErr: string? = nil
	if isChassis then
		if wb.chassis ~= nil then
			orderErr = "Chassis sudah terpasang di workbench."
		end
	elseif isMobo then
		if wb.chassis == nil then
			orderErr = "Pasang chassis dulu."
		elseif wb.mobo ~= nil then
			orderErr = "Motherboard sudah terpasang."
		end
	elseif isCpu then
		if wb.mobo == nil then
			orderErr = "Pasang motherboard dulu."
		elseif wb.cpuCount >= wb.cpuSockets then
			orderErr = "Socket CPU penuh."
		end
	elseif isRam then
		if wb.mobo == nil then
			orderErr = "Pasang motherboard dulu."
		elseif wb.ramSlotsUsed >= wb.ramSlots then
			orderErr = "Slot RAM penuh."
		end
	elseif isStorage then
		if wb.mobo == nil then
			orderErr = "Pasang motherboard dulu."
		elseif wb.storageBaysUsed >= wb.storageBays then
			orderErr = "Bay storage penuh."
		end
	elseif isPsu then
		if wb.chassis == nil or wb.mobo == nil then
			orderErr = "Pasang chassis + motherboard dulu."
		elseif wb.psu ~= nil then
			orderErr = "PSU sudah terpasang."
		end
	else
		orderErr = "Komponen tidak dikenal."
	end
	if orderErr ~= nil then
		hint(player, orderErr :: string)
		playSFX(player, "error")
		return
	end

	-- Balance.
	if session.balance < def.price then
		hint(player, "Uang belum cukup untuk " .. def.name .. " ($" .. tostring(def.price) .. ")")
		playSFX(player, "error")
		return
	end

	session.balance -= def.price
	wb.totalSpent += def.price

	local specs = def.specs
	if isChassis then
		wb.chassis = itemId
		wb.snapIndex = 0 -- no component visuals yet
		ensureBenchModel(session) -- device id reserved, node NOT registered yet
	elseif isMobo then
		wb.mobo = itemId
		wb.cpuSockets = specs.sockets or 1
		wb.ramSlots = specs.ramSlots or 2
		wb.storageBays = specs.storageBays or 2
	elseif isCpu then
		wb.cpuCount += 1
		wb.cpuCores += specs.cores or 8
		wb.lastCpuId = itemId
	elseif isRam then
		wb.ramSlotsUsed += 1
		wb.ramGb += specs.ramGb or 0
		wb.lastRamId = itemId
	elseif isStorage then
		wb.storageBaysUsed += 1
		wb.storageGb += specs.storageGb or 0
	elseif isPsu then
		wb.psu = itemId
	end

	-- Visual: every non-chassis component snaps onto the bench top
	-- (Snap_1..6 used cyclically). The chassis IS the bench device model.
	if not isChassis then
		local visual = ModelFactory.BuildBenchComponentVisual(itemId)
		local nextSnap = ((wb.snapIndex or 0) % 6) + 1
		placeVisual(session, visual, nextSnap)
		wb.snapIndex = nextSnap
	end

	-- Registered bench node? Keep its specs in sync.
	local node = session.devices[BENCH_DEVICE_ID]
	if node ~= nil then
		node.specs.cpu = wb.cpuCores
		node.specs.ram = wb.ramGb
		node.specs.disk = wb.storageGb
	end

	playSFX(player, "plug")
	if isPsu and wb.powered then
		WorkbenchBuilderSystem.RegisterBenchNode(session)
	end
end

---------------------------------------------------------------------
-- Bench node registration
---------------------------------------------------------------------

--[[
	RegisterBenchNode(session): when the build is complete (chassis + mobo +
	psu) and not registered yet, creates the BareMetal node "bench_1" with
	specs from the installed components, registers it with the bench device
	model, hooks its interactions and auto-cables it when powered (skipped
	when session.loadedFromSave - the persistence layer re-links cables
	explicitly). EnsureBenchNode is an alias for the same behavior.
]]
function WorkbenchBuilderSystem.RegisterBenchNode(session: any)
	local wb = session.workbench
	if session.devices[BENCH_DEVICE_ID] ~= nil then
		return -- already registered
	end
	if wb.chassis == nil or wb.mobo == nil or wb.psu == nil then
		return -- build incomplete
	end

	ensureBenchModel(session) -- covers restored chassis state without a model
	local benchModel = wb.benchModel
	if benchModel == nil then
		return
	end

	local chassisId = wb.chassis :: string
	local node = Graph.DefaultNode(BENCH_DEVICE_ID, "Custom Server (" .. chassisId .. ")", chassisId)
	local chassisDef = Catalog.Get(chassisId)
	node.uSize = if chassisDef ~= nil then chassisDef.uSize else 1
	local psuDef = Catalog.Get(wb.psu :: string)
	node.specs.powerWatts = if psuDef ~= nil then (psuDef.specs.powerWatts or 450) else 450
	node.specs.cpu = wb.cpuCores
	node.specs.ram = wb.ramGb
	node.specs.disk = wb.storageGb
	node.osInstalled = wb.osInstalled
	node.isPowered = wb.powered
	wb.deviceId = BENCH_DEVICE_ID

	Graph.RegisterDevice(session, node, benchModel :: Model)
	Cabling.HookDevice(session, BENCH_DEVICE_ID)
	if wb.powered and not session.loadedFromSave then
		Graph.AutoCable(session, BENCH_DEVICE_ID)
	end
end

-- Alias: same single registration path (CONTRACT lists both entry points).
function WorkbenchBuilderSystem.EnsureBenchNode(session: any)
	WorkbenchBuilderSystem.RegisterBenchNode(session)
end

---------------------------------------------------------------------
-- Remote responder
---------------------------------------------------------------------

function WorkbenchBuilderSystem.onWorkbenchAction(player: Player, action: any)
	if Sessions == nil then
		return
	end
	local session = Sessions.GetSession(player)
	if session == nil then
		return
	end
	if action == "register" then
		WorkbenchBuilderSystem.RegisterBenchNode(session)
	end
end

---------------------------------------------------------------------
-- Shipping
---------------------------------------------------------------------

--[[
	Ship(session) -> (ok, msg): packs the finished build into a crate that
	spawns on the loading dock (despawns after 20 s) and pays out
	floor(totalSpent * 0.3) + 100. Requires chassis + psu + OS + stress-test
	pass and not already shipped.
]]
function WorkbenchBuilderSystem.Ship(session: any): (boolean, string)
	local wb = session.workbench
	if wb.chassis == nil then
		return false, "Belum ada build di workbench (pasang chassis dulu)."
	end
	if wb.psu == nil then
		return false, "Build belum lengkap (PSU belum terpasang)."
	end
	-- Sync OS state from the bench node (install-os writes the node directly).
	local node = session.devices[BENCH_DEVICE_ID]
	if wb.osInstalled == nil and node ~= nil then
		wb.osInstalled = node.osInstalled
	end
	if wb.osInstalled == nil then
		return false, "Install OS dulu di server bench (install-os)."
	end
	if not wb.tested then
		return false, "Jalankan stress-test dulu di server bench."
	end
	if wb.shipped then
		return false, "Build ini sudah dikirim."
	end

	wb.shipped = true
	local payout = math.floor(wb.totalSpent * PAYOUT_MARGIN) + PAYOUT_BONUS
	session.balance += payout

	local facility = session.facility
	if type(facility) == "table" and facility.dockCF ~= nil then
		local crate = ModelFactory.BuildCrate("CUSTOM SERVER\n+$" .. tostring(payout))
		crate:PivotTo(facility.dockCF :: CFrame)
		crate.Parent = facility.crates
		task.delay(CRATE_DESPAWN, function()
			if crate.Parent ~= nil then
				crate:Destroy()
			end
		end)
	end

	playSFX(session.player, "cash")
	return true, ""
end

---------------------------------------------------------------------
-- Persistence
---------------------------------------------------------------------

--[[
	Serialize(session) -> table: every persistent workbench field + the
	visuals list (component ids in install order). No Instance values - this
	payload goes straight into a DataStore.
]]
function WorkbenchBuilderSystem.Serialize(session: any): { [string]: any }
	local wb = session.workbench
	-- Sync OS from the bench node so a finished build keeps its OS on reload.
	local node = session.devices[BENCH_DEVICE_ID]
	if wb.osInstalled == nil and node ~= nil then
		wb.osInstalled = node.osInstalled
	end

	local visuals: { string } = {}
	if wb.mobo ~= nil then
		table.insert(visuals, wb.mobo :: string)
	end
	for _ = 1, wb.cpuCount do
		table.insert(visuals, wb.lastCpuId or "cpu_xeon8")
	end
	for _ = 1, wb.ramSlotsUsed do
		table.insert(visuals, wb.lastRamId or "ram_32g")
	end
	for _ = 1, wb.storageBaysUsed do
		table.insert(visuals, "nvme_1tb")
	end
	if wb.psu ~= nil then
		table.insert(visuals, wb.psu :: string)
	end

	return {
		chassis = wb.chassis,
		mobo = wb.mobo,
		cpuCount = wb.cpuCount,
		cpuSockets = wb.cpuSockets,
		cpuCores = wb.cpuCores,
		ramSlotsUsed = wb.ramSlotsUsed,
		ramSlots = wb.ramSlots,
		ramGb = wb.ramGb,
		storageBaysUsed = wb.storageBaysUsed,
		storageBays = wb.storageBays,
		storageGb = wb.storageGb,
		psu = wb.psu,
		powered = wb.powered == true,
		osInstalled = wb.osInstalled,
		tested = wb.tested == true,
		shipped = wb.shipped == true,
		totalSpent = wb.totalSpent,
		deviceId = wb.deviceId,
		snapIndex = wb.snapIndex,
		lastCpuId = wb.lastCpuId,
		lastRamId = wb.lastRamId,
		visuals = visuals,
	}
end

--[[
	ApplyState(session, data): restores the workbench from a save.
	- sets every wb field (incl. cpuCores / lastCpuId / lastRamId)
	- chassis present -> rebuilds the bench device model (same path as install)
	- data.visuals -> rebuilds the component visuals on the bench snaps
	- complete + powered -> registers the bench node (auto-cable suppressed by
	  loadedFromSave; cables are restored by the persistence link pass)
	- recolors the bench LED
]]
function WorkbenchBuilderSystem.ApplyState(session: any, data: any)
	if type(data) ~= "table" then
		return
	end
	local wb = session.workbench

	wb.chassis = if type(data.chassis) == "string" then data.chassis else nil
	wb.mobo = if type(data.mobo) == "string" then data.mobo else nil
	wb.cpuCount = tonumber(data.cpuCount) or 0
	wb.cpuSockets = tonumber(data.cpuSockets) or 0
	wb.cpuCores = tonumber(data.cpuCores) or 0
	wb.ramSlotsUsed = tonumber(data.ramSlotsUsed) or 0
	wb.ramSlots = tonumber(data.ramSlots) or 0
	wb.ramGb = tonumber(data.ramGb) or 0
	wb.storageBaysUsed = tonumber(data.storageBaysUsed) or 0
	wb.storageBays = tonumber(data.storageBays) or 0
	wb.storageGb = tonumber(data.storageGb) or 0
	wb.psu = if type(data.psu) == "string" then data.psu else nil
	wb.powered = data.powered == true
	wb.osInstalled = if type(data.osInstalled) == "string" then data.osInstalled else nil
	wb.installing = false
	wb.stressRunning = false
	wb.tested = data.tested == true
	wb.shipped = data.shipped == true
	wb.totalSpent = tonumber(data.totalSpent) or 0
	wb.snapIndex = tonumber(data.snapIndex) or 0
	wb.lastCpuId = if type(data.lastCpuId) == "string" then data.lastCpuId else nil
	wb.lastRamId = if type(data.lastRamId) == "string" then data.lastRamId else nil
	wb.deviceId = nil
	wb.benchModel = nil

	-- Rebuild the bench device model through the same path as a live install.
	if wb.chassis ~= nil then
		ensureBenchModel(session)

		-- Rebuild the component visuals (skip the chassis id if present).
		if type(data.visuals) == "table" then
			local snapIdx = 0
			for _, compId in ipairs(data.visuals :: { any }) do
				if type(compId) == "string" and compId ~= wb.chassis then
					local visual = ModelFactory.BuildBenchComponentVisual(compId)
					snapIdx = (snapIdx % 6) + 1
					placeVisual(session, visual, snapIdx)
				end
			end
			wb.snapIndex = snapIdx
		end

		-- Complete + powered -> the bench node comes alive right away.
		if wb.powered and wb.mobo ~= nil and wb.psu ~= nil then
			WorkbenchBuilderSystem.RegisterBenchNode(session)
		end
	end

	local benchLed = session.facility.benchLed
	if benchLed ~= nil and benchLed:IsA("BasePart") then
		benchLed.Color = if wb.powered then LED_GREEN else LED_OFF
	end
end

return WorkbenchBuilderSystem
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX23">
<Properties>
<string name="Name">CarryAndMountSystem</string>
<ProtectedString name="Source"><![CDATA[--!strict
--[[
	CarryAndMountSystem (ModuleScript, ServerScriptService/Physical)
	Fase 2 physical layer for colocation deliveries:
	- SpawnCrate: a client server crate appears on the loading dock when a
	  Colocation contract is accepted (label + "Angkat Crate" prompt)
	- BeginCarry / EndCarry: the crate follows the player's HumanoidRootPart
	  on Heartbeat while every rack exposes a "Pasang Server" prompt
	- MountCarried: validates a free U block, calls PlacementSystem.MountDevice
	  (ColocationServer node, client IP, rack power) and links the ticket
	- DropCarried: puts the crate back on the dock (prompt on the crate)
	- EvaluateColo: ticket acceptance test = powered + switch access VLAN match
	  + reachable from the ISP gateway
	- CleanupTicket: removes the crate and the rack-mounted client server
	No remotes are introduced: every action is a ProximityPrompt on the server.
]]

local RunService = game:GetService("RunService")

local CarryAndMountSystem = {}

local Sessions: any = nil
local Placement: any = nil
local Graph: any = nil
local ModelFactory: any = nil
local Constants: any = nil
local Remotes: any = nil
local Catalog: any = nil

local GATEWAY_DEVICE_ID = "isp_router_1"

---------------------------------------------------------------------
-- Init
---------------------------------------------------------------------

function CarryAndMountSystem.Init(deps: { [string]: any })
	Sessions = deps.sessions
	Placement = deps.placement
	Graph = deps.graph
	ModelFactory = deps.modelFactory
	Constants = deps.constants
	Remotes = deps.remotesFolder
	Catalog = deps.catalog
end

---------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------

local function playSFX(player: Player, name: string)
	local remote = if Remotes ~= nil then Remotes:FindFirstChild("PlaySFXRemote") else nil
	if remote ~= nil then
		(remote :: any):FireClient(player, name)
	end
end

local function hint(player: Player, message: string)
	local remote = if Remotes ~= nil then Remotes:FindFirstChild("OpenTerminalEvent") else nil
	if remote ~= nil then
		(remote :: any):FireClient(player, { action = "hint", message = message })
	end
end

local function findTicket(session: any, ticketId: string): any?
	for _, ticket in ipairs(session.tickets or {}) do
		if ticket.id == ticketId then
			return ticket
		end
	end
	return nil
end

local function cratePart(crate: Model): BasePart?
	local box = crate:FindFirstChild("CrateBox")
	if box ~= nil and box:IsA("BasePart") then
		return box :: BasePart
	end
	for _, desc in ipairs(crate:GetDescendants()) do
		if desc:IsA("BasePart") then
			return desc :: BasePart
		end
	end
	return nil
end

local function removeMountPrompts(session: any)
	for _, rackModel in pairs(session.rackModels) do
		local frame = rackModel:FindFirstChild("SlotFrame", true)
		if frame ~= nil then
			local prompt = frame:FindFirstChild("MountPrompt")
			if prompt ~= nil then
				prompt:Destroy()
			end
		end
	end
end

local function addMountPrompts(session: any)
	local player = session.player
	for rackId, rackModel in pairs(session.rackModels) do
		local frame = rackModel:FindFirstChild("SlotFrame", true)
		if frame ~= nil and frame:IsA("BasePart") and frame:FindFirstChild("MountPrompt") == nil then
			local rack = session.racks[rackId]
			local prompt = Instance.new("ProximityPrompt")
			prompt.Name = "MountPrompt"
			prompt.ActionText = "Pasang Server"
			prompt.ObjectText = if rack ~= nil then rack.name else rackId
			prompt.HoldDuration = 0.35
			prompt.MaxActivationDistance = 18
			prompt.RequiresLineOfSight = false
			prompt.Parent = frame
			prompt.Triggered:Connect(function(triggerer: Player)
				if triggerer ~= player then
					return
				end
				CarryAndMountSystem.MountCarried(session, rackId)
			end)
		end
	end
end

local function setCratePromptText(crate: Model, text: string)
	local part = cratePart(crate)
	if part == nil then
		return
	end
	local prompt = part:FindFirstChildOfClass("ProximityPrompt")
	if prompt ~= nil and prompt:IsA("ProximityPrompt") then
		prompt.ActionText = text
	end
end

local function updateCarry(session: any)
	local carry = session.carry
	if carry == nil then
		return
	end
	local crate = carry.crate
	if crate == nil or crate.Parent == nil then
		CarryAndMountSystem.EndCarry(session)
		return
	end
	local char = session.player.Character
	local hrp = if char ~= nil then char:FindFirstChild("HumanoidRootPart") else nil
	if hrp == nil or not hrp:IsA("BasePart") then
		CarryAndMountSystem.DropCarried(session)
		return
	end
	crate:PivotTo((hrp :: BasePart).CFrame * CFrame.new(0, -1.25, -2.35))
end

---------------------------------------------------------------------
-- Crate lifecycle
---------------------------------------------------------------------

--[[ Creates the client server crate for an accepted Colocation ticket at the
	 loading dock. Returns false when the dock/CF is missing or a crate
	 already exists for this ticket. ]]
function CarryAndMountSystem.SpawnCrate(session: any, ticket: any): boolean
	if session == nil or ticket == nil or type(ticket.id) ~= "string" then
		return false
	end
	if session.colocation.crates[ticket.id] ~= nil then
		return false
	end
	local facility = session.facility
	local dockCF = if type(facility) == "table" then facility.dockCF else nil
	if dockCF == nil then
		return false
	end

	local crate = ModelFactory.BuildCrate("COLOCATION\n" .. tostring(ticket.clientName))
	crate.Name = "ColoCrate_" .. ticket.id
	for _, desc in ipairs(crate:GetDescendants()) do
		if desc:IsA("BasePart") then
			desc.Anchored = true
			desc.CanCollide = false
		end
	end
	-- Keep multiple deliveries side by side on the dock pad.
	local occupied = 0
	for _ in pairs(session.colocation.crates) do
		occupied += 1
	end
	crate:PivotTo((dockCF :: CFrame) * CFrame.new(occupied * 2.9, 0, 0))

	local box = cratePart(crate)
	if box ~= nil then
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "CarryPrompt"
		prompt.ActionText = "Angkat Crate"
		prompt.ObjectText = tostring(ticket.clientName) .. " Colo Server"
		prompt.HoldDuration = 0.2
		prompt.MaxActivationDistance = 14
		prompt.RequiresLineOfSight = false
		prompt.Parent = box
		prompt.Triggered:Connect(function(triggerer: Player)
			if triggerer ~= session.player then
				return
			end
			if session.carry ~= nil and session.carry.crate == crate then
				CarryAndMountSystem.DropCarried(session)
			else
				CarryAndMountSystem.BeginCarry(session, crate, ticket.id)
			end
		end)
	end

	local cratesFolder = if type(facility) == "table" then facility.crates else nil
	crate.Parent = if cratesFolder ~= nil then cratesFolder else facility.root
	session.colocation.crates[ticket.id] = crate
	session.colocation.byTicket[ticket.id] = crate
	hint(session.player, "Crate colocation tiba di Loading Dock. Angkat lalu pasang di rack.")
	playSFX(session.player, "key")
	return true
end

function CarryAndMountSystem.BeginCarry(session: any, crate: Model, ticketId: string)
	if session.carry ~= nil then
		hint(session.player, "Kamu sudah membawa crate. Pasang dulu di rack.")
		return
	end
	local char = session.player.Character
	local hrp = if char ~= nil then char:FindFirstChild("HumanoidRootPart") else nil
	if hrp == nil then
		hint(session.player, "Karakter belum siap.")
		return
	end

	session.carry = {
		crate = crate,
		ticketId = ticketId,
		conn = RunService.Heartbeat:Connect(function()
			updateCarry(session)
		end),
	}
	setCratePromptText(crate, "Turunkan Crate")
	addMountPrompts(session)
	updateCarry(session)
	playSFX(session.player, "key")
	hint(session.player, "Crate diangkat. Dekati rack dan tekan 'Pasang Server'.")
end

function CarryAndMountSystem.EndCarry(session: any)
	local carry = session.carry
	if carry == nil then
		return
	end
	if carry.conn ~= nil then
		carry.conn:Disconnect()
	end
	if carry.crate ~= nil and carry.crate.Parent ~= nil then
		setCratePromptText(carry.crate, "Angkat Crate")
	end
	session.carry = nil
	removeMountPrompts(session)
end

--[[ Puts the carried crate back on the dock (or in front of the player). ]]
function CarryAndMountSystem.DropCarried(session: any)
	local carry = session.carry
	if carry == nil then
		return
	end
	local crate = carry.crate
	local dockCF = if type(session.facility) == "table" then session.facility.dockCF else nil
	if crate ~= nil and crate.Parent ~= nil and dockCF ~= nil then
		crate:PivotTo(dockCF :: CFrame)
	end
	CarryAndMountSystem.EndCarry(session)
	hint(session.player, "Crate diturunkan di Loading Dock.")
	playSFX(session.player, "plug")
end

--[[ Mounts the carried crate into the first free U block of a rack. ]]
function CarryAndMountSystem.MountCarried(session: any, rackId: string): boolean
	local carry = session.carry
	if carry == nil then
		hint(session.player, "Tidak ada crate yang dibawa.")
		return false
	end
	local ticket = findTicket(session, carry.ticketId)
	if ticket == nil or ticket.status ~= "Active" then
		hint(session.player, "Kontrak colocation tidak aktif.")
		return false
	end
	local rack = session.racks[rackId]
	if rack == nil then
		hint(session.player, "Rack tidak ditemukan.")
		return false
	end

	local colo = Constants.COLOCATION
	local uSize = colo.uSize
	local uSlot = Placement.FindFreeUSlot(session, rackId, uSize)
	if uSlot == nil then
		hint(session.player, string.format("Rack %s tidak punya ruang %dU kosong.", rack.name, uSize))
		playSFX(session.player, "error")
		return false
	end

	local itemId = "bm_starter"
	local def = Catalog.Get(itemId)
	local displayName = tostring(ticket.clientName) .. " Colo Server"
	local ok, result = Placement.MountDevice(session, itemId, rackId, uSlot, {
		name = displayName,
		deviceType = "ColocationServer",
		ip = ticket.targetIp,
		gateway = "192.168.1.1",
		subnetMask = "255.255.255.0",
		osInstalled = "ubuntu-22.04",
		isPowered = rack.pduPowered,
		contractId = ticket.id,
		noAutoCable = true,
		idPrefix = "colo",
	})
	if not ok then
		hint(session.player, "Gagal mount: " .. tostring(result))
		playSFX(session.player, "error")
		return false
	end

	ticket.targetDeviceId = result
	ticket.targetRackId = rackId
	ticket.targetUSlot = uSlot
	ticket.phase = "mounted"
	ticket.validationText = "Terpasang - kabel ke switch, atur VLAN, PDU ON"

	local crate = carry.crate
	if crate ~= nil then
		crate:Destroy()
	end
	session.colocation.crates[ticket.id] = nil
	session.colocation.byTicket[ticket.id] = nil
	CarryAndMountSystem.EndCarry(session)

	playSFX(session.player, "plug")
	local ourU = uSlot - (def ~= nil and def.uSize or uSize) + 1
	hint(session.player, string.format(
		"Server klien terpasang di %s U%d-%d. Kabel ke switch, set VLAN %d, nyalakan PDU.",
		rack.name,
		math.max(1, ourU),
		uSlot,
		ticket.vlanId or 1
	))
	return true
end

---------------------------------------------------------------------
-- Colocation validation & cleanup
---------------------------------------------------------------------

--[[ Returns (ready, validationText) for an active Colocation ticket. ]]
function CarryAndMountSystem.EvaluateColo(session: any, ticket: any): (boolean, string)
	local deviceId = ticket.targetDeviceId
	if deviceId == nil then
		return false, "Crate belum dipasang di rack"
	end
	local node = session.devices[deviceId]
	if node == nil then
		return false, "Server klien tidak ditemukan"
	end
	if not node.isPowered then
		return false, "PDU rack OFF - nyalakan PDU"
	end
	local accessSwitch, accessPortId = Graph.GetAccessSwitchPort(session, deviceId)
	if accessSwitch == nil or accessPortId == nil then
		return false, "Belum ada kabel ke switch"
	end
	local port = accessSwitch.ports[accessPortId]
	if port == nil then
		return false, "Port switch tidak ditemukan"
	end
	local wanted = ticket.vlanId or 1
	if port.isTrunk == true then
		return false, "Port access masih trunk - set mode access + VLAN " .. tostring(wanted)
	end
	if port.vlanId ~= wanted then
		return false, string.format("VLAN switch %d != %d", port.vlanId, wanted)
	end
	if node.ip == nil then
		return false, "Server klien belum punya IP"
	end
	local reachable = Graph.CanReachIP(session, GATEWAY_DEVICE_ID, node.ip)
	if not reachable then
		return false, "Tidak reachable dari gateway - cek kabel uplink/VLAN"
	end
	return true, string.format("Reachable dari gateway di VLAN %d", port.vlanId)
end

--[[ Removes every physical trace of a ticket: crate and mounted server. ]]
function CarryAndMountSystem.CleanupTicket(session: any, ticket: any)
	if session == nil or ticket == nil then
		return
	end
	local crate = session.colocation.crates[ticket.id]
	if crate ~= nil then
		crate:Destroy()
		session.colocation.crates[ticket.id] = nil
		session.colocation.byTicket[ticket.id] = nil
	end
	local deviceId = ticket.targetDeviceId
	if type(deviceId) == "string" and session.devices[deviceId] ~= nil then
		Placement.UnmountDevice(session, deviceId)
	end
	ticket.targetDeviceId = nil
	ticket.targetRackId = nil
	ticket.targetUSlot = nil
end

--[[ Tick guard: if the carried character disappears, drop the crate. ]]
function CarryAndMountSystem.Update(session: any)
	if session.carry == nil then
		return
	end
	local char = session.player.Character
	if char == nil or char:FindFirstChild("HumanoidRootPart") == nil then
		CarryAndMountSystem.DropCarried(session)
	end
end

return CarryAndMountSystem
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="Folder" referent="RBX24">
<Properties>
<string name="Name">Gameplay</string>
</Properties>
<Item class="ModuleScript" referent="RBX25">
<Properties>
<string name="Name">ShiftAndEconomyManager</string>
<ProtectedString name="Source"><![CDATA[--!strict
--[[
	ShiftAndEconomyManager (ModuleScript, ServerScriptService/Gameplay)
	AGENT C - Fase 1.

	Economy tick (every ECONOMY.tickSeconds = 5s) per session:
	  - VM load jitter: running VMs get a smoothed currentLoadPercent toward a
	    random 35..95 target, capped by cpuThrottlePercent (status "throttled"
	    while a throttle limit > 0 is set); stopped VMs sit at 0.
	  - Device loadPercent = sum(vm.cpu * vmLoad / 100) / specs.cpu * 100.
	  - Thermal sim: temperatureC = 30 + loadPercent * 0.45; at >= 80 C the
	    model's "OverheatSmoke" ParticleEmitter is enabled, otherwise disabled.
	  - Power cost per tick: sum of powered device powerWatts + 40 W per rack
	    with pduPowered; balance -= watts * electricityPerWattPerTick (clamp >= 0).
	  - Payout every ECONOMY.payoutInterval (15s = 3 ticks): per VM hosted on a
	    powered device that has an IP: cpu*vpsCpuRate + ram*vpsRamRate + disk*vpsDiskRate.
	  - cabling.Update(session): console cable distance check.
	  - BuildSnapshot -> StateSyncRemote:FireClient.

	Fase 1 runs 24/7 (no shift clock / daily settlement - that is Fase 3 scope,
	see CONTRACT.md Section 9). clockText in the snapshot reflects that.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local NetworkTypes = require(ReplicatedStorage.Shared.NetworkTypes)
local PlotConstants = require(ReplicatedStorage.Shared.PlotConstants)

local ShiftAndEconomyManager = {}

type FacilitySnapshot = NetworkTypes.FacilitySnapshot
type DeviceSnapshot = NetworkTypes.DeviceSnapshot
type VMStatus = NetworkTypes.VMStatus

type VMSnapshotRow = {
	name: string,
	hostId: string,
	cpu: number,
	ram: number,
	disk: number,
	ip: string?,
	status: VMStatus,
	loadPercent: number,
}

type VMLike = {
	name: string,
	cpu: number,
	ram: number,
	disk: number,
	assignedIp: string?,
	cpuThrottlePercent: number,
	currentLoadPercent: number,
	status: VMStatus,
}

-- Session tables are constructed by SessionManager (Agent A) and cross-module
-- state is intentionally dynamic; only the snapshot output is strictly typed.
type SessionLike = any

local sessions: any = nil
local graph: any = nil
local constants: any = PlotConstants
local remotesFolder: any = nil
local cabling: any = nil
local stateSyncRemote: any = nil

local rng = Random.new()
local tickCounter = 0

-- Fraction of the distance to the new jitter target applied per tick (smoothing).
local LOAD_SMOOTHING = 0.4
-- Room/base temperature used when a device carries no meaningful load.
local BASE_TEMP_C = 30
-- Smoke kicks in at this temperature (per spec: >= 80 C enables OverheatSmoke).
local SMOKE_TEMP_C = 80
-- Fixed idle draw of a powered rack PDU (watts), per contract Section 6.
local RACK_IDLE_WATTS = 40

local function getRemote(): any
	if stateSyncRemote ~= nil and stateSyncRemote.Parent ~= nil then
		return stateSyncRemote
	end
	if remotesFolder == nil then
		return nil
	end
	local remote = remotesFolder:FindFirstChild("StateSyncRemote")
	if remote ~= nil then
		stateSyncRemote = remote
	end
	return stateSyncRemote
end

--[[ Total uptime percent: producing VMs / total VMs (100 when no VM exists).
	 A VM counts as producing when its host is powered, has an IP, and the VM
	 is not stopped. ]]
local function computeUptimePercent(session: SessionLike): number
	local total = 0
	local producing = 0
	for _, node in pairs(session.devices) do
		for _, vm: VMLike in pairs(node.vms) do
			total += 1
			if node.isPowered and node.ip ~= nil and vm.status ~= "stopped" then
				producing += 1
			end
		end
	end
	if total == 0 then
		return 100
	end
	return (producing / total) * 100
end

--[[ Live power draw in watts: powered devices' powerWatts + 40 W per powered rack. ]]
local function computePowerWatts(session: SessionLike): number
	local watts = 0
	for _, node in pairs(session.devices) do
		if node.isPowered then
			local specs = node.specs
			watts += (specs ~= nil and specs.powerWatts) or 0
		end
	end
	for _, rack in pairs(session.racks) do
		if rack.pduPowered then
			watts += RACK_IDLE_WATTS
		end
	end
	return watts
end

--[[ VM load jitter + device load aggregation + thermal sim + overheat smoke. ]]
local function applyLoadAndThermal(session: SessionLike)
	for deviceId, node in pairs(session.devices) do
		local model = session.deviceModels[deviceId]
		local specs = node.specs
		local hostCpu = (specs ~= nil and specs.cpu) or 0
		local totalLoad = 0

		for _, vm: VMLike in pairs(node.vms) do
			if vm.status == "stopped" then
				vm.currentLoadPercent = 0
			else
				local throttle = vm.cpuThrottlePercent or 0
				local target = rng:NextInteger(35, 95)
				if throttle > 0 then
					-- Throttle limit caps the load; status stays throttled while set.
					target = math.min(target, throttle)
					vm.status = "throttled"
				end
				local current = vm.currentLoadPercent or 0
				current += (target - current) * LOAD_SMOOTHING
				vm.currentLoadPercent = math.clamp(current, 0, 100)
				totalLoad += vm.cpu * vm.currentLoadPercent / 100
			end
		end

		local loadPercent = 0
		if hostCpu > 0 then
			loadPercent = math.clamp(totalLoad / hostCpu * 100, 0, 100)
		end
		-- loadPercent lives as a dynamic node field (DeviceSnapshot needs it).
		node.loadPercent = loadPercent
		node.temperatureC = BASE_TEMP_C + loadPercent * 0.45

		if model ~= nil then
			local smoking = node.temperatureC >= SMOKE_TEMP_C
			for _, desc in ipairs(model:GetDescendants()) do
				if desc:IsA("ParticleEmitter") and desc.Name == "OverheatSmoke" then
					desc.Enabled = smoking
				end
			end
		end
	end
end

--[[ Electricity bill for this tick (clamped so balance never goes negative). ]]
local function chargeElectricity(session: SessionLike)
	local watts = computePowerWatts(session)
	local cost = watts * constants.ECONOMY.electricityPerWattPerTick
	session.balance = math.max(0, session.balance - cost)
end

--[[ VPS income every payoutInterval: per VM on a powered host with an IP set. ]]
local function payVpsIncome(session: SessionLike)
	local economy = constants.ECONOMY
	local income = 0
	for _, node in pairs(session.devices) do
		if node.isPowered and node.ip ~= nil then
			for _, vm: VMLike in pairs(node.vms) do
				income += vm.cpu * economy.vpsCpuRatePerPayout
				income += vm.ram * economy.vpsRamRatePerPayout
				income += vm.disk * economy.vpsDiskRatePerPayout
			end
		end
	end
	if income > 0 then
		session.balance += income
	end
end

--[[ Objective booleans computed live from session state (keys fixed by contract). ]]
local function computeObjectives(session: SessionLike): { [string]: boolean }
	local objectives: { [string]: boolean } = {}

	local bm = session.devices["bm_starter_1"]
	local cableWired = false
	if bm ~= nil then
		for _, port in pairs(bm.ports) do
			if port.connectedToDeviceId ~= nil and port.portType ~= "Console" then
				cableWired = true
				break
			end
		end
	end
	objectives.cableWired = cableWired
	objectives.ipSetStarter = bm ~= nil and bm.ip ~= nil
	objectives.osInstalledStarter = bm ~= nil and bm.osInstalled ~= nil
	objectives.pingGateway = session.flags.pingGateway == true
	objectives.vmCreated = ShiftAndEconomyManager.sessionHasAnyVM(session)

	local wb = session.workbench
	objectives.benchBuilt = wb ~= nil and wb.psu ~= nil
	local benchNode = session.devices["bench_1"]
	objectives.benchOsInstalled = benchNode ~= nil and benchNode.osInstalled ~= nil
	objectives.stressPassed = wb ~= nil and wb.tested == true
	objectives.shipped = wb ~= nil and wb.shipped == true

	return objectives
end

function ShiftAndEconomyManager.sessionHasAnyVM(session: SessionLike): boolean
	for _, node in pairs(session.devices) do
		if next(node.vms) ~= nil then
			return true
		end
	end
	return false
end

--[[ Build the full FacilitySnapshot for a session (shape = NetworkTypes.FacilitySnapshot). ]]
function ShiftAndEconomyManager.BuildSnapshot(session: SessionLike): FacilitySnapshot
	local deviceSnapshots: { DeviceSnapshot } = {}
	local vmRows: { VMSnapshotRow } = {}
	local tempSum = 0
	local poweredCount = 0

	for id, node in pairs(session.devices) do
		-- peers = names of devices connected on any port (deduped)
		local peers: { string } = {}
		local seen: { [string]: boolean } = {}
		for _, port in pairs(node.ports) do
			local peerId = port.connectedToDeviceId
			if peerId ~= nil then
				local peer = session.devices[peerId]
				local peerName = if peer ~= nil then peer.name else peerId
				if not seen[peerName] then
					seen[peerName] = true
					table.insert(peers, peerName)
				end
			end
		end

		local vmCount = 0
		for _, vm: VMLike in pairs(node.vms) do
			vmCount += 1
			table.insert(vmRows, {
				name = vm.name,
				hostId = id,
				cpu = vm.cpu,
				ram = vm.ram,
				disk = vm.disk,
				ip = vm.assignedIp,
				status = vm.status,
				loadPercent = vm.currentLoadPercent or 0,
			})
		end

		if node.isPowered then
			tempSum += node.temperatureC or BASE_TEMP_C
			poweredCount += 1
		end

		local snapshot: DeviceSnapshot = {
			id = id,
			name = node.name,
			deviceType = node.deviceType,
			ip = node.ip,
			isPowered = node.isPowered,
			temperatureC = node.temperatureC or BASE_TEMP_C,
			loadPercent = node.loadPercent or 0,
			vmCount = vmCount,
			peers = peers,
		}
		table.insert(deviceSnapshots, snapshot)
	end

	local avgTempC = if poweredCount > 0 then tempSum / poweredCount else 0

	local ticketRows = {}
	for _, t in ipairs(session.tickets or {}) do
		table.insert(ticketRows, {
			id = t.id,
			category = t.category,
			title = t.title,
			description = t.description,
			rewardPayout = t.rewardPayout,
			status = t.status,
			requirementsText = t.requirementsText or "",
			slaRemainingSec = t.slaRemainingSec,
			payoutIntervalSec = t.payoutIntervalSec,
			validationText = t.validationText or "",
			vlanId = t.vlanId,
		})
	end

	local snapshot: FacilitySnapshot = {
		plotIndex = session.plotIndex,
		balance = session.balance,
		reputation = session.reputation,
		uptimePercent = computeUptimePercent(session),
		powerWatts = computePowerWatts(session),
		avgTempC = avgTempC,
		storm = session.broadcastStorm == true,
		day = session.day,
		-- Fase 1 has no shift clock yet (Fase 3 scope); the lab runs 24/7.
		clockText = "24/7",
		devices = deviceSnapshots,
		vms = vmRows,
		objectives = computeObjectives(session),
		tickets = ticketRows,
	}
	return snapshot
end

--[[ Immediately build and push a snapshot to this session's player. ]]
function ShiftAndEconomyManager.ForceSync(session: SessionLike)
	local remote = getRemote()
	if remote == nil then
		return
	end
	remote:FireClient(session.player, ShiftAndEconomyManager.BuildSnapshot(session))
end

--[[ One economy tick for one session. ]]
local function tickSession(session: SessionLike, isPayoutTick: boolean)
	applyLoadAndThermal(session)
	chargeElectricity(session)
	if isPayoutTick then
		payVpsIncome(session)
	end
	if cabling ~= nil and type(cabling.Update) == "function" then
		cabling.Update(session) -- console cable distance check (> 18 studs detaches)
	end
	ShiftAndEconomyManager.ForceSync(session)
end

function ShiftAndEconomyManager.Init(deps: { [string]: any })
	sessions = deps.sessions
	graph = deps.graph
	constants = deps.constants or PlotConstants
	remotesFolder = deps.remotesFolder
	cabling = deps.cabling
	if remotesFolder ~= nil then
		stateSyncRemote = remotesFolder:FindFirstChild("StateSyncRemote")
	end
end

--[[ Main loop: every ECONOMY.tickSeconds, tick every session; payout every
	 ECONOMY.payoutInterval (tracked via a tick counter, 15s / 5s = every 3rd tick). ]]
function ShiftAndEconomyManager.Start()
	local economy = constants.ECONOMY
	local tickSeconds = economy.tickSeconds
	local payoutEvery = math.max(1, math.floor(economy.payoutInterval / tickSeconds + 0.5))

	task.spawn(function()
		while true do
			task.wait(tickSeconds)
			tickCounter += 1
			local isPayoutTick = (tickCounter % payoutEvery == 0)
			local allSessions = if sessions ~= nil then sessions.GetAllSessions() else nil
			if allSessions ~= nil then
				for _, session in pairs(allSessions) do
					local ok, err = pcall(tickSession, session, isPayoutTick)
					if not ok then
						warn("[ShiftAndEconomyManager] tick error: " .. tostring(err))
					end
				end
			end
		end
	end)
end

return ShiftAndEconomyManager
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX26">
<Properties>
<string name="Name">ContractAndIncidentManager</string>
<ProtectedString name="Source"><![CDATA[--!strict
--[[
	ContractAndIncidentManager (ModuleScript, ServerScriptService/Gameplay)
	AGENT C - Fase 1 + Fase 2 contract pool.

	FASE 2 SCOPE: three contract pillars (CloudVPS, Colocation, CustomBuild)
	with a live SLA. There is still intentionally NO incident engine in this
	file: Cable Fault, DDoS Flood, Noisy Neighbor and Remote Hands Drive
	Failure are Fase 3 scope per CONTRACT.md Section 9 (the AlarmBeacon stays
	decorative).

	Ticket flow (tickets live in session.tickets as an array of
	ContractTicket-like tables, plus a requirementsText field for the UI):
	  - Loop every 5s per session: top up to 3 Available tickets, always
	    filling the category with the fewest Available rows.
	  - CloudVPS specs: cpu 2..8, ram 4..32, disk 50..500; reward scaled
	    (cpu*60 + ram*2 + disk*0.1, minimum 120).
	  - CustomBuild: reward 250..600, fixed requirementsText.
	  - Colocation: client wants a server hosted in the player's rack on a
	    dedicated VLAN. Accept -> crate spawns at the dock after 3s ->
	    carry/mount -> cable + switch VLAN + PDU ON -> reachable from the
	    gateway. SLA 240s. While running, the client pays rewardPayout every
	    10s for 60s, then collects the server.
	  - ContractActionRemote {action="accept", ticketId}: Available -> Active,
	    max 2 Active tickets per session.
	  - Active validation each pass:
	      CloudVPS    = any powered BareMetal with an OS hosts a big-enough VM.
	      CustomBuild = session.workbench.shipped.
	      Colocation  = CarryAndMountSystem.EvaluateColo (powered, VLAN match,
	                    gateway reachability).
	  - Completion pays the reward, reputation and SFX; Failed (SLA expiry)
	    plays the error SFX. Both linger briefly before removal.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local NetworkTypes = require(ReplicatedStorage.Shared.NetworkTypes)

local ContractAndIncidentManager = {}

type TicketCategory = NetworkTypes.TicketCategory
type TicketStatus = NetworkTypes.TicketStatus

--[[ ContractTicket plus the UI-only requirementsText row. ]]
export type TicketRow = NetworkTypes.ContractTicket & {
	requirementsText: string,
}

type SessionLike = any

local MAX_AVAILABLE_TICKETS = 3
local MAX_ACTIVE_TICKETS = 2
local LOOP_SECONDS = 5
local COMPLETED_LINGER_SECONDS = 8
local DEFAULT_SLA_SECONDS = 300
local CATEGORY_ORDER: { string } = { "CloudVPS", "Colocation", "CustomBuild" }

local sessions: any = nil
local graph: any = nil
local constants: any = nil
local remotesFolder: any = nil
local workbench: any = nil
local carry: any = nil

local contractRemote: any = nil
local playSFXRemote: any = nil
local openTerminalRemote: any = nil
local acceptBound = false

local rng = Random.new()
local ticketCounter = 0

-- Eight invented client names for contract flavor.
local CLIENT_NAMES = {
	"PT Andalan Cloud",
	"CV Mitra Data",
	"Kafe BitRasa",
	"Studio Arus Media",
	"Koperasi Digital Nusa",
	"Toko Kompona",
	"Warung Kopi Server",
	"Startup Lokal Dev",
}

local function randomChoice(list: { any }): any
	return list[rng:NextInteger(1, #list)]
end

local function getRemotes()
	if contractRemote == nil and remotesFolder ~= nil then
		contractRemote = remotesFolder:FindFirstChild("ContractActionRemote")
	end
	if playSFXRemote == nil and remotesFolder ~= nil then
		playSFXRemote = remotesFolder:FindFirstChild("PlaySFXRemote")
	end
	if openTerminalRemote == nil and remotesFolder ~= nil then
		openTerminalRemote = remotesFolder:FindFirstChild("OpenTerminalEvent")
	end
end

local function playSFX(session: SessionLike, name: string)
	if playSFXRemote ~= nil then
		playSFXRemote:FireClient(session.player, name)
	end
end

local function sendHint(session: SessionLike, message: string)
	if openTerminalRemote ~= nil then
		openTerminalRemote:FireClient(session.player, { action = "hint", message = message })
	end
end

local function nextTicketId(): string
	ticketCounter += 1
	return string.format("tkt_%d_%d", math.floor(os.clock() * 1000), ticketCounter)
end

---------------------------------------------------------------------
-- Ticket factories
---------------------------------------------------------------------

local function makeCloudVPSTicket(): TicketRow
	local clientName = randomChoice(CLIENT_NAMES) :: string
	local cpu = rng:NextInteger(2, 8)
	local ram = rng:NextInteger(4, 32)
	local disk = rng:NextInteger(50, 500)
	local reward = math.max(120, math.floor(cpu * 60 + ram * 2 + disk * 0.1))

	local ticket: TicketRow = {
		id = nextTicketId(),
		category = "CloudVPS" :: TicketCategory,
		clientName = clientName,
		title = string.format("Cloud VPS %d vCPU", cpu),
		description = string.format(
			"%s sewa VPS: %d vCPU / %dGB RAM / %dGB disk. Jalankan VM-nya di bare-metal kamu. SLA %d detik.",
			clientName,
			cpu,
			ram,
			disk,
			DEFAULT_SLA_SECONDS
		),
		requirements = { cpu = cpu, ram = ram, disk = disk },
		rewardPayout = reward,
		payoutIntervalSec = nil,
		slaRemainingSec = nil,
		runtimeRemainingSec = nil,
		vlanId = nil,
		targetIp = nil,
		phase = nil,
		validationText = "Menunggu VM yang cocok",
		targetDeviceId = nil,
		targetRackId = nil,
		targetUSlot = nil,
		status = "Available" :: TicketStatus,
		requirementsText = string.format(
			"VM >= %d vCPU / %dGB RAM / %dGB disk di bare-metal powered + OS ter-install",
			cpu,
			ram,
			disk
		),
	}
	return ticket
end

local function makeCustomBuildTicket(): TicketRow
	local clientName = randomChoice(CLIENT_NAMES) :: string
	local reward = rng:NextInteger(250, 600)

	local ticket: TicketRow = {
		id = nextTicketId(),
		category = "CustomBuild" :: TicketCategory,
		clientName = clientName,
		title = "Custom Server Build",
		description = string.format(
			"%s pesan server rakitan custom, bayaran di depan setelah unit dikirim dari dock. SLA %d detik.",
			clientName,
			DEFAULT_SLA_SECONDS
		),
		requirements = {},
		rewardPayout = reward,
		payoutIntervalSec = nil,
		slaRemainingSec = nil,
		runtimeRemainingSec = nil,
		vlanId = nil,
		targetIp = nil,
		phase = nil,
		validationText = "Rakit + install OS + stress test + ship",
		targetDeviceId = nil,
		targetRackId = nil,
		targetUSlot = nil,
		status = "Available" :: TicketStatus,
		requirementsText = "Rakit server di workbench + install OS + stress test + ship",
	}
	return ticket
end

local function makeColocationTicket(): TicketRow
	local clientName = randomChoice(CLIENT_NAMES) :: string
	local vlanChoices: { number } = constants.COLOCATION.vlanChoices
	local vlanId = randomChoice(vlanChoices) :: number
	local ip = string.format("10.20.%d.%d", vlanId, rng:NextInteger(10, 200))
	local reward = rng:NextInteger(35, 70)
	local colo = constants.COLOCATION

	local ticket: TicketRow = {
		id = nextTicketId(),
		category = "Colocation" :: TicketCategory,
		clientName = clientName,
		title = string.format("Colocation VLAN %d", vlanId),
		description = string.format(
			"%s kirim server fisik untuk di-hosting di rack kamu. Pasang unit, kabel ke switch VLAN %d, nyalakan PDU, lalu pastikan reachable dari gateway. Kontrak $%d tiap %d detik selama %d detik.",
			clientName,
			vlanId,
			reward,
			colo.payoutIntervalSeconds,
			colo.runtimeSeconds
		),
		requirements = { vlanId = vlanId, ip = ip },
		rewardPayout = reward,
		payoutIntervalSec = colo.payoutIntervalSeconds,
		slaRemainingSec = nil,
		runtimeRemainingSec = nil,
		vlanId = vlanId,
		targetIp = ip,
		phase = nil,
		validationText = "Terima kontrak untuk memanggil crate ke dock",
		targetDeviceId = nil,
		targetRackId = nil,
		targetUSlot = nil,
		status = "Available" :: TicketStatus,
		requirementsText = string.format(
			"Mount crate %dU di rack, kabel ke switch VLAN %d, PDU ON, ping dari gateway OK. SLA %d detik.",
			colo.uSize,
			vlanId,
			colo.slaSeconds
		),
	}
	return ticket
end

--[[ Top up Available tickets, always filling the category with the fewest
	 Available rows so the three pillars rotate naturally. ]]
local function generateTickets(session: SessionLike)
	local available: { [string]: number } = { CloudVPS = 0, Colocation = 0, CustomBuild = 0 }
	for _, t in ipairs(session.tickets) do
		if t.status == "Available" and available[t.category] ~= nil then
			available[t.category] += 1
		end
	end

	local totalAvailable = available.CloudVPS + available.Colocation + available.CustomBuild
	while totalAvailable < MAX_AVAILABLE_TICKETS do
		local category = CATEGORY_ORDER[1]
		local lowest = available[category]
		for _, candidate in ipairs(CATEGORY_ORDER) do
			if available[candidate] < lowest then
				lowest = available[candidate]
				category = candidate
			end
		end

		local ticket: TicketRow
		if category == "CloudVPS" then
			ticket = makeCloudVPSTicket()
		elseif category == "Colocation" then
			ticket = makeColocationTicket()
		else
			ticket = makeCustomBuildTicket()
		end
		table.insert(session.tickets, ticket)
		available[category] += 1
		totalAvailable += 1
	end
end

---------------------------------------------------------------------
-- Validation
---------------------------------------------------------------------

--[[ CloudVPS done when a powered BareMetal with an OS hosts a big-enough VM. ]]
local function cloudVPSComplete(session: SessionLike, requirements: any): boolean
	local reqCpu = (type(requirements) == "table" and requirements.cpu) or 0
	local reqRam = (type(requirements) == "table" and requirements.ram) or 0
	local reqDisk = (type(requirements) == "table" and requirements.disk) or 0
	for _, node in pairs(session.devices) do
		if node.deviceType == "BareMetal" and node.osInstalled ~= nil and node.isPowered then
			for _, vm in pairs(node.vms) do
				if vm.cpu >= reqCpu and vm.ram >= reqRam and vm.disk >= reqDisk then
					return true
				end
			end
		end
	end
	return false
end

--[[ Keep a finished row visible for one or two syncs, then remove it. ]]
local function scheduleRemoval(session: SessionLike, ticketId: string)
	local player = session.player
	task.delay(COMPLETED_LINGER_SECONDS, function()
		if sessions.GetSession(player) ~= session then
			return
		end
		for idx = #session.tickets, 1, -1 do
			local row = session.tickets[idx]
			if row.id == ticketId and (row.status == "Completed" or row.status == "Failed") then
				table.remove(session.tickets, idx)
			end
		end
	end)
end

local function completeColocation(session: SessionLike, ticket: any)
	ticket.status = "Completed"
	ticket.phase = "closed"
	ticket.validationText = "Kontrak selesai - klien mengambil server"
	session.reputation += 2
	playSFX(session, "cash")
	sendHint(session, string.format("Kontrak colocation selesai: %s (semua payout sudah dibayar)", ticket.title))
	local coloCleanup = constants.COLOCATION.cleanupDelaySeconds
	task.delay(coloCleanup, function()
		if sessions.GetSession(session.player) == session then
			if carry ~= nil then
				carry.CleanupTicket(session, ticket)
			end
		end
	end)
	scheduleRemoval(session, ticket.id)
end

--[[ Counts down a non-colocation SLA. Returns true when it just expired. ]]
local function tickSla(ticket: any): boolean
	if ticket.slaRemainingSec == nil then
		ticket.slaRemainingSec = DEFAULT_SLA_SECONDS
	end
	ticket.slaRemainingSec = math.max(0, ticket.slaRemainingSec - LOOP_SECONDS)
	return ticket.slaRemainingSec <= 0
end

local function failContract(session: SessionLike, ticket: any, reason: string)
	ticket.status = "Failed"
	ticket.validationText = reason
	playSFX(session, "error")
	sendHint(session, string.format("Kontrak gagal: %s (%s)", ticket.title, reason))
	scheduleRemoval(session, ticket.id)
end

local function failColocation(session: SessionLike, ticket: any, reason: string)
	ticket.status = "Failed"
	ticket.phase = "closed"
	ticket.validationText = reason
	playSFX(session, "error")
	sendHint(session, string.format("Kontrak colocation gagal: %s (%s)", ticket.title, reason))
	if carry ~= nil then
		carry.CleanupTicket(session, ticket)
	end
	scheduleRemoval(session, ticket.id)
end

--[[ Mark completed Active tickets, pay out, and schedule removal from the list. ]]
local function validateActiveTickets(session: SessionLike)
	for _, t in ipairs(session.tickets) do
		if t.status ~= "Active" then
			continue
		end

		if t.category == "CloudVPS" then
			if cloudVPSComplete(session, t.requirements) then
				t.status = "Completed"
				session.balance += t.rewardPayout
				session.reputation += 1
				playSFX(session, "cash")
				sendHint(session, string.format("Kontrak selesai: %s +$%d", t.title, t.rewardPayout))
				scheduleRemoval(session, t.id)
			elseif tickSla(t) then
				failContract(session, t, "SLA habis sebelum VM siap")
				continue
			else
				t.validationText = string.format("Menunggu VM yang cocok - SLA %ds", t.slaRemainingSec)
			end
		elseif t.category == "CustomBuild" then
			-- session.workbench is the live state source (deps.workbench is the
			-- module handle kept for API compliance with the contract).
			if session.workbench.shipped == true then
				t.status = "Completed"
				session.balance += t.rewardPayout
				session.reputation += 1
				playSFX(session, "cash")
				sendHint(session, string.format("Kontrak selesai: %s +$%d", t.title, t.rewardPayout))
				scheduleRemoval(session, t.id)
			elseif tickSla(t) then
				failContract(session, t, "SLA habis sebelum build dikirim")
				continue
			else
				t.validationText = string.format("Menunggu build dikirim - SLA %ds", t.slaRemainingSec)
			end
		elseif t.category == "Colocation" then
			if t.phase == "running" then
				t.runtimeRemainingSec = math.max(0, (t.runtimeRemainingSec or 0) - LOOP_SECONDS)
				t.payoutTimer = (t.payoutTimer or 0) + LOOP_SECONDS
				local interval = t.payoutIntervalSec or constants.COLOCATION.payoutIntervalSeconds
				if t.payoutTimer >= interval then
					t.payoutTimer -= interval
					session.balance += t.rewardPayout
					playSFX(session, "cash")
					sendHint(session, string.format("%s: payout colocation +$%d", t.title, t.rewardPayout))
				end
				if t.runtimeRemainingSec <= 0 then
					completeColocation(session, t)
				else
					t.validationText = string.format("Layanan jalan - sisa %d dtk", t.runtimeRemainingSec)
				end
			elseif t.status == "Active" then
				if t.slaRemainingSec == nil then
					t.slaRemainingSec = constants.COLOCATION.slaSeconds
				end
				t.slaRemainingSec = math.max(0, t.slaRemainingSec - LOOP_SECONDS)
				if t.slaRemainingSec <= 0 then
					failColocation(session, t, "SLA habis sebelum server valid")
					continue
				end
				if carry ~= nil then
					local ready, message = carry.EvaluateColo(session, t)
					t.validationText = message
					if ready then
						t.phase = "running"
						t.runtimeRemainingSec = constants.COLOCATION.runtimeSeconds
						t.payoutTimer = 0
						playSFX(session, "cash")
						sendHint(session, string.format("Colocation aktif: %s - payout tiap %d dtk", t.title, t.payoutIntervalSec or 10))
					elseif t.phase == "mounted" and t.slaRemainingSec <= 30 then
						sendHint(session, string.format("SLA %s tinggal %d dtk: %s", t.title, t.slaRemainingSec, message))
					end
				end
			end
		end
	end
end

---------------------------------------------------------------------
-- Accept
---------------------------------------------------------------------

--[[ ContractActionRemote handler: {action="accept", ticketId} -> Available -> Active. ]]
local function onAccept(player: Player, payload: any)
	if type(payload) ~= "table" or payload.action ~= "accept" then
		return
	end
	local session = sessions.GetSession(player)
	if session == nil then
		return
	end
	local ticketId = payload.ticketId
	if type(ticketId) ~= "string" then
		return
	end

	local activeCount = 0
	for _, t in ipairs(session.tickets) do
		if t.status == "Active" then
			activeCount += 1
		end
	end
	if activeCount >= MAX_ACTIVE_TICKETS then
		sendHint(session, string.format("Maksimal %d kontrak aktif. Selesaikan dulu salah satunya.", MAX_ACTIVE_TICKETS))
		return
	end

	for _, t in ipairs(session.tickets) do
		if t.id == ticketId and t.status == "Available" then
			t.status = "Active"
			playSFX(session, "key")

			if t.category == "Colocation" then
				t.phase = "delivery"
				t.slaRemainingSec = constants.COLOCATION.slaSeconds
				t.runtimeRemainingSec = constants.COLOCATION.runtimeSeconds
				t.validationText = "Crate sedang dikirim ke dock"
				local delivery = constants.COLOCATION.deliveryDelaySeconds
				task.delay(delivery, function()
					if sessions.GetSession(player) ~= session then
						return
					end
					local live: any? = nil
					for _, row in ipairs(session.tickets) do
						if row.id == ticketId and row.status == "Active" then
							live = row
							break
						end
					end
					if live == nil then
						return
					end
					if carry ~= nil then
						carry.SpawnCrate(session, live)
					end
					live.phase = "crate"
					live.validationText = "Angkat crate di dock, lalu pasang di rack"
				end)
				sendHint(session, string.format("Kontrak colocation diterima: %s. Crate tiba %d detik lagi.", t.title, delivery))
			else
				t.slaRemainingSec = DEFAULT_SLA_SECONDS
				t.validationText = "Kontrak aktif - selesaikan sebelum SLA habis"
				sendHint(session, string.format("Kontrak diterima: %s (SLA %d dtk)", t.title, DEFAULT_SLA_SECONDS))
			end
			return
		end
	end
end

local function bindAccept()
	if acceptBound or remotesFolder == nil then
		return
	end
	getRemotes()
	if contractRemote ~= nil then
		contractRemote.OnServerEvent:Connect(onAccept)
		acceptBound = true
	end
end

function ContractAndIncidentManager.Init(deps: { [string]: any })
	sessions = deps.sessions
	graph = deps.graph
	constants = deps.constants
	remotesFolder = deps.remotesFolder
	workbench = deps.workbench
	carry = deps.carry
	getRemotes()
	bindAccept()
end

--[[ Main loop: every 5s per session, top up Available tickets and validate
	 Active tickets. (Incident generation joins this loop in Fase 3.) ]]
function ContractAndIncidentManager.Start()
	bindAccept()
	task.spawn(function()
		while true do
			task.wait(LOOP_SECONDS)
			if sessions == nil then
				continue
			end
			local allSessions = sessions.GetAllSessions()
			for _, session in pairs(allSessions) do
				local ok, err = pcall(function()
					generateTickets(session)
					validateActiveTickets(session)
				end)
				if not ok then
					warn("[ContractAndIncidentManager] tick error: " .. tostring(err))
				end
			end
		end
	end)
end

return ContractAndIncidentManager
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX27">
<Properties>
<string name="Name">DataPersistenceManager</string>
<ProtectedString name="Source"><![CDATA[--!strict
--[[
	DataPersistenceManager (ModuleScript, ServerScriptService/Gameplay)
	AGENT C - Fase 1 + 2.

	DataStore "NetSimDC_v1", key "lab_"..UserId. Every DataStore access is
	wrapped in pcall; if GetDataStore itself fails, a session-independent flag
	is set and a warning is emitted once - persistence silently disables
	itself instead of ever breaking a session.

	Reset flow (contract Section 6): MainServer owns ResetDataRemote. On reset
	it calls DataPersistenceManager.WipeSave(player), then deletes and rebuilds
	the session via SessionManager.CreateSession + WorldAndAssetBuilder.
	PlayerRemoving is likewise handled by MainServer calling Save(session);
	this module only provides the autosave loop (Start, every 120s).

	Saved payload:
	  balance, reputation, cableSpools, selectedCableColor,
	  racks = freeform racks (item, world position, rotation, PDU state),
	  devices  = array over session.devices EXCEPT "isp_uplink":
	             { id, name, itemId, deviceType, contractId, freeform, posX,
	               posZ, rotY, rackId, uSlot, ip, gateway, subnetMask,
	               osInstalled, isPowered,
	               ports = { [portId] = { peer?, peerPort?, color?, vlan } },
	               vms = { VMData... } }
	             "bench_1" saves PORTS ONLY (the workbench payload covers the
	             node itself; ports must survive for the link pass).
	  workbench = WorkbenchBuilderSystem.Serialize(session)
	  tickets   = Active CloudVPS/CustomBuild tickets (Colocation contracts are
	              short-lived and reference a physical crate, so they are not
	              persisted; mounted servers are saved as rack devices).

	Apply(session, data):
	  loadedFromSave = true FIRST (suppresses AutoCable during restore) ->
	  balance/reputation/cable inventory -> freeform racks restored ->
	  starter device config (bm_starter_1, sw_main_1, isp_router_1) ->
	  freeform devices re-placed via PlacementSystem.PlaceDevice(config) ->
	  rack devices re-mounted via PlacementSystem.MountDevice(config) ->
	  workbench.ApplyState (so bench_1 exists before cables) -> link pass
	  (graph.ConnectPorts per saved peer, deduped by sorted "dev|port" pair,
	  covers starter + bench + placed links) -> VLAN restore -> tickets
	  restore -> loadedFromSave = false -> graph.UpdateDeviceLED -> ForceSync.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local NetworkTypes = require(ReplicatedStorage.Shared.NetworkTypes)
local PlotConstants = require(ReplicatedStorage.Shared.PlotConstants)

local DataPersistenceManager = {}

type SessionLike = any

-- ShiftAndEconomyManager lives next to this module; used only for the final
-- ForceSync after Apply so the client immediately receives the restored state.
local Economy: any = nil
do
	local ok, mod = pcall(require, script.Parent.ShiftAndEconomyManager)
	if ok then
		Economy = mod
	end
end

local DATASTORE_NAME = "NetSimDC_v1"
local KEY_PREFIX = "lab_"
local AUTOSAVE_SECONDS = 120

-- Session-independent DataStore availability flag (set once in Init).
local store: any = nil
local storeOk = false
local storeUnavailableWarned = false

local sessions: any = nil
local graph: any = nil
local constants: any = PlotConstants
local placement: any = nil
local workbench: any = nil

local STARTER_IDS = { "bm_starter_1", "sw_main_1", "isp_router_1" }
local ISP_ID = "isp_uplink"
local BENCH_ID = "bench_1"

local function warnStoreUnavailableOnce()
	if not storeUnavailableWarned then
		storeUnavailableWarned = true
		warn("[DataPersistenceManager] DataStore unavailable - saving/loading disabled for this server.")
	end
end

function DataPersistenceManager.Init(deps: { [string]: any })
	sessions = deps.sessions
	graph = deps.graph
	constants = deps.constants or PlotConstants
	placement = deps.placement
	workbench = deps.workbench

	local ok, result = pcall(function()
		return game:GetService("DataStoreService"):GetDataStore(DATASTORE_NAME)
	end)
	if ok then
		store = result
		storeOk = true
	else
		store = nil
		storeOk = false
		warnStoreUnavailableOnce()
	end
end

--[[ Load the saved payload for a player, nil when nothing/failure. ]]
function DataPersistenceManager.Load(player: Player): any?
	if not storeOk then
		warnStoreUnavailableOnce()
		return nil
	end
	local ok, data = pcall(function()
		return store:GetAsync(KEY_PREFIX .. tostring(player.UserId))
	end)
	if not ok then
		warn("[DataPersistenceManager] LoadAsync failed for userId " .. tostring(player.UserId) .. ": " .. tostring(data))
		return nil
	end
	return data
end

--[[ Serialize one VMData row (plain, DataStore-safe). ]]
local function serializeVM(vm: any): { [string]: any }
	return {
		name = vm.name,
		cpu = vm.cpu,
		ram = vm.ram,
		disk = vm.disk,
		assignedIp = vm.assignedIp,
		cpuThrottlePercent = vm.cpuThrottlePercent,
		currentLoadPercent = vm.currentLoadPercent,
		status = vm.status,
	}
end

--[[ requirements reduced to the persistable cpu/ram/disk triple (or nil). ]]
local function serializeRequirements(req: any): { [string]: number }?
	if type(req) == "table" and req.cpu ~= nil then
		return { cpu = req.cpu, ram = req.ram, disk = req.disk }
	end
	return nil
end

--[[ Save one session (balance, reputation, devices, workbench, active tickets). ]]
function DataPersistenceManager.Save(session: SessionLike)
	if not storeOk then
		warnStoreUnavailableOnce()
		return
	end
	if type(session) ~= "table" or session.player == nil then
		return
	end

	local devices: { any } = {}
	for id, node in pairs(session.devices) do
		if id == ISP_ID then
			continue -- ISP uplink is rebuilt fresh by BuildFacility every join
		end

		-- ports: connected links plus non-default VLANs (Fase 2 switch config)
		local ports: { [string]: { [string]: any } } = {}
		for portId, port in pairs(node.ports) do
			if port.connectedToDeviceId ~= nil or port.vlanId ~= 1 or port.isTrunk == true then
				ports[portId] = {
					peer = port.connectedToDeviceId,
					peerPort = port.connectedToPortId,
					color = port.cableColor,
					vlan = port.vlanId,
					trunk = port.isTrunk == true,
				}
			end
		end

		if id == BENCH_ID then
			-- bench_1 node data is covered by the workbench payload; keep its
			-- cables only so the link pass can restore them.
			if next(ports) ~= nil then
				table.insert(devices, { id = BENCH_ID, ports = ports })
			end
			continue
		end

		local vms: { any } = {}
		for _, vm in pairs(node.vms) do
			table.insert(vms, serializeVM(vm))
		end

		table.insert(devices, {
			id = id,
			name = node.name,
			itemId = node.itemId,
			deviceType = node.deviceType,
			contractId = node.contractId,
			freeform = node.freeform == true,
			posX = node.posX,
			posZ = node.posZ,
			rotY = node.rotY,
			rackId = node.rackId,
			uSlot = node.uSlot,
			ip = node.ip,
			gateway = node.gateway,
			subnetMask = node.subnetMask,
			osInstalled = node.osInstalled,
			isPowered = node.isPowered == true,
			ports = ports,
			vms = vms,
		})
	end

	-- Freeform racks (the starter rack is rebuilt by WorldAndAssetBuilder).
	local racks: { any } = {}
	for rackId, rack in pairs(session.racks) do
		if rackId ~= "rack_main_1" then
			local model = session.rackModels[rackId]
			if model ~= nil then
				local cf = model:GetPivot()
				local _rx, rotY, _rz = cf:ToOrientation()
				table.insert(racks, {
					rackId = rackId,
					itemId = rack.itemId,
					posX = cf.Position.X,
					posZ = cf.Position.Z,
					rotY = rotY,
					pduPowered = rack.pduPowered == true,
				})
			end
		end
	end

	local tickets: { any } = {}
	for _, t in ipairs(session.tickets or {}) do
		-- Colocation contracts are short live sessions and reference a physical
		-- crate; they are not persisted. The mounted server itself is saved as a
		-- normal rack device above.
		if t.status == "Active" and t.category ~= "Colocation" then
			table.insert(tickets, {
				id = t.id,
				category = t.category,
				clientName = t.clientName,
				title = t.title,
				description = t.description,
				rewardPayout = t.rewardPayout,
				requirements = serializeRequirements(t.requirements),
				status = t.status,
				requirementsText = t.requirementsText,
			})
		end
	end

	local payload: { [string]: any } = {
		balance = session.balance,
		reputation = session.reputation,
		devices = devices,
		racks = racks,
		cableSpools = session.cableSpools,
		selectedCableColor = session.selectedCableColor,
		workbench = (workbench ~= nil and type(workbench.Serialize) == "function") and workbench.Serialize(session) or nil,
		tickets = tickets,
	}

	local key = KEY_PREFIX .. tostring(session.player.UserId)
	local ok, err = pcall(function()
		store:SetAsync(key, payload)
	end)
	if not ok then
		-- Warn once per session so a broken DataStore does not spam the output.
		if not session.noSaveWarned then
			session.noSaveWarned = true
			warn("[DataPersistenceManager] Save failed for userId " .. tostring(session.player.UserId) .. ": " .. tostring(err))
		end
	end
end

--[[ Rebuild VM tables onto a node; returns the highest used 10.0.0.x octet
	 (base 1 when none) so vmIpCounter can continue after the restored VMs
	 without colliding with any restored IP. ]]
local function restoreVMs(session: SessionLike, node: any, hostNewId: string, vmArray: any): number
	local maxOctet = 1
	if type(vmArray) == "table" then
		for _, v in ipairs(vmArray) do
			if type(v) == "table" and type(v.name) == "string" and #v.name > 0 then
				local vm = {
					name = v.name,
					cpu = tonumber(v.cpu) or 1,
					ram = tonumber(v.ram) or 1,
					disk = tonumber(v.disk) or 5,
					assignedIp = (type(v.assignedIp) == "string") and v.assignedIp or nil,
					cpuThrottlePercent = tonumber(v.cpuThrottlePercent) or 0,
					currentLoadPercent = tonumber(v.currentLoadPercent) or 0,
					status = if v.status == "throttled" or v.status == "stopped" then v.status else "running",
				}
				node.vms[vm.name] = vm
				if vm.assignedIp ~= nil then
					local octet = tonumber(string.match(vm.assignedIp, "^10%.0%.0%.(%d+)$"))
					if octet ~= nil and octet > maxOctet then
						maxOctet = octet
					end
				end
			end
		end
	end
	session.vmIpCounter[hostNewId] = maxOctet + 1
	return maxOctet
end

--[[ Sorted-pair dedupe key for a cable connection ("devA|portA>devB|portB"). ]]
local function pairKey(devA: string, portA: string, devB: string, portB: string): string
	local left = devA .. "|" .. portA
	local right = devB .. "|" .. portB
	return if left <= right then left .. ">" .. right else right .. ">" .. left
end

--[[ Restore a saved payload onto a freshly built session. ]]
function DataPersistenceManager.Apply(session: SessionLike, data: any)
	if type(data) ~= "table" then
		return
	end

	-- Must be set before any placement so AutoCable stays suppressed.
	session.loadedFromSave = true

	if tonumber(data.balance) ~= nil then
		session.balance = tonumber(data.balance) :: number
	end
	if tonumber(data.reputation) ~= nil then
		session.reputation = tonumber(data.reputation) :: number
	end

	-- Fase 2 cable inventory.
	if type(data.cableSpools) == "table" then
		for _, color in ipairs(constants.CABLES.colors) do
			local count = tonumber(data.cableSpools[color])
			if count ~= nil then
				session.cableSpools[color] = math.max(0, math.floor(count))
			end
		end
	end
	if type(data.selectedCableColor) == "string" then
		for _, color in ipairs(constants.CABLES.colors) do
			if color == data.selectedCableColor then
				session.selectedCableColor = color
			end
		end
	end

	-- saved device / rack id -> live id (starters keep their fixed ids)
	local restoredIds: { [string]: string } = {
		[ISP_ID] = ISP_ID,
		["isp_router_1"] = "isp_router_1",
		["sw_main_1"] = "sw_main_1",
		["bm_starter_1"] = "bm_starter_1",
		["rack_main_1"] = "rack_main_1",
		[BENCH_ID] = BENCH_ID,
	}
	local starterSet: { [string]: boolean } = {
		["bm_starter_1"] = true,
		["sw_main_1"] = true,
		["isp_router_1"] = true,
	}

	local savedDevices: { any } = if type(data.devices) == "table" then data.devices else {}

	-- 0) Freeform racks must exist before their mounted devices are restored.
	if type(data.racks) == "table" and placement ~= nil then
		for _, entry in ipairs(data.racks) do
			if type(entry) ~= "table" or type(entry.rackId) ~= "string" or type(entry.itemId) ~= "string" then
				continue
			end
			if entry.rackId == "rack_main_1" then
				continue
			end
			local posX = tonumber(entry.posX) or 0
			local posZ = tonumber(entry.posZ) or 0
			local rotY = tonumber(entry.rotY) or 0
			local ok, newRackId = pcall(function()
				return placement.RestoreRack(session, entry.itemId :: string, posX, posZ, rotY, entry.pduPowered == true)
			end)
			if ok and type(newRackId) == "string" and newRackId ~= "" then
				restoredIds[entry.rackId] = newRackId
			else
				warn("[DataPersistenceManager] could not restore rack '" .. entry.rackId .. "'")
			end
		end
	end

	-- 1) Starter device config + freeform / rack-mounted device re-placement.
	for _, entry in ipairs(savedDevices) do
		if type(entry) ~= "table" or type(entry.id) ~= "string" then
			continue
		end
		local savedId = entry.id
		if savedId == BENCH_ID then
			continue -- node comes from workbench.ApplyState; ports link later
		end

		if starterSet[savedId] then
			local node = session.devices[savedId]
			if node ~= nil then
				restoredIds[savedId] = savedId
				if entry.ip ~= nil then
					node.ip = entry.ip
				end
				if entry.gateway ~= nil then
					node.gateway = entry.gateway
				end
				if entry.subnetMask ~= nil then
					node.subnetMask = entry.subnetMask
				end
				node.osInstalled = entry.osInstalled
				if entry.isPowered ~= nil then
					node.isPowered = entry.isPowered == true
				end
				node.vms = {}
				restoreVMs(session, node, savedId, entry.vms)
			end
		elseif entry.freeform == true and type(entry.itemId) == "string" and placement ~= nil then
			local posX = tonumber(entry.posX) or 0
			local posZ = tonumber(entry.posZ) or 0
			local rotY = tonumber(entry.rotY) or 0
			local floorY = constants.ROOM.floorTopY

			local vms: { any } = {}
			local maxOctet = 1
			if type(entry.vms) == "table" then
				for _, v in ipairs(entry.vms) do
					if type(v) == "table" and type(v.name) == "string" and #v.name > 0 then
						table.insert(vms, {
							name = v.name,
							cpu = tonumber(v.cpu) or 1,
							ram = tonumber(v.ram) or 1,
							disk = tonumber(v.disk) or 5,
							assignedIp = (type(v.assignedIp) == "string") and v.assignedIp or nil,
							cpuThrottlePercent = tonumber(v.cpuThrottlePercent) or 0,
							currentLoadPercent = tonumber(v.currentLoadPercent) or 0,
							status = if v.status == "throttled" or v.status == "stopped" then v.status else "running",
						})
						if type(v.assignedIp) == "string" then
							local octet = tonumber(string.match(v.assignedIp, "^10%.0%.0%.(%d+)$"))
							if octet ~= nil and octet > maxOctet then
								maxOctet = octet
							end
						end
					end
				end
			end

			local ok, newId = pcall(function()
				return placement.PlaceDevice(session, entry.itemId :: string,
					CFrame.new(Vector3.new(posX, floorY, posZ)), rotY, {
						ip = entry.ip,
						gateway = entry.gateway,
						subnetMask = entry.subnetMask,
						osInstalled = entry.osInstalled,
						isPowered = if entry.isPowered ~= nil then entry.isPowered == true else nil,
						vms = vms,
					})
			end)
			if ok and type(newId) == "string" then
				restoredIds[savedId] = newId
				session.vmIpCounter[newId] = maxOctet + 1
			else
				warn("[DataPersistenceManager] could not restore device '" .. savedId .. "' (" .. tostring(entry.itemId) .. ")")
			end
		elseif type(entry.rackId) == "string" and entry.uSlot ~= nil and type(entry.itemId) == "string" and placement ~= nil then
			-- Fase 2: rack-mounted devices (colocation servers, purchased units)
			local rackId = restoredIds[entry.rackId] or entry.rackId
			if session.racks[rackId] == nil then
				warn("[DataPersistenceManager] missing rack '" .. tostring(entry.rackId) .. "' for device '" .. savedId .. "'")
				continue
			end
			local ok, mounted, result = pcall(placement.MountDevice, session, entry.itemId, rackId, entry.uSlot, {
				name = entry.name,
				deviceType = entry.deviceType,
				ip = entry.ip,
				gateway = entry.gateway,
				subnetMask = entry.subnetMask,
				osInstalled = entry.osInstalled,
				isPowered = if entry.isPowered ~= nil then entry.isPowered == true else nil,
				contractId = entry.contractId,
				noAutoCable = true,
			})
			if ok and mounted == true then
				restoredIds[savedId] = result
				local node = session.devices[result]
				if node ~= nil then
					restoreVMs(session, node, result, entry.vms)
				end
			else
				warn("[DataPersistenceManager] could not restore rack device '" .. savedId .. "': " .. tostring(result))
			end
		else
			warn("[DataPersistenceManager] skipping non-restorable device '" .. savedId .. "'")
		end
	end

	-- 2) Workbench state BEFORE the link pass so bench_1 exists for bench cables.
	if workbench ~= nil and type(workbench.ApplyState) == "function" and type(data.workbench) == "table" then
		local ok, err = pcall(workbench.ApplyState, session, data.workbench)
		if not ok then
			warn("[DataPersistenceManager] workbench.ApplyState failed: " .. tostring(err))
		end
	end

	-- 3) Link pass: restore every recorded cable, deduped by sorted pair key.
	local linked: { [string]: boolean } = {}
	for _, entry in ipairs(savedDevices) do
		if type(entry) ~= "table" or type(entry.id) ~= "string" or type(entry.ports) ~= "table" then
			continue
		end
		local devA = restoredIds[entry.id]
		if devA == nil then
			continue
		end
		for portA, conn in pairs(entry.ports :: { [string]: any }) do
			if type(conn) ~= "table" or type(conn.peer) ~= "string" or type(conn.peerPort) ~= "string" or type(portA) ~= "string" then
				continue
			end
			local devB = restoredIds[conn.peer]
			if devB == nil then
				continue
			end
			local key = pairKey(devA, portA, devB, conn.peerPort)
			if not linked[key] then
				linked[key] = true
				local color = if type(conn.color) == "string" then conn.color else "LAN_Blue"
				local ok, err = graph.ConnectPorts(session, devA, portA, devB, conn.peerPort, color)
				if not ok then
					-- Mostly benign: pre-wired starter links (wan1<->isp_uplink)
					-- already exist from BuildFacility and are rejected here.
					_ = err
				end
			end
		end
	end

	-- 3b) VLAN restore: applies to connected and unconnected ports alike.
	for _, entry in ipairs(savedDevices) do
		if type(entry) ~= "table" or type(entry.id) ~= "string" or type(entry.ports) ~= "table" then
			continue
		end
		local devA = restoredIds[entry.id]
		if devA == nil then
			continue
		end
		for portA, conn in pairs(entry.ports :: { [string]: any }) do
			if type(conn) == "table" and type(portA) == "string" then
				if tonumber(conn.vlan) ~= nil then
					local okVlan = graph.SetPortVlan(session, devA, portA, tonumber(conn.vlan) :: number)
					_ = okVlan
				end
				if conn.trunk == true then
					local okTrunk = graph.SetPortTrunk(session, devA, portA, true)
					_ = okTrunk
				end
			end
		end
	end

	-- 4) Tickets restore: Available stays Available, Active stays Active.
	if type(data.tickets) == "table" then
		for _, t in ipairs(data.tickets) do
			if type(t) == "table" and type(t.id) == "string" and type(t.title) == "string" then
				table.insert(session.tickets, {
					id = t.id,
					category = if t.category == "CustomBuild" then "CustomBuild" else "CloudVPS",
					clientName = if type(t.clientName) == "string" then t.clientName else "Klien",
					title = t.title,
					description = if type(t.description) == "string" then t.description else "",
					requirements = if type(t.requirements) == "table" then t.requirements else {},
					rewardPayout = tonumber(t.rewardPayout) or 120,
					status = if t.status == "Active" then "Active" else "Available",
					requirementsText = if type(t.requirementsText) == "string" then t.requirementsText else "",
				})
			end
		end
	end

	-- 5) Restore done: re-enable normal placement behavior and refresh visuals.
	session.loadedFromSave = false
	if graph ~= nil and type(graph.UpdateDeviceLED) == "function" then
		for deviceId in pairs(session.devices) do
			pcall(graph.UpdateDeviceLED, session, deviceId)
		end
	end

	-- 6) Push the restored state to the client immediately.
	if Economy ~= nil and type(Economy.ForceSync) == "function" then
		pcall(Economy.ForceSync, session)
	end
end

--[[ Remove a player's save (Reset flow; MainServer then rebuilds the session). ]]
function DataPersistenceManager.WipeSave(player: Player)
	if not storeOk then
		warnStoreUnavailableOnce()
		return
	end
	local ok, err = pcall(function()
		store:RemoveAsync(KEY_PREFIX .. tostring(player.UserId))
	end)
	if not ok then
		warn("[DataPersistenceManager] RemoveAsync failed for userId " .. tostring(player.UserId) .. ": " .. tostring(err))
	end
end

--[[ Save every live session (autosave / shutdown). ]]
function DataPersistenceManager.SaveAll()
	if sessions == nil then
		return
	end
	for _, session in pairs(sessions.GetAllSessions()) do
		local ok, err = pcall(DataPersistenceManager.Save, session)
		if not ok then
			warn("[DataPersistenceManager] SaveAll error: " .. tostring(err))
		end
	end
end

--[[ Autosave loop (PlayerRemoving save is handled by MainServer -> Save). ]]
function DataPersistenceManager.Start()
	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_SECONDS)
			DataPersistenceManager.SaveAll()
		end
	end)
end

return DataPersistenceManager
]]></ProtectedString>
</Properties>
</Item>
</Item>
</Item>
<Item class="StarterPlayer" referent="RBX28">
<Properties>
<string name="Name">StarterPlayer</string>
</Properties>
<Item class="StarterPlayerScripts" referent="RBX29">
