-- Close button: Modal=true frees mouse cursor in First-Person / ShiftLock on PC
local closeBtn = Instance.new("TextButton")
closeBtn.Name = "CloseButton"
closeBtn.Size = UDim2.new(0, 62, 0, 26)
closeBtn.Position = UDim2.new(1, -68, 0, 5)
closeBtn.BackgroundColor3 = COLOR_RED_BG
closeBtn.Font = Enum.Font.GothamBold
closeBtn.TextSize = 12
closeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
closeBtn.Text = "X [~]"
closeBtn.AutoButtonColor = true
closeBtn.Modal = true
closeBtn.Active = true
closeBtn.ZIndex = 10
closeBtn.Parent = topBar
local closeCorner = Instance.new("UICorner")
closeCorner.CornerRadius = UDim.new(0, 6)
closeCorner.Parent = closeBtn

-- Output: ScrollingFrame + one RichText TextLabel (AutomaticSize Y)
local outputScroll = Instance.new("ScrollingFrame")
outputScroll.Name = "OutputScroll"
outputScroll.Position = UDim2.new(0, 10, 0, 42)
outputScroll.Size = UDim2.new(1, -20, 1, -86)
outputScroll.BackgroundColor3 = COLOR_OUTPUT
outputScroll.BorderSizePixel = 0
outputScroll.ScrollBarThickness = 7
outputScroll.ScrollBarImageColor3 = COLOR_BORDER
outputScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
outputScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
outputScroll.Active = true
outputScroll.Parent = window
local outputPadding = Instance.new("UIPadding")
outputPadding.PaddingLeft = UDim.new(0, 6)
outputPadding.PaddingRight = UDim.new(0, 6)
outputPadding.PaddingTop = UDim.new(0, 4)
outputPadding.PaddingBottom = UDim.new(0, 8)
outputPadding.Parent = outputScroll

local outputLabel = Instance.new("TextLabel")
outputLabel.Name = "OutputLabel"
outputLabel.Size = UDim2.new(1, -8, 0, 0)
outputLabel.Position = UDim2.new(0, 0, 0, 0)
outputLabel.BackgroundTransparency = 1
outputLabel.RichText = true
outputLabel.AutomaticSize = Enum.AutomaticSize.Y
outputLabel.TextWrapped = true
outputLabel.Font = Enum.Font.RobotoMono
outputLabel.TextSize = 14
outputLabel.TextXAlignment = Enum.TextXAlignment.Left
outputLabel.TextYAlignment = Enum.TextYAlignment.Top
outputLabel.TextColor3 = COLOR_TEXT
outputLabel.Text = ""
outputLabel.Parent = outputScroll

-- Input TextBox (bottom). Name "InputBox" is referenced by AudioAndEffectsClient.
local inputBox = Instance.new("TextBox")
inputBox.Name = "InputBox"
inputBox.Position = UDim2.new(0, 10, 1, -38)
inputBox.Size = UDim2.new(1, -20, 0, 30)
inputBox.BackgroundColor3 = COLOR_BAR
inputBox.Font = Enum.Font.RobotoMono
inputBox.TextSize = 14
inputBox.TextColor3 = COLOR_BLUE
inputBox.PlaceholderText = "ketik help | Enter=kirim | Tab=lengkapi | Up/Down=riwayat | [~]/[F2]=tutup"
inputBox.PlaceholderColor3 = COLOR_GREY
inputBox.ClearTextOnFocus = false
inputBox.Text = ""
inputBox.TextXAlignment = Enum.TextXAlignment.Left
inputBox.Parent = window
local inputPad = Instance.new("UIPadding")
inputPad.PaddingLeft = UDim.new(0, 8)
inputPad.PaddingRight = UDim.new(0, 8)
inputPad.Parent = inputBox
local inputCorner = Instance.new("UICorner")
inputCorner.CornerRadius = UDim.new(0, 6)
inputCorner.Parent = inputBox
local inputStroke = Instance.new("UIStroke")
inputStroke.Color = COLOR_BORDER
inputStroke.Thickness = 1
inputStroke.Parent = inputBox

-- ===== Terminal state =====
local buffer: { string } = {}
local history: { string } = {}
local historyIndex = 1
local hintToken = 0
local openToken = 0
local lastCloseTime = 0
local MAX_BUFFER_LINES = 500

local COMMANDS = {
	"help", "clear", "close", "ping", "traceroute", "ip a", "ip set", "ssh", "exit",
	"top", "vm create", "vm list", "vm throttle", "vm delete", "install-os", "stress-test", "ship",
	"vlan list", "vlan set", "switch port", "switch list",
	"cable", "cable use", "cable buy", "cable cut", "mount list", "mount",
}

local function scrollToEnd()
	task.defer(function()
		outputScroll.CanvasPosition = Vector2.new(0, 1e9)
	end)
end

local function appendLines(lines: { string })
	for _, line in ipairs(lines) do
		table.insert(buffer, tostring(line))
	end
	while #buffer > MAX_BUFFER_LINES do
		table.remove(buffer, 1)
	end
	outputLabel.Text = table.concat(buffer, "\n")
	scrollToEnd()
end

local function clearBuffer()
	buffer = {}
	outputLabel.Text = ""
	outputScroll.CanvasPosition = Vector2.new(0, 0)
end

local function refocusInput()
	if not window.Visible then
		return
	end
	openToken += 1
	local myToken = openToken
	task.defer(function()
		if window.Visible and openToken == myToken then
			inputBox:CaptureFocus()
		end
	end)
end

local function closeTerminal()
	openToken += 1 -- invalidate any pending refocusInput
	lastCloseTime = os.clock()
	window.Visible = false
	if inputBox:IsFocused() then
		inputBox:ReleaseFocus()
	end
end

local function toggleTerminal()
	if window.Visible then
		closeTerminal()
	else
		openTerminalRemote:FireServer({ action = "request_shell" })
	end
end

local function titleFor(mode: string?, deviceName: string?): string
	if mode == "LocalConsole" then
		return "[CONSOLE: " .. (deviceName or "?") .. "]"
	elseif mode == "RemoteSSH" then
		return "[SSH: " .. (deviceName or "?") .. "]"
	end
	return "[LOCAL SHELL]"
end

-- Hint message shown in the bar area for 3 seconds
local function showHint(message: string)
	hintToken += 1
	local myToken = hintToken
	hintLabel.Text = message
	hintLabel.Visible = true
	modeLabel.Visible = false
	hotkeyHint.Visible = false
	task.delay(3, function()
		if hintToken == myToken then
			hintLabel.Visible = false
			modeLabel.Visible = true
			hotkeyHint.Visible = true
		end
	end)
end

-- ===== PC TopBar Dragging =====
local dragging = false
local dragStartMouse = Vector2.new(0, 0)
local dragStartPos = window.Position

topBar.InputBegan:Connect(function(input: InputObject)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStartMouse = Vector2.new(input.Position.X, input.Position.Y)
		dragStartPos = window.Position
	end
end)

UserInputService.InputChanged:Connect(function(input: InputObject)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = Vector2.new(input.Position.X, input.Position.Y) - dragStartMouse
		window.Position = UDim2.new(
			dragStartPos.X.Scale,
			dragStartPos.X.Offset + delta.X,
			dragStartPos.Y.Scale,
			dragStartPos.Y.Offset + delta.Y
		)
	end
end)

UserInputService.InputEnded:Connect(function(input: InputObject)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
	end
end)

-- ===== Command history + Tab autocomplete =====
local function historyUp()
	if #history == 0 then
		return
	end
	historyIndex = math.max(1, math.min(historyIndex - 1, #history))
	inputBox.Text = history[historyIndex] or ""
end

local function historyDown()
	if #history == 0 then
		return
	end
	historyIndex = math.min(#history + 1, historyIndex + 1)
	if historyIndex <= #history then
		inputBox.Text = history[historyIndex] or ""
	else
		inputBox.Text = ""
	end
end

local function tabComplete()
	local current = string.gsub(inputBox.Text, "\t", "")
	if #current == 0 then
		return
	end
	local lower = string.lower(current)
	local matches: { string } = {}
	for _, cmd in ipairs(COMMANDS) do
		if string.sub(cmd, 1, #lower) == lower then
			table.insert(matches, cmd)
		end
	end
	if #matches == 0 then
		inputBox.Text = current
		return
	end
	if #matches == 1 then
		inputBox.Text = matches[1] .. " "
		return
	end
	-- Complete up to the longest common prefix of all matches
	local prefix = matches[1]
	for i = 2, #matches do
		local other = matches[i]
		local maxLen = math.min(#prefix, #other)
		local keep = 0
		for j = 1, maxLen do
			if string.sub(prefix, j, j) == string.sub(other, j, j) then
				keep = j
			else
				break
			end
		end
		prefix = string.sub(prefix, 1, keep)
		if #prefix == 0 then
			break
		end
	end
	if #prefix > #lower then
		inputBox.Text = prefix
	else
		inputBox.Text = current
	end
end

-- ===== PC Keyboard Shortcuts =====
-- [~] (Backquote) and [F2] toggle terminal anytime (works even while typing in inputBox).
-- While open: Up/Down = history, Tab = autocomplete, Ctrl+L = clear, Ctrl+W = close.
UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
	local key = input.KeyCode
	if key == Enum.KeyCode.Backquote or key == Enum.KeyCode.F2 then
		if window.Visible then
			-- Strip stray backtick if typed into TextBox right before close
			task.defer(function()
				inputBox.Text = string.gsub(inputBox.Text, "`", "")
			end)
			closeTerminal()
		elseif not gameProcessed then
			toggleTerminal()
		end
		return
	end

	if not window.Visible then
		return
	end

	local ctrlHeld = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
		or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
	if ctrlHeld and key == Enum.KeyCode.W then
		closeTerminal()
		return
	elseif ctrlHeld and key == Enum.KeyCode.L then
		clearBuffer()
		return
	end

	if key == Enum.KeyCode.Up then
		historyUp()
	elseif key == Enum.KeyCode.Down then
		historyDown()
	elseif key == Enum.KeyCode.Tab then
		task.defer(function()
			tabComplete()
			refocusInput()
		end)
	end
end)

-- ===== Enter = send command =====
inputBox.FocusLost:Connect(function(enterPressed: boolean)
	if not enterPressed or not window.Visible then
		return
	end
	local raw = string.gsub(inputBox.Text, "`", "")
	inputBox.Text = ""
	historyIndex = #history + 1
	if raw == nil or #raw == 0 then
		refocusInput()
		return
	end

	local trimmedLower = string.lower((string.gsub(raw, "^%s*(.-)%s*$", "%1")))
	if trimmedLower == "close" or trimmedLower == "quit" then
		closeTerminal()
		return
	end

	table.insert(history, raw)
	historyIndex = #history + 1

	-- Local echo of the typed command (escaped before embedding in RichText)
	appendLines({
		string.format('<font color="#58A6FF">&gt; %s</font>', NetworkUtils.EscapeRich(raw)),
	})

	local ok, result = pcall(function(): any
		return (executeRemote :: any):InvokeServer(raw)
	end)
	if not ok then
		appendLines({ '<font color="#FF5555">[terminal] gagal mengirim perintah ke server</font>' })
	else
		local lines = (result :: any).lines
		if type(lines) == "table" then
			if #lines == 1 and lines[1] == "__CLEAR__" then
				clearBuffer()
			else
				local strs: { string } = {}
				for _, line in ipairs(lines :: { any }) do
					table.insert(strs, tostring(line))
				end
				appendLines(strs)
			end
		end
	end
	refocusInput()
end)

-- ===== Server -> client =====
openTerminalRemote.OnClientEvent:Connect(function(payload: any)
	if type(payload) ~= "table" then
		return
	end
	local action = payload.action
	if action == "open" then
		-- Ignore stale open packets right after an explicit close
		if os.clock() - lastCloseTime < 0.2 then
			return
		end
		window.Visible = true
		modeLabel.Visible = true
		hotkeyHint.Visible = true
		hintLabel.Visible = false
		modeLabel.Text = titleFor(payload.mode, payload.deviceName)
		refocusInput()
	elseif action == "detach" then
		modeLabel.Visible = true
		hotkeyHint.Visible = true
		hintLabel.Visible = false
		modeLabel.Text = "[LOCAL SHELL]"
	elseif action == "hint" then
		showHint(tostring(payload.message or ""))
	end
end)

pushOutputRemote.OnClientEvent:Connect(function(payload: any)
	if type(payload) ~= "table" then
		return
	end
	local rawLines = if type(payload.lines) == "table" then payload.lines else payload
	local strs: { string } = {}
	for _, line in ipairs(rawLines :: { any }) do
		table.insert(strs, tostring(line))
	end
	if #strs > 0 then
		appendLines(strs)
	end
end)

-- Fire close on MouseButton1Down so a single click closes immediately even while
-- inputBox is focused (and before Tool.Activated could ever react to the click).
closeBtn.MouseButton1Down:Connect(closeTerminal)
closeBtn.MouseButton1Click:Connect(closeTerminal)

-- ===== Cross-script toggle: HudClient's "TERMINAL [~]" button fires this =====
local toggleBindable = Instance.new("BindableEvent")
toggleBindable.Name = "NetSimToggleTerminal"
toggleBindable.Parent = playerGui
toggleBindable.Event:Connect(toggleTerminal)

-- ===== Laptop tool hook (Activated -> request_shell, guarded against UI clicks) =====
local function isPointerOverInteractiveGui(): boolean
	local pos = UserInputService:GetMouseLocation()
	local topLeftInset = GuiService:GetGuiInset()
	local objs = playerGui:GetGuiObjectsAtPosition(pos.X, pos.Y - topLeftInset.Y)
	for _, obj in ipairs(objs) do
		if obj.Visible and (obj:IsA("GuiButton") or obj:IsA("TextBox") or obj.Active) then
			return true
		end
	end
	return false
end

local function bindTool(tool: Tool)
	if tool:GetAttribute("NetSimTermHooked") == true then
		return
	end
	tool:SetAttribute("NetSimTermHooked", true)
	tool.Activated:Connect(function()
		-- Do not re-open if terminal is already visible, just closed, or clicking a UI element
		if window.Visible then
			return
		end
		if os.clock() - lastCloseTime < 0.45 then
			return
		end
		if isPointerOverInteractiveGui() then
			return
		end
		openTerminalRemote:FireServer({ action = "request_shell" })
	end)
end

local function bindCharacter(char: Model)
	char.ChildAdded:Connect(function(child: Instance)
		if child:IsA("Tool") and child.Name == "TechnicianLaptop" then
			bindTool(child :: Tool)
		end
	end)
	for _, child in ipairs(char:GetChildren()) do
		if child:IsA("Tool") and child.Name == "TechnicianLaptop" then
			bindTool(child :: Tool)
		end
	end
end

player.CharacterAdded:Connect(function(char: Model)
	bindCharacter(char)
end)
if player.Character ~= nil then
	bindCharacter(player.Character :: Model)
end

-- ===== Welcome banner (Indonesian, PC controls) =====
appendLines({
	'<font color="#00FF66">[NetSim Terminal] Selamat datang, teknisi.</font>',
	'<font color="#8B949E">Ketik <b>help</b> untuk daftar perintah. [~] / [F2] / klik X = tutup | Tab = autocomplete | Up/Down = riwayat | Ctrl+L = clear.</font>',
})
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBX31">
<Properties>
<string name="Name">NOCMonitorClient</string>
<bool name="Disabled">false</bool>
<ProtectedString name="Source"><![CDATA[--!strict
--[[
	NOCMonitorClient (LocalScript, StarterPlayer/StarterPlayerScripts)
	Mengisi 3 monitor SurfaceGui di NOC Desk milik plot pemain:
	- TopologyMonitor : kartu node device + garis edge (midpoint + atan2 rotation),
	  klik node -> popup info + tombol "Putus semua kabel" (CableActionRemote).
	- TicketMonitor   : daftar kontrak (Accept -> ContractActionRemote) + checklist objectives.
	- TelemetryMonitor: Saldo, Reputasi, Uptime, Daya, Suhu rata-rata, Hari/Jam + banner storm.

	Catatan tipe: mirror manual dari ReplicatedStorage/Shared/NetworkTypes (module type-only
	yang return nil; tidak bisa dipakai di posisi type lewat require path dinamis).
	Shell UI dibangun sekali per monitor (guard atribut "BuiltBy" pada Root); konten dinamis
	(node/edge topology, daftar tiket) di-rebuild tiap snapshot, label telemetri di-update.
	Semua teks GUI Bahasa Indonesia; komentar kode Bahasa Inggris.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local sharedFolder = ReplicatedStorage:WaitForChild("Shared")
local NetworkUtils = require(sharedFolder:WaitForChild("NetworkUtils"))

local remotesFolder = ReplicatedStorage:WaitForChild("Remotes", 180) :: any
if remotesFolder == nil then
	warn("[NOCMonitorClient] ReplicatedStorage.Remotes tidak ditemukan (timeout 180s)")
	return
end

local stateSyncRemote = remotesFolder:WaitForChild("StateSyncRemote") :: RemoteEvent
local contractRemote = remotesFolder:WaitForChild("ContractActionRemote") :: RemoteEvent
local cableRemote = remotesFolder:WaitForChild("CableActionRemote") :: RemoteEvent

-- ===== Palette =====
local COLOR_BG = Color3.fromRGB(13, 17, 23)
local COLOR_CARD = Color3.fromRGB(22, 27, 34)
local COLOR_ROW = Color3.fromRGB(28, 33, 41)
local COLOR_BORDER = Color3.fromRGB(48, 54, 61)
local COLOR_GREEN = Color3.fromRGB(0, 255, 102)
local COLOR_BLUE = Color3.fromRGB(88, 166, 255)
local COLOR_RED = Color3.fromRGB(255, 85, 85)
local COLOR_YELLOW = Color3.fromRGB(255, 216, 102)
local COLOR_GREY = Color3.fromRGB(139, 148, 158)
local COLOR_TEXT = Color3.fromRGB(201, 209, 217)

-- ===== Mirrored snapshot types (keep in sync with NetworkTypes) =====
type SnapDevice = {
	id: string,
	name: string,
	deviceType: string,
	ip: string?,
	isPowered: boolean,
	temperatureC: number,
	loadPercent: number,
	vmCount: number,
	peers: { string },
}

type SnapTicket = {
	id: string,
	category: string,
	title: string,
	description: string,
	rewardPayout: number,
	status: string,
	requirementsText: string,
	slaRemainingSec: number?,
	payoutIntervalSec: number?,
	validationText: string?,
	vlanId: number?,
}

type FacilitySnapshot = {
	plotIndex: number,
	balance: number,
	reputation: number,
	uptimePercent: number,
	powerWatts: number,
	avgTempC: number,
	storm: boolean,
	day: number,
	clockText: string,
	devices: { SnapDevice },
	vms: { any },
	objectives: { [string]: boolean },
	tickets: { SnapTicket },
}

-- ===== State =====
type MonitorRef = {
	part: BasePart,
	surfaceGui: SurfaceGui,
	root: Frame,
}

local monitorRefs: { [string]: MonitorRef } = {}
local lastPlotIndex: number? = nil

local topoCanvas: Frame? = nil
local topoPopup: Frame? = nil
local topoCanvasW = 264 -- px, recomputed at build time from part size x PixelsPerStud
local topoCanvasH = 164
local ticketsScroll: ScrollingFrame? = nil
local objectiveChecks: { [string]: TextLabel } = {}
local teleValues: { [string]: TextLabel } = {}
local stormBanner: Frame? = nil

local MONITOR_NAMES = { "TopologyMonitor", "TicketMonitor", "TelemetryMonitor" }

local OBJECTIVES: { { key: string, label: string } } = {
	{ key = "cableWired", label = "Kabel switch -> router & server" },
	{ key = "ipSetStarter", label = "Set IP server starter" },
	{ key = "osInstalledStarter", label = "Install OS server starter" },
	{ key = "pingGateway", label = "Ping gateway" },
	{ key = "vmCreated", label = "Buat VM pertama" },
	{ key = "benchBuilt", label = "Rakit server di bench" },
	{ key = "benchOsInstalled", label = "Bench: install OS" },
	{ key = "stressPassed", label = "Stress test" },
	{ key = "shipped", label = "Kirim crate" },
}

-- Row assignment per device type (top / middle / bottom), Y positions in canvas scale
local ROW_Y = { 0.12, 0.45, 0.78 }
local function rowIndexOf(deviceType: string): number
	if deviceType == "Router" then
		return 1
	elseif deviceType == "Switch" then
		return 2
	end
	return 3 -- BareMetal / ColocationServer / unknown
end

local function clearChildren(inst: Instance, keep: { Instance }?): ()
	local keepMap: { [Instance]: boolean } = {}
	if keep ~= nil then
		for _, k in ipairs(keep) do
			keepMap[k] = true
		end
	end
	for _, child in ipairs(inst:GetChildren()) do
		if not keepMap[child] and not child:IsA("UICorner") and not child:IsA("UIStroke") and not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end
end

local function makeTitle(parent: Instance, text: string): TextLabel
	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.Size = UDim2.new(1, -8, 0, 14)
	title.Position = UDim2.new(0, 4, 0, 2)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamBold
	title.TextScaled = true
	title.TextColor3 = COLOR_GREEN
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Text = text
	title.Parent = parent
	return title
end

-- ===== Monitor discovery =====
-- Moves each monitor's SurfaceGui into PlayerGui with Adornee = part so
-- TextButtons inside the SurfaceGui receive mouse clicks in Roblox.
local function findMonitorPart(plot: Instance, name: string): (BasePart?, SurfaceGui?, Frame?)
	for _, desc in ipairs(plot:GetDescendants()) do
		if desc.Name == name and desc:IsA("BasePart") then
			local part = desc :: BasePart
			-- Check if we already moved this part's SurfaceGui into PlayerGui
			for _, child in ipairs(playerGui:GetChildren()) do
				if child:IsA("SurfaceGui") and child.Adornee == part then
					local root = child:FindFirstChild("Root")
					if root ~= nil and root:IsA("Frame") then
						return part, child :: SurfaceGui, root :: Frame
					end
				end
			end
			local surfaceGui = part:FindFirstChild("SurfaceGui")
			if surfaceGui ~= nil and surfaceGui:IsA("SurfaceGui") then
				local sg = surfaceGui :: SurfaceGui
				local root = sg:FindFirstChild("Root")
				if root ~= nil and root:IsA("Frame") then
					sg.Name = "NetSimNOC_" .. name
					sg.Adornee = part
					sg.ResetOnSpawn = false
					sg.Parent = playerGui
					return part, sg, root :: Frame
				end
			end
		end
	end
	return nil, nil, nil
end

local function clearAllMonitorRefs()
	for name, ref in pairs(monitorRefs) do
		if ref.surfaceGui.Parent == playerGui then
			ref.surfaceGui:Destroy()
		end
		monitorRefs[name] = nil :: any
	end
end

local function resetContentCaches()
	topoCanvas = nil
	topoPopup = nil
	ticketsScroll = nil
	objectiveChecks = {}
	teleValues = {}
	stormBanner = nil
end

-- Reset only the dynamic-content caches of one monitor (used when its Root is rebuilt)
local function resetCachesFor(name: string)
	if name == "TopologyMonitor" then
		topoCanvas = nil
		topoPopup = nil
	elseif name == "TicketMonitor" then
		ticketsScroll = nil
		objectiveChecks = {}
	elseif name == "TelemetryMonitor" then
		teleValues = {}
		stormBanner = nil
	end
end

local function refreshMonitorRefs(plot: Instance)
	-- Drop refs whose plot was destroyed (facility rebuild / reset data)
	for name, ref in pairs(monitorRefs) do
		if ref.part.Parent == nil or ref.root.Parent == nil then
			if ref.surfaceGui.Parent == playerGui then
				ref.surfaceGui:Destroy()
			end
			monitorRefs[name] = nil :: any
		end
	end
	for _, name in ipairs(MONITOR_NAMES) do
		if monitorRefs[name] == nil then
			local part, sg, root = findMonitorPart(plot, name)
			if part ~= nil and sg ~= nil and root ~= nil then
				monitorRefs[name] = { part = part, surfaceGui = sg, root = root }
			end
		end
	end
end

-- ===== TopologyMonitor =====
local function buildTopology(ref: MonitorRef)
	local root = ref.root
	makeTitle(root, "TOPOLOGI JARINGAN")

	local canvas = Instance.new("Frame")
	canvas.Name = "TopoCanvas"
	canvas.Position = UDim2.new(0, 0, 0, 16)
	canvas.Size = UDim2.new(1, 0, 1, -16)
	canvas.BackgroundTransparency = 1
	canvas.Parent = root

	local surfaceGui = ref.surfaceGui
	local pps = 60
	if surfaceGui ~= nil and surfaceGui:IsA("SurfaceGui") then
		pps = surfaceGui.PixelsPerStud
	end
	topoCanvasW = math.max(64, ref.part.Size.X * pps)
	topoCanvasH = math.max(64, ref.part.Size.Y * pps - 16)

	local popup = Instance.new("Frame")
	popup.Name = "NodePopup"
	popup.AnchorPoint = Vector2.new(0.5, 0.5)
	popup.Position = UDim2.fromScale(0.5, 0.5)
	popup.Size = UDim2.fromScale(0.86, 0.74)
	popup.BackgroundColor3 = COLOR_BG
	popup.BorderSizePixel = 0
	popup.ZIndex = 30
	popup.Visible = false
	popup.Parent = canvas
	local popupCorner = Instance.new("UICorner")
	popupCorner.CornerRadius = UDim.new(0, 6)
	popupCorner.Parent = popup
	local popupStroke = Instance.new("UIStroke")
	popupStroke.Color = COLOR_BLUE
	popupStroke.Thickness = 1.5
	popupStroke.Parent = popup

	topoCanvas = canvas
	topoPopup = popup
end

local function closePopup()
	if topoPopup ~= nil then
		topoPopup.Visible = false
	end
end

local function openNodePopup(dev: SnapDevice)
	local popup = topoPopup
	if popup == nil then
		return
	end
	clearChildren(popup)

	local title = Instance.new("TextLabel")
	title.Name = "PopupTitle"
	title.Size = UDim2.new(1, -40, 0.24, 0)
	title.Position = UDim2.new(0, 8, 0, 6)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamBold
	title.TextScaled = true
	title.TextColor3 = COLOR_BLUE
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Text = dev.name
	title.ZIndex = 31
	title.Parent = popup

	local infoLines = string.format(
		"Tipe: %s\nIP: %s\nDaya: %s\nSuhu: %.1f C  |  Beban: %.0f%%  |  VM: %d\nPeer: %s",
		dev.deviceType,
		dev.ip or "-",
		if dev.isPowered then "ON" else "OFF",
		dev.temperatureC or 0,
		dev.loadPercent or 0,
		dev.vmCount or 0,
		if #dev.peers > 0 then table.concat(dev.peers, ", ") else "tidak ada"
	)
	local info = Instance.new("TextLabel")
	info.Name = "PopupInfo"
	info.Size = UDim2.new(1, -16, 0.5, 0)
	info.Position = UDim2.new(0, 8, 0.28, 0)
	info.BackgroundTransparency = 1
	info.Font = Enum.Font.Gotham
	info.TextSize = 10
	info.TextWrapped = true
	info.TextXAlignment = Enum.TextXAlignment.Left
	info.TextYAlignment = Enum.TextYAlignment.Top
	info.TextColor3 = COLOR_TEXT
	info.Text = infoLines
	info.ZIndex = 31
	info.Parent = popup

	local discBtn = Instance.new("TextButton")
	discBtn.Name = "DisconnectButton"
	discBtn.Size = UDim2.new(0.62, 0, 0, 20)
	discBtn.Position = UDim2.new(0, 8, 1, -28)
	discBtn.BackgroundColor3 = Color3.fromRGB(140, 45, 45)
	discBtn.Font = Enum.Font.GothamBold
	discBtn.TextSize = 11
	discBtn.TextColor3 = COLOR_TEXT
	discBtn.Text = "PUTUS SEMUA KABEL"
	discBtn.AutoButtonColor = true
	discBtn.ZIndex = 31
	discBtn.Parent = popup
	local discCorner = Instance.new("UICorner")
	discCorner.CornerRadius = UDim.new(0, 4)
	discCorner.Parent = discBtn
	discBtn.MouseButton1Click:Connect(function()
		cableRemote:FireServer({ action = "disconnect_all", deviceId = dev.id })
		closePopup()
	end)

	local closeBtn = Instance.new("TextButton")
	closeBtn.Name = "PopupCloseButton"
	closeBtn.AnchorPoint = Vector2.new(1, 0)
	closeBtn.Size = UDim2.new(0.24, 0, 0, 20)
	closeBtn.Position = UDim2.new(1, -8, 1, -28)
	closeBtn.BackgroundColor3 = COLOR_BORDER
	closeBtn.Font = Enum.Font.GothamBold
	closeBtn.TextSize = 11
	closeBtn.TextColor3 = COLOR_TEXT
	closeBtn.Text = "TUTUP"
	closeBtn.AutoButtonColor = true
	closeBtn.ZIndex = 31
	closeBtn.Parent = popup
	local closeCorner = Instance.new("UICorner")
	closeCorner.CornerRadius = UDim.new(0, 4)
	closeCorner.Parent = closeBtn
	closeBtn.MouseButton1Click:Connect(closePopup)

	popup.Visible = true
end

local function createNodeButton(canvas: Frame, dev: SnapDevice, cx: number, cy: number)
	local powered = dev.isPowered == true
	local btn = Instance.new("TextButton")
	btn.Name = "Node_" .. dev.id
	btn.AnchorPoint = Vector2.new(0.5, 0.5)
	btn.Position = UDim2.fromScale(cx, cy)
	btn.Size = UDim2.fromScale(0.16, 0.12)
	btn.BackgroundColor3 = COLOR_CARD
	btn.BorderSizePixel = 0
	btn.Text = ""
	btn.AutoButtonColor = false
	btn.ZIndex = 2
	btn.Parent = canvas
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 4)
	corner.Parent = btn
	local stroke = Instance.new("UIStroke")
	stroke.Color = if powered then COLOR_GREEN else COLOR_RED
	stroke.Thickness = 1.5
	stroke.Parent = btn

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "NodeName"
	nameLabel.Size = UDim2.new(1, -4, 0.55, 0)
	nameLabel.Position = UDim2.new(0, 2, 0.04, 0)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextScaled = true
	nameLabel.TextColor3 = if powered then COLOR_TEXT else COLOR_RED
	nameLabel.Text = dev.name
	nameLabel.ZIndex = 3
	nameLabel.Parent = btn

	local ipLabel = Instance.new("TextLabel")
	ipLabel.Name = "NodeIp"
	ipLabel.Size = UDim2.new(1, -4, 0.34, 0)
	ipLabel.Position = UDim2.new(0, 2, 0.62, 0)
	ipLabel.BackgroundTransparency = 1
	ipLabel.Font = Enum.Font.RobotoMono
	ipLabel.TextScaled = true
	ipLabel.TextColor3 = if dev.ip ~= nil then COLOR_BLUE else COLOR_GREY
	ipLabel.Text = dev.ip or "-"
	ipLabel.ZIndex = 3
	ipLabel.Parent = btn

	btn.MouseButton1Click:Connect(function()
		openNodePopup(dev)
	end)

	return { cx = cx, cy = cy, powered = powered, id = dev.id, name = dev.name }
end

local function updateTopology(snap: FacilitySnapshot)
	local canvas = topoCanvas
	if canvas == nil or topoPopup == nil then
		return
	end
	clearChildren(canvas, { topoPopup })

	local devices = snap.devices or {}
	local byName: { [string]: SnapDevice } = {}
	for _, dev in ipairs(devices) do
		if byName[dev.name] == nil then
			byName[dev.name] = dev
		end
	end

	-- Group devices per row, spread horizontally
	local rowDevices: { { SnapDevice } } = { {}, {}, {} }
	for _, dev in ipairs(devices) do
		table.insert(rowDevices[rowIndexOf(dev.deviceType)], dev)
	end

	local nodeByName: { [string]: { cx: number, cy: number, powered: boolean, id: string, name: string } } = {}
	for rowIdx = 1, 3 do
		local list = rowDevices[rowIdx]
		local n = #list
		for i, dev in ipairs(list) do
			local cx = (i - 0.5) / n
			local cy = ROW_Y[rowIdx] + 0.06 -- node center (node height = 0.12 scale)
			nodeByName[dev.name] = createNodeButton(canvas, dev, cx, cy)
		end
	end

	-- Edge lines derived from peers (matched by device name), one per unordered pair
	local seenEdges: { [string]: boolean } = {}
	for _, dev in ipairs(devices) do
		local a = nodeByName[dev.name]
		if a ~= nil then
			for _, peerName in ipairs(dev.peers) do
				local b = nodeByName[peerName]
				if b ~= nil and b.name ~= a.name then
					local pairKey = if a.id < b.id then a.id .. "|" .. b.id else b.id .. "|" .. a.id
					if not seenEdges[pairKey] then
						seenEdges[pairKey] = true
						local dx = (b.cx - a.cx) * topoCanvasW
						local dy = (b.cy - a.cy) * topoCanvasH
						local len = math.sqrt(dx * dx + dy * dy)
						if len > 8 then
							local edge = Instance.new("Frame")
							edge.Name = "Edge_" .. pairKey
							edge.AnchorPoint = Vector2.new(0.5, 0.5)
							edge.Position = UDim2.fromScale((a.cx + b.cx) / 2, (a.cy + b.cy) / 2)
							edge.Size = UDim2.new(0, len, 0, 2)
							-- Roblox GUI Y axis points down and Rotation is clockwise-positive,
							-- so the screen-space atan2 angle is used directly (not negated).
							edge.Rotation = math.deg(math.atan2(dy, dx))
							edge.BackgroundColor3 = if a.powered and b.powered then COLOR_GREEN else COLOR_RED
							edge.BorderSizePixel = 0
							edge.ZIndex = 1
							edge.Parent = canvas
						end
					end
				end
			end
		end
	end
end

-- ===== TicketMonitor =====
local function buildTickets(ref: MonitorRef)
	local root = ref.root
	makeTitle(root, "KONTRAK & OBJECTIVES")

	local scroll = Instance.new("ScrollingFrame")
	scroll.Name = "TicketsList"
	scroll.Position = UDim2.new(0, 4, 0, 16)
	scroll.Size = UDim2.new(1, -8, 0, 62)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 3
	scroll.ScrollBarImageColor3 = COLOR_BORDER
	scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.Parent = root
	local listLayout = Instance.new("UIListLayout")
	listLayout.FillDirection = Enum.FillDirection.Vertical
	listLayout.Padding = UDim.new(0, 3)
	listLayout.SortOrder = Enum.SortOrder.LayoutOrder
	listLayout.Parent = scroll

	local objHeader = Instance.new("TextLabel")
	objHeader.Name = "ObjectivesHeader"
	objHeader.Size = UDim2.new(1, -8, 0, 10)
	objHeader.Position = UDim2.new(0, 4, 0, 80)
	objHeader.BackgroundTransparency = 1
	objHeader.Font = Enum.Font.GothamBold
	objHeader.TextScaled = true
	objHeader.TextColor3 = COLOR_GREY
	objHeader.TextXAlignment = Enum.TextXAlignment.Left
	objHeader.Text = "OBJECTIVES:"
	objHeader.Parent = root

	for i, objDef in ipairs(OBJECTIVES) do
		local row = Instance.new("Frame")
		row.Name = "Objective_" .. objDef.key
		row.Size = UDim2.new(1, -8, 0, 8.6)
		row.Position = UDim2.new(0, 4, 0, 92 + (i - 1) * 9.2)
		row.BackgroundTransparency = 1
		row.Parent = root

		local check = Instance.new("TextLabel")
		check.Name = "Check"
		check.Size = UDim2.new(0, 10, 1, 0)
		check.Position = UDim2.new(0, 2, 0, 0)
		check.BackgroundTransparency = 1
		check.Font = Enum.Font.GothamBold
		check.TextScaled = true
		check.TextColor3 = COLOR_GREY
		check.Text = "o"
		check.Parent = row

		local label = Instance.new("TextLabel")
		label.Name = "Label"
		label.Size = UDim2.new(1, -18, 1, 0)
		label.Position = UDim2.new(0, 14, 0, 0)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.Gotham
		label.TextScaled = true
		label.TextColor3 = COLOR_TEXT
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.Text = objDef.label
		label.Parent = row

		objectiveChecks[objDef.key] = check
	end

	ticketsScroll = scroll
end

local function updateTickets(snap: FacilitySnapshot)
	local scroll = ticketsScroll
	if scroll == nil then
		return
	end
	clearChildren(scroll)

	local tickets = snap.tickets or {}
	local order = 0
	for _, ticket in ipairs(tickets) do
		if ticket.status == "Available" or ticket.status == "Active" then
			order += 1
			local isActive = ticket.status == "Active"
			local row = Instance.new("Frame")
			row.Name = "Ticket_" .. tostring(ticket.id)
			row.Size = UDim2.new(1, -6, 0, 40)
			row.BackgroundColor3 = COLOR_ROW
			row.BorderSizePixel = 0
			row.LayoutOrder = order
			row.Parent = scroll
			local rowCorner = Instance.new("UICorner")
			rowCorner.CornerRadius = UDim.new(0, 4)
			rowCorner.Parent = row

			local titleLabel = Instance.new("TextLabel")
			titleLabel.Name = "TicketTitle"
			titleLabel.Size = UDim2.new(1, -66, 0, 14)
			titleLabel.Position = UDim2.new(0, 6, 0, 2)
			titleLabel.BackgroundTransparency = 1
			titleLabel.Font = Enum.Font.GothamBold
			titleLabel.TextScaled = true
			titleLabel.TextColor3 = if isActive then COLOR_GREEN else COLOR_TEXT
			titleLabel.TextXAlignment = Enum.TextXAlignment.Left
			titleLabel.Text = ticket.title
			titleLabel.Parent = row

			local subLabel = Instance.new("TextLabel")
			subLabel.Name = "TicketReward"
			subLabel.Size = UDim2.new(1, -66, 0, 11)
			subLabel.Position = UDim2.new(0, 6, 0, 17)
			subLabel.BackgroundTransparency = 1
			subLabel.Font = Enum.Font.Gotham
			subLabel.TextScaled = true
			subLabel.TextColor3 = COLOR_YELLOW
			subLabel.TextXAlignment = Enum.TextXAlignment.Left
			subLabel.Text = NetworkUtils.FormatCurrency(ticket.rewardPayout or 0) .. "  -  " .. tostring(ticket.category)
			subLabel.Parent = row

			local statusBits: { string } = {}
			local running = false
			if isActive then
				if ticket.category == "Colocation" and ticket.vlanId ~= nil then
					table.insert(statusBits, "VLAN " .. tostring(ticket.vlanId))
				end
				local note = ticket.validationText or ""
				running = string.find(note, "Layanan jalan") ~= nil
				if ticket.slaRemainingSec ~= nil and ticket.slaRemainingSec > 0 and not running then
					table.insert(statusBits, string.format("SLA %ds", ticket.slaRemainingSec))
				end
				if note ~= "" then
					table.insert(statusBits, note)
				end
			else
				table.insert(statusBits, ticket.requirementsText or "")
			end
			if #statusBits > 0 then
				local statusLabel = Instance.new("TextLabel")
				statusLabel.Name = "TicketStatus"
				statusLabel.Size = UDim2.new(1, -66, 0, 10)
				statusLabel.Position = UDim2.new(0, 6, 0, 28)
				statusLabel.BackgroundTransparency = 1
				statusLabel.Font = Enum.Font.Gotham
				statusLabel.TextSize = 10
				statusLabel.TextColor3 = if running then COLOR_GREEN else COLOR_GREY
				statusLabel.TextXAlignment = Enum.TextXAlignment.Left
				statusLabel.TextTruncate = Enum.TextTruncate.AtEnd
				statusLabel.Text = table.concat(statusBits, "  |  ")
				statusLabel.Parent = row
			end

			if isActive then
				local activeLabel = Instance.new("TextLabel")
				activeLabel.Name = "ActiveBadge"
				activeLabel.Size = UDim2.new(0, 52, 0, 22)
				activeLabel.Position = UDim2.new(1, -58, 0, 4)
				activeLabel.BackgroundTransparency = 1
				activeLabel.Font = Enum.Font.GothamBold
				activeLabel.TextScaled = true
				activeLabel.TextColor3 = COLOR_GREEN
				activeLabel.Text = "AKTIF"
				activeLabel.Parent = row
			else
				local acceptBtn = Instance.new("TextButton")
				acceptBtn.Name = "AcceptButton"
				acceptBtn.Size = UDim2.new(0, 52, 0, 22)
				acceptBtn.Position = UDim2.new(1, -58, 0, 4)
				acceptBtn.BackgroundColor3 = Color3.fromRGB(35, 134, 54)
				acceptBtn.Font = Enum.Font.GothamBold
				acceptBtn.TextSize = 12
				acceptBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
				acceptBtn.Text = "TERIMA"
				acceptBtn.AutoButtonColor = true
				acceptBtn.Parent = row
				local btnCorner = Instance.new("UICorner")
				btnCorner.CornerRadius = UDim.new(0, 4)
				btnCorner.Parent = acceptBtn
				acceptBtn.MouseButton1Click:Connect(function()
					contractRemote:FireServer({ action = "accept", ticketId = ticket.id })
				end)
			end
		end
	end
	if order == 0 then
		local empty = Instance.new("TextLabel")
		empty.Name = "NoTickets"
		empty.Size = UDim2.new(1, -6, 0, 20)
		empty.BackgroundTransparency = 1
		empty.Font = Enum.Font.Gotham
		empty.TextSize = 11
		empty.TextColor3 = COLOR_GREY
		empty.Text = "Belum ada kontrak tersedia..."
		empty.LayoutOrder = 999
		empty.Parent = scroll
	end

	-- Objectives checklist
	local objectives = snap.objectives or {}
	for _, objDef in ipairs(OBJECTIVES) do
		local check = objectiveChecks[objDef.key]
		if check ~= nil then
			local done = objectives[objDef.key] == true
			check.Text = if done then "✓" else "o"
			check.TextColor3 = if done then COLOR_GREEN else COLOR_GREY
		end
	end
end

-- ===== TelemetryMonitor =====
local function buildTelemetry(ref: MonitorRef)
	local root = ref.root
	makeTitle(root, "TELEMETRI")

	local rows: { { key: string, label: string } } = {
		{ key = "balance", label = "Saldo" },
		{ key = "reputation", label = "Reputasi" },
		{ key = "uptime", label = "Uptime" },
		{ key = "power", label = "Daya" },
		{ key = "temp", label = "Suhu Rata2" },
		{ key = "clock", label = "Hari / Jam" },
	}
	for i, rowDef in ipairs(rows) do
		local row = Instance.new("Frame")
		row.Name = "Row_" .. rowDef.key
		row.Size = UDim2.new(1, -8, 0, 16)
		row.Position = UDim2.new(0, 4, 0, 20 + (i - 1) * 18)
		row.BackgroundTransparency = 1
		row.Parent = root

		local label = Instance.new("TextLabel")
		label.Name = "RowLabel"
		label.Size = UDim2.new(0.42, 0, 1, 0)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.Gotham
		label.TextScaled = true
		label.TextColor3 = COLOR_GREY
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.Text = rowDef.label
		label.Parent = row

		local value = Instance.new("TextLabel")
		value.Name = "RowValue"
		value.Size = UDim2.new(0.58, -4, 1, 0)
		value.Position = UDim2.new(0.42, 0, 0, 0)
		value.BackgroundTransparency = 1
		value.Font = Enum.Font.GothamBold
		value.TextScaled = true
		value.TextColor3 = COLOR_TEXT
		value.TextXAlignment = Enum.TextXAlignment.Right
		value.Text = "-"
		value.Parent = row

		teleValues[rowDef.key] = value
	end

	local banner = Instance.new("Frame")
	banner.Name = "StormBanner"
	banner.Size = UDim2.new(1, -8, 0, 24)
	banner.Position = UDim2.new(0, 4, 0, 132)
	banner.BackgroundColor3 = Color3.fromRGB(150, 30, 30)
	banner.BorderSizePixel = 0
	banner.Visible = false
	banner.Parent = root
	local bannerCorner = Instance.new("UICorner")
	bannerCorner.CornerRadius = UDim.new(0, 4)
	bannerCorner.Parent = banner
	local bannerLabel = Instance.new("TextLabel")
	bannerLabel.Name = "StormText"
	bannerLabel.Size = UDim2.new(1, -8, 1, 0)
	bannerLabel.Position = UDim2.new(0, 4, 0, 0)
	bannerLabel.BackgroundTransparency = 1
	bannerLabel.Font = Enum.Font.GothamBold
	bannerLabel.TextScaled = true
	bannerLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	bannerLabel.Text = "BROADCAST STORM!"
	bannerLabel.Parent = banner

	stormBanner = banner
end

local function updateTelemetry(snap: FacilitySnapshot)
	local setValue = function(key: string, text: string, color: Color3?)
		local label = teleValues[key]
		if label ~= nil then
			label.Text = text
			if color ~= nil then
				label.TextColor3 = color
			end
		end
	end

	setValue("balance", NetworkUtils.FormatCurrency(snap.balance or 0), COLOR_GREEN)
	setValue("reputation", tostring(snap.reputation or 0), COLOR_TEXT)
	setValue("uptime", string.format("%.1f%%", snap.uptimePercent or 0), COLOR_TEXT)
	setValue("power", NetworkUtils.FormatWatts(snap.powerWatts or 0), COLOR_YELLOW)
	local tempC = snap.avgTempC or 0
	setValue("temp", string.format("%.1f °C", tempC), if tempC > 75 then COLOR_RED else COLOR_TEXT)
	setValue("clock", string.format("Hari %d  -  %s", snap.day or 1, snap.clockText or "--:--"), COLOR_TEXT)

	if stormBanner ~= nil then
		stormBanner.Visible = snap.storm == true
	end
end

-- ===== Build / update dispatch =====
local function buildMonitor(name: string, ref: MonitorRef)
	if name == "TopologyMonitor" then
		buildTopology(ref)
	elseif name == "TicketMonitor" then
		buildTickets(ref)
	elseif name == "TelemetryMonitor" then
		buildTelemetry(ref)
	end
	ref.root:SetAttribute("BuiltBy", "NetSimNOC")
end

local function updateMonitor(name: string, snap: FacilitySnapshot)
	if name == "TopologyMonitor" then
		updateTopology(snap)
	elseif name == "TicketMonitor" then
		updateTickets(snap)
	elseif name == "TelemetryMonitor" then
		updateTelemetry(snap)
	end
end

-- ===== Snapshot handling =====
stateSyncRemote.OnClientEvent:Connect(function(payload: any)
	if type(payload) ~= "table" then
		return
	end
	local snap = payload :: FacilitySnapshot
	if type(snap.plotIndex) ~= "number" or snap.plotIndex < 1 then
		return
	end
	if snap.plotIndex ~= lastPlotIndex then
		clearAllMonitorRefs()
		resetContentCaches()
		lastPlotIndex = snap.plotIndex
	end

	local plots = Workspace:FindFirstChild("Plots")
	if plots == nil then
		return
	end
	local plot = plots:FindFirstChild("Plot" .. tostring(snap.plotIndex))
	if plot == nil then
		return
	end

	refreshMonitorRefs(plot)

	for _, name in ipairs(MONITOR_NAMES) do
		local ref = monitorRefs[name]
		if ref ~= nil then
			-- Build once per Root (attribute guard); re-check in case the SurfaceGui got rebuilt
			if ref.root:GetAttribute("BuiltBy") ~= "NetSimNOC" then
				resetCachesFor(name)
				buildMonitor(name, ref)
			end
			updateMonitor(name, snap)
		end
	end
end)
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBX32">
<Properties>
<string name="Name">CatalogAndBuilderClient</string>
<bool name="Disabled">false</bool>
<ProtectedString name="Source"><![CDATA[--!strict
--[[
	CatalogAndBuilderClient (LocalScript, StarterPlayer/StarterPlayerScripts)
	Hardware Store (tombol keyboard B / tombol "STORE [B]" di HUD via BindableEvent
	"NetSimToggleStore" yang dibuat script ini) + ghost placement mode.

	Store 740x470 center: kolom kategori (Rack/Network/Server/Component/Cable dari
	HardwareCatalog.StoreCategories), daftar item (nama/harga/specs + tombol BELI),
	dan panel kanan "PANDUAN BUILD".

	Buy behavior (CONTRACT.md Section 3, PurchaseHardwareRemote):
	- Component -> FireServer(itemId, "buy")
	- Cable spool -> FireServer(itemId, "buy") (server menambah 5 kabel)
	- Placeable (Rack/Network/Server) -> FireServer(itemId, "prepare") lalu ghost mode:
	  RenderStepped mouse raycast (player:GetMouse(), TargetFilter=ghost), snap 2-grid
	  relatif PLOT_POSITIONS[ownPlotIndex], validasi lokal = bounds + furniture zones
	  (radius + max(halfX,halfZ) dari ModelFactory.ComputeFootprint; overlap device
	  lain divalidasi ulang oleh server). LMB = place, RMB/Esc = cancel, R = rotate 90.

	Semua teks GUI Bahasa Indonesia; komentar kode Bahasa Inggris.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local sharedFolder = ReplicatedStorage:WaitForChild("Shared")
local Catalog = require(sharedFolder:WaitForChild("HardwareCatalog"))
local PlotConstants = require(sharedFolder:WaitForChild("PlotConstants"))
local ModelFactory = require(sharedFolder:WaitForChild("ModelFactory"))
local NetworkUtils = require(sharedFolder:WaitForChild("NetworkUtils"))

local remotesFolder = ReplicatedStorage:WaitForChild("Remotes", 180) :: any
if remotesFolder == nil then
	warn("[CatalogAndBuilderClient] ReplicatedStorage.Remotes tidak ditemukan (timeout 180s)")
	return
end

local purchaseRemote = remotesFolder:WaitForChild("PurchaseHardwareRemote") :: RemoteEvent
local stateSyncRemote = remotesFolder:WaitForChild("StateSyncRemote") :: RemoteEvent

-- ===== Palette =====
local COLOR_BG = Color3.fromRGB(13, 17, 23)
local COLOR_CARD = Color3.fromRGB(22, 27, 34)
local COLOR_ROW = Color3.fromRGB(28, 33, 41)
local COLOR_BORDER = Color3.fromRGB(48, 54, 61)
local COLOR_GREEN = Color3.fromRGB(0, 255, 102)
local COLOR_BLUE = Color3.fromRGB(88, 166, 255)
local COLOR_RED = Color3.fromRGB(255, 85, 85)
local COLOR_YELLOW = Color3.fromRGB(255, 216, 102)
local COLOR_GREY = Color3.fromRGB(139, 148, 158)
local COLOR_TEXT = Color3.fromRGB(201, 209, 217)
local COLOR_BUY_OK = Color3.fromRGB(35, 134, 54)
local COLOR_BUY_POOR = Color3.fromRGB(110, 60, 60)

-- ===== State =====
local lastPlotIndex: number? = nil
local lastBalance: number? = nil
local storeVisible = false
local selectedCategory: string = "Rack"

type GhostState = {
	itemId: string,
	model: Model,
	origColors: { [BasePart]: Color3 },
	halfX: number,
	halfZ: number,
	rotY: number,
	valid: boolean,
	snappedCF: CFrame,
	connRender: RBXScriptConnection,
	connInput: RBXScriptConnection,
}
local ghost: GhostState? = nil

-- Forward declarations (mutually recursive helpers, assigned further below)
local selectCategory: (string) -> ()
local rebuildItems: () -> ()
local onBuy: (def: any) -> ()
local startGhost: (itemId: string) -> ()
local exitGhost: (cancel: boolean) -> ()
local updateGhost: () -> ()
local toggleStore: () -> ()

-- ===== Helpers =====
local function plotOrigin(): Vector3?
	local idx = lastPlotIndex
	if idx == nil or idx < 1 or idx > #PlotConstants.PLOT_POSITIONS then
		return nil
	end
	return PlotConstants.PLOT_POSITIONS[idx]
end

local function clearDynamicChildren(inst: Instance)
	for _, child in ipairs(inst:GetChildren()) do
		if not child:IsA("UICorner") and not child:IsA("UIStroke") and not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end
end

-- Compact Indonesian spec line per item category
local function specsLine(def: any): string
	local s = def.specs or {}
	local id = tostring(def.id)
	if def.category == "Rack" then
		return string.format("Max %dU  -  PDU %dW", s.maxU or 0, s.maxPowerWatts or 0)
	elseif def.category == "Network" then
		return string.format("%d RJ45  -  %d WAN  -  %d SFP  -  %dW", s.ports or 0, s.wanPorts or 0, s.sfpPorts or 0, s.powerWatts or 0)
	elseif def.category == "Server" then
		return string.format("%d vCPU  -  %dGB RAM  -  %dGB Disk  -  %dW", s.cpu or 0, s.ram or 0, s.disk or 0, s.powerWatts or 0)
	elseif def.category == "Cable" then
		return string.format("1 spool = %d kabel  -  klik dua port untuk pasang", PlotConstants.CABLES.spoolYield)
	end
	-- Components
	if string.sub(id, 1, 8) == "chassis_" then
		return string.format("%dU  -  %d port", s.uSize or def.uSize or 0, s.ports or 0)
	elseif string.sub(id, 1, 5) == "mobo_" then
		return string.format("%d socket  -  %d slot RAM  -  %d bay", s.sockets or 0, s.ramSlots or 0, s.storageBays or 0)
	elseif string.sub(id, 1, 4) == "cpu_" then
		return string.format("%d core", s.cores or 0)
	elseif string.sub(id, 1, 4) == "ram_" then
		return string.format("%d GB", s.ramGb or 0)
	elseif string.sub(id, 1, 5) == "nvme_" or id == "replacement_hdd" then
		return string.format("%d GB", s.storageGb or 0)
	elseif string.sub(id, 1, 4) == "psu_" then
		return string.format("%d W", s.powerWatts or 0)
	end
	return tostring(def.description)
end

-- ===== Store GUI build =====
local storeGui = Instance.new("ScreenGui")
storeGui.Name = "NetSimStore"
storeGui.ResetOnSpawn = false
storeGui.DisplayOrder = 90
storeGui.Parent = playerGui

local storeWindow = Instance.new("Frame")
storeWindow.Name = "StoreWindow"
storeWindow.AnchorPoint = Vector2.new(0.5, 0.5)
storeWindow.Position = UDim2.new(0.5, 0, 0.5, 0)
storeWindow.Size = UDim2.new(0, 740, 0, 470)
storeWindow.BackgroundColor3 = COLOR_BG
storeWindow.BorderSizePixel = 0
storeWindow.Active = true -- absorb mouse clicks on PC so tools/ClickDetectors behind do not trigger
storeWindow.Visible = false
storeWindow.Parent = storeGui
local windowCorner = Instance.new("UICorner")
windowCorner.CornerRadius = UDim.new(0, 10)
windowCorner.Parent = storeWindow
local windowStroke = Instance.new("UIStroke")
windowStroke.Color = COLOR_BORDER
windowStroke.Thickness = 1
windowStroke.Parent = storeWindow

-- Title bar
local titleBar = Instance.new("Frame")
titleBar.Name = "TitleBar"
titleBar.Size = UDim2.new(1, 0, 0, 34)
titleBar.BackgroundColor3 = COLOR_CARD
titleBar.BorderSizePixel = 0
titleBar.Parent = storeWindow
local titleBarCorner = Instance.new("UICorner")
titleBarCorner.CornerRadius = UDim.new(0, 10)
titleBarCorner.Parent = titleBar

local titleLabel = Instance.new("TextLabel")
titleLabel.Size = UDim2.new(1, -260, 1, 0)
titleLabel.Position = UDim2.new(0, 12, 0, 0)
titleLabel.BackgroundTransparency = 1
titleLabel.Font = Enum.Font.GothamBold
titleLabel.TextSize = 15
titleLabel.TextXAlignment = Enum.TextXAlignment.Left
titleLabel.TextColor3 = COLOR_GREEN
titleLabel.Text = "TOKO HARDWARE"
titleLabel.Parent = titleBar

local subLabel = Instance.new("TextLabel")
subLabel.Size = UDim2.new(0, 220, 1, 0)
subLabel.Position = UDim2.new(1, -294, 0, 0)
subLabel.BackgroundTransparency = 1
subLabel.Font = Enum.Font.Gotham
subLabel.TextSize = 11
subLabel.TextXAlignment = Enum.TextXAlignment.Right
subLabel.TextColor3 = COLOR_GREY
subLabel.Text = "tekan [B] buka / tutup"
subLabel.Parent = titleBar

local closeBtn = Instance.new("TextButton")
closeBtn.Name = "CloseButton"
closeBtn.Size = UDim2.new(0, 60, 0, 26)
closeBtn.Position = UDim2.new(1, -66, 0, 4)
closeBtn.BackgroundColor3 = Color3.fromRGB(145, 40, 48)
closeBtn.Font = Enum.Font.GothamBold
closeBtn.TextSize = 12
closeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
closeBtn.Text = "X [B]"
closeBtn.Modal = true -- frees PC mouse cursor in First-Person / ShiftLock
closeBtn.Active = true
closeBtn.Parent = titleBar
local closeCorner = Instance.new("UICorner")
closeCorner.CornerRadius = UDim.new(0, 6)
closeCorner.Parent = closeBtn

-- Left column: categories
local catHeader = Instance.new("TextLabel")
catHeader.Size = UDim2.new(0, 120, 0, 16)
catHeader.Position = UDim2.new(0, 8, 0, 40)
catHeader.BackgroundTransparency = 1
catHeader.Font = Enum.Font.GothamBold
catHeader.TextSize = 11
catHeader.TextXAlignment = Enum.TextXAlignment.Left
catHeader.TextColor3 = COLOR_GREY
catHeader.Text = "KATEGORI"
catHeader.Parent = storeWindow

local categoryButtons: { [string]: TextButton } = {}
local categoryStrokes: { [string]: UIStroke } = {}

for i, category in ipairs(Catalog.StoreCategories) do
	local catName = tostring(category)
	local btn = Instance.new("TextButton")
	btn.Name = "Category_" .. catName
	btn.Size = UDim2.new(0, 120, 0, 30)
	btn.Position = UDim2.new(0, 8, 0, 60 + (i - 1) * 36)
	btn.BackgroundColor3 = COLOR_CARD
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 13
	btn.TextColor3 = COLOR_TEXT
	btn.Text = catName
	btn.AutoButtonColor = true
	btn.Parent = storeWindow
	local btnCorner = Instance.new("UICorner")
	btnCorner.CornerRadius = UDim.new(0, 6)
	btnCorner.Parent = btn
	local btnStroke = Instance.new("UIStroke")
	btnStroke.Color = COLOR_BORDER
	btnStroke.Thickness = 1
	btnStroke.Transparency = 0.4
	btnStroke.Parent = btn
	btn.MouseButton1Click:Connect(function()
		selectCategory(catName)
	end)
	categoryButtons[catName] = btn
	categoryStrokes[catName] = btnStroke
end

-- Middle column: item list
local itemsHeader = Instance.new("TextLabel")
itemsHeader.Size = UDim2.new(0, 380, 0, 16)
itemsHeader.Position = UDim2.new(0, 136, 0, 40)
itemsHeader.BackgroundTransparency = 1
itemsHeader.Font = Enum.Font.GothamBold
itemsHeader.TextSize = 11
itemsHeader.TextXAlignment = Enum.TextXAlignment.Left
itemsHeader.TextColor3 = COLOR_GREY
itemsHeader.Text = "ITEM"
itemsHeader.Parent = storeWindow

local itemsScroll = Instance.new("ScrollingFrame")
itemsScroll.Name = "ItemsScroll"
itemsScroll.Position = UDim2.new(0, 136, 0, 60)
itemsScroll.Size = UDim2.new(0, 380, 1, -84)
itemsScroll.BackgroundTransparency = 1
itemsScroll.BorderSizePixel = 0
itemsScroll.ScrollBarThickness = 6
itemsScroll.ScrollBarImageColor3 = COLOR_BORDER
itemsScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
itemsScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
itemsScroll.Parent = storeWindow
local itemsLayout = Instance.new("UIListLayout")
itemsLayout.FillDirection = Enum.FillDirection.Vertical
itemsLayout.Padding = UDim.new(0, 5)
itemsLayout.SortOrder = Enum.SortOrder.LayoutOrder
itemsLayout.Parent = itemsScroll

-- Status label (transient feedback, e.g. saldo tidak cukup)
local statusLabel = Instance.new("TextLabel")
statusLabel.Name = "StatusLabel"
statusLabel.Size = UDim2.new(0, 380, 0, 16)
statusLabel.Position = UDim2.new(0, 136, 1, -20)
statusLabel.BackgroundTransparency = 1
statusLabel.Font = Enum.Font.Gotham
statusLabel.TextSize = 11
statusLabel.TextColor3 = COLOR_YELLOW
statusLabel.Text = ""
statusLabel.Visible = false
statusLabel.Parent = storeWindow
local statusToken = 0

local function showStatus(message: string)
	statusToken += 1
	local myToken = statusToken
	statusLabel.Text = message
	statusLabel.Visible = true
	task.delay(3, function()
		if statusToken == myToken then
			statusLabel.Visible = false
		end
	end)
end

-- Right column: build guide (static, PC-oriented)
local guideHeader = Instance.new("TextLabel")
guideHeader.Size = UDim2.new(0, 208, 0, 16)
guideHeader.Position = UDim2.new(0, 524, 0, 40)
guideHeader.BackgroundTransparency = 1
guideHeader.Font = Enum.Font.GothamBold
guideHeader.TextSize = 11
guideHeader.TextXAlignment = Enum.TextXAlignment.Left
guideHeader.TextColor3 = COLOR_BLUE
guideHeader.Text = "PANDUAN BUILD (PC)"
guideHeader.Parent = storeWindow

local guideBody = Instance.new("TextLabel")
guideBody.Name = "BuildGuide"
guideBody.Size = UDim2.new(0, 208, 1, -68)
guideBody.Position = UDim2.new(0, 524, 0, 60)
guideBody.BackgroundColor3 = COLOR_CARD
guideBody.BorderSizePixel = 0
guideBody.Font = Enum.Font.Gotham
guideBody.TextSize = 12
guideBody.TextWrapped = true
guideBody.TextXAlignment = Enum.TextXAlignment.Left
guideBody.TextYAlignment = Enum.TextYAlignment.Top
guideBody.TextColor3 = COLOR_TEXT
guideBody.Text = "Urutan Rakit Workbench:\nChassis -> Mobo -> CPU -> RAM -> Storage -> PSU\n\nLangkah PC:\n- Klik saklar merah di bench\n- Dekati bench + tekan [E] (pegang laptop)\n- Terminal: install-os ubuntu-22.04\n- Terminal: stress-test\n- Terminal: ship (kirim ke dock)\n\nKontrol Placement:\n[Klik Kiri] Pasang\n[R] Putar 90 deg\n[Klik Kanan / Esc] Batal"
guideBody.Parent = storeWindow
local guideCorner = Instance.new("UICorner")
guideCorner.CornerRadius = UDim.new(0, 6)
guideCorner.Parent = guideBody
local guidePadding = Instance.new("UIPadding")
guidePadding.PaddingLeft = UDim.new(0, 10)
guidePadding.PaddingTop = UDim.new(0, 8)
guidePadding.PaddingRight = UDim.new(0, 10)
guidePadding.PaddingBottom = UDim.new(0, 8)
guidePadding.Parent = guideBody

-- PC ghost placement bottom control bar (visible only while placing)
local ghostBanner = Instance.new("TextLabel")
ghostBanner.Name = "GhostBanner"
ghostBanner.AnchorPoint = Vector2.new(0.5, 1)
ghostBanner.Position = UDim2.new(0.5, 0, 1, -46)
ghostBanner.Size = UDim2.new(0, 540, 0, 30)
ghostBanner.BackgroundColor3 = COLOR_BG
ghostBanner.BackgroundTransparency = 0.12
ghostBanner.Font = Enum.Font.GothamBold
ghostBanner.TextSize = 13
ghostBanner.TextColor3 = COLOR_YELLOW
ghostBanner.Text = "[PLACEMENT PC]  Klik Kiri: Pasang  |  [R]: Putar 90 deg  |  Klik Kanan / [Esc]: Batal"
ghostBanner.Visible = false
ghostBanner.Parent = storeGui
local ghostBannerCorner = Instance.new("UICorner")
ghostBannerCorner.CornerRadius = UDim.new(0, 8)
ghostBannerCorner.Parent = ghostBanner
local ghostBannerStroke = Instance.new("UIStroke")
ghostBannerStroke.Color = COLOR_BORDER
ghostBannerStroke.Thickness = 1
ghostBannerStroke.Parent = ghostBanner

-- ===== Category selection + item rows =====
type ItemRow = {
	def: any,
	buyBtn: TextButton,
}
local currentRows: { ItemRow } = {}

local function updateAffordability()
	local balance = lastBalance
	for _, row in ipairs(currentRows) do
		local poor = balance ~= nil and balance < (row.def.price or 0)
		row.buyBtn.BackgroundColor3 = if poor then COLOR_BUY_POOR else COLOR_BUY_OK
	end
end

selectCategory = function(category: string)
	selectedCategory = category
	for name, btn in pairs(categoryButtons) do
		local stroke = categoryStrokes[name]
		local active = name == selectedCategory
		btn.TextColor3 = if active then COLOR_GREEN else COLOR_TEXT
		if stroke ~= nil then
			stroke.Color = if active then COLOR_GREEN else COLOR_BORDER
			stroke.Transparency = if active then 0 else 0.4
		end
	end
	rebuildItems()
end

onBuy = function(def: any)
	if ghost ~= nil then
		showStatus("Selesaikan / batalkan placement dulu (klik kanan = batal)")
		return
	end
	if def.category == "Component" then
		-- Components go straight to the workbench (server validates order + proximity)
		purchaseRemote:FireServer(def.id, "buy")
		showStatus("Komponen dibeli: " .. tostring(def.name) .. " (pasang di bench)")
	elseif def.category == "Cable" then
		-- Fase 2: a spool fills the matching cable inventory server-side.
		purchaseRemote:FireServer(def.id, "buy")
		showStatus("Spool dibeli: " .. tostring(def.name) .. " (+" .. tostring(PlotConstants.CABLES.spoolYield) .. " kabel)")
	else
		if lastBalance ~= nil and lastBalance < (def.price or 0) then
			showStatus("Saldo tidak cukup untuk " .. tostring(def.name))
			return
		end
		purchaseRemote:FireServer(def.id, "prepare")
		startGhost(def.id)
	end
end

rebuildItems = function()
	clearDynamicChildren(itemsScroll)
	currentRows = {}
	local items = Catalog.ListByCategory(selectedCategory :: any)
	for i, def in ipairs(items) do
		local row = Instance.new("Frame")
		row.Name = "Item_" .. tostring(def.id)
		row.Size = UDim2.new(1, -6, 0, 54)
		row.BackgroundColor3 = COLOR_ROW
		row.BorderSizePixel = 0
		row.LayoutOrder = i
		row.Parent = itemsScroll
		local rowCorner = Instance.new("UICorner")
		rowCorner.CornerRadius = UDim.new(0, 6)
		rowCorner.Parent = row

		local nameLabel = Instance.new("TextLabel")
		nameLabel.Size = UDim2.new(1, -84, 0, 16)
		nameLabel.Position = UDim2.new(0, 8, 0, 4)
		nameLabel.BackgroundTransparency = 1
		nameLabel.Font = Enum.Font.GothamBold
		nameLabel.TextSize = 13
		nameLabel.TextXAlignment = Enum.TextXAlignment.Left
		nameLabel.TextColor3 = COLOR_TEXT
		nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
		nameLabel.Text = tostring(def.name)
		nameLabel.Parent = row

		local specLabel = Instance.new("TextLabel")
		specLabel.Size = UDim2.new(1, -84, 0, 14)
		specLabel.Position = UDim2.new(0, 8, 0, 21)
		specLabel.BackgroundTransparency = 1
		specLabel.Font = Enum.Font.Gotham
		specLabel.TextSize = 11
		specLabel.TextXAlignment = Enum.TextXAlignment.Left
		specLabel.TextColor3 = COLOR_GREY
		specLabel.TextTruncate = Enum.TextTruncate.AtEnd
		specLabel.Text = specsLine(def)
		specLabel.Parent = row

		local priceLabel = Instance.new("TextLabel")
		priceLabel.Size = UDim2.new(1, -84, 0, 14)
		priceLabel.Position = UDim2.new(0, 8, 0, 37)
		priceLabel.BackgroundTransparency = 1
		priceLabel.Font = Enum.Font.GothamBold
		priceLabel.TextSize = 12
		priceLabel.TextXAlignment = Enum.TextXAlignment.Left
		priceLabel.TextColor3 = COLOR_GREEN
		priceLabel.Text = NetworkUtils.FormatCurrency(def.price or 0)
		priceLabel.Parent = row

		local buyBtn = Instance.new("TextButton")
		buyBtn.Name = "BuyButton"
		buyBtn.Size = UDim2.new(0, 62, 0, 34)
		buyBtn.Position = UDim2.new(1, -70, 0, 10)
		buyBtn.BackgroundColor3 = COLOR_BUY_OK
		buyBtn.Font = Enum.Font.GothamBold
		buyBtn.TextSize = 13
		buyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		buyBtn.Text = "BELI"
		buyBtn.AutoButtonColor = true
		buyBtn.Parent = row
		local buyCorner = Instance.new("UICorner")
		buyCorner.CornerRadius = UDim.new(0, 6)
		buyCorner.Parent = buyBtn
		buyBtn.MouseButton1Click:Connect(function()
			onBuy(def)
		end)

		table.insert(currentRows, { def = def, buyBtn = buyBtn })
	end
	if #currentRows == 0 then
		local empty = Instance.new("TextLabel")
		empty.Size = UDim2.new(1, -6, 0, 24)
		empty.BackgroundTransparency = 1
		empty.Font = Enum.Font.Gotham
		empty.TextSize = 12
		empty.TextColor3 = COLOR_GREY
		empty.Text = "Tidak ada item di kategori ini"
		empty.LayoutOrder = 9999
		empty.Parent = itemsScroll
	end
	updateAffordability()
end

local function closeStore()
	storeWindow.Visible = false
	storeVisible = false
end

closeBtn.MouseButton1Down:Connect(closeStore)
closeBtn.MouseButton1Click:Connect(closeStore)

local function setStoreVisible(visible: boolean)
	if ghost ~= nil and visible then
		return -- never open the store while a ghost placement is in progress
	end
	storeWindow.Visible = visible
	storeVisible = visible
end

toggleStore = function()
	setStoreVisible(not storeVisible)
end

-- ===== Ghost placement mode =====
exitGhost = function(cancel: boolean)
	local g = ghost
	if g == nil then
		return
	end
	ghost = nil
	ghostBanner.Visible = false
	if g.connRender.Connected then
		g.connRender:Disconnect()
	end
	if g.connInput.Connected then
		g.connInput:Disconnect()
	end
	if cancel then
		purchaseRemote:FireServer(g.itemId, "cancel")
	end
	player:GetMouse().TargetFilter = nil
	g.model:Destroy()
end

updateGhost = function()
	local g = ghost
	if g == nil then
		return
	end
	local mouse = player:GetMouse()
	local hit = mouse.Target
	if hit ~= nil then
		local hitPos = mouse.Hit.Position
		local origin = plotOrigin()
		if origin ~= nil then
			local snap = PlotConstants.SNAP_GRID
			local relX = hitPos.X - origin.X
			local relZ = hitPos.Z - origin.Z
			local sx = math.floor(relX / snap + 0.5) * snap
			local sz = math.floor(relZ / snap + 0.5) * snap
			g.snappedCF = CFrame.new(origin.X + sx, PlotConstants.ROOM.floorTopY, origin.Z + sz)

			-- Local validity: placement bounds + furniture zones (server revalidates overlap etc.)
			local bounds = PlotConstants.PLACEMENT_BOUNDS
			local valid = sx >= bounds.minX and sx <= bounds.maxX and sz >= bounds.minZ and sz <= bounds.maxZ
			if valid then
				local maxHalf = math.max(g.halfX, g.halfZ)
				for _, zone in ipairs(PlotConstants.FURNITURE_ZONES) do
					local dx = sx - zone.position.X
					local dz = sz - zone.position.Z
					if math.sqrt(dx * dx + dz * dz) < zone.radius + maxHalf then
						valid = false
						break
					end
				end
			end
			g.valid = valid
		else
			g.valid = false
		end
	end

	local tint = if g.valid then COLOR_GREEN else COLOR_RED
	for part, orig in pairs(g.origColors) do
		if part.Parent ~= nil then
			part.Color = orig:Lerp(tint, 0.5)
		end
	end
	g.model:PivotTo(g.snappedCF * CFrame.Angles(0, math.rad(g.rotY), 0))
end

startGhost = function(itemId: string)
	local def = Catalog.Get(itemId)
	if def == nil then
		return
	end
	exitGhost(true) -- cancel any previous pending placement

	local model: Model
	if def.category == "Rack" then
		model = ModelFactory.BuildRack(itemId, "ghost")
	else
		model = ModelFactory.BuildDeviceModel(itemId, "ghost")
	end
	model.Name = "Ghost_" .. itemId

	local origColors: { [BasePart]: Color3 } = {}
	for _, desc in ipairs(model:GetDescendants()) do
		if desc:IsA("BasePart") then
			local part = desc :: BasePart
			origColors[part] = part.Color
			part.Transparency = 0.5
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			part.Anchored = true
		end
	end

	local halfX, halfZ = ModelFactory.ComputeFootprint(itemId)
	local origin = plotOrigin()
	local startCF: CFrame
	if origin ~= nil then
		startCF = CFrame.new(origin.X, PlotConstants.ROOM.floorTopY, origin.Z)
	else
		startCF = CFrame.new(0, PlotConstants.ROOM.floorTopY, 0)
	end

	local connRender = RunService.RenderStepped:Connect(updateGhost)
	local connInput = UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
		local g = ghost
		if g == nil then
			return
		end
		if input.KeyCode == Enum.KeyCode.R then
			g.rotY = (g.rotY + 90) % 360
		elseif input.KeyCode == Enum.KeyCode.Escape then
			exitGhost(true)
		elseif input.UserInputType == Enum.UserInputType.MouseButton1 and not gameProcessed then
			if g.valid then
				purchaseRemote:FireServer(g.itemId, "place", g.snappedCF, math.rad(g.rotY))
				exitGhost(false)
			end
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
			exitGhost(true)
		end
	end)

	ghost = {
		itemId = itemId,
		model = model,
		origColors = origColors,
		halfX = halfX,
		halfZ = halfZ,
		rotY = 0,
		valid = false,
		snappedCF = startCF,
		connRender = connRender,
		connInput = connInput,
	}

	model.Parent = Workspace
	player:GetMouse().TargetFilter = model
	model:PivotTo(startCF)

	ghostBanner.Visible = true
	setStoreVisible(false)
end

-- ===== Input: key B toggles store (works anytime no TextBox is focused) =====
UserInputService.InputBegan:Connect(function(input: InputObject, _gameProcessed: boolean)
	if UserInputService:GetFocusedTextBox() ~= nil then
		return
	end
	if input.KeyCode == Enum.KeyCode.B then
		toggleStore()
	end
end)

-- ===== Cross-script toggle: HudClient's "STORE [B]" button fires this bindable =====
local toggleBindable = Instance.new("BindableEvent")
toggleBindable.Name = "NetSimToggleStore"
toggleBindable.Parent = playerGui
toggleBindable.Event:Connect(function()
	toggleStore()
end)

-- ===== Snapshot: keep plot index + balance for ghost validation & affordability =====
stateSyncRemote.OnClientEvent:Connect(function(payload: any)
	if type(payload) ~= "table" then
		return
	end
	local plotIndex = payload.plotIndex
	local balance = payload.balance
	if type(plotIndex) == "number" and plotIndex >= 1 then
		lastPlotIndex = plotIndex
	end
	if type(balance) == "number" then
		lastBalance = balance
		updateAffordability()
	end
end)

-- Initial category render
selectCategory("Rack")
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBX33">
<Properties>
<string name="Name">HudClient</string>
<bool name="Disabled">false</bool>
<ProtectedString name="Source"><![CDATA[--!strict
--[[
	HudClient (LocalScript, StarterPlayer/StarterPlayerScripts)
	HUD pemain:
	- Panel kanan-atas: Saldo (besar, hijau), Reputasi, Uptime %, Daya, Suhu rata-rata,
	  Hari/Jam -- di-update dari StateSyncRemote (FacilitySnapshot tiap 5s).
	- Tombol "STORE [B]" kiri-atas: memicu BindableEvent "NetSimToggleStore" yang dibuat
	  oleh CatalogAndBuilderClient untuk membuka/menutup jendela store.
	- Tombol "RESET DATA" kanan-atas (di bawah panel): konfirmasi 2 klik dalam 4 detik
	  -> ResetDataRemote:FireServer().
	- Hint bawah-tengah: tips berputar tiap 8 detik; pesan {action="hint"} dari
	  OpenTerminalEvent tampil 4 detik dengan prioritas.

	Semua teks GUI Bahasa Indonesia; komentar kode Bahasa Inggris.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local sharedFolder = ReplicatedStorage:WaitForChild("Shared")
local NetworkUtils = require(sharedFolder:WaitForChild("NetworkUtils"))

local remotesFolder = ReplicatedStorage:WaitForChild("Remotes", 180) :: any
if remotesFolder == nil then
	warn("[HudClient] ReplicatedStorage.Remotes tidak ditemukan (timeout 180s)")
	return
end

local stateSyncRemote = remotesFolder:WaitForChild("StateSyncRemote") :: RemoteEvent
local openTerminalRemote = remotesFolder:WaitForChild("OpenTerminalEvent") :: RemoteEvent
local resetDataRemote = remotesFolder:WaitForChild("ResetDataRemote") :: RemoteEvent

-- ===== Palette =====
local COLOR_BG = Color3.fromRGB(13, 17, 23)
local COLOR_CARD = Color3.fromRGB(22, 27, 34)
local COLOR_BORDER = Color3.fromRGB(48, 54, 61)
local COLOR_GREEN = Color3.fromRGB(0, 255, 102)
local COLOR_RED = Color3.fromRGB(255, 85, 85)
local COLOR_YELLOW = Color3.fromRGB(255, 216, 102)
local COLOR_GREY = Color3.fromRGB(139, 148, 158)
local COLOR_TEXT = Color3.fromRGB(230, 237, 243)
local COLOR_RESET = Color3.fromRGB(140, 45, 45)

-- ===== GUI build =====
local gui = Instance.new("ScreenGui")
gui.Name = "NetSimHUD"
gui.ResetOnSpawn = false
gui.DisplayOrder = 50
gui.Parent = playerGui

-- Top-left: PC quick buttons (STORE [B] + TERMINAL [~])
local storeBtn = Instance.new("TextButton")
storeBtn.Name = "StoreButton"
storeBtn.Size = UDim2.new(0, 110, 0, 30)
storeBtn.Position = UDim2.new(0, 12, 0, 12)
storeBtn.BackgroundColor3 = COLOR_CARD
storeBtn.Font = Enum.Font.GothamBold
storeBtn.TextSize = 13
storeBtn.TextColor3 = COLOR_GREEN
storeBtn.Text = "STORE [B]"
storeBtn.AutoButtonColor = true
storeBtn.Active = true
storeBtn.Parent = gui
local storeCorner = Instance.new("UICorner")
storeCorner.CornerRadius = UDim.new(0, 6)
storeCorner.Parent = storeBtn
local storeStroke = Instance.new("UIStroke")
storeStroke.Color = COLOR_BORDER
storeStroke.Thickness = 1
storeStroke.Parent = storeBtn

local termBtn = Instance.new("TextButton")
termBtn.Name = "TerminalButton"
termBtn.Size = UDim2.new(0, 128, 0, 30)
termBtn.Position = UDim2.new(0, 130, 0, 12)
termBtn.BackgroundColor3 = COLOR_CARD
termBtn.Font = Enum.Font.GothamBold
termBtn.TextSize = 13
termBtn.TextColor3 = Color3.fromRGB(88, 166, 255)
termBtn.Text = "TERMINAL [~]"
termBtn.AutoButtonColor = true
termBtn.Active = true
termBtn.Parent = gui
local termCorner = Instance.new("UICorner")
termCorner.CornerRadius = UDim.new(0, 6)
termCorner.Parent = termBtn
local termStroke = Instance.new("UIStroke")
termStroke.Color = COLOR_BORDER
termStroke.Thickness = 1
termStroke.Parent = termBtn

-- Top-right: stats panel
local panel = Instance.new("Frame")
panel.Name = "StatsPanel"
panel.AnchorPoint = Vector2.new(1, 0)
panel.Position = UDim2.new(1, -12, 0, 12)
panel.Size = UDim2.new(0, 212, 0, 152)
panel.BackgroundColor3 = COLOR_BG
panel.BackgroundTransparency = 0.15
panel.BorderSizePixel = 0
panel.Active = true
panel.Parent = gui
local panelCorner = Instance.new("UICorner")
panelCorner.CornerRadius = UDim.new(0, 10)
panelCorner.Parent = panel
local panelStroke = Instance.new("UIStroke")
panelStroke.Color = COLOR_BORDER
panelStroke.Thickness = 1
panelStroke.Parent = panel

local panelTitle = Instance.new("TextLabel")
panelTitle.Name = "PanelTitle"
panelTitle.Size = UDim2.new(1, -12, 0, 14)
panelTitle.Position = UDim2.new(0, 8, 0, 4)
panelTitle.BackgroundTransparency = 1
panelTitle.Font = Enum.Font.GothamBold
panelTitle.TextSize = 11
panelTitle.TextXAlignment = Enum.TextXAlignment.Left
panelTitle.TextColor3 = COLOR_GREY
panelTitle.Text = "STATUS LAB"
panelTitle.Parent = panel

local valueLabels: { [string]: TextLabel } = {}

-- Balance row (big green value)
do
	local row = Instance.new("Frame")
	row.Name = "Row_balance"
	row.Size = UDim2.new(1, -12, 0, 26)
	row.Position = UDim2.new(0, 8, 0, 20)
	row.BackgroundTransparency = 1
	row.Parent = panel

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0.4, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.Gotham
	label.TextSize = 12
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextColor3 = COLOR_GREY
	label.Text = "SALDO"
	label.Parent = row

	local value = Instance.new("TextLabel")
	value.Size = UDim2.new(0.6, 0, 1, 0)
	value.Position = UDim2.new(0.4, 0, 0, 0)
	value.BackgroundTransparency = 1
	value.Font = Enum.Font.GothamBold
	value.TextSize = 19
	value.TextXAlignment = Enum.TextXAlignment.Right
	value.TextColor3 = COLOR_GREEN
	value.Text = "$0"
	value.Parent = row

	valueLabels["balance"] = value
end

local HUD_ROWS: { { key: string, label: string } } = {
	{ key = "reputation", label = "Reputasi" },
	{ key = "uptime", label = "Uptime" },
	{ key = "power", label = "Daya" },
	{ key = "temp", label = "Suhu" },
	{ key = "clock", label = "Hari / Jam" },
}

for i, rowDef in ipairs(HUD_ROWS) do
	local row = Instance.new("Frame")
	row.Name = "Row_" .. rowDef.key
	row.Size = UDim2.new(1, -12, 0, 16)
	row.Position = UDim2.new(0, 8, 0, 48 + (i - 1) * 18)
	row.BackgroundTransparency = 1
	row.Parent = panel

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0.4, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.Gotham
	label.TextSize = 12
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextColor3 = COLOR_GREY
	label.Text = rowDef.label
	label.Parent = row

	local value = Instance.new("TextLabel")
	value.Size = UDim2.new(0.6, 0, 1, 0)
	value.Position = UDim2.new(0.4, 0, 0, 0)
	value.BackgroundTransparency = 1
	value.Font = Enum.Font.GothamBold
	value.TextSize = 13
	value.TextXAlignment = Enum.TextXAlignment.Right
	value.TextColor3 = COLOR_TEXT
	value.Text = "-"
	value.Parent = row

	valueLabels[rowDef.key] = value
end

-- Top-right: RESET DATA button under the panel (2-click confirm, 4s window)
local resetBtn = Instance.new("TextButton")
resetBtn.Name = "ResetButton"
resetBtn.AnchorPoint = Vector2.new(1, 0)
resetBtn.Position = UDim2.new(1, -12, 0, 170)
resetBtn.Size = UDim2.new(0, 212, 0, 26)
resetBtn.BackgroundColor3 = COLOR_RESET
resetBtn.Font = Enum.Font.GothamBold
resetBtn.TextSize = 12
resetBtn.TextColor3 = COLOR_TEXT
resetBtn.Text = "RESET DATA"
resetBtn.AutoButtonColor = true
resetBtn.Parent = gui
local resetCorner = Instance.new("UICorner")
resetCorner.CornerRadius = UDim.new(0, 6)
resetCorner.Parent = resetBtn

-- Bottom-center hint label
local hintLabel = Instance.new("TextLabel")
hintLabel.Name = "HintLabel"
hintLabel.AnchorPoint = Vector2.new(0.5, 1)
hintLabel.Position = UDim2.new(0.5, 0, 1, -12)
hintLabel.Size = UDim2.new(0, 700, 0, 26)
hintLabel.BackgroundTransparency = 1
hintLabel.Font = Enum.Font.Gotham
hintLabel.TextSize = 14
hintLabel.TextColor3 = COLOR_TEXT
hintLabel.TextStrokeTransparency = 0.4
hintLabel.TextTruncate = Enum.TextTruncate.AtEnd
hintLabel.Text = ""
hintLabel.Parent = gui

-- ===== Hint system: rotating PC tips + priority server hints =====
local TIPS = {
	"Tekan [~] atau [F2] untuk buka / tutup Terminal (klik X [~] juga bisa)",
	"Tekan [B] untuk buka / tutup Hardware Store",
	"Pegang TechnicianLaptop (hotbar) lalu dekati device + tekan [E] = Kabel Console",
	"Klik 2 port berbeda untuk kabel LAN | Klik port terhubung = cabut",
	"Mode placement: [R] Putar 90 deg | Klik Kiri = Pasang | Klik Kanan/[Esc] = Batal",
	"Kabel berwarna: port WAN otomatis pakai spool kuning, port data pakai biru/merah",
	"Colocation: terima kontrak, angkat crate di dock, mount ke rack, atur VLAN + PDU",
}
local tipIndex = 1
local priorityActive = false
local priorityToken = 0

hintLabel.Text = TIPS[1]

local function showPriority(message: string)
	priorityToken += 1
	local myToken = priorityToken
	priorityActive = true
	hintLabel.Text = message
	task.delay(4, function()
		if priorityToken == myToken then
			priorityActive = false
			hintLabel.Text = TIPS[tipIndex]
		end
	end)
end

task.spawn(function()
	while true do
		task.wait(8)
		tipIndex = (tipIndex % #TIPS) + 1
		if not priorityActive then
			hintLabel.Text = TIPS[tipIndex]
		end
	end
end)

-- ===== RESET DATA: 2-click confirm within 4 seconds =====
local resetArmed = false
resetBtn.MouseButton1Click:Connect(function()
	if resetArmed then
		resetArmed = false
		resetBtn.Text = "RESET DATA"
		resetBtn.BackgroundColor3 = COLOR_RESET
		resetDataRemote:FireServer()
		showPriority("Data direset! Lab dibangun ulang oleh server...")
	else
		resetArmed = true
		resetBtn.Text = "YAKIN? KLIK LAGI (4s)"
		resetBtn.BackgroundColor3 = COLOR_RED
		task.delay(4, function()
			if resetArmed then
				resetArmed = false
				resetBtn.Text = "RESET DATA"
				resetBtn.BackgroundColor3 = COLOR_RESET
			end
		end)
	end
end)

-- ===== STORE [B] & TERMINAL [~] buttons -> BindableEvents =====
task.spawn(function()
	local toggleBindable = playerGui:WaitForChild("NetSimToggleStore", 60) :: any
	if toggleBindable ~= nil and toggleBindable:IsA("BindableEvent") then
		storeBtn.MouseButton1Down:Connect(function()
			toggleBindable:Fire()
		end)
	else
		storeBtn.Visible = false
		warn("[HudClient] BindableEvent NetSimToggleStore tidak ditemukan; tombol STORE disembunyikan")
	end
end)

task.spawn(function()
	local toggleTerm = playerGui:WaitForChild("NetSimToggleTerminal", 60) :: any
	if toggleTerm ~= nil and toggleTerm:IsA("BindableEvent") then
		termBtn.MouseButton1Down:Connect(function()
			toggleTerm:Fire()
		end)
	else
		termBtn.Visible = false
	end
end)

-- ===== OpenTerminalEvent hint messages (4s priority) =====
openTerminalRemote.OnClientEvent:Connect(function(payload: any)
	if type(payload) ~= "table" then
		return
	end
	if payload.action == "hint" then
		showPriority(tostring(payload.message or ""))
	end
end)

-- ===== Snapshot updates =====
stateSyncRemote.OnClientEvent:Connect(function(payload: any)
	if type(payload) ~= "table" then
		return
	end

	local function setValue(key: string, text: string, color: Color3?)
		local label = valueLabels[key]
		if label ~= nil then
			label.Text = text
			if color ~= nil then
				label.TextColor3 = color
			end
		end
	end

	setValue("balance", NetworkUtils.FormatCurrency(payload.balance or 0), COLOR_GREEN)
	setValue("reputation", tostring(payload.reputation or 0), COLOR_TEXT)
	setValue("uptime", string.format("%.1f%%", payload.uptimePercent or 0), COLOR_TEXT)
	setValue("power", NetworkUtils.FormatWatts(payload.powerWatts or 0), COLOR_YELLOW)
	local tempC = payload.avgTempC or 0
	setValue("temp", string.format("%.1f °C", tempC), if tempC > 75 then COLOR_RED else COLOR_TEXT)
	setValue("clock", string.format("Hari %d  -  %s", payload.day or 1, payload.clockText or "--:--"), COLOR_TEXT)
end)
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBX34">
<Properties>
<string name="Name">AudioAndEffectsClient</string>
<bool name="Disabled">false</bool>
<ProtectedString name="Source"><![CDATA[--!strict
--[[
	AudioAndEffectsClient (LocalScript, StarterPlayer/StarterPlayerScripts)
	Bank SFX client-side memakai asset bawaan rbxasset:// saja (tanpa aset eksternal):
	- plug  -> rbxasset://sounds/snap.mp3                (volume 0.6)
	- key   -> rbxasset://sounds/electronicpingshort.wav (pitch 1.6, volume 0.35)
	- error -> rbxasset://sounds/electronicpingshort.wav (pitch 0.6, volume 0.5)
	- cash  -> rbxasset://sounds/electronicpingshort.wav (pitch 1.2, volume 0.5)

	PlaySFXRemote.OnClientEvent(name) -> mainkan sound yang cocok (clone + Play agar
	overlap aman). Blip ketikan: TextBox "InputBox" di ScreenGui "NetSimTerminal"
	(dibuat TerminalClient) di-watch GetPropertyChangedSignal("Text"), throttle 80ms.
	Di-binding lewat ChildAdded PlayerGui + scan awal + DescendantAdded.

	Komentar kode Bahasa Inggris; tidak ada teks GUI (script ini tanpa UI).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local remotesFolder = ReplicatedStorage:WaitForChild("Remotes", 180) :: any
if remotesFolder == nil then
	warn("[AudioAndEffectsClient] ReplicatedStorage.Remotes tidak ditemukan (timeout 180s)")
	return
end

local playSfxRemote = remotesFolder:WaitForChild("PlaySFXRemote") :: RemoteEvent

-- ===== Sound bank (built-in rbxasset assets only) =====
local ASSET_PLUG = "rbxasset://sounds/snap.mp3"
local ASSET_BLIP = "rbxasset://sounds/electronicpingshort.wav"

local function makeSound(name: string, asset: string, speed: number, volume: number): Sound
	local sound = Instance.new("Sound")
	sound.Name = "NetSimSFX_" .. name
	sound.SoundId = asset
	sound.PlaybackSpeed = speed
	sound.Volume = volume
	sound.Parent = SoundService
	return sound
end

local soundBank: { [string]: Sound } = {
	plug = makeSound("plug", ASSET_PLUG, 1.0, 0.6),
	key = makeSound("key", ASSET_BLIP, 1.6, 0.35),
	error = makeSound("error", ASSET_BLIP, 0.6, 0.5),
	cash = makeSound("cash", ASSET_BLIP, 1.2, 0.5),
}

-- Play a short-lived clone so overlapping triggers do not cut each other off
local function playClone(base: Sound)
	local clone = base:Clone()
	clone.Name = base.Name .. "_OneShot"
	clone.Parent = SoundService
	clone:Play()
	clone.Ended:Connect(function()
		clone:Destroy()
	end)
	-- Safety net in case Ended never fires (e.g. sound looping properties changed)
	task.delay(4, function()
		if clone.Parent ~= nil then
			clone:Destroy()
		end
	end)
end

local function playNamed(name: string)
	local base = soundBank[name]
	if base ~= nil then
		playClone(base)
	end
end

playSfxRemote.OnClientEvent:Connect(function(name: any)
	if type(name) == "string" then
		playNamed(name)
	end
end)

-- ===== Typing blip on the terminal input TextBox =====
local keySound = soundBank.key :: Sound
local lastBlipTime = 0
local BLIP_THROTTLE_SECONDS = 0.08

local function bindTextBox(box: TextBox)
	if box:GetAttribute("NetSimSfxHooked") == true then
		return
	end
	box:SetAttribute("NetSimSfxHooked", true)
	box:GetPropertyChangedSignal("Text"):Connect(function()
		local now = os.clock()
		if now - lastBlipTime < BLIP_THROTTLE_SECONDS then
			return
		end
		lastBlipTime = now
		-- Restart the shared blip sound (no clone per keystroke)
		keySound.TimePosition = 0
		keySound:Play()
	end)
end

local function bindTerminalGui(terminalGui: Instance)
	-- Bind any existing input box
	for _, desc in ipairs(terminalGui:GetDescendants()) do
		if desc:IsA("TextBox") and desc.Name == "InputBox" then
			bindTextBox(desc :: TextBox)
		end
	end
	-- And any input box added later (TerminalClient may still be building its UI)
	terminalGui.DescendantAdded:Connect(function(desc: Instance)
		if desc:IsA("TextBox") and desc.Name == "InputBox" then
			bindTextBox(desc :: TextBox)
		end
	end)
end

-- Watch PlayerGui for the terminal ScreenGui (created by TerminalClient)
local function scanPlayerGui()
	for _, child in ipairs(playerGui:GetChildren()) do
		if child.Name == "NetSimTerminal" and child:IsA("ScreenGui") then
			bindTerminalGui(child)
		end
	end
end

playerGui.ChildAdded:Connect(function(child: Instance)
	if child.Name == "NetSimTerminal" and child:IsA("ScreenGui") then
		-- Defer one frame so TerminalClient finishes adding its children first
		task.defer(bindTerminalGui, child)
	end
end)
scanPlayerGui()
]]></ProtectedString>
</Properties>
</Item>
</Item>
</Item>
