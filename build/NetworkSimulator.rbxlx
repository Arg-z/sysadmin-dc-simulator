-- Hint overlay shown inside the bar area for 3 seconds
local hintLabel = Instance.new("TextLabel")
hintLabel.Name = "HintLabel"
hintLabel.Size = UDim2.new(1, -86, 1, 0)
hintLabel.Position = UDim2.new(0, 12, 0, 0)
